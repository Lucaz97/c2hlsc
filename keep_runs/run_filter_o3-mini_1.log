void filter(int input, int *fir_output, int *iir_output)
{
  // Define the tap values as static constants so that they can be mapped to ROM.
  static const int fir_taps_const[NUM_TAPS]         = {1, 2, 3, 2, 1};
  static const int feedforward_taps_const[NUM_TAPS]   = {1, 2, 3, 2, 1};
  static const int feedback_taps_const[NUM_TAPS]      = {0, 1, -1, 0, 0};

  // Local arrays for tap coefficients to pass to the child functions.
  // Using a loop with full unrolling copies the constants into local memory with minimal latency overhead.
  int fir_taps[NUM_TAPS];
  int feedforward_taps[NUM_TAPS];
  int feedback_taps[NUM_TAPS];

  copy_fir_taps:
  for (int i = 0; i < NUM_TAPS; i++) {
    #pragma HLS unroll
    fir_taps[i] = fir_taps_const[i];
  }

  copy_feedforward_taps:
  for (int i = 0; i < NUM_TAPS; i++) {
    #pragma HLS unroll
    feedforward_taps[i] = feedforward_taps_const[i];
  }

  copy_feedback_taps:
  for (int i = 0; i < NUM_TAPS; i++) {
    #pragma HLS unroll
    feedback_taps[i] = feedback_taps_const[i];
  }

  // The inline directive encourages the child functions (fir and iir)
  // to be inlined, which can collapse control and data-path logic,
  // reducing latency.
  #pragma HLS inline region recursive

  // Use DATAFLOW to launch the computations for FIR and IIR concurrently.
  #pragma HLS DATAFLOW

  fir(input, fir_output, fir_taps);
  iir(input, iir_output, feedforward_taps, feedback_taps);
}
```
