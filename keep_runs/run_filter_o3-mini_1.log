  int d0 = delay_lane[0];
  int d1 = delay_lane[1];
  int d2 = delay_lane[2];
  int d3 = delay_lane[3];
  // Note: delay_lane[4] is not needed for the MAC computation.

  // Compute the multiply–accumulate (MAC) using a balanced adder tree.
  int p0 = input   * taps[0];
  int p1 = d0      * taps[1];
  int p2 = d1      * taps[2];
  int p3 = d2      * taps[3];
  int p4 = d3      * taps[4];

  int s0 = p0 + p1;
  int s1 = p2 + p3;
  int sum = s0 + s1 + p4;  // Balanced accumulation to minimize delay

  // Update the delay line (shift-register behavior)
  delay_lane[4] = d3;
  delay_lane[3] = d2;
  delay_lane[2] = d1;
  delay_lane[1] = d0;
  delay_lane[0] = input;

  *output = sum;
}
```
