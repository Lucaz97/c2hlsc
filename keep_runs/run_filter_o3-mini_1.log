void fir(int input, int *output, int taps[5])
{
  // Partition arrays completely to eliminate memory access bottlenecks
  #pragma HLS array_partition variable=taps complete
  // partition the static delay line array to allow parallel access
  static int delay_lane[5] = {0};
  #pragma HLS array_partition variable=delay_lane complete

  int acc = 0;

  // Fully unrolled shift operation to reduce latency
  for (int i = 4; i > 0; i--) {
    #pragma HLS unroll yes
    delay_lane[i] = delay_lane[i - 1];
  }
  delay_lane[0] = input;

  // Fully unrolled multiply-accumulate to minimize the critical path
  for (int j = 0; j < 5; j++) {
    #pragma HLS unroll yes
    acc += delay_lane[j] * taps[j];
  }

  *output = acc;
}
