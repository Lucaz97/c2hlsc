int mac(int delay_lane[5], int taps[5], int size)
{
  // When the full set of 5 taps is used, we can avoid a loop altogether.
  // This constant‑folded expression lets the synthesis tool optimize the logic,
  // reducing the critical path and area while achieving minimum latency.
  if (size == 5) {
    return delay_lane[0]*taps[0] +
           delay_lane[1]*taps[1] +
           delay_lane[2]*taps[2] +
           delay_lane[3]*taps[3] +
           delay_lane[4]*taps[4];
  }
  else {
    int result = 0;
    // Fully unroll the loop to minimize latency when size is less than 5.
    for (int i = 0; i < size; i++) {
      #pragma hls_unroll yes
      result += delay_lane[i] * taps[i];
    }
    return result;
  }
}
