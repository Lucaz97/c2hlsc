python: '''import sys
from ortools.linear_solver import pywraplp

# Data for each function: list of options as tuples (area, latency, throughput)
options = {
    'shift': [(1451.8, 2.0, 4.0),
              (1929.7, 2.0, 4.0),
              (1451.8, 2.0, 4.0),
              (1546.9, 3.0, 5.0),
              (1451.8, 2.0, 4.0)],
    'mac':   [(4346.7, 2.0, 3.0),
              (6690.9, 6.0, 7.0),
              (4346.7, 2.0, 3.0),
              (4346.7, 2.0, 3.0),
              (6690.9, 6.0, 7.0)],
    'fir':   [(5043.1,10.0,11.0),
              (5043.1,10.0,11.0),
              (6135.1, 5.0, 6.0),
              (4901.3,10.0,11.0),
              (6219.2, 5.0, 6.0)],
    'iir':   [(8132.5,16.0,22.0),
              (8160.4,16.0,22.0),
              (8160.4,16.0,22.0),
              (8160.4,16.0,22.0),
              (8630.3,10.0,11.0)],
    # filter options are identical, but we'll include for completeness.
    'filter':[(3440.3, 1.0, 2.0),
               (3440.3, 1.0, 2.0),
               (3440.3, 1.0, 2.0),
               (3440.3, 1.0, 2.0),
               (3440.3, 1.0, 2.0)]
}

# Target area value
target_area = 6000.0

# We assume that overall latency is roughly determined by some combination rule.
# Since the application is hierarchical, and the synthesis reports always choose the best latency from the children,
# we will assume a simple additive model: overall_latency = filter_latency + min(fir_latency, iir_latency)
# Plus, for iir and fir, if they are executed serially inside filter, we might consider the maximum latency among them.
# However, based on the provided call graph, filter calls fir and iir concurrently (if possible).
# For simplification, we will assume overall latency = filter_latency + max(fir_latency, iir_latency)
#
# Also, overall area in the synthesis report is not a sum but a combined metric.
# For our optimization, we will assume an approximate total area as:
# total_area = filter_area + fir_area_component + iir_area_component + mac_area_component + shift_area_component
# Here, fir_area_component and iir_area_component are taken directly from the chosen options,
# and similarly for mac and shift.
#
# We want to minimize overall_latency, while keeping total_area close to target_area.
# We can formulate an optimization model with a weighted objective:
#   minimize latency + lambda * |total_area - target_area|
# We choose lambda as a small weight to enforce area closeness.
#
# Decision variables: for each function f, choose an option j.
#
# For simplicity, we enumerate all combinations and choose the best.
#
import itertools
import math

best_config = None
best_obj = float('inf')

# define lambda weight for area deviation penalty
lambda_penalty = 0.001

# iterate over all combinations for the 5 functions: shift, mac, fir, iir, filter.
for shift_idx in range(len(options['shift'])):
    for mac_idx in range(len(options['mac'])):
        for fir_idx in range(len(options['fir'])):
            for iir_idx in range(len(options['iir'])):
                for filter_idx in range(len(options['filter'])):
                    # Get parameters
                    area_shift, lat_shift, thr_shift = options['shift'][shift_idx]
                    area_mac, lat_mac, thr_mac = options['mac'][mac_idx]
                    area_fir, lat_fir, thr_fir = options['fir'][fir_idx]
                    area_iir, lat_iir, thr_iir = options['iir'][iir_idx]
                    area_filter, lat_filter, thr_filter = options['filter'][filter_idx]
                    
                    # Approximate overall latency:
                    # According to the call graph,
                    # iir calls: ['shift', 'mac', 'mac', 'shift'] => its latency might be lat_iir + max(lat_shift, lat_mac)
                    # fir calls: ['shift', 'mac'] => lat_fir + max(lat_shift, lat_mac)
                    # filter calls both fir and iir => lat_filter + max( fir_total_latency, iir_total_latency )
                    # And main calls filter which adds nothing significant.
                    # For simplicity, we aggregate as:
                    lat_iir_total = lat_iir + max(lat_shift, lat_mac, lat_mac, lat_shift)
                    lat_fir_total = lat_fir + max(lat_shift, lat_mac)
                    overall_latency = lat_filter + max(lat_fir_total, lat_iir_total)
                    
                    # Approximate total area: we sum areas of individual functions (even if not vanilla additive, for our model)
                    total_area = area_filter + area_fir + area_iir + area_mac + area_shift
                    
                    # Objective: minimize latency, with penalty for area deviation from target
                    obj = overall_latency + lambda_penalty * abs(total_area - target_area)
                    
                    if obj < best_obj:
                        best_obj = obj
                        best_config = {
                            'shift': shift_idx,
                            'mac': mac_idx,
                            'fir': fir_idx,
                            'iir': iir_idx,
                            'filter': filter_idx,
                            'latency': overall_latency,
                            'total_area': total_area
                        }

print("Best configuration found:")
print(best_config)
