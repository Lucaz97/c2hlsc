void shift(int input, int delay_lane[5], int size)
{
  #pragma HLS inline

  // Manually unroll the shift operation for the common values of size.
  // This minimizes control overhead and results in lower latency.
  if (size == 5) {
    delay_lane[4] = delay_lane[3];
    delay_lane[3] = delay_lane[2];
    delay_lane[2] = delay_lane[1];
    delay_lane[1] = delay_lane[0];
  }
  else if (size == 4) {
    delay_lane[3] = delay_lane[2];
    delay_lane[2] = delay_lane[1];
    delay_lane[1] = delay_lane[0];
  }
  else if (size == 3) {
    delay_lane[2] = delay_lane[1];
    delay_lane[1] = delay_lane[0];
  }
  else if (size == 2) {
    delay_lane[1] = delay_lane[0];
  }
  else if (size > 1) {
    // For any other size, fully unroll the loop (should the unrolling heuristic not fully expand the logic)
    for (int i = size - 1; i > 0; i--) {
      #pragma HLS unroll
      delay_lane[i] = delay_lane[i - 1];
    }
  }

  // Insert the new input value at the head of the delay line.
  delay_lane[0] = input;
}
