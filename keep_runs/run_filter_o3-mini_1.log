void fir(int input, int *output, int taps[5])
{
  // Optimize for lowest latency by completely unrolling the loops.
  // Instead of calling the external shift and mac functions,
  // we inline their functionality using fully unrolled loops.

  // The delay line (state) is implemented as a static array.
  static int delay_lane[5] = {0};
  int acc = 0;

  // Shift: move each element one position to the right.
  // Unroll fully for minimal latency.
  for (int i = 4; i > 0; i--) {
    #pragma HLS unroll yes
    delay_lane[i] = delay_lane[i-1];
  }
  delay_lane[0] = input;

  // MAC: multiply and accumulate across the taps.
  // Again, unroll fully to minimize latency.
  for (int j = 0; j < 5; j++) {
    #pragma HLS unroll yes
    acc += delay_lane[j] * taps[j];
  }
  *output = acc;
}
