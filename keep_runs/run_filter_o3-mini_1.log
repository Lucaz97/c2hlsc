void iir(int input, int *output, int feedforward_taps[5], int feedback_taps[5])
{
  // Use small local arrays for delay lines without complete partitioning
  static int input_delay_lane[5] = {0};
  static int output_delay_lane[5] = {0};

  // Shift the input delay line:
  for (int i = 4; i > 0; i--) {
    // Pipeline the shift loop with an initiation interval of 1 to minimize latency
    #pragma HLS pipeline init_interval=1
    input_delay_lane[i] = input_delay_lane[i - 1];
  }
  input_delay_lane[0] = input;

  // Compute the feedforward and feedback MAC operations.
  int feedforward = 0;
  int feedback = 0;
  for (int i = 0; i < 5; i++) {
    // Pipeline the MAC loop to keep the latency low while sharing resources for area savings
    #pragma HLS pipeline init_interval=1
    feedforward += input_delay_lane[i] * feedforward_taps[i];
    feedback    += output_delay_lane[i] * feedback_taps[i];
  }
  
  *output = feedforward + feedback;

  // Shift the output delay line:
  for (int i = 4; i > 0; i--) {
    #pragma HLS pipeline init_interval=1
    output_delay_lane[i] = output_delay_lane[i - 1];
  }
  output_delay_lane[0] = *output;
}
