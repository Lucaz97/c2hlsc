void iir(int input, int *output, int feedforward_taps[5], int feedback_taps[5])
{
  // Use fully partitioned arrays to allow full parallel accesses
  static int input_delay_lane[5] = {0};
  static int output_delay_lane[5] = {0};
#pragma HLS array_partition variable=input_delay_lane complete
#pragma HLS array_partition variable=output_delay_lane complete

  // Instead of calling external shift and mac functions,
  // we inline their functionality to allow full loop unrolling,
  // which minimizes latency.

  // -------------------------------
  // 1. Shift in the new input value:
  //    Move each element one position towards the end.
  //    This loop is unrolled completely.
  // -------------------------------
  for (int i = 4; i > 0; i--) {
#pragma HLS unroll
    input_delay_lane[i] = input_delay_lane[i-1];
  }
  input_delay_lane[0] = input;

  // -------------------------------
  // 2. Compute the MAC operations for feedforward and feedback taps concurrently.
  //    The loops are merged into one and unrolled completely.
  // -------------------------------
  int feedforward = 0;
  int feedback    = 0;
  for (int i = 0; i < 5; i++) {
#pragma HLS unroll
    feedforward += input_delay_lane[i] * feedforward_taps[i];
    feedback    += output_delay_lane[i] * feedback_taps[i];
  }

  *output = feedforward + feedback;

  // -------------------------------
  // 3. Shift the output into the output delay lane.
  // -------------------------------
  for (int i = 4; i > 0; i--) {
#pragma HLS unroll
    output_delay_lane[i] = output_delay_lane[i-1];
  }
  output_delay_lane[0] = *output;
}
