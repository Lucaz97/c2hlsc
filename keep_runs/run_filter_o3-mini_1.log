void fir(int input, int *output, int taps[5])
{
  // Use pipelining combined with partial unrolling to achieve low latency
  // while keeping resource usage lower than full unrolling.
  static int delay_lane[5] = {0};

  // Shift the delay line with II = 1 and unroll partially by factor 2.
  // A factor smaller than full unroll helps reduce area.
  for (int i = 4; i > 0; i--) {
    #pragma HLS pipeline II=1
    #pragma HLS unroll factor=2
    delay_lane[i] = delay_lane[i - 1];
  }
  delay_lane[0] = input;

  int acc = 0;
  // Compute the MAC using a pipelined loop with partial unrolling by factor 2.
  for (int j = 0; j < 5; j++) {
    #pragma HLS pipeline II=1
    #pragma HLS unroll factor=2
    acc += delay_lane[j] * taps[j];
  }
  *output = acc;
}
