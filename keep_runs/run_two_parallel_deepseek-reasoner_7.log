from ortools.sat.python import cp_model

model = cp_model.CpModel()

# Function options data
options = {
    'compute2': [{'area': 4266.1, 'latency': 3.0}]*5,
    'odd_factorial': [{'area': 3696.9, 'latency': 2.0}]*5,
    'even_sum': [{'area': 1349.7, 'latency': 2.0}]*4 + [{'area': 3014.2, 'latency': 1.0}]
}

target_area = 4000

# Variables
c2 = model.NewIntVar(0, 4, 'compute2')
od = model.NewIntVar(0, 4, 'odd_factorial')
es = model.NewIntVar(0, 4, 'even_sum')

# Since compute2 includes children, total area = compute2's area
total_area = 4266.1  
area_diff = model.NewIntVar(0, 10000, 'area_diff')
model.Add(area_diff == abs(int(100*(total_area - target_area))))

# Minimize latency (fixed at 3.0) and area difference
model.Minimize(area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f"solution: compute2 {solver.Value(c2)}, odd_factorial {solver.Value(od)}, even_sum {solver.Value(es)}")
else:
    print("No optimal solution found")
