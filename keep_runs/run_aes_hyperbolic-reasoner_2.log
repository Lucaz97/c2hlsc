static void MixColumns_hls(state_t state) {
  #pragma HLS ARRAY_PARTITION variable=state complete dim=1
  #pragma HLS ARRAY_PARTITION variable=state complete dim=2
  for (uint8_t i = 0; i < 4; ++i) {
    #pragma HLS UNROLL
    const uint8_t s0 = state[i][0];
    const uint8_t s1 = state[i][1];
    const uint8_t s2 = state[i][2];
    const uint8_t s3 = state[i][3];
    
    // Parallel XOR layer
    const uint8_t a = s0 ^ s1;
    const uint8_t b = s1 ^ s2;
    const uint8_t c = s2 ^ s3;
    const uint8_t d = s3 ^ s0;
    const uint8_t sum_all = a ^ c;
    
    // Parallel Galois field multiplications
    const uint8_t Tm0 = xtime(a);
    const uint8_t Tm1 = xtime(b);
    const uint8_t Tm2 = xtime(c);
