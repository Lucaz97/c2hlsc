static void SubBytes_hls(state_t state) {
  uint8_t i;
  uint8_t j;
  for (i = 0; i < 4; ++i) {
    #pragma HLS unroll yes
    for (j = 0; j < 4; ++j) {
      #pragma HLS unroll yes
      state[j][i] = sbox[state[j][i]];
    }
  }
}

static void SubBytes(state_t *state) {
  SubBytes_hls(*state);
}
