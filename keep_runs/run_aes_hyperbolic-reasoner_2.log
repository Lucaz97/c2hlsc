static void ShiftRows_hls(state_t state) {
  #pragma HLS ARRAY_PARTITION variable=state complete dim=1
  #pragma HLS ARRAY_PARTITION variable=state complete dim=2

  // Parallel read phase
  const uint8_t c1_t[4] = {state[0][1], state[1][1], state[2][1], state[3][1]};
  const uint8_t c2_t[4] = {state[0][2], state[1][2], state[2][2], state[3][2]};
  const uint8_t c3_t[4] = {state[0][3], state[1][3], state[2][3], state[3][3]};

  // Parallel write phase with rotated indices
  state[0][1] = c1_t[1];
  state[1][1] = c1_t[2];
  state[2][1] = c1_t[3];
  state[3][1] = c1_t[0];
  
  state[0][2] = c2_t[2];
  state[2][2] = c2_t[0];
  state[1][2] = c2_t[3];
  state[3][2] = c2_t[1];
  
  state[0][3] = c3_t[3];
  state[3][3] = c3_t[2];
  state[2][3] = c3_t[1];
  state[1][3] = c3_t[0];
}

static void ShiftRows(state_t *state) {
  ShiftRows_hls(*state);
}
