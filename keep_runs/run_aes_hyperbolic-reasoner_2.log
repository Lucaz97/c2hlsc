static void ShiftRows_hls(state_t state) {
  #pragma HLS ARRAY_PARTITION variable=state complete dim=1
  #pragma HLS ARRAY_PARTITION variable=state complete dim=2
  #pragma HLS latency min=0 max=0

  // Batch read all required elements first
  const uint8_t c1[4] = {state[0][1], state[1][1], state[2][1], state[3][1]};
  const uint8_t c2[4] = {state[0][2], state[1][2], state[2][2], state[3][2]};
  const uint8_t c3[4] = {state[0][3], state[1][3], state[2][3], state[3][3]};

  // Parallel write operations with explicit rotation patterns
  state[0][1] = c1[1]; state[1][1] = c1[2]; state[2][1] = c1[3]; state[3][1] = c1[0];
  state[0][2] = c2[2]; state[2][2] = c2[0]; state[1][2] = c2[3]; state[3][2] = c2[1];
  state[0][3] = c3[3]; state[3][3] = c3[2]; state[2][3] = c3[1]; state[1][3] = c3[0];
}

static void ShiftRows(state_t *state) {
  ShiftRows_hls(*state);
}
