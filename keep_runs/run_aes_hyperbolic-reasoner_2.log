static void AddRoundKey_hls(uint8_t round, state_t state, const round_t RoundKey) {
  #pragma HLS INLINE
  uint8_t round_key_block[16];
  #pragma HLS ARRAY_PARTITION variable=round_key_block complete

  // Parallel load round key block
  const uint8_t base = round << 4;
  for (int k = 0; k < 16; ++k) {
    #pragma HLS UNROLL
    round_key_block[k] = RoundKey[base + k];
  }

  // Fully parallel XOR operations
  for (uint8_t i = 0; i < 4; ++i) {
    #pragma HLS UNROLL yes
    for (uint8_t j = 0; j < 4; ++j) {
      #pragma HLS UNROLL yes
      state[i][j] ^= round_key_block[(i << 2) + j];
    }
  }
}

static void AddRoundKey(uint8_t round, state_t *state, const round_t *RoundKey) {
  AddRoundKey_hls(round, *state, *RoundKey);
}
