void sha256_transform_hls(state_t state, data_t data)
{
  unsigned int a;
  unsigned int b;
  unsigned int c;
  unsigned int d;
  unsigned int e;
  unsigned int f;
  unsigned int g;
  unsigned int h;
  unsigned int i;
  unsigned int j;
  unsigned int t1;
  unsigned int t2;
  unsigned int m[64];
  #pragma HLS array_partition variable=m complete  // Full parallel access
  
  // Full unroll of initial message processing (1 cycle)
  #pragma HLS unroll yes
  for (i = 0, j = 0; i < 16; ++i, j += 4)
    m[i] = ((data[j] << 24) | (data[j+1] << 16) | (data[j+2] << 8) | data[j+3]);

  // Full unroll of first 16 message expansion steps (1 cycle)
  #pragma HLS unroll yes
  for (i = 16; i < 32; ++i)
    m[i] = SIG1(m[i-2]) + m[i-7] + SIG0(m[i-15]) + m[i-16];

  // Pipelined remainder of message expansion with dependency awareness
  #pragma HLS pipeline II=2
  for (; i < 64; ++i)
    m[i] = SIG1(m[i-2]) + m[i-7] + SIG0(m[i-15]) + m[i-16];

  a = state[0];
  b = state[1];
  c = state[2];
  d = state[3];
  e = state[4];
  f = state[5];
  g = state[6];
  h = state[7];

  // Full unroll of main compression with explicit dataflow
  #pragma HLS unroll yes
  for (i = 0; i < 64; ++i) {
    #pragma HLS expression_balance
    t1 = h + EP1(e) + CH(e,f,g) + k[i] + m[i];
    t2 = EP0(a) + MAJ(a,b,c);
    h = g;
    g = f;
    f = e;
    e = d + t1;
    d = c;
    c = b;
    b = a;
    a = t1 + t2;
  }

  state[0] += a;
  state[1] += b;
  state[2] += c;
  state[3] += d;
  state[4] += e;
  state[5] += f;
  state[6] += g;
  state[7] += h;
}

void sha256_transform(state_t *state, data_t *data)
{
    sha256_transform_hls(*state, *data);
}
