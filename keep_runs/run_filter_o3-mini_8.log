python: '''
from ortools.sat.python import cp_model
import math

model = cp_model.CpModel()

# Define available options for each function (0-indexed)
shift = model.NewIntVar(0, 4, 'shift')
mac = model.NewIntVar(0, 4, 'mac')
fir = model.NewIntVar(0, 4, 'fir')
iir = model.NewIntVar(0, 4, 'iir')
flt = model.NewIntVar(0, 4, 'filter')

# Function parameters (values multiplied by 10 to use integers)
shift_area = [int(round(a*10)) for a in [1451.8, 1929.7, 1451.8, 1546.9, 1451.8]]
shift_latency = [int(round(l*10)) for l in [2.0, 2.0, 2.0, 3.0, 2.0]]

mac_area = [int(round(a*10)) for a in [4346.7, 6690.9, 4346.7, 4346.7, 6690.9]]
mac_latency = [int(round(l*10)) for l in [2.0, 6.0, 2.0, 2.0, 6.0]]

fir_area = [int(round(a*10)) for a in [5043.1, 5043.1, 6135.1, 4901.3, 6219.2]]
fir_latency = [int(round(l*10)) for l in [10.0, 10.0, 5.0, 10.0, 5.0]]

iir_area = [int(round(a*10)) for a in [8132.5, 8160.4, 8160.4, 8160.4, 8630.3]]
iir_latency = [int(round(l*10)) for l in [16.0, 16.0, 16.0, 16.0, 10.0]]

flt_area = [int(round(a*10)) for a in [3440.3]*5]
flt_latency = [int(round(l*10)) for l in [1.0]*5]

# Create variables for each function's chosen area and latency
shift_area_var = model.NewIntVar(0, 100000, 'shift_area_var')
shift_lat = model.NewIntVar(0, 100000, 'shift_lat')
mac_area_var = model.NewIntVar(0, 100000, 'mac_area_var')
mac_lat = model.NewIntVar(0, 100000, 'mac_lat')
fir_area_var = model.NewIntVar(0, 100000, 'fir_area_var')
fir_lat = model.NewIntVar(0, 100000, 'fir_lat')
iir_area_var = model.NewIntVar(0, 100000, 'iir_area_var')
iir_lat = model.NewIntVar(0, 100000, 'iir_lat')
flt_area_var = model.NewIntVar(0, 100000, 'flt_area_var')
flt_lat = model.NewIntVar(0, 100000, 'flt_lat')

model.AddElement(shift, shift_area, shift_area_var)
model.AddElement(shift, shift_latency, shift_lat)
model.AddElement(mac, mac_area, mac_area_var)
model.AddElement(mac, mac_latency, mac_lat)
model.AddElement(fir, fir_area, fir_area_var)
model.AddElement(fir, fir_latency, fir_lat)
model.AddElement(iir, iir_area, iir_area_var)
model.AddElement(iir, iir_latency, iir_lat)
model.AddElement(flt, flt_area, flt_area_var)
model.AddElement(flt, flt_latency, flt_lat)

# For this prototype, assume overall latency is the sum of individual latencies,
# and overall area is the sum of individual areas.
total_latency = model.NewIntVar(0, 100000, 'total_latency')
total_area = model.NewIntVar(0, 100000, 'total_area')
model.Add(total_latency == shift_lat + mac_lat + fir_lat + iir_lat + flt_lat)
model.Add(total_area == shift_area_var + mac_area_var + fir_area_var + iir_area_var + flt_area_var)

# Target area (scaled by 10)
target_area = 6000 * 10  # 60000

# Define a variable for the absolute difference from target area
diff = model.NewIntVar(0, 100000, 'diff')
model.Add(diff == abs(total_area - target_area))

# Objective: minimize latency primarily, then area difference secondary.
# Weight latency heavily.
model.Minimize(total_latency * 100000 + diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    print("shift", solver.Value(shift))
    print("mac", solver.Value(mac))
    print("fir", solver.Value(fir))
    print("iir", solver.Value(iir))
    print("filter", solver.Value(flt))
    print("total_latency", solver.Value(total_latency)/10.0)
    print("total_area", solver.Value(total_area)/10.0)
else:
    print("No solution found")
'''
