from ortools.sat.python import cp_model

# Function options data
functions = {
    'AddRoundKey_hls': [
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1816.7, 'latency': 49.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
    ],
    'SubBytes_hls': [
        {'area': 826.5, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
    ],
    'xtime': [
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
    ],
    'MixColumns_hls': [
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
    ],
    'Cipher_hls': [
        {'area': 2632.8, 'latency': 1091.0},
        {'area': 3685.5, 'latency': 1011.0},
        {'area': 2632.8, 'latency': 1091.0},
        {'area': 3685.5, 'latency': 1011.0},
        {'area': 2665.5, 'latency': 1029.0},
    ],
}

# Create model
model = cp_model.CpModel()

# Variables: option index for each function
vars = {}
for func in functions:
    vars[func] = model.NewIntVar(0, len(functions[func])-1, func)

# Latency: sum of all latencies
total_latency = sum(
    functions[func][vars[func]].latency() for func in functions
)
model.Minimize(total_latency)

# Area: sum of all areas, target 10000
total_area = sum(
    functions[func][vars[func]].area() for func in functions
)
model.Add(total_area <= 11000)  # Allow some flexibility

# Solve
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output best configuration
if status == cp_model.OPTIMAL:
    config = []
    for func in functions:
        idx = solver.Value(vars[func])
        config.append(f"{func} {idx}")
    print(f"Best configuration: {', '.join(config)}")
    print(f"Total latency: {solver.ObjectiveValue()}")
    print(f"Total area: {sum(functions[func][idx].area() for func, idx in zip(functions, [solver.Value(vars[func]) for func in functions]))}")
else:
    print("No optimal solution found")
