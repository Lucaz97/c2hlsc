python: '''
from ortools.sat.python import cp_model

# Function options data scaled by 10 to integers
functions = {
    'AddRoundKey_hls': [
        {'area': 7526, 'latency': 340},
        {'area': 7526, 'latency': 340},
        {'area': 18167, 'latency': 490},
        {'area': 7526, 'latency': 340},
        {'area': 7526, 'latency': 340},
    ],
    'SubBytes_hls': [
        {'area': 8265, 'latency': 330},
        {'area': 8259, 'latency': 330},
        {'area': 8259, 'latency': 330},
        {'area': 8259, 'latency': 330},
        {'area': 8259, 'latency': 330},
    ],
    'ShiftRows_hls': [
        {'area': 239, 'latency': 0},
        {'area': 239, 'latency': 0},
        {'area': 239, 'latency': 0},
        {'area': 239, 'latency': 0},
        {'area': 239, 'latency': 0},
    ],
    'xtime': [
        {'area': 770, 'latency': 10},
        {'area': 770, 'latency': 10},
        {'area': 770, 'latency': 10},
        {'area': 770, 'latency': 10},
        {'area': 770, 'latency': 10},
    ],
    'MixColumns_hls': [
        {'area': 6359, 'latency': 60},
        {'area': 6359, 'latency': 60},
        {'area': 6359, 'latency': 60},
        {'area': 6359, 'latency': 60},
        {'area': 6359, 'latency': 60},
    ],
    'Cipher_hls': [
        {'area': 26328, 'latency': 10910},
        {'area': 36855, 'latency': 10110},
        {'area': 26328, 'latency': 10910},
        {'area': 36855, 'latency': 10110},
        {'area': 26655, 'latency': 10290},
    ],
}

model = cp_model.CpModel()

# Variables and element constraints
vars = {func: model.NewIntVar(0, len(options)-1, func) for func, options in functions.items()}
latencies = {}
areas = {}

for func in functions:
    options = functions[func]
    latencies[func] = model.NewIntVar(0, max(opt['latency'] for opt in options), f'{func}_latency')
    areas[func] = model.NewIntVar(0, max(opt['area'] for opt in options), f'{func}_area')
    model.AddElement(vars[func], [opt['latency'] for opt in options], latencies[func])
    model.AddElement(vars[func], [opt['area'] for opt in options], areas[func])

total_latency = sum(latencies.values())
total_area = sum(areas.values())

model.Minimize(total_latency)
model.Add(total_area <= 110000)  # 11000 * 10

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    config = []
    for func in functions:
        idx = solver.Value(vars[func])
        config.append(f"{func} {idx}")
    print("solution: " + ", ".join(config))
else:
    print("No optimal solution found")
