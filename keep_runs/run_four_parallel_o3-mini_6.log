import sys
from ortools.sat.python import cp_model

# Create the CP-SAT model
model = cp_model.CpModel()

# Options for each function: (area, latency, throughput)
# Note: Options indexed starting at 0
fibonacci_options = [
    (1640.4, 2.0, 3.0),
    (2323.6, 3.0, 4.0),
    (1640.4, 2.0, 3.0),
    (4551.5, 97.0, 98.0),
    (1800.0, 3.0, 4.0)
]
odd_sum_options = [
    (1287.7, 2.0, 3.0),
    (2787.1, 1.0, 2.0),
    (1643.5, 3.0, 4.0),
    (2257.9, 5.0, 6.0),
    (2107.8, 4.0, 5.0)
]
even_sum_options = [
    (1349.7, 2.0, 3.0),
    (3047.8, 1.0, 2.0),
    (1230.0, 2.0, 3.0),
    (2958.7, 1.0, 2.0),
    (1244.6, 3.0, 4.0)
]
compute3_options = [
    (7636.8, 5.0, 6.0),
    (7636.8, 5.0, 6.0),
    (7636.8, 5.0, 6.0),
    (7608.1, 5.0, 6.0),
    (7636.8, 5.0, 6.0)
]

num_fib = len(fibonacci_options)
num_odd = len(odd_sum_options)
num_even = len(even_sum_options)
num_comp = len(compute3_options)

# Decision variables: which option to select for each function
fib_sel = model.NewIntVar(0, num_fib - 1, 'fib_sel')
odd_sel = model.NewIntVar(0, num_odd - 1, 'odd_sel')
even_sel = model.NewIntVar(0, num_even - 1, 'even_sel')
comp_sel = model.NewIntVar(0, num_comp - 1, 'comp_sel')

# Since CP-SAT works with integers, scale floating point values by a factor.
scale = 10

fib_areas = [int(round(a * scale)) for (a, l, t) in fibonacci_options]
fib_lat =   [int(round(l * scale)) for (a, l, t) in fibonacci_options]
odd_areas = [int(round(a * scale)) for (a, l, t) in odd_sum_options]
odd_lat =   [int(round(l * scale)) for (a, l, t) in odd_sum_options]
even_areas = [int(round(a * scale)) for (a, l, t) in even_sum_options]
even_lat =   [int(round(l * scale)) for (a, l, t) in even_sum_options]
comp_areas = [int(round(a * scale)) for (a, l, t) in compute3_options]
comp_lat =   [int(round(l * scale)) for (a, l, t) in compute3_options]

# Here we assume that the final accelerator is built
# by composing compute3 and its child functions.
# To avoid double-counting, assume each function is mapped once.
# Thus: total_area = area(compute3) + area(fibonacci) + area(odd_sum) + area(even_sum)
total_area = model.NewIntVar(0, 1000000, 'total_area')
model.Add(total_area == comp_areas[comp_sel] +
                        fib_areas[fib_sel] +
                        odd_areas[odd_sel] +
                        even_areas[even_sel])

# Similarly, assume total_latency is the sum of individual latencies.
total_latency = model.NewIntVar(0, 1000000, 'total_latency')
model.Add(total_latency == comp_lat[comp_sel] +
                           fib_lat[fib_sel] +
                           odd_lat[odd_sel] +
                           even_lat[even_sel])

# Our target area (scaled)
target_area = 2800 * scale

# Create an auxiliary variable for the absolute difference with target_area.
area_diff = model.NewIntVar(0, 1000000, 'area_diff')
# Since CP-SAT does not support abs(x) directly, we use two constraints.
temp = model.NewIntVar(-1000000, 1000000, 'temp')
model.Add(temp == total_area - target_area)
model.AddAbsEquality(area_diff, temp)

# Objective:
# Primary: minimize latency, Secondary: minimize deviation from target area.
# We form a weighted sum where latency is given a high weight.
# Objective = total_latency * 1000 + area_diff
objective = model.NewIntVar(0, 100000000, 'objective')
model.Add(objective == total_latency * 1000 + area_diff)
model.Minimize(objective)

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in [cp_model.OPTIMAL, cp_model.FEASIBLE]:
    print("fibonacci", solver.Value(fib_sel))
    print("odd_sum", solver.Value(odd_sel))
    print("even_sum", solver.Value(even_sel))
    print("compute3", solver.Value(comp_sel))
    print("Total Latency:", solver.Value(total_latency) / scale)
    print("Total Area:", solver.Value(total_area) / scale)
else:
    print("No solution found")
'''
