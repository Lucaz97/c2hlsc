int odd_sum(int n)
{
    int sum = 0;
    if (n <= 1)
        return 0;

    int i;
    // Process pairs of odd numbers while ensuring both numbers are < n
    for (i = 1; i <= n - 4; i += 4) {
        #pragma hls_pipeline_init_interval 1
        sum += i + (i + 2);
    }
    // Process any remaining odd number
    for (; i < n; i += 2) {
        #pragma hls_pipeline_init_interval 1
        sum += i;
    }
    return sum;
}
