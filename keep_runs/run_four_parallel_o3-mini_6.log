int odd_sum(int n)
{
    // Closed-form computation completely eliminates the loop,
    // significantly reducing latency.
    // For n <= 1, no odd numbers exist.
    if (n <= 1)
        return 0;
    // Compute the number of odd terms, which is floor(n/2)
    int m = n >> 1;
    // The sum of the first m odd numbers is m*m.
    return m * m;
}
```
