```c
int fibonacci(int n)
{
  // Use the doubling algorithm to compute F(n-1) in O(log n) steps,
  // reducing the combinational chain depth and hence latency.
  // The algorithm computes the pair (F(k), F(k+1)) iteratively.
  // Here, we interpret the original fibonacci(n) as returning F(n-1).
  int m = n - 1; // we want to compute F(n-1)
  int a = 0;     // a = F(0)
  int b = 1;     // b = F(1)

  // Iterate over each bit of m from most-significant (assuming 32-bit int)
  for (int i = 31; i >= 0; i--) {
    #pragma hls_unroll yes
    // Doubling formulas:
    // c = F(2k)   = F(k) * [2*F(k+1) − F(k)]
    // d = F(2k+1) = F(k)^2 + F(k+1)^2
    int c = a * (2 * b - a);
    int d = a * a + b * b;
    
    // If the current bit of m is set, update the pair accordingly.
    if ((m >> i) & 1) {
      a = d;
      b = c + d;
    } else {
      a = c;
      b = d;
    }
  }
  
  // At the end, a holds F(m) which is F(n-1).
  return a;
}
```
