int fibonacci(int n)
{
  // Early exit for n less than 2 (ensuring defined behavior)
  if(n < 2) return n;

  int a = 0;
  int b = 1;
  int c = 0;

  // Fully unroll the loop to generate a combinational chain,
  // which minimizes the critical path latency.
  for (int i = 2; i < n; i++)
  {
    #pragma hls_unroll yes
    c = a + b;
    a = b;
    b = c;
  }

  return c;
}
```
