```c
int fibonacci(int n)
{
  int a = 0;
  int b = 1;
  int c = 0;
  int i = 2;

  // Process two Fibonacci updates per loop iteration to reduce
  // the number of dependent stages and hence minimize latency.
  // Fully unroll the loop to remove loop overhead.
  for (; i <= n - 2; i += 2) {
    #pragma hls_unroll yes
    // First update
    c = a + b;
    a = b;
    b = c;
    // Second update
    c = a + b;
    a = b;
    b = c;
  }

  // If an odd number of iterations remain, process one more update.
  if (i < n) {
    c = a + b;
  }
  
  return c;
}
```
