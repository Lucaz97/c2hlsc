int even_sum(int n)
{
  // Use bit-shift for division by 2 instead of an arithmetic division
  // Compute the number of even terms < n (i.e. k = (n-1)/2)
  int k = (n - 1) >> 1;
  // Compute closed-form sum: 2 + 4 + ... + 2*k = k*(k+1)
  int sum = k * (k + 1);
  return sum;
}
