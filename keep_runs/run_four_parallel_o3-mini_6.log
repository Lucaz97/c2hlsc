int odd_sum(int n)
{
    int sum1 = 0;
    int sum2 = 0;

    for (int i = 1; i < n; i += 2)
    {
        // Pipeline the loop with an initiation interval of 1 to improve latency.
        #pragma hls_pipeline_init_interval 1
        // Split the accumulation to reduce the dependency chain.
        // The odd numbers alternate as follows:
        // i = 1 (mod4 == 1) -> sum1, i = 3 (mod4 == 3) -> sum2, i = 5 -> sum1, etc.
        if ((i % 4) == 1)
            sum1 += i;
        else
            sum2 += i;
    }

    return sum1 + sum2;
}
```
