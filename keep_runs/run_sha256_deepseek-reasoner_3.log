from ortools.sat.python import cp_model

transform_options = [
    {'area': 34078.8, 'latency': 80},
    {'area': 34078.8, 'latency': 80},
    {'area': 34078.8, 'latency': 80},
    {'area': 34082.3, 'latency': 80},
    {'area': 34082.3, 'latency': 80},
]
update_options = [
    {'area': 41794.1, 'latency': 83},
    {'area': 42191.2, 'latency': 84},
    {'area': 44444.2, 'latency': 81},
    {'area': 42191.2, 'latency': 84},
    {'area': 42191.2, 'latency': 84},
]

model = cp_model.CpModel()
t = model.NewIntVar(0, 4, 'transform')
u = model.NewIntVar(0, 4, 'update')

# Convert areas to integers scaled by 10
t_areas = [int(opt['area'] * 10) for opt in transform_options]
u_areas = [int(opt['area'] * 10) for opt in update_options]

# Total area calculation
t_area = model.NewIntVar(0, 200000, 't_area')
u_area = model.NewIntVar(0, 200000, 'u_area')
model.AddElement(t, t_areas, t_area)
model.AddElement(u, u_areas, u_area)
total_area = model.NewIntVar(0, 200000, 'total_area')
model.Add(total_area == t_area + u_area)

# Latency (using update's latency as critical path)
latency = model.NewIntVar(0, 200, 'latency')
model.AddElement(u, [opt['latency'] for opt in update_options], latency)

# Deviation from target (70000 * 10)
target = 70000 * 10
deviation = model.NewIntVar(0, 200000, 'deviation')
model.AddAbsEquality(deviation, total_area - target)

# Objective: minimize latency & deviation
model.Minimize(latency * 10000 + deviation)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f"Transform: {solver.Value(t)}, Update: {solver.Value(u)}")
    print(f"Area: {solver.Value(total_area)/10:.1f}, Latency: {solver.Value(latency)}")
else:
    print("No solution")
'''
