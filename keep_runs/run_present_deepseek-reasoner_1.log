        {'area': 1175.3, 'latency': 15.0},
        {'area': 1175.3, 'latency': 15.0},
        {'area': 1175.3, 'latency': 15.0},
    ],
    'generateRoundKeys80_hls': [
        {'area': 2354.3, 'latency': 596.0},
        {'area': 2354.3, 'latency': 596.0},
        {'area': 2365.8, 'latency': 596.0},
        {'area': 2365.8, 'latency': 596.0},
        {'area': 2365.8, 'latency': 596.0},
    ],
    'addRoundKey_hls': [
        {'area': 424.1, 'latency': 14.0},
        {'area': 424.1, 'latency': 14.0},
        {'area': 126.1, 'latency': 0.0},
        {'area': 423.6, 'latency': 14.0},
        {'area': 126.1, 'latency': 0.0},
    ],
    'pLayer_hls': [
        {'area': 1007.7, 'latency': 150.0},
        {'area': 1007.7, 'latency': 150.0},
        {'area': 902.8, 'latency': 79.0},
        {'area': 902.8, 'latency': 79.0},
        {'area': 871.1, 'latency': 47.0},
    ],
    'present80_encryptBlock_hls': [
        {'area': 13399.8, 'latency': 2993.0},
        {'area': 13399.8, 'latency': 2993.0},
        {'area': 13399.8, 'latency': 2993.0},
        {'area': 13399.8, 'latency': 2993.0},
        {'area': 13399.8, 'latency': 2993.0},
    ]
}

target_area = 70000

model = cp_model.CpModel()

option_vars = {func: model.NewIntVar(0, len(opts)-1, func) for func, opts in functions.items()}

total_area = model.NewIntVar(0, int(2e5), 'total_area')
total_latency = model.NewIntVar(0, int(2e5), 'total_latency')

area_terms = []
latency_terms = []

for func in functions:
    for idx, opt in enumerate(functions[func]):
        selected = model.NewBoolVar(f'{func}_opt{idx}')
        model.Add(option_vars[func] == idx).OnlyEnforceIf(selected)
        model.Add(option_vars[func] != idx).OnlyEnforceIf(selected.Not())
        area_terms.append(int(opt['area'] * 10) * selected)  # Scale to avoid floats
        latency_terms.append(int(opt['latency'] * 10) * selected)

model.Add(total_area == sum(area_terms))
model.Add(total_latency == sum(latency_terms))

delta = model.NewIntVar(-int(2e5), int(2e5), 'delta')
model.Add(delta == total_area - int(target_area * 10))
abs_delta = model.NewIntVar(0, int(2e5), 'abs_delta')
model.AddAbsEquality(abs_delta, delta)

model.Minimize(total_latency * 10000 + abs_delta)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal configuration:")
    for func in functions:
        idx = solver.Value(option_vars[func])
        print(f"{func}: {idx}")
    print(f"Total area: {solver.Value(total_area)/10}")
    print(f"Total latency: {solver.Value(total_latency)/10}")
else:
    print("No solution found.")
