void pLayer_hls(block_t block) {
  block_t initial;
  #pragma HLS ARRAY_PARTITION variable=initial complete
  copyBlock_hls(block, initial);

  for (unsigned char i = 0; i < 8; i++) {
    #pragma HLS UNROLL
    unsigned char temp = 0;
    for (unsigned char j = 0; j < 8; j++) {
      #pragma HLS PIPELINE II=1
      const unsigned char indexVal = (4 * (i & 1)) + (3 - (j >> 1));
      const unsigned char andVal = (8 >> (i >> 1)) << ((j & 1) << 2);
      temp |= ((initial[indexVal] & andVal) ? 1 : 0) << j;
    }
    block[i] = temp;
  }
}

void pLayer(block_t *block) {
  pLayer_hls(*block);
}
```

