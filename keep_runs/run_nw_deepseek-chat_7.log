    'needwun': [1303.0, 1303.0, 1303.0, 1303.0, 1303.0]
}

# Decision variables: binary variables for each option of each function
fill_matrix_vars = [solver.IntVar(0, 1, f'fill_matrix_{i}') for i in range(5)]
reverse_string_vars = [solver.IntVar(0, 1, f'reverse_string_{i}') for i in range(5)]
traceback_vars = [solver.IntVar(0, 1, f'traceback_{i}') for i in range(5)]
needwun_vars = [solver.IntVar(0, 1, f'needwun_{i}') for i in range(5)]

# Constraints: Only one option can be selected per function
solver.Add(solver.Sum(fill_matrix_vars) == 1)
solver.Add(solver.Sum(reverse_string_vars) == 1)
solver.Add(solver.Sum(traceback_vars) == 1)
solver.Add(solver.Sum(needwun_vars) == 1)

# Objective: Minimize latency
solver.Minimize(
    solver.Sum(latency_data['fill_matrix'][i] * fill_matrix_vars[i] for i in range(5)) +
    solver.Sum(latency_data['reverse_string'][i] * reverse_string_vars[i] for i in range(5)) +
    solver.Sum(latency_data['traceback'][i] * traceback_vars[i] for i in range(5)) +
    solver.Sum(latency_data['needwun'][i] * needwun_vars[i] for i in range(5))
)

# Constraint: Total area <= 230000
solver.Add(
