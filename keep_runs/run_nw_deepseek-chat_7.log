# Area and latency data
area_data = {
    'fill_matrix': [2206.1, 2206.1, 2215.5, 2206.1, 2206.1],
    'reverse_string': [2541.5, 2541.5, 2338.5, 2338.5, 2541.5],
    'traceback': [10612.2, 10612.2, 10612.2, 10612.2, 10612.2],
