// odd_factorial option 2

int odd_factorial(int n)
{
  int res = 1;
  #pragma hls_pipeline_init_interval 1
  for (int i = 1; i < n; i += 2)
  {
    res = res * i;
  }

  return res;
}
// fibonacci option 0

int fibonacci(int n)
{
  int a = 0;
  int b = 1;
  int c;

  #pragma hls_unroll yes
  for (int i = 2; i < n; i++)
  {
    c = a + b;
    a = b;
    b = c;
  }

  return c;
}
// even_sum option 2

int even_sum(int n)
{
  int sum = 0;
  #pragma hls_pipeline_init_interval 1
  for (int i = 2; i < n; i += 2)
  {
    sum += i;
  }

  return sum;
}

