python: '''import math
from ortools.sat.python import cp_model

model = cp_model.CpModel()

# Define the options as (area, latency) tuples, scaled by a factor for integer variables.
fib_options = [(1640.4, 2), (2323.6, 3), (1640.4, 2), (4551.5, 97), (1800.0, 3)]
odd_options = [(1287.7, 2), (2787.1, 1), (1643.5, 3), (2257.9, 5), (2107.8, 4)]
even_options = [(1349.7, 2), (3047.8, 1), (1230.0, 2), (2958.7, 1), (1244.6, 3)]
comp_options = [(7636.8, 5), (7636.8, 5), (7636.8, 5), (7608.1, 5), (7636.8, 5)]

num_fib = len(fib_options)
num_odd = len(odd_options)
num_even = len(even_options)
num_comp = len(comp_options)

# Create decision variables for each function’s option selection.
fib_choice = model.NewIntVar(0, num_fib - 1, 'fib_choice')
odd_choice = model.NewIntVar(0, num_odd - 1, 'odd_choice')
even_choice = model.NewIntVar(0, num_even - 1, 'even_choice')
comp_choice = model.NewIntVar(0, num_comp - 1, 'comp_choice')

# Scaling factor to convert area to integer.
scale = 10
fib_areas = [int(a * scale) for (a, l) in fib_options]
fib_lats  = [l for (a, l) in fib_options]
odd_areas = [int(a * scale) for (a, l) in odd_options]
odd_lats  = [l for (a, l) in odd_options]
even_areas = [int(a * scale) for (a, l) in even_options]
even_lats  = [l for (a, l) in even_options]
comp_areas = [int(a * scale) for (a, l) in comp_options]
comp_lats  = [l for (a, l) in comp_options]

# Create variables to fetch the individual areas and latencies by element constraints.
fib_area = model.NewIntVar(0, 100000, 'fib_area')
model.AddElement(fib_choice, fib_areas, fib_area)
fib_lat = model.NewIntVar(0, 1000, 'fib_lat')
model.AddElement(fib_choice, fib_lats, fib_lat)

odd_area = model.NewIntVar(0, 100000, 'odd_area')
model.AddElement(odd_choice, odd_areas, odd_area)
odd_lat = model.NewIntVar(0, 1000, 'odd_lat')
model.AddElement(odd_choice, odd_lats, odd_lat)

even_area = model.NewIntVar(0, 100000, 'even_area')
model.AddElement(even_choice, even_areas, even_area)
even_lat = model.NewIntVar(0, 1000, 'even_lat')
model.AddElement(even_choice, even_lats, even_lat)

comp_area = model.NewIntVar(0, 100000, 'comp_area')
model.AddElement(comp_choice, comp_areas, comp_area)
comp_lat = model.NewIntVar(0, 1000, 'comp_lat')
model.AddElement(comp_choice, comp_lats, comp_lat)

# Total area and total latency (summing all functions for the application).
total_area = model.NewIntVar(0, 1000000, 'total_area')
total_lat  = model.NewIntVar(0, 100000, 'total_lat')
model.Add(total_area == fib_area + odd_area + even_area + comp_area)
model.Add(total_lat  == fib_lat + odd_lat + even_lat + comp_lat)

# Our target total area is 2800 (scaled to integer).
target_area = 2800 * scale  # 28000

# Introduce a variable to represent the absolute difference from the target area.
area_diff = model.NewIntVar(0, 100000, 'area_diff')
model.Add(area_diff >= total_area - target_area)
model.Add(area_diff >= target_area - total_area)

# Objective: minimize latency while keeping area close to target.
# We combine both objectives in a weighted sum.
# Since latency numbers are small compared to area difference,
# we multiply total_lat by a factor (e.g., 1000) to give it priority.
model.Minimize(total_lat * 1000 + area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in [cp_model.OPTIMAL, cp_model.FEASIBLE]:
    print('fib_choice', solver.Value(fib_choice))
    print('odd_choice', solver.Value(odd_choice))
    print('even_choice', solver.Value(even_choice))
    print('comp_choice', solver.Value(comp_choice))
    print('total_lat', solver.Value(total_lat))
    print('total_area', solver.Value(total_area) / scale)
else:
    print("No solution found.")
'''
