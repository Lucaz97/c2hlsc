Given that the current configuration still exceeds the target area significantly, let's explore a different approach. We will use a Python script with the Google OR-Tools library to find the optimal combination of function options that minimizes latency while keeping the total area as close as possible to 10000.

Here is the Python script to solve the optimization problem:

```python
python: '''
from ortools.linear_solver import pywraplp

# Define the solver
solver = pywraplp.Solver.CreateSolver('SCIP')

# Define the variables
sha256_transform_options = [
    {'area': 46135.0, 'latency': 571.0},
    {'area': 37187.1, 'latency': 77.0},
    {'area': 41436.4, 'latency': 17.0},
    {'area': 42551.8, 'latency': 34.0},
    {'area': 36088.9, 'latency': 33.0}
]

sha256_update_options = [
    {'area': 45854.1, 'latency': 19.0},
    {'area': 45854.1, 'latency': 19.0},
    {'area': 45854.1, 'latency': 19.0},
    {'area': 45854.1, 'latency': 19.0},
    {'area': 45854.1, 'latency': 19.0}
]

# Create decision variables
x_transform = [solver.IntVar(0, 1, f'x_transform_{i}') for i in range(len(sha256_transform_options))]
x_update = [solver.IntVar(0, 1, f'x_update_{i}') for i in range(len(sha256_update_options))]

# Constraint: Only one option can be selected for each function
solver.Add(sum(x_transform) == 1)
solver.Add(sum(x_update) == 1)

# Objective: Minimize latency
latency = solver.Sum([x_transform[i] * sha256_transform_options[i]['latency'] for i in range(len(sha256_transform_options))]) + \
          solver.Sum([x_update[i] * sha256_update_options[i]['latency'] for i in range(len(sha256_update_options))])
solver.Minimize(latency)

# Constraint: Total area should be as close as possible to 10000
area = solver.Sum([x_transform[i] * sha256_transform_options[i]['area'] for i in range(len(sha256_transform_options))]) + \
       solver.Sum([x_update[i] * sha256_update_options[i]['area'] for i in range(len(sha256_update_options))])
solver.Add(area <= 10000)

# Solve the problem
status = solver.Solve()

# Output the results
if status == pywraplp.Solver.OPTIMAL:
    print('Optimal solution found:')
    for i in range(len(sha256_transform_options)):
        if x_transform[i].solution_value() == 1:
            print(f'sha256_transform_hls option {i} selected')
    for i in range(len(sha256_update_options)):
        if x_update[i].solution_value() == 1:
            print(f'sha256_update_hls option {i} selected')
    print(f'Total Latency: {solver.Objective().Value()}')
    print(f'Total Area: {area.solution_value()}')
else:
    print('No optimal solution found.')
'''
```
