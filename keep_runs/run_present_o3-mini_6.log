void present80_encryptBlock_hls(unsigned char block[PRESENT_BLOCK_SIZE_BYTES],
                                unsigned char key[PRESENT_80_KEY_SIZE_BYTES])
{
    keys_t roundKeys;
    unsigned char i, j;
    unsigned char currentBlock[PRESENT_BLOCK_SIZE_BYTES];
    unsigned char nextBlock[PRESENT_BLOCK_SIZE_BYTES];

    // Copy input block into temporary buffer
    for(j = 0; j < PRESENT_BLOCK_SIZE_BYTES; j++){
        currentBlock[j] = block[j];
    }

    generateRoundKeys80_hls(key, roundKeys);

    for (i = 0; i < (ROUNDS - 1); i++)
    {
        addRoundKey_hls(currentBlock, roundKeys[i]);

        // Substitution layer: compute in nextBlock to break long feedback path
        for (j = 0; j < PRESENT_BLOCK_SIZE_BYTES; j++)
        {
            unsigned char tmp = currentBlock[j];
            nextBlock[j] = (sBox[tmp >> 4] << 4) | sBox[tmp & 0x0F];
        }

        // Permutation layer applied on the substituted block
        pLayer_hls(nextBlock);

        // Prepare for next round by copying nextBlock into currentBlock
        for (j = 0; j < PRESENT_BLOCK_SIZE_BYTES; j++)
        {
            currentBlock[j] = nextBlock[j];
        }
    }
    addRoundKey_hls(currentBlock, roundKeys[ROUNDS - 1]);

    // Write the final result back to output block
    for (j = 0; j < PRESENT_BLOCK_SIZE_BYTES; j++)
    {
        block[j] = currentBlock[j];
    }
}

void present80_encryptBlock(block_t *block, present_key_t *key)
{
    present80_encryptBlock_hls(*block, *key);
}
