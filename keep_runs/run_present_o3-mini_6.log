python: '''
from ortools.linear_solver import pywraplp

# Data: function options for each function in the application.
# Each tuple: (area, latency)
functions = {
    'copyKey_hls': [
        (529.7, 1.0),   # option 0
        (529.7, 1.0),   # option 1
        (529.7, 1.0),   # option 2
        (1527.9, 19.0), # option 3
        (529.7, 1.0)    # option 4
    ],
    'copyBlock_hls': [
        (427.6, 1.0),   # option 0
        (427.6, 1.0),   # option 1
        (427.6, 1.0),   # option 2
        (1175.3, 15.0), # option 3
        (1175.3, 15.0)  # option 4
    ],
    'generateRoundKeys80_hls': [
        (2354.3, 596.0), # option 0
        (2336.0, 596.0), # option 1
        (1558.8, 286.0), # option 2
        (1546.0, 286.0), # option 3
        (1546.0, 286.0)  # option 4
    ],
    'addRoundKey_hls': [
        (126.1, 0.0),   # option 0
        (2056.9, 30.0), # option 1
        (126.1, 0.0),   # option 2
        (126.1, 0.0),   # option 3
        (126.1, 0.0)    # option 4
    ],
    'pLayer_hls': [
        (23.9, 0.0),    # option 0
        (902.8, 79.0),  # option 1
        (23.9, 0.0),    # option 2
        (876.8, 79.0),  # option 3
        (23.9, 0.0)     # option 4
    ],
    'present80_encryptBlock_hls': [
        (14572.9, 1128.0), # option 0
        (20121.8, 544.0),  # option 1
        (13035.3, 584.0),  # option 2
        (13077.4, 1137.0), # option 3
        (13066.8, 1137.0)  # option 4
    ]
}

target_area = 70000
# Weight for area deviation in the objective. Chosen small enough
# so that latency minimization is the primary objective.
w = 0.001

# Create solver
solver = pywraplp.Solver.CreateSolver('SCIP')
if not solver:
    raise Exception("Solver not found")

# Decision variables: for each function and each option, binary variables.
x = {}
for func, opts in functions.items():
    n_opts = len(opts)
    x[func] = [solver.IntVar(0, 1, f"x_{func}_{i}") for i in range(n_opts)]
    # Each function: exactly one option must be chosen.
    solver.Add(solver.Sum(x[func][i] for i in range(n_opts)) == 1)

# Total area and total latency.
total_area = solver.NumVar(0, solver.infinity(), 'total_area')
total_latency = solver.NumVar(0, solver.infinity(), 'total_latency')

# Set expressions for area and latency.
area_expr = solver.Sum( x[func][i] * functions[func][i][0] for func in functions for i in range(len(functions[func])) )
latency_expr = solver.Sum( x[func][i] * functions[func][i][1] for func in functions for i in range(len(functions[func])) )

# Link the expressions with the variables.
solver.Add(total_area == area_expr)
solver.Add(total_latency == latency_expr)

# For the area deviation, we linearize |total_area - target_area|
diff_pos = solver.NumVar(0, solver.infinity(), 'diff_pos')
diff_neg = solver.NumVar(0, solver.infinity(), 'diff_neg')
solver.Add(total_area - target_area == diff_pos - diff_neg)

# Objective: minimize total_latency plus weighted absolute area deviation.
objective = solver.Minimize(total_latency + w*(diff_pos + diff_neg))

status = solver.Solve()

if status == pywraplp.Solver.OPTIMAL:
    print("Optimal solution found:")
    print("Total latency =", total_latency.solution_value())
    print("Total area =", total_area.solution_value())
    print("Area deviation =", (diff_pos.solution_value() + diff_neg.solution_value()))
    for func in functions:
        for i in range(len(functions[func])):
            if x[func][i].solution_value() > 0.5:
                area, lat = functions[func][i]
                print(f"{func}: option {i} (area={area}, latency={lat})")
else:
    print("No optimal solution found.")
'''
