                     unsigned char roundKey[ROUND_KEY_SIZE_BYTES])
{
  // Optimize for latency and area by processing the block in 32‐bit chunks.
  // This approach replaces eight individual XORs with two 32‐bit XOR operations.
  // We use the HLS inline directive to ensure the function is fully inlined.
  #pragma HLS inline
  
