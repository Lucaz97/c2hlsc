python: '''import sys
from ortools.sat.python import cp_model

# Data for each function: list of (area, latency)
# Multiply area and latency by 10 (deci-units) to avoid floating point
options = {
    'AddRoundKey_hls': [(7526, 340), (7394, 310), (7394, 310), (7346, 310), (19005, 160)],
    'SubBytes_hls':   [(18891, 150), (8310, 210), (8255, 150), (18891, 150), (8290, 150)],
    'ShiftRows_hls':  [(9756, 190), (239, 0), (239, 0), (239, 0), (239, 0)],
    'xtime':          [(770, 10), (770, 10), (820, 10), (770, 10), (770, 10)],
    'MixColumns_hls': [(8666, 0), (8666, 0), (6399, 30), (8666, 0), (8666, 0)],
    'Cipher_hls':     [(48692, 1940), (97685, 1750), (48692, 1940), (86220, 2020), (97685, 1750)]
}

functions = list(options.keys())

# Target area multiplied by 10
target_area = 100000

model = cp_model.CpModel()

# Decision variables: for each function, choose one option index.
choice = {}
for func in functions:
    num_options = len(options[func])
    choice[func] = model.NewIntVar(0, num_options - 1, f'{func}_choice')

# Expressions for area and latency per function.
area_vars = {}
latency_vars = {}
for func in functions:
    areas = [opt[0] for opt in options[func]]
    latencies = [opt[1] for opt in options[func]]
    area_var = model.NewIntVar(min(areas), max(areas), f'{func}_area')
    latency_var = model.NewIntVar(min(latencies), max(latencies), f'{func}_latency')
    model.AddElement(choice[func], areas, area_var)
    model.AddElement(choice[func], latencies, latency_var)
    area_vars[func] = area_var
    latency_vars[func] = latency_var

# Total area and total latency
total_area = model.NewIntVar(0, 1000000, 'total_area')
model.Add(total_area == sum(area_vars[func] for func in functions))

total_latency = model.NewIntVar(0, 100000, 'total_latency')
model.Add(total_latency == sum(latency_vars[func] for func in functions))

# Absolute deviation from the target area
deviation = model.NewIntVar(0, 1000000, 'deviation')
model.AddAbsEquality(deviation, total_area - target_area)

# Define objective: minimize total_latency + lambda_weight * deviation.
# Here, lambda_weight is 1.
lambda_weight = 1
model.Minimize(total_latency + lambda_weight * deviation)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in [cp_model.OPTIMAL, cp_model.FEASIBLE]:
    print('Solution:')
    for func in functions:
        idx = solver.Value(choice[func])
        area = options[func][idx][0] / 10.0
        lat  = options[func][idx][1] / 10.0
        print(f'{func} option {idx}: area = {area}, latency = {lat}')
    tot_area = solver.Value(total_area) / 10.0
    tot_latency = solver.Value(total_latency) / 10.0
    deviation_val = solver.Value(deviation) / 10.0
    print(f'Total area: {tot_area}, Total latency: {tot_latency}, Deviation from target: {deviation_val}')
else:
    print('No solution found.')
'''
