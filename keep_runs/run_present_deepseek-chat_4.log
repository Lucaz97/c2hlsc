    copyKey_hls(newKey, key);
    key[0] = (sBox[key[0] >> 4] << 4) | (key[0] & 0xF);
    key[8] ^= i << 7;
    key[7] ^= i >> 1;
    copyBlock_hls(key, keys[i]);
