python: '''
from ortools.sat.python import cp_model

functions = {
    'fill_matrix': [
        {'area': 2206.1, 'latency': 1293.0},
        {'area': 2144.7, 'latency': 1293.0},
        {'area': 2597.8, 'latency': 213.0},
        {'area': 2407.3, 'latency': 2538.0},
        {'area': 2698.4, 'latency': 213.0},
    ],
    'reverse_string': [
        {'area': 1804.2, 'latency': 31.0},
        {'area': 1719.0, 'latency': 31.0},
        {'area': 1719.0, 'latency': 31.0},
        {'area': 1906.1, 'latency': 31.0},
        {'area': 3611.2, 'latency': 95.0},
    ],
    'traceback': [
        {'area': 10173.9, 'latency': 34.0},
        {'area': 10173.9, 'latency': 34.0},
        {'area': 10173.9, 'latency': 34.0},
        {'area': 9416.3, 'latency': 127.0},
        {'area': 10173.9, 'latency': 34.0},
    ],
    'needwun': [
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
    ],
}

model = cp_model.CpModel()
vars = {func: model.NewIntVar(0, len(options)-1, func) for func, options in functions.items()}

# Create element constraints for area/latency
area_vars = []
latency_vars = []
for func in functions:
    areas = [int(opt['area']*10) for opt in functions[func]]
    latencies = [int(opt['latency']*10) for opt in functions[func]]
    
    area_var = model.NewIntVar(min(areas), max(areas), f'{func}_area')
    latency_var = model.NewIntVar(min(latencies), max(latencies), f'{func}_latency')
    
    model.AddElement(vars[func], areas, area_var)
    model.AddElement(vars[func], latencies, latency_var)
    
    area_vars.append(area_var)
    latency_vars.append(latency_var)

total_area = sum(area_vars)
total_latency = sum(latency_vars)

target_area = 6000*10  # Scaled target
area_diff = model.NewIntVar(0, 1000000, 'area_diff')
model.AddAbsEquality(area_diff, (total_area - target_area))

model.Minimize(total_latency * 1000 + area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    config = [f"{func} {solver.Value(vars[func])}" for func in functions]
    print(f"solution: {', '.join(config)}")
else:
    print("No optimal solution found")
'''
