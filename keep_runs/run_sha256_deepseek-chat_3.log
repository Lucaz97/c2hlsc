from ortools.sat.python import cp_model

# Define the problem
model = cp_model.CpModel()

# Variables
sha256_transform_options = [0, 1, 2, 3, 4]
sha256_update_options = [0, 1, 2, 3, 4]

# Latency and area data for sha256_transform_hls (scaled to integers)
transform_latency = [int(571.0 * 100), int(77.0 * 100), int(17.0 * 100), int(34.0 * 100), int(33.0 * 100)]
transform_area = [int(46135.0), int(37187.1), int(41436.4), int(42551.8), int(36088.9)]

# Latency and area data for sha256_update_hls (scaled to integers)
update_latency = [int(19.0 * 100), int(19.0 * 100), int(19.0 * 100), int(19.0 * 100), int(19.0 * 100)]
update_area = [int(45854.1), int(45854.1), int(45854.1), int(45854.1), int(45854.1)]

# Decision variables
transform_choice = model.NewIntVar(0, 4, 'transform_choice')
update_choice = model.NewIntVar(0, 4, 'update_choice')

# Intermediate variables for latency and area
transform_latency_var = model.NewIntVar(0, 100000, 'transform_latency_var')
transform_area_var = model.NewIntVar(0, 100000, 'transform_area_var')
update_latency_var = model.NewIntVar(0, 100000, 'update_latency_var')
update_area_var = model.NewIntVar(0, 100000, 'update_area_var')

# Boolean variables to represent the choice conditions
transform_choice_bool = [model.NewBoolVar(f'transform_choice_bool_{i}') for i in range(5)]
update_choice_bool = [model.NewBoolVar(f'update_choice_bool_{i}') for i in range(5)]

# Enforce that exactly one option is chosen for each function
model.Add(sum(transform_choice_bool) == 1)
model.Add(sum(update_choice_bool) == 1)

# Map decision variables to latency and area values
for i in range(5):
    model.Add(transform_choice == i).OnlyEnforceIf(transform_choice_bool[i])
    model.Add(transform_latency_var == transform_latency[i]).OnlyEnforceIf(transform_choice_bool[i])
    model.Add(transform_area_var == transform_area[i]).OnlyEnforceIf(transform_choice_bool[i])

    model.Add(update_choice == i).OnlyEnforceIf(update_choice_bool[i])
    model.Add(update_latency_var == update_latency[i]).OnlyEnforceIf(update_choice_bool[i])
    model.Add(update_area_var == update_area[i]).OnlyEnforceIf(update_choice_bool[i])

# Objective: Minimize latency
total_latency = model.NewIntVar(0, 100000, 'total_latency')
model.Add(total_latency == transform_latency_var + update_latency_var)
model.Minimize(total_latency)

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print(f"Optimal configuration:")
    print(f"sha256_transform_hls: {solver.Value(transform_choice)}")
    print(f"sha256_update_hls: {solver.Value(update_choice)}")
    print(f"Total latency: {solver.Value(total_latency) / 100}")  # Scale back to original units
    print(f"Total area: {solver.Value(transform_area_var) + solver.Value(update_area_var)}")
else:
    print("No feasible solution found.")
'''
