python: '''
from ortools.sat.python import cp_model

transform_options = [
    {'area': 34078.8, 'latency': 80.0},
    {'area': 34050.7, 'latency': 80.0},
    {'area': 35364.6, 'latency': 65.0},
    {'area': 35364.6, 'latency': 65.0},
    {'area': 35364.6, 'latency': 65.0}
]

update_options = [
    {'area': 43624.5, 'latency': 68.0},
    {'area': 43933.9, 'latency': 68.0},
    {'area': 43441.5, 'latency': 68.0},
    {'area': 70914.8, 'latency': 396.0},
    {'area': 43933.9, 'latency': 68.0}
]

target_area = 70000

model = cp_model.CpModel()

# Variables
t = model.NewIntVar(0, len(transform_options)-1, 'transform')
u = model.NewIntVar(0, len(update_options)-1, 'update')

# Create area/latency arrays for element constraints
transform_areas = [int(opt['area']) for opt in transform_options]
transform_latencies = [int(opt['latency']) for opt in transform_options]
update_areas = [int(opt['area']) for opt in update_options]
update_latencies = [int(opt['latency']) for opt in update_options]

# Element constraints to get values based on selection
t_area = model.NewIntVar(0, 100000, 't_area')
t_latency = model.NewIntVar(0, 1000, 't_latency')
u_area = model.NewIntVar(0, 100000, 'u_area')
u_latency = model.NewIntVar(0, 1000, 'u_latency')

model.AddElement(t, transform_areas, t_area)
model.AddElement(t, transform_latencies, t_latency)
model.AddElement(u, update_areas, u_area)
model.AddElement(u, update_latencies, u_latency)

# Total area and latency
total_area = model.NewIntVar(0, 200000, 'total_area')
total_latency = model.NewIntVar(0, 1000, 'total_latency')
model.Add(total_area == t_area + u_area)
model.Add(total_latency == t_latency + u_latency)

# Objective: minimize latency first, then area proximity
area_diff = model.NewIntVar(0, 200000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - target_area)
model.Minimize(total_latency * 1000 + area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f'Solution:')
    print(f'sha256_transform_hls {solver.Value(t)}')
    print(f'sha256_update_hls {solver.Value(u)}')
    print(f'Total area: {solver.Value(total_area)}, Target: {target_area}')
    print(f'Total latency: {solver.Value(total_latency)}')
else:
    print('No solution found')
'''
