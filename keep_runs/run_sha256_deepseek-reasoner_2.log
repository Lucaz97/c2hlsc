from ortools.sat.python import cp_model

# Function options data
transform_options = [
    {'area': 34078.8, 'latency': 80.0},
    {'area': 34050.7, 'latency': 80.0},
    {'area': 35364.6, 'latency': 65.0},
    {'area': 35364.6, 'latency': 65.0},
    {'area': 35364.6, 'latency': 65.0}
]

update_options = [
    {'area': 43624.5, 'latency': 68.0},
    {'area': 43933.9, 'latency': 68.0},
    {'area': 43441.5, 'latency': 68.0},
    {'area': 70914.8, 'latency': 396.0},
    {'area': 43933.9, 'latency': 68.0}
]

target_area = 70000

model = cp_model.CpModel()

# Variables
t = model.NewIntVar(0, 4, 'transform')
u = model.NewIntVar(0, 4, 'update')

# Area and latency expressions
area = model.NewIntVar(0, 200000, 'area')
latency = model.NewIntVar(0, 1000, 'latency')

# Add area and latency constraints
model.Add(area == int(transform_options[t].get('area') + update_options[u].get('area')))
model.Add(latency == int(transform_options[t].get('latency') + update_options[u].get('latency')))

# Objective: minimize latency and stay close to target area
area_diff = model.NewIntVar(0, 200000, 'area_diff')
model.AddAbsEquality(area_diff, area - target_area)
model.Minimize(latency * 1000 + area_diff)  # Prioritize latency, then area proximity

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f'Optimal solution found:')
    print(f'Transform option: {solver.Value(t)}, Area: {transform_options[solver.Value(t)]["area"]}')
    print(f'Update option: {solver.Value(u)}, Area: {update_options[solver.Value(u)]["area"]}')
    print(f'Total area: {solver.Value(area)}, Total latency: {solver.Value(latency)}')
else:
    print('No optimal solution found')
'''
