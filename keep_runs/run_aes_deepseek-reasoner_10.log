from ortools.sat.python import cp_model

# Function options data
functions = {
    'AddRoundKey_hls': [
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1900.5, 'latency': 16.0},
        {'area': 1900.5, 'latency': 16.0},
    ],
    'SubBytes_hls': [
        {'area': 826.5, 'latency': 33.0} for _ in range(5)
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0} for _ in range(5)
    ],
    'xtime': [
        {'area': 77.0, 'latency': 1.0} for _ in range(5)
    ],
    'MixColumns': [
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.3, 'latency': 6.0},
        {'area': 635.3, 'latency': 6.0},
        {'area': 648.1, 'latency': 6.0},
    ],
    'Cipher': [
        {'area': 3714.0, 'latency': 672.0},
        {'area': 4418.2, 'latency': 644.0},
        {'area': 4418.2, 'latency': 644.0},
        {'area': 6683.8, 'latency': 626.0},
        {'area': 4418.2, 'latency': 644.0},
    ]
}

target_area = 10000

model = cp_model.CpModel()

# Variables: option index for each function
variables = {}
for func in functions:
    variables[func] = model.NewIntVar(0, len(functions[func])-1, func)

# Calculate total area and latency
total_area = sum(
    functions[func][variables[func]].get('area', 0) for func in functions)
total_latency = sum(
    functions[func][variables[func]].get('latency', 0) for func in functions)

# Objective: minimize latency
model.Minimize(total_latency)

# Constraint: total area as close as possible to target
model.Add(total_area <= target_area * 1.1)  # Allow 10% over

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    config = {}
    for func in functions:
        option = solver.Value(variables[func])
        config[func] = option
    print(f"Optimal configuration: {config}")
else:
    print("No solution found")
