from ortools.sat.python import cp_model

# Function options data scaled by 10 to handle as integers
functions = {
    'AddRoundKey_hls': [
        {'area': 7526, 'latency': 340},  # Original 752.6 -> 7526
        {'area': 7526, 'latency': 340},
        {'area': 7526, 'latency': 340},
        {'area': 19005, 'latency': 160},
        {'area': 19005, 'latency': 160},
    ],
    'SubBytes_hls': [
        {'area': 8265, 'latency': 330} for _ in range(5)
    ],
    'ShiftRows_hls': [
        {'area': 239, 'latency': 0} for _ in range(5)
    ],
    'xtime': [
        {'area': 770, 'latency': 10} for _ in range(5)
    ],
    'MixColumns': [
        {'area': 6359, 'latency': 60},
        {'area': 6359, 'latency': 60},
        {'area': 6353, 'latency': 60},
        {'area': 6353, 'latency': 60},
        {'area': 6481, 'latency': 60},
    ],
    'Cipher': [
        {'area': 37140, 'latency': 6720},
        {'area': 44182, 'latency': 6440},
        {'area': 44182, 'latency': 6440},
        {'area': 66838, 'latency': 6260},
        {'area': 44182, 'latency': 6440},
    ]
}

target_area = 10000 * 10  # Scaled target
max_area = int(target_area * 1.1)  # 10% tolerance

model = cp_model.CpModel()

# Create Boolean variables for each option
selections = {}
area_vars = []
latency_vars = []

for func in functions:
    num_options = len(functions[func])
    option_vars = [model.NewBoolVar(f'{func}_option_{i}') for i in range(num_options)]
    model.AddExactlyOne(option_vars)
    selections[func] = option_vars
    
    # Add area and latency contributions
    for i, option in enumerate(functions[func]):
        area_vars.append(option['area'] * option_vars[i])
        latency_vars.append(option['latency'] * option_vars[i])

total_area = sum(area_vars)
total_latency = sum(latency_vars)

model.Add(total_area <= max_area)
model.Minimize(total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    config = {}
    for func in functions:
        for i, var in enumerate(selections[func]):
            if solver.Value(var):
                config[func] = i
                break
    print(f"Optimal configuration: {config}")
else:
    print("No solution found")
