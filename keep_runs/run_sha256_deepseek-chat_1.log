# Area and latency expressions
transform_area = model.NewIntVar(0, int(1e6), "transform_area")
transform_latency = model.NewIntVar(0, int(1e6), "transform_latency")
update_area = model.NewIntVar(0, int(1e6), "update_area")
update_latency = model.NewIntVar(0, int(1e6), "update_latency")

# Use Element constraint to map variables to options
model.AddElement(transform_var, [int(opt["area"]) for opt in transform_options], transform_area)
model.AddElement(transform_var, [int(opt["latency"]) for opt in transform_options], transform_latency)
model.AddElement(update_var, [int(opt["area"]) for opt in update_options], update_area)
model.AddElement(update_var, [int(opt["latency"]) for opt in update_options], update_latency)

# Constraints
model.Add(transform_area + update_area <= 100000)

# Objective: Minimize latency
model.Minimize(transform_latency + update_latency)

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print(f"Optimal configuration found:")
    print(f"sha256_transform_hls: Option {solver.Value(transform_var)}")
    print(f"sha256_update_hls: Option {solver.Value(update_var)}")
    print(f"Total Area: {solver.Value(transform_area) + solver.Value(update_area)}")
    print(f"Total Latency: {solver.Value(transform_latency) + solver.Value(update_latency)}")
else:
    print("No feasible solution found.")
'''
