python: '''
from ortools.sat.python import cp_model

# Define the problem
model = cp_model.CpModel()

# Options for sha256_transform_hls
transform_options = [
    {"index": 0, "area": 46135.0, "latency": 571.0},
    {"index": 1, "area": 37187.1, "latency": 77.0},
    {"index": 2, "area": 41436.4, "latency": 17.0},
    {"index": 3, "area": 42551.8, "latency": 34.0},
    {"index": 4, "area": 36088.9, "latency": 33.0},
]

# Options for sha256_update_hls
update_options = [
    {"index": 0, "area": 45854.1, "latency": 19.0},
    {"index": 1, "area": 45854.1, "latency": 19.0},
    {"index": 2, "area": 45854.1, "latency": 19.0},
    {"index": 3, "area": 45854.1, "latency": 19.0},
    {"index": 4, "area": 45854.1, "latency": 19.0},
]

# Variables
transform_var = model.NewIntVar(0, len(transform_options) - 1, "transform_option")
update_var = model.NewIntVar(0, len(update_options) - 1, "update_option")

# Constraints
model.Add(transform_options[transform_var]["area"] + update_options[update_var]["area"] <= 10000)

# Objective: Minimize latency
model.Minimize(transform_options[transform_var]["latency"] + update_options[update_var]["latency"])

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print(f"Optimal configuration found:")
    print(f"sha256_transform_hls: Option {solver.Value(transform_var)}")
    print(f"sha256_update_hls: Option {solver.Value(update_var)}")
    print(f"Total Area: {transform_options[solver.Value(transform_var)]['area'] + update_options[solver.Value(update_var)]['area']}")
    print(f"Total Latency: {transform_options[solver.Value(transform_var)]['latency'] + update_options[solver.Value(update_var)]['latency']}")
else:
    print("No feasible solution found.")
'''
