model.AddElement(transform_var, [opt["latency"] for opt in transform_options], transform_latency)
model.AddElement(update_var, [opt["area"] for opt in update_options], update_area)
model.AddElement(update_var, [opt["latency"] for opt in update_options], update_latency)

# Constraints
model.Add(transform_area + update_area <= 10000)

# Objective: Minimize latency
model.Minimize(transform_latency + update_latency)

# Solve the model
