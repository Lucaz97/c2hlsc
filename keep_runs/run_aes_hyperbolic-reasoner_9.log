from ortools.sat.python import cp_model

functions = {
    'AddRoundKey_hls': [
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1816.7, 'latency': 49.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
    ],
    'SubBytes_hls': [
        {'area': 826.5, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
    ],
    'MixColumns_hls': [
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
    ],
    'Cipher_hls': [
        {'area': 2632.8, 'latency': 1091.0},
        {'area': 3685.5, 'latency': 1011.0},
        {'area': 2632.8, 'latency': 1091.0},
        {'area': 3685.5, 'latency': 1011.0},
        {'area': 2665.5, 'latency': 1029.0},
    ],
}

target_area = 10000

model = cp_model.CpModel()

selected = {}
for func in functions:
    selected[func] = model.NewIntVar(0, 4, f'{func}_option')

total_area = model.NewIntVar(0, 70000, 'total_area')  # Increased upper bound
total_latency = model.NewIntVar(0, 200000, 'total_latency')  # Increased upper bound

area_terms = []
latency_terms = []
for func in functions:
    options = functions[func]
    for i, opt in enumerate(options):
        option_active = model.NewBoolVar(f'{func}_option_{i}')
        model.Add(selected[func] == i).OnlyEnforceIf(option_active)
        area_terms.append(int(opt['area'] * 10) * option_active)
        latency_terms.append(int(opt['latency'] * 10) * option_active)

model.Add(total_area == sum(area_terms))
model.Add(total_latency == sum(latency_terms))

area_diff = model.NewIntVar(0, 70000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - int(target_area * 10))

model.Minimize(total_latency * 1000 + area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Solution:")
    for func in functions:
        opt_idx = solver.Value(selected[func])
        print(f"{func} {opt_idx}")
else:
    print("No optimal solution found")
'''
