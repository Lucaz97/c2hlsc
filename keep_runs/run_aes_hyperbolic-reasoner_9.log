from ortools.sat.python import cp_model

functions = {
    'AddRoundKey_hls': [
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1816.7, 'latency': 49.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
    ],
    'SubBytes_hls': [
        {'area': 826.5, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
    ],
    'MixColumns_hls': [
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
    ],
    'Cipher_hls': [
        {'area': 2632.8, 'latency': 1091.0},
        {'area': 3685.5, 'latency': 1011.0},
        {'area': 2632.8, 'latency': 1091.0},
        {'area': 3685.5, 'latency': 1011.0},
        {'area': 2665.5, 'latency': 1029.0},
    ],
}

target_area = 6500  # Adjusted realistic target

model = cp_model.CpModel()

# Create option selection variables
selected = {func: model.NewIntVar(0, 4, f'{func}_option') for func in functions}

# Create total area and latency expressions
area_terms = []
latency_terms = []

for func in functions:
    for idx in range(5):
        # Create activation variable for each option
        is_selected = model.NewBoolVar(f'{func}_sel_{idx}')
        model.Add(selected[func] == idx).OnlyEnforceIf(is_selected)
        
        # Add weighted terms using integer scaling
        area_terms.append(int(functions[func][idx]['area'] * 10) * is_selected)
        latency_terms.append(int(functions[func][idx]['latency'] * 10) * is_selected)

total_area = sum(area_terms)
total_latency = sum(latency_terms)

# Area proximity constraint
area_diff = model.NewIntVar(0, 20000, 'area_diff')
model.Add(area_diff == abs(total_area - int(target_area * 10)))

# Objective: minimize latency with area proximity
model.Minimize(total_latency * 1000 + area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Solution:")
    for func in functions:
        opt_idx = solver.Value(selected[func])
        print(f"{func} {opt_idx}")
else:
    print("No solution found")
