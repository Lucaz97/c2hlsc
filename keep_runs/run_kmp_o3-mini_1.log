// In this version we ask the tool to aggressively inline the entire kmp function as well as its child calls
// so that the scheduler can fully flatten the hierarchy and potentially shave off any extra overhead.
// Using the "always_inline" attribute hints to HLS that inlining is the preferred strategy for minimum latency.
__attribute__((always_inline))
int kmp(char pattern[4], char input[204], int kmpNext[4], int n_matches[1])
{
    // Reset the match counter.
    n_matches[0] = 0;

    // Force inline of CPF to flatten its operations into this function.
    #pragma HLS inline region
    CPF(pattern, kmpNext);

    // Force inline of kmp_process to flatten its operations as well.
    #pragma HLS inline region
    kmp_process(pattern, input, kmpNext, n_matches);

    return 0;
}
```
