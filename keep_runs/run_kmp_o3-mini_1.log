// fully inlines CPF and kmp_process without forcing an unnecessary pipelining boundary.
// This allows the HLS tool to flatten the hierarchy even further, reducing scheduling overhead.
#pragma HLS inline
int kmp(char pattern[4], char input[204], int kmpNext[4], int n_matches[1])
{
    // Reset the match counter.
    n_matches[0] = 0;
    
    // Inline and flatten the CPF call.
    #pragma HLS inline region
    CPF(pattern, kmpNext);
    
    // Inline and flatten the kmp_process call.
    #pragma HLS inline region
    kmp_process(pattern, input, kmpNext, n_matches);
    
    return 0;
}
