void CPF(char pattern[4], int kmpNext[4])
{
    int k = 0;
    kmpNext[0] = 0;

    // For a fixed, very small pattern size we can collapse the dependency chain
    // by pipelining the outer loop with an initiation interval of 0.
    // This forces the three iterations (q = 1,2,3) to be scheduled in a single combinational chain,
    // which reduces the latency (targeting 4 cycles) while retaining the low area
    // similar to the iterative (FSM) implementation.
    c1: for (int q = 1; q < 4; q++)
    {
        #pragma HLS pipeline II=0
        c2: while ((k > 0) && (pattern[k] != pattern[q]))
        {
            // Preserve the original logic: note that the while‐loop uses kmpNext[q]
            // (even though many KMP implementations would index k-1);
            // we must not change the algorithm.
            k = kmpNext[q];
        }
        if (pattern[k] == pattern[q])
        {
            k++;
        }
        kmpNext[q] = k;
    }
}
