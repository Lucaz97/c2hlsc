// We further reduce latency by forcing the compiler to inline the entire kmp function 
// and its calls to CPF and kmp_process, which helps flatten the hierarchy and improve scheduling.
#pragma HLS inline
int kmp(char pattern[4], char input[204], int kmpNext[4], int n_matches[1])
{
    // This pipeline directive helps schedule the operations with an initiation interval of zero.
    // When combined with inlining, it reduces call overhead and conservatively minimizes latency.
    #pragma HLS pipeline init_interval=0

    // Reset the match counter.
    n_matches[0] = 0;
    
    // Inline the CPF function call to compute the kmpNext array.
    #pragma HLS inline region
    CPF(pattern, kmpNext);
    
    // Inline the kmp_process function call to process the input data.
    #pragma HLS inline region
    kmp_process(pattern, input, kmpNext, n_matches);
    
    return 0;
}
