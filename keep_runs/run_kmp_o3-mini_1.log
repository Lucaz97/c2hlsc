void CPF(char pattern[4], int kmpNext[4])
{
    int k = 0;
    kmpNext[0] = 0;

    // For such a small fixed-size pattern, we unroll each iteration completely.
    // We also replace the while loops by a bounded for loop with full unrolling
    // to force the tool to implement them as combinational logic, reducing latency.

    // q = 1 iteration
    {
        // Bound the inner loop to at most PATTERN_SIZE iterations.
        c1_q1: for (int i = 0; i < 4; i++) {
            #pragma HLS unroll yes
            if (!( (k > 0) && (pattern[k] != pattern[1]) ))
                break;
            k = kmpNext[1];
        }
        if (pattern[k] == pattern[1]) {
            k++;
        }
        kmpNext[1] = k;
    }

    // q = 2 iteration
    {
        c1_q2: for (int i = 0; i < 4; i++) {
            #pragma HLS unroll yes
            if (!( (k > 0) && (pattern[k] != pattern[2]) ))
                break;
            k = kmpNext[2];
        }
        if (pattern[k] == pattern[2]) {
            k++;
        }
        kmpNext[2] = k;
    }

    // q = 3 iteration
    {
        c1_q3: for (int i = 0; i < 4; i++) {
            #pragma HLS unroll yes
            if (!( (k > 0) && (pattern[k] != pattern[3]) ))
                break;
            k = kmpNext[3];
        }
        if (pattern[k] == pattern[3]) {
            k++;
        }
        kmpNext[3] = k;
    }
}
