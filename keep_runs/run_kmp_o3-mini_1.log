from ortools.sat.python import cp_model

# Data for each function option: (area, latency, throughput)
# Functions: CPF, kmp_process, kmp
CPF_options = [
    (992.6, 9.0, 12.0),
    (1599.6, 4.0, 6.0),
    (992.6, 9.0, 12.0),
    (1822.3, 10.0, 12.0),
    (992.6, 9.0, 12.0)
]

kmp_process_options = [
    (1220.5, 1018.0, 1022.0),
    (1617.7, 1018.0, 1022.0),
    (1220.5, 1018.0, 1022.0),
    (1564.7, 610.0, 614.0),
    (1334.9, 1018.0, 1022.0)
]

kmp_options = [
    (3102.4, 619.0, 620.0),
    (3102.4, 619.0, 620.0),
    (3102.4, 619.0, 620.0),
    (3102.4, 619.0, 620.0),
    (3102.4, 619.0, 620.0)
]

target_area = 10000

# Instantiate CP-SAT model
model = cp_model.CpModel()

# Decision variables for each function selection.
cpf_choice = model.NewIntVar(0, len(CPF_options) - 1, 'cpf_choice')
kmp_process_choice = model.NewIntVar(0, len(kmp_process_options) - 1, 'kmp_process_choice')
kmp_choice = model.NewIntVar(0, len(kmp_options) - 1, 'kmp_choice')

# Scale factor to convert float values to integers (preserving one decimal place)
scale = 10

# Create scaled lists for area and latency for each option.
CPF_area = [int(round(opt[0] * scale)) for opt in CPF_options]
CPF_latency = [int(round(opt[1] * scale)) for opt in CPF_options]

kmp_process_area = [int(round(opt[0] * scale)) for opt in kmp_process_options]
kmp_process_latency = [int(round(opt[1] * scale)) for opt in kmp_process_options]

kmp_area = [int(round(opt[0] * scale)) for opt in kmp_options]
kmp_latency = [int(round(opt[1] * scale)) for opt in kmp_options]

# Create integer variables for selected option attributes.
cpf_area_var = model.NewIntVar(min(CPF_area), max(CPF_area), 'cpf_area')
cpf_latency_var = model.NewIntVar(min(CPF_latency), max(CPF_latency), 'cpf_latency')
model.AddElement(cpf_choice, CPF_area, cpf_area_var)
model.AddElement(cpf_choice, CPF_latency, cpf_latency_var)

kmp_process_area_var = model.NewIntVar(min(kmp_process_area), max(kmp_process_area), 'kmp_process_area')
kmp_process_latency_var = model.NewIntVar(min(kmp_process_latency), max(kmp_process_latency), 'kmp_process_latency')
model.AddElement(kmp_process_choice, kmp_process_area, kmp_process_area_var)
model.AddElement(kmp_process_choice, kmp_process_latency, kmp_process_latency_var)

kmp_area_var = model.NewIntVar(min(kmp_area), max(kmp_area), 'kmp_area')
kmp_latency_var = model.NewIntVar(min(kmp_latency), max(kmp_latency), 'kmp_latency')
model.AddElement(kmp_choice, kmp_area, kmp_area_var)
model.AddElement(kmp_choice, kmp_latency, kmp_latency_var)

# Total area and latency (assuming additive latency for simplicity)
total_area = model.NewIntVar(0, 1000000, 'total_area')
total_latency = model.NewIntVar(0, 1000000, 'total_latency')
model.Add(total_area == cpf_area_var + kmp_process_area_var + kmp_area_var)
model.Add(total_latency == cpf_latency_var + kmp_process_latency_var + kmp_latency_var)

# Calculate absolute deviation from target area using AddAbsEquality.
target_area_scaled = int(round(target_area * scale))
area_deviation = model.NewIntVar(0, 1000000, 'area_deviation')
model.AddAbsEquality(area_deviation, total_area - target_area_scaled)

# We combine the objectives: minimize latency and the deviation from target area.
# In this formulation, we directly minimize the sum of total_latency and area_deviation.
model.Minimize(total_latency + area_deviation)

# Solve the model.
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    cpf_opt = solver.Value(cpf_choice)
    kmp_process_opt = solver.Value(kmp_process_choice)
    kmp_opt = solver.Value(kmp_choice)
    total_area_val = solver.Value(total_area) / scale
    total_latency_val = solver.Value(total_latency) / scale
    print("CPF option:", cpf_opt, "Area =", CPF_options[cpf_opt][0], "Latency =", CPF_options[cpf_opt][1])
    print("kmp_process option:", kmp_process_opt, "Area =", kmp_process_options[kmp_process_opt][0], "Latency =", kmp_process_options[kmp_process_opt][1])
    print("kmp option:", kmp_opt, "Area =", kmp_options[kmp_opt][0], "Latency =", kmp_options[kmp_opt][1])
    print("Total area:", total_area_val)
    print("Total latency:", total_latency_val)
else:
    print("No solution found.")
