Given that all explored configurations either result in a latency of 0 with an area significantly higher than the target of 8000 or a higher latency with an area below the target, I will now use the Google OR-Tools library to solve the optimization problem and find the best combination of function options that minimizes latency while keeping the total area as close as possible to 8000.

Here is the Python script to solve the optimization problem:

```python
python: '''
from ortools.linear_solver import pywraplp

# Define the data
functions = {
    'fibonacci': [
        {'area': 1640.9, 'latency': 2.0},
        {'area': 1728.2, 'latency': 2.0},
        {'area': 1640.9, 'latency': 2.0},
        {'area': 1728.2, 'latency': 2.0},
        {'area': 1640.9, 'latency': 2.0}
    ],
    'odd_sum': [
        {'area': 1287.7, 'latency': 2.0},
        {'area': 1210.9, 'latency': 2.0},
        {'area': 1287.7, 'latency': 2.0},
        {'area': 1287.7, 'latency': 2.0},
        {'area': 2817.3, 'latency': 1.0}
    ],
    'even_sum': [
        {'area': 1349.7, 'latency': 2.0},
        {'area': 2397.2, 'latency': 3.0},
        {'area': 1230.0, 'latency': 2.0},
        {'area': 1509.2, 'latency': 2.0},
        {'area': 1230.0, 'latency': 2.0}
    ],
    'compute5': [
        {'area': 9056.5, 'latency': 34.0},
        {'area': 7715.6, 'latency': 0.0},
        {'area': 7710.1, 'latency': 0.0},
        {'area': 7710.1, 'latency': 0.0},
        {'area': 6821.0, 'latency': 38.0}
    ]
}

# Create the solver
solver = pywraplp.Solver.CreateSolver('SCIP')

# Define the variables
x = {}
for func in functions:
    for i in range(len(functions[func])):
        x[(func, i)] = solver.IntVar(0, 1, f'{func}_{i}')

# Add constraints: exactly one option per function
for func in functions:
    solver.Add(sum(x[(func, i)] for i in range(len(functions[func]))) == 1)

# Define the objective: minimize latency
latency = solver.Sum(x[(func, i)] * functions[func][i]['latency'] for func in functions for i in range(len(functions[func])))
solver.Minimize(latency)

# Add constraint: total area close to 8000
area = solver.Sum(x[(func, i)] * functions[func][i]['area'] for func in functions for i in range(len(functions[func])))
solver.Add(area <= 8000)

# Solve the problem
status = solver.Solve()

# Extract the solution
if status == pywraplp.Solver.OPTIMAL:
    solution = {}
    for func in functions:
        for i in range(len(functions[func])):
            if x[(func, i)].solution_value() > 0.5:
                solution[func] = i
    print(solution)
else:
    print('No optimal solution found.')
'''
