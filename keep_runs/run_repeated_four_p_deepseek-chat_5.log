# Create the solver
solver = pywraplp.Solver.CreateSolver('SCIP')

# Define the variables
x = {}
for func in functions:
    for i in range(len(functions[func])):
        x[(func, i)] = solver.IntVar(0, 1, f'{func}_{i}')

# Add constraints: exactly one option per function
for func in functions:
    solver.Add(sum(x[(func, i)] for i in range(len(functions[func]))) == 1)

# Define the objective: minimize latency
latency = solver.Sum(x[(func, i)] * functions[func][i]['latency'] for func in functions for i in range(len(functions[func])))
solver.Minimize(latency)

# Add constraint: total area close to 8000
area = solver.Sum(x[(func, i)] * functions[func][i]['area'] for func in functions for i in range(len(functions[func])))
solver.Add(area <= 8000)

# Solve the problem
status = solver.Solve()

# Extract the solution
if status == pywraplp.Solver.OPTIMAL:
    solution = {}
    for func in functions:
        for i in range(len(functions[func])):
            if x[(func, i)].solution_value() > 0.5:
                solution[func] = i
    print(solution)
else:
    print('No optimal solution found.')
