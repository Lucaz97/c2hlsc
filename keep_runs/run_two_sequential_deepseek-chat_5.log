int odd_factorial(int n)
{
  int res = 1;
  #pragma hls_pipeline_init_interval 1
  for (int i = 1; i < n; i += 2)
  {
    res = res * i;
  }

  return res;
}
// even_sum option 0

int even_sum(int n)
{
  int sum = 0;
