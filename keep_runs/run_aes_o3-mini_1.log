void ShiftRows_hls(uint8_t state[4][4])
{
    // This version uses fully partitioned temporary arrays to capture
    // the shifted columns. By reading the input columns into local arrays
    // (which are fully partitioned) and then writing back the results,
    // we expose maximum parallelism to the HLS tool.
    #pragma HLS inline

    uint8_t col1[4], col2[4], col3[4];
    #pragma HLS array_partition variable=col1 complete
    #pragma HLS array_partition variable=col2 complete
    #pragma HLS array_partition variable=col3 complete

    // For column 1 (second column): perform a cyclic upward shift by 1.
    // Equivalent to a left rotation on row indices.
    col1[0] = state[1][1];
    col1[1] = state[2][1];
    col1[2] = state[3][1];
    col1[3] = state[0][1];

    // For column 2 (third column): perform a cyclic upward shift by 2.
    // This swaps the top pair with the bottom pair.
    col2[0] = state[2][2];
    col2[1] = state[3][2];
    col2[2] = state[0][2];
    col2[3] = state[1][2];

    // For column 3 (fourth column): perform a cyclic upward shift by 3,
    // which is equivalent to a right circular shift by 1.
    col3[0] = state[3][3];
    col3[1] = state[0][3];
    col3[2] = state[1][3];
    col3[3] = state[2][3];

    // Write back the shifted columns to the state.
    state[0][1] = col1[0];
    state[1][1] = col1[1];
    state[2][1] = col1[2];
    state[3][1] = col1[3];

    state[0][2] = col2[0];
    state[1][2] = col2[1];
    state[2][2] = col2[2];
    state[3][2] = col2[3];

    state[0][3] = col3[0];
    state[1][3] = col3[1];
    state[2][3] = col3[2];
    state[3][3] = col3[3];
}

static void ShiftRows(state_t *state)
{
    ShiftRows_hls(*state);
}
