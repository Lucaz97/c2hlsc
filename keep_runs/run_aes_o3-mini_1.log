    total_area_val = solver2.Value(total_area2) / scale
    total_latency_val = solver2.Value(total_latency2) / scale
    diff_area_val = solver2.Value(diff_area) / scale
    print("Chosen configuration:")
    for f in funcs:
        idx = chosen_options[f]
        area_val, lat_val = options[f][idx]
        print(f"{f}: option {idx} -> area: {area_val}, latency: {lat_val}")
    print(f"Total area: {total_area_val}")
    print(f"Total latency: {total_latency_val}")
    print(f"Area deviation from target ({target_area}): {diff_area_val}")
else:
