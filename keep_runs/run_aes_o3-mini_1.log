void AddRoundKey_hls(uint8_t round, uint8_t state[4][4], const uint8_t RoundKey[176])
{
  // Reinterpret the 4x4 state as four 32-bit words.
  // The RoundKey offset is round*16 bytes; when cast to a 32-bit pointer, that becomes round*4 words.
  uint32_t *state_word = (uint32_t *) state;
  const uint32_t *rk_word = (const uint32_t *) &RoundKey[round * 16];

  // Fully unroll the loop over the four 32-bit words.
  for (int i = 0; i < 4; i++) {
    #pragma HLS unroll yes
    state_word[i] ^= rk_word[i];
  }
}

static void AddRoundKey(uint8_t round, state_t *state, const round_t *RoundKey)
{
  AddRoundKey_hls(round, *state, *RoundKey);
}
