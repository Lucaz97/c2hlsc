void MixColumns_hls(uint8_t state[4][4])
{
  uint8_t i;
  // Fully unroll the loop to achieve minimum latency while restructuring
  // the computation to use local variables and reduce redundant memory accesses.
  #pragma hls_unroll yes
  for(i = 0; i < 4; i++)
  {
    // Read the row into local variables
    uint8_t s0 = state[i][0];
    uint8_t s1 = state[i][1];
    uint8_t s2 = state[i][2];
    uint8_t s3 = state[i][3];

    // Compute the combined XOR of the entire row once.
    uint8_t tmp = s0 ^ s1 ^ s2 ^ s3;

    // Update each element using xtime on the XOR differences,
    // recombining with the original value and the precomputed tmp.
    state[i][0] = s0 ^ xtime(s0 ^ s1) ^ tmp;
    state[i][1] = s1 ^ xtime(s1 ^ s2) ^ tmp;
    state[i][2] = s2 ^ xtime(s2 ^ s3) ^ tmp;
    state[i][3] = s3 ^ xtime(s3 ^ s0) ^ tmp;
  }
}

static void MixColumns(state_t *state)
{
  MixColumns_hls(*state);
}
