static uint8_t xtime(uint8_t x)
{
    #pragma HLS inline
    // Pre-calculate shifted value and mask for clarity to aid synthesis optimization.
    const uint8_t shifted = x << 1;
    const uint8_t mask = (x & 0x80) ? 0x1b : 0;
    return shifted ^ mask;
}
