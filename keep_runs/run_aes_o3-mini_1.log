void ShiftRows_hls(uint8_t state[4][4])
{
    uint8_t temp;

    // Rotate the second column (index 1) upward by one.
    temp = state[0][1];
    for (int i = 0; i < 3; i++) {
        #pragma HLS unroll yes
        state[i][1] = state[i+1][1];
    }
    state[3][1] = temp;

    // For the third column (index 2), swap the top and bottom halves.
    temp = state[0][2];
    state[0][2] = state[2][2];
    state[2][2] = temp;

    temp = state[1][2];
    state[1][2] = state[3][2];
    state[3][2] = temp;

    // For the fourth column (index 3), perform a right circular shift by one.
    // Use a temporary array to hold the column values.
    uint8_t temp_col[4];
    #pragma HLS array_partition variable=temp_col complete

    for (int i = 0; i < 4; i++) {
        #pragma HLS unroll yes
        temp_col[i] = state[i][3];
    }
    for (int i = 0; i < 4; i++) {
        #pragma HLS unroll yes
        state[i][3] = temp_col[(i + 3) % 4];
    }
}

static void ShiftRows(state_t *state)
{
    ShiftRows_hls(*state);
}
