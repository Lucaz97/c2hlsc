void MixColumns_hls(uint8_t state[4][4])
{
  uint8_t i;
  uint8_t Tmp;
  uint8_t t;
  
  // Unroll the loop completely (latency-critical)
  #pragma hls_unroll yes
  for (i = 0; i < 4; i++)
  {
    // Save the original first element for later use
    t = state[i][0];
    // Compute the XOR of the entire row in one go
    Tmp = state[i][0] ^ state[i][1] ^ state[i][2] ^ state[i][3];
    
    // Instead of sequentially computing Tm and updating state,
    // compute all xtime results in parallel by introducing separate temporaries.
    uint8_t tm0 = xtime(state[i][0] ^ state[i][1]);
    uint8_t tm1 = xtime(state[i][1] ^ state[i][2]);
    uint8_t tm2 = xtime(state[i][2] ^ state[i][3]);
    uint8_t tm3 = xtime(state[i][3] ^ t);
    
    // Update the state elements concurrently.
    state[i][0] ^= tm0 ^ Tmp;
    state[i][1] ^= tm1 ^ Tmp;
    state[i][2] ^= tm2 ^ Tmp;
    state[i][3] ^= tm3 ^ Tmp;
  }
}

static void MixColumns(state_t *state)
{
  MixColumns_hls(*state);
}
