static uint8_t xtime(uint8_t x)
{
    #pragma HLS inline
    // Use arithmetic trick to select 0x1b when the most significant bit is set.
    // If (x >> 7) is 1 then -1 (all ones) & 0x1b yields 0x1b, else 0.
    return (x << 1) ^ ((- (x >> 7)) & 0x1b);
}
```

