python: '''
from ortools.sat.python import cp_model

# Data for each function's options: (area, latency, throughput)
# Using indices starting at 0.
cpf_options = [
    (992.6, 9.0, 12.0),   # option 0
    (992.6, 9.0, 12.0),   # option 1
    (1012.8, 18.0, 21.0), # option 2
    (992.6, 9.0, 12.0),   # option 3
    (1201.7, 0.0, 2.0)    # option 4
]

kmp_process_options = [
    (1334.9, 1018.0, 1022.0),  # option 0
    (1047.5, 2242.0, 2246.0),  # option 1
    (1564.7, 610.0, 614.0),    # option 2
    (1617.7, 1018.0, 1022.0),  # option 3
    (2391.0, 2243.0, 2246.0)   # option 4
]

kmp_options = [
    (3486.4, 615.0, 616.0),  # option 0
    (3486.4, 615.0, 616.0),  # option 1
    (3486.4, 615.0, 616.0),  # option 2
    (3486.4, 615.0, 616.0),  # option 3
    (2109.0, 413.0, 415.0)   # option 4
]

functions = ['CPF', 'kmp_process', 'kmp']
options_dict = {
    'CPF': cpf_options,
    'kmp_process': kmp_process_options,
    'kmp': kmp_options
}

num_options = {f: len(options_dict[f]) for f in functions}

# Target area
target_area = 10000.0

# Weight for the area deviation penalty.
# Since latencies are small relative to area numbers, choose a factor to balance the two objectives.
lambda_penalty = 0.001

model = cp_model.CpModel()

# Decision variables: for each function f and option j chosen (binary)
x = {}
for f in functions:
    for j in range(num_options[f]):
        x[(f, j)] = model.NewBoolVar(f'x_{f}_{j}')

# Exactly one option per function
for f in functions:
    model.Add(sum(x[(f, j)] for j in range(num_options[f])) == 1)

# Compute total area and total latency as linear expressions.
# We multiply floats by a scaling factor to convert to integers.
scale = 1000  # scaling factor for area and latency
total_area = sum(int(round(options_dict[f][j][0] * scale)) * x[(f,j)] for f in functions for j in range(num_options[f]))
total_latency = sum(int(round(options_dict[f][j][1] * scale)) * x[(f,j)] for f in functions for j in range(num_options[f]))

# For the absolute difference |total_area - target_area|, we introduce auxiliary variables.
target_area_int = int(round(target_area * scale))
area_dev = model.NewIntVar(0, 10000000, 'area_dev')
model.Add(total_area - target_area_int <= area_dev)
model.Add(target_area_int - total_area <= area_dev)

# We will combine objectives by scaling the area deviation penalty.
# Since latency is scaled by 1000 and area deviation is similarly scaled,
# we scale lambda_penalty accordingly.
lambda_int = int(round(lambda_penalty * scale))  # scale lambda to integer domain

# Our objective is total_latency + lambda_penalty * area_dev.
# To keep it linear in the integer domain:
objective = total_latency + lambda_int * area_dev
model.Minimize(objective)

# Solve the model.
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    selected_options = {}
    for f in functions:
        for j in range(num_options[f]):
            if solver.BooleanValue(x[(f, j)]):
                selected_options[f] = j
    total_area_val = sum(options_dict[f][selected_options[f]][0] for f in functions)
    total_latency_val = sum(options_dict[f][selected_options[f]][1] for f in functions)
    print("Selected configuration:")
    for f in functions:
        print(f" {f}: option {selected_options[f]} with area {options_dict[f][selected_options[f]][0]}, latency {options_dict[f][selected_options[f]][1]}")
    print(f"Total area: {total_area_val}")
    print(f"Total latency: {total_latency_val}")
    print(f"Objective value: {solver.ObjectiveValue()/scale}")
else:
    print("No solution found.")
'''
