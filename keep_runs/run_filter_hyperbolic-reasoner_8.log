python: '''
from ortools.sat.python import cp_model

# Function options data
functions = {
    'shift': [
        {'area': 1451.8, 'latency': 2.0},
        {'area': 1451.8, 'latency': 2.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 1107.1, 'latency': 9.0}
    ],
    'mac': [
        {'area': 4346.7, 'latency': 2.0},
        {'area': 3951.4, 'latency': 6.0},
        {'area': 4625.0, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0}
    ],
    'fir': [
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0}
    ],
    'iir': [
        {'area': 7225.5, 'latency': 12.0},
        {'area': 7235.0, 'latency': 12.0},
        {'area': 8680.8, 'latency': 15.0},
        {'area': 8630.3, 'latency': 10.0},
        {'area': 8630.3, 'latency': 10.0}
    ],
    'filter': [
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0}
    ]
}

model = cp_model.CpModel()

# Variables: option index for each function
option_vars = {fn: model.NewIntVar(0, len(options)-1, fn) for fn, options in functions.items()}

# Calculate total area and latency
total_area = sum(
    model.NewIntVar(0, sum(opt['area'] for opts in functions.values() for opt in opts), 'total_area')
)
model.Add(total_area == sum(
    [functions[fn][option_vars[fn]].get('area', 0) for fn in functions]
))

total_latency = sum(
    model.NewIntVar(0, sum(opt['latency'] for opts in functions.values() for opt in opts), 'total_latency')
)
model.Add(total_latency == sum(
    [functions[fn][option_vars[fn]].get('latency', 0) for fn in functions]
))

# Target area: 6000
target_area = 6000
delta = model.NewIntVar(0, 10000, 'delta')
model.AddAbsEquality(delta, total_area - target_area)

# Minimize delta and latency
model.Minimize(delta * 1000 + total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal solution found:")
    for fn in functions:
        print(f"{fn}: option {solver.Value(option_vars[fn])}")
    print(f"Total area: {solver.Value(total_area)}")
    print(f"Total latency: {solver.Value(total_latency)}")
else:
    print("No solution found.")
'''
