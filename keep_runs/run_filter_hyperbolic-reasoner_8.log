from ortools.sat.python import cp_model

model = cp_model.CpModel()

# Function options data scaled by 10 to integers
functions = {
    'shift': [
        {'area': 14518, 'latency': 20},
        {'area': 14518, 'latency': 20},
        {'area': 239, 'latency': 0},
        {'area': 239, 'latency': 0},
        {'area': 11071, 'latency': 90},
    ],
    'mac': [
        {'area': 43467, 'latency': 20},
        {'area': 39514, 'latency': 60},
        {'area': 46250, 'latency': 80},
        {'area': 44175, 'latency': 80},
        {'area': 44175, 'latency': 80},
    ],
    'iir': [
        {'area': 72255, 'latency': 120},
        {'area': 72350, 'latency': 120},
        {'area': 86808, 'latency': 150},
        {'area': 86303, 'latency': 100},
        {'area': 86303, 'latency': 100},
    ],
    'fir': [
        {'area': 46691, 'latency': 60},
        {'area': 46691, 'latency': 60},
        {'area': 46691, 'latency': 60},
        {'area': 46691, 'latency': 60},
        {'area': 46691, 'latency': 60},
    ],
    'filter': [
        {'area': 45813, 'latency': 70},
        {'area': 45813, 'latency': 70},
        {'area': 45813, 'latency': 70},
        {'area': 45813, 'latency': 70},
        {'area': 45813, 'latency': 70},
    ],
}

# Variables for each function's option choice
vars = {fn: model.NewIntVar(0, len(opts)-1, fn) for fn, opts in functions.items()}

# Total area and latency variables
total_area = model.NewIntVar(0, 10**6, 'total_area')
total_latency = model.NewIntVar(0, 10**4, 'total_latency')

# Element constraints for area and latency
area_vars = []
latency_vars = []
for fn in functions:
    area = model.NewIntVar(0, 10**5, f'{fn}_area')
    model.AddElement(vars[fn], [opt['area'] for opt in functions[fn]], area)
    area_vars.append(area)
    
    latency = model.NewIntVar(0, 10**3, f'{fn}_latency')
    model.AddElement(vars[fn], [opt['latency'] for opt in functions[fn]], latency)
    latency_vars.append(latency)

model.Add(total_area == sum(area_vars))
model.Add(total_latency == sum(latency_vars))

# Target area constraint (6000*10=60000 ±5%)
target = 60000
tolerance = int(0.05 * target)
model.Add(total_area >= target - tolerance)
model.Add(total_area <= target + tolerance)

# Minimize latency
model.Minimize(total_latency)

# Solve
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Solution:")
    for fn in functions:
        print(f"{fn}: {solver.Value(vars[fn])}")
    print(f"Total area: {solver.Value(total_area)/10}")
    print(f"Total latency: {solver.Value(total_latency)/10}")
else:
    print("No solution found")
