        {'area': 1107.1, 'latency': 9.0},
    ],
    'mac': [
        {'area': 4346.7, 'latency': 2.0},
        {'area': 3951.4, 'latency': 6.0},
        {'area': 4625.0, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
    ],
    'fir': [
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
    ],
    'iir': [
        {'area': 7225.5, 'latency': 12.0},
        {'area': 7235.0, 'latency': 12.0},
        {'area': 8680.8, 'latency': 15.0},
        {'area': 8630.3, 'latency': 10.0},
        {'area': 8630.3, 'latency': 10.0},
    ],
    'filter': [
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
    ],
}

# Integer variables for options
option_vars = {fn: model.NewIntVar(0, len(opts)-1, f'{fn}_opt') for fn, opts in functions.items()}

# Area and latency expressions using scaled integers
scaled_areas = {}
scaled_latencies = {}
for fn in functions:
    scaled_areas[fn] = [int(round(opt['area'] * 10)) for opt in functions[fn]]
    scaled_latencies[fn] = [int(round(opt['latency'] * 10)) for opt in functions[fn]]

# Total area and latency calculation
total_area = sum(model.NewIntVar(0, sa, f'{fn}_area') for fn, sa in scaled_areas.items())
for fn in functions:
    area_var = model.NewIntVar(0, max(scaled_areas[fn]), f'{fn}_area_aux')
    model.AddElement(option_vars[fn], scaled_areas[fn], area_var)
    model.Add(total_area += area_var)

total_latency = sum(model.NewIntVar(0, sl, f'{fn}_latency') for fn, sl in scaled_latencies.items())
for fn in functions:
    latency_var = model.NewIntVar(0, max(scaled_latencies[fn]), f'{fn}_latency_aux')
    model.AddElement(option_vars[fn], scaled_latencies[fn], latency_var)
    model.Add(total_latency += latency_var)

# Target area constraint with tolerance
target = 6000 * 10
tolerance = 500
model.Add(total_area >= target - tolerance)
model.Add(total_area <= target + tolerance)

# Minimize latency
model.Minimize(total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    print('solution:', ', '.join([f'{fn} {solver.Value(opt)}' for fn, opt in option_vars.items()]))
else:
    print('No solution found')
