from ortools.sat.python import cp_model

model = cp_model.CpModel()

functions = {
    'shift': [
        {'area': 1451.8, 'latency': 2.0},
        {'area': 1451.8, 'latency': 2.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 1107.1, 'latency': 9.0}
    ],
    'mac': [
        {'area': 4346.7, 'latency': 2.0},
        {'area': 3951.4, 'latency': 6.0},
        {'area': 4625.0, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0}
    ],
    'fir': [
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0}
    ],
    'iir': [
        {'area': 7225.5, 'latency': 12.0},
        {'area': 7235.0, 'latency': 12.0},
        {'area': 8680.8, 'latency': 15.0},
        {'area': 8630.3, 'latency': 10.0},
        {'area': 8630.3, 'latency': 10.0}
    ],
    'filter': [
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0}
    ]
}

option_vars = {fn: model.NewIntVar(0, len(functions[fn])-1, f'{fn}_option') for fn in functions}

total_area = 0
latency_terms = []

for fn in functions:
    options = functions[fn]
    option = option_vars[fn]
    area_expr = model.NewIntVar(0, sum(opt['area'] for opt in options), f'{fn}_area')
    model.AddElement(option, [opt['area'] for opt in options], area_expr)
    total_area += area_expr

    latency_expr = model.NewIntVar(0, sum(opt['latency'] for opt in options), f'{fn}_latency')
    model.AddElement(option, [opt['latency'] for opt in options], latency_expr)
    latency_terms.append(latency_expr)

model.Add(total_area <= 6500)
model.Add(total_area >= 5500)

total_latency = sum(latency_terms)
model.Minimize(total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Solution:")
    for fn in functions:
        opt = solver.Value(option_vars[fn])
        print(f"{fn}: {opt} (area={functions[fn][opt]['area']}, latency={functions[fn][opt]['latency']})")
    print(f"Total area: {solver.Value(total_area)}")
    print(f"Total latency: {solver.Value(total_latency)}")
else:
    print("No solution found")
