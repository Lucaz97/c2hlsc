        {'area': 1451.8, 'latency': 2.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 1107.1, 'latency': 9.0}
    ],
    'mac': [
        {'area': 4346.7, 'latency': 2.0},
        {'area': 3951.4, 'latency': 6.0},
        {'area': 4625.0, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0}
    ],
    'fir': [
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0}
    ],
    'iir': [
        {'area': 7225.5, 'latency': 12.0},
        {'area': 7235.0, 'latency': 12.0},
        {'area': 8680.8, 'latency': 15.0},
        {'area': 8630.3, 'latency': 10.0},
        {'area': 8630.3, 'latency': 10.0}
    ],
    'filter': [
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0}
    ]
}

# Create model
model = cp_model.CpModel()

# Variables: option index for each function
shift_var = model.NewIntVar(0, 4, 'shift')
mac_var = model.NewIntVar(0, 4, 'mac')
fir_var = model.NewIntVar(0, 4, 'fir')
iir_var = model.NewIntVar(0, 4, 'iir')
filter_var = model.NewIntVar(0, 4, 'filter')

# Area and latency expressions
total_area = sum(
    [functions[fn][option]['area'] for fn, option in zip(
        ['shift', 'mac', 'fir', 'iir', 'filter'],
        [shift_var, mac_var, fir_var, iir_var, filter_var]
    )]
)
total_latency = sum(
    [functions[fn][option]['latency'] for fn, option in zip(
        ['shift', 'mac', 'fir', 'iir', 'filter'],
        [shift_var, mac_var, fir_var, iir_var, filter_var]
    )]
)

# Target area
target_area = 6000
delta = model.NewIntVar(0, 100000, 'delta')
model.Add(delta == abs(total_area - target_area))

# Objective: minimize latency and delta
model.Minimize(total_latency * 1000 + delta)

# Solve
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output result
if status == cp_model.OPTIMAL:
    config = {
        'shift': solver.Value(shift_var),
        'mac': solver.Value(mac_var),
        'fir': solver.Value(fir_var),
        'iir': solver.Value(iir_var),
        'filter': solver.Value(filter_var)
    }
    print(f"Optimal configuration: {config}")
    print(f"Total latency: {solver.Value(total_latency)}")
    print(f"Total area: {solver.Value(total_area)}")
else:
    print("No solution found")
