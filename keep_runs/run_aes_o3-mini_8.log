python: '''
import sys
from ortools.sat.python import cp_model

# Data for each function option: (area, latency)
data = {
    "AddRoundKey_hls": [
        (752.6, 34.0),
        (739.4, 31.0),
        (739.4, 31.0),
        (734.6, 31.0),
        (1900.5, 16.0)
    ],
    "SubBytes_hls": [
        (1889.1, 15.0),
        (831.0, 21.0),
        (825.5, 15.0),
        (1889.1, 15.0),
        (829.0, 15.0)
    ],
    "ShiftRows_hls": [
        (975.6, 19.0),
        (23.9, 0.0),
        (23.9, 0.0),
        (23.9, 0.0),
        (23.9, 0.0)
    ],
    "xtime": [
        (77.0, 1.0),
        (77.0, 1.0),
        (82.0, 1.0),
        (77.0, 1.0),
        (77.0, 1.0)
    ],
    "MixColumns_hls": [
        (866.6, 0.0),
        (866.6, 0.0),
        (639.9, 3.0),
        (866.6, 0.0),
        (866.6, 0.0)
    ],
    "Cipher_hls": [
        (4869.2, 194.0),
        (9768.5, 175.0),
        (4869.2, 194.0),
        (8622.0, 202.0),
        (9768.5, 175.0)
    ]
}

target_area = 10000.0
# Weight factor for area deviation relative to latency
lambda_weight = 0.05

model = cp_model.CpModel()

# Create decision variables: for each function, an integer variable indicating the chosen option.
choice = {}
for func, opts in data.items():
    # domain is from 0 to len(opts)-1
    choice[func] = model.NewIntVar(0, len(opts)-1, func + "_choice")

# To sum up areas and latencies, we need to model piecewise-linear expressions, but our data is constant.
# We create arrays for areas and latencies for each function option.
# We then use an element constraint to pick the appropriate value.
area_expr = []
latency_expr = []
for func, opts in data.items():
    areas = [int(round(opt[0]*100)) for opt in opts]   # scale area by factor 100 for integrality
    latencies = [int(round(opt[1]*100)) for opt in opts] # scale latency by factor 100
    # Use element constraint: each function’s area and latency
    area_var = model.NewIntVarFromDomain(cp_model.Domain.FromValues(areas), func + "_area")
    latency_var = model.NewIntVarFromDomain(cp_model.Domain.FromValues(latencies), func + "_latency")
    model.AddElement(choice[func], areas, area_var)
    model.AddElement(choice[func], latencies, latency_var)
    area_expr.append(area_var)
    latency_expr.append(latency_var)

# Total area and total latency
total_area = model.NewIntVar(0, 1000000, "total_area")
total_latency = model.NewIntVar(0, 1000000, "total_latency")
model.Add(total_area == sum(area_expr))
model.Add(total_latency == sum(latency_expr))

# Compute the absolute deviation from target_area (scaled accordingly: target_area*100)
target_area_scaled = int(round(target_area*100))
area_deviation = model.NewIntVar(0, 1000000, "area_deviation")
model.Add(area_deviation >= total_area - target_area_scaled)
model.Add(area_deviation >= target_area_scaled - total_area)

# Define objective: primary is latency, plus weighted area deviation.
# Since our variables are scaled by 100, adjust the weight accordingly.
obj = total_latency + int(round(lambda_weight*100)) * area_deviation
model.Minimize(obj)

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Solution:")
    for func in data.keys():
        opt = solver.Value(choice[func])
        area_val = solver.Value(next(var for name, var in zip([f"{func}_option_{i}" for i in range(len(data[func]))], area_expr) if True))  # not used
        print(f"{func}: option {opt}")
    print(f"Total area (scaled): {solver.Value(total_area)/100.0}")
    print(f"Total latency (scaled): {solver.Value(total_latency)/100.0}")
    print(f"Area deviation: {solver.Value(area_deviation)/100.0}")
else:
    print("No solution found.")
'''
