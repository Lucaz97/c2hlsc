        {"area": 16316.0, "latency": 5751.0},
        {"area": 15083.1, "latency": 5747.0},
        {"area": 15083.1, "latency": 5747.0},
    ],
}

# Scale floating-point values to integers
scale_factor = 10  # Scale to 1 decimal place
for func, options in functions.items():
    for opt in options:
        opt["area"] = int(opt["area"] * scale_factor)
        opt["latency"] = int(opt["latency"] * scale_factor)

# Decision variables: option index for each function
option_vars = {}
for func, options in functions.items():
    option_vars[func] = model.NewIntVar(0, len(options) - 1, f"{func}_option")

# Total area and latency
total_area = model.NewIntVar(0, 1000000, "total_area")
total_latency = model.NewIntVar(0, 1000000, "total_latency")

# Use Element constraint to dynamically select area and latency values
area_expr = []
latency_expr = []
for func, options in functions.items():
    area_expr.append(model.NewIntVar(0, 1000000, f"{func}_area"))
    latency_expr.append(model.NewIntVar(0, 1000000, f"{func}_latency"))
    model.AddElement(option_vars[func], [opt["area"] for opt in options], area_expr[-1])
    model.AddElement(option_vars[func], [opt["latency"] for opt in options], latency_expr[-1])

model.Add(total_area == sum(area_expr))
model.Add(total_latency == sum(latency_expr))

# Constraints
target_area = 70000 * scale_factor  # Scale target area
model.Add(total_area <= target_area)  # Area must not exceed target
model.Minimize(total_latency)  # Minimize latency

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Optimal configuration found:")
    for func, var in option_vars.items():
        option_index = solver.Value(var)
        print(f"{func}: option {option_index} (area: {functions[func][option_index]['area'] / scale_factor}, latency: {functions[func][option_index]['latency'] / scale_factor})")
    print(f"Total area: {solver.Value(total_area) / scale_factor}")
    print(f"Total latency: {solver.Value(total_latency) / scale_factor}")
else:
    print("No feasible solution found.")
