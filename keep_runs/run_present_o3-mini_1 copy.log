#include <stdint.h>

void copyKey_hls(unsigned char from[PRESENT_80_KEY_SIZE_BYTES],
                 unsigned char to[PRESENT_80_KEY_SIZE_BYTES])
{
    // Instead of copying byte‐by‐byte, pack the 10-byte key into two wider reads/writes.
    // This reduces the number of operations and may reduce area while keeping minimum latency.
#pragma HLS inline
    // Read first 8 bytes as a 64-bit word.
    uint64_t data64 = *((const uint64_t *)from);
    // Read remaining 2 bytes as a 16-bit word.
    uint16_t data16 = *((const uint16_t *)(from + 8));
    
    // Write back the values.
    *((uint64_t *)to) = data64;
    *((uint16_t *)(to + 8)) = data16;
}

void copyKey(present_key_t *from, present_key_t *to)
{
    copyKey_hls(*from, *to);
}
