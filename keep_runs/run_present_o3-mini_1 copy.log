        newKey[8] = (key[5] << 5) | (key[6] >> 3);
        newKey[9] = (key[6] << 5) | (key[7] >> 3);

        // Inline copy: Update "key" with the new key value
        for (j = 0; j < PRESENT_80_KEY_SIZE_BYTES; j++) {
#pragma hls_unroll yes
