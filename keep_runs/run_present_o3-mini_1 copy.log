        (530, 1),  # option 0: rounded 529.7 -> 530
        (530, 1),  # option 1
        (2158, 21),# option 2: rounded 2157.7 -> 2158
        (530, 1),  # option 3
        (530, 1)   # option 4
    ],
    'copyBlock': [
        (428, 1),  # option 0: 427.6 -> 428
        (428, 1),  # option 1
        (428, 1),  # option 2
        (1988, 23),# option 3: 1988.2 -> 1988
        (428, 1)   # option 4
    ],
    'generateRoundKeys80': [
        (2354, 596), # option 0: 2354.3 -> 2354, 596
        (1559, 286), # option 1: 1558.8 -> 1559, 286
        (2077, 885), # option 2: 2077.1 -> 2077, 885
        (1559, 286), # option 3
        (2077, 885)  # option 4
    ],
    'addRoundKey': [
        (126, 0),   # option 0: 126.1 -> 126, 0
        (424, 14),  # option 1: 423.6 -> 424, 14
        (126, 0),   # option 2
        (498, 2),   # option 3: 498.1 -> 498, 2
        (2057, 30)  # option 4: 2056.9 -> 2057, 30
    ],
    'pLayer': [
        (1008, 150),# option 0: 1007.7 -> 1008, 150
        (1008, 150),# option 1
        (1008, 150),# option 2
        (24, 0),    # option 3: 23.9 -> 24, 0
        (24, 0)     # option 4
    ],
    'present80_encryptBlock': [
        (13067, 1137), # All options are same: 13066.8 -> 13067, 1137
        (13067, 1137),
        (13067, 1137),
        (13067, 1137),
        (13067, 1137)
    ]
}

# Replication factors from the call graph:
# present80_encryptBlock calls:
#   - generateRoundKeys80
#   - addRoundKey (first instance)
#   - pLayer
#   - addRoundKey (second instance)
# generateRoundKeys80 calls:
#   - copyKey (twice) and copyBlock (twice)
# pLayer calls:
#   - copyBlock

# Effective total area is computed as:
# total_area = area(present80_encryptBlock) +
#              area(generateRoundKeys80) + 2*(area(copyKey) + area(copyBlock)) +
#              area(addRoundKey)_1 +
#              (area(pLayer) + area(copyBlock) for pLayer) +
#              area(addRoundKey)_2

# For latency, we assume the overall system latency is given by the latency of present80_encryptBlock option.

# Target area:
target_area = 70000

model = cp_model.CpModel()

# Decision variables: one option per function. Domain: index options available.
choice = {}
for func, opts in data.items():
    choice[func] = model.NewIntVar(0, len(opts)-1, func + '_choice')

# Helper: create area and latency lists for each function based on options.
def create_option_list(func):
    areas = [opt[0] for opt in data[func]]
    lats  = [opt[1] for opt in data[func]]
    return areas, lats

areas_dict = {}
lats_dict = {}
for func in data:
    areas, lats = create_option_list(func)
    areas_dict[func] = areas
    lats_dict[func] = lats

# Create integer variables for area and latency for each function based on the choice.
area_var = {}
lat_var = {}
for func in data:
    area_var[func] = model.NewIntVar(min(areas_dict[func]), max(areas_dict[func]), func + '_area')
    lat_var[func] = model.NewIntVar(min(lats_dict[func]), max(lats_dict[func]), func + '_lat')
    model.AddElement(choice[func], areas_dict[func], area_var[func])
    model.AddElement(choice[func], lats_dict[func], lat_var[func])

# For addRoundKey, allow independent choices for the two instances.
ar1_choice = model.NewIntVar(0, len(data['addRoundKey'])-1, 'addRoundKey1_choice')
ar2_choice = model.NewIntVar(0, len(data['addRoundKey'])-1, 'addRoundKey2_choice')

ar1_area = model.NewIntVar(min(areas_dict['addRoundKey']), max(areas_dict['addRoundKey']), 'addRoundKey1_area')
ar2_area = model.NewIntVar(min(areas_dict['addRoundKey']), max(areas_dict['addRoundKey']), 'addRoundKey2_area')
ar1_lat = model.NewIntVar(min(lats_dict['addRoundKey']), max(lats_dict['addRoundKey']), 'addRoundKey1_lat')
ar2_lat = model.NewIntVar(min(lats_dict['addRoundKey']), max(lats_dict['addRoundKey']), 'addRoundKey2_lat')
model.AddElement(ar1_choice, areas_dict['addRoundKey'], ar1_area)
model.AddElement(ar1_choice, lats_dict['addRoundKey'], ar1_lat)
model.AddElement(ar2_choice, areas_dict['addRoundKey'], ar2_area)
model.AddElement(ar2_choice, lats_dict['addRoundKey'], ar2_lat)

# For the copyBlock used in the pLayer call, allow an independent choice.
cb2_choice = model.NewIntVar(0, len(data['copyBlock'])-1, 'copyBlock2_choice')
cb2_area = model.NewIntVar(min(areas_dict['copyBlock']), max(areas_dict['copyBlock']), 'copyBlock2_area')
cb2_lat = model.NewIntVar(min(lats_dict['copyBlock']), max(lats_dict['copyBlock']), 'copyBlock2_lat')
model.AddElement(cb2_choice, areas_dict['copyBlock'], cb2_area)
model.AddElement(cb2_choice, lats_dict['copyBlock'], cb2_lat)

# Effective total area:
# total_area = area(present80_encryptBlock) +
#              area(generateRoundKeys80) + 2*(area(copyKey) + area(copyBlock)) +
#              addRoundKey1_area +
#              area(pLayer) + copyBlock2_area +
#              addRoundKey2_area
total_area = model.NewIntVar(0, 200000, 'total_area')
model.Add(total_area == area_var['present80_encryptBlock'] +
          area_var['generateRoundKeys80'] + 2*(area_var['copyKey'] + area_var['copyBlock']) +
          ar1_area +
          area_var['pLayer'] + cb2_area +
          ar2_area)

# Overall latency is taken as the latency of present80_encryptBlock.
overall_latency = lat_var['present80_encryptBlock']

# Now define the objective:
# We wish to minimize latency and have total area as close as possible to target_area.
# To avoid fractional coefficients, scale the latency by 10 and minimize: 10*overall_latency + diff,
# where diff is the absolute difference between total_area and target.
diff = model.NewIntVar(0, 200000, 'diff')
model.Add(diff >= total_area - target_area)
model.Add(diff >= target_area - total_area)

# Objective: minimize 10*latency + diff.
model.Minimize(10 * overall_latency + diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Solution:")
    print("copyKey option:", solver.Value(choice['copyKey']), "area =", solver.Value(area_var['copyKey']), "lat =", solver.Value(lat_var['copyKey']))
    print("copyBlock option:", solver.Value(choice['copyBlock']), "area =", solver.Value(area_var['copyBlock']), "lat =", solver.Value(lat_var['copyBlock']))
    print("generateRoundKeys80 option:", solver.Value(choice['generateRoundKeys80']), "area =", solver.Value(area_var['generateRoundKeys80']), "lat =", solver.Value(lat_var['generateRoundKeys80']))
    print("addRoundKey1 option:", solver.Value(ar1_choice), "area =", solver.Value(ar1_area), "lat =", solver.Value(ar1_lat))
    print("pLayer option:", solver.Value(choice['pLayer']), "area =", solver.Value(area_var['pLayer']), "lat =", solver.Value(lat_var['pLayer']))
    print("copyBlock2 (for pLayer) option:", solver.Value(cb2_choice), "area =", solver.Value(cb2_area), "lat =", solver.Value(cb2_lat))
    print("addRoundKey2 option:", solver.Value(ar2_choice), "area =", solver.Value(ar2_area), "lat =", solver.Value(ar2_lat))
    print("present80_encryptBlock option:", solver.Value(choice['present80_encryptBlock']), "area =", solver.Value(area_var['present80_encryptBlock']), "lat =", solver.Value(lat_var['present80_encryptBlock']))
    print("Total area:", solver.Value(total_area))
    print("Overall latency:", solver.Value(overall_latency))
    print("Objective value:", solver.ObjectiveValue())
else:
    print("No solution found.")
