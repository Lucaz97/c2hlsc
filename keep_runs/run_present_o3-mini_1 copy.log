    ],
    'generateRoundKeys80': [
        (2354, 596), # opt 0: 2354.3->2354, 596
        (1559, 286), # opt 1: 1558.8->1559, 286
        (2077, 885), # opt 2: 2077.1->2077, 885
        (1559, 286), # opt 3
