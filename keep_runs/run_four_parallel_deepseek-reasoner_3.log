```c
int fibonacci(int n)
{
  int a = 0;
  int b = 1;
  int c;

  #pragma HLS pipeline II=1
  for (int i = 2; i < n; i++)
  {
    c = a + b;
    a = b;
    b = c;
  }

  return c;
}
```

