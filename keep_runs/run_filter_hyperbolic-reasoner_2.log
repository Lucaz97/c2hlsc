        {'area': 3951.4, 'latency': 6.0},
        {'area': 4625.0, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
    ],
    'fir': [
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
    ],
    'iir': [
        {'area': 7225.5, 'latency': 12.0},
        {'area': 7235.0, 'latency': 12.0},
        {'area': 8680.8, 'latency': 15.0},
        {'area': 8630.3, 'latency': 10.0},
        {'area': 8630.3, 'latency': 10.0},
    ],
    'filter': [
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
    ],
}

vars = {func: model.NewIntVar(0, len(opts)-1, func) for func, opts in functions.items()}

func_areas = {}
func_latencies = {}
for func in functions:
    areas = [int(opts['area']) for opts in functions[func]]
    latencies = [int(opts['latency']) for opts in functions[func]]
    func_area = model.NewIntVar(0, 100000, f'{func}_area')
    model.AddElement(vars[func], areas, func_area)
    func_areas[func] = func_area
    func_latency = model.NewIntVar(0, 100, f'{func}_latency')
    model.AddElement(vars[func], latencies, func_latency)
    func_latencies[func] = func_latency

total_area = model.NewIntVar(0, 100000, 'total_area')
model.Add(total_area == sum(func_areas.values()))

total_latency = model.NewIntVar(0, 1000, 'total_latency')
model.Add(total_latency == sum(func_latencies.values()))

target_area = 6000
diff = model.NewIntVar(0, 100000, 'diff')
model.AddAbsEquality(diff, total_area - target_area)
model.Minimize(diff * 1000 + total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Solution:")
    for func in functions:
        print(f"{func}: {solver.Value(vars[func])}")
else:
    print("No solution found.")
