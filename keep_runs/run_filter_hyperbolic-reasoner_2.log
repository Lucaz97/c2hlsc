from ortools.sat.python import cp_model

functions = {
    'shift': [
        {'area': 1451.8, 'latency': 2.0},
        {'area': 1451.8, 'latency': 2.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 1107.1, 'latency': 9.0},
    ],
    'mac': [
        {'area': 4346.7, 'latency': 2.0},
        {'area': 3951.4, 'latency': 6.0},
        {'area': 4625.0, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
    ],
    'fir': [
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
    ],
    'iir': [
        {'area': 7225.5, 'latency': 12.0},
        {'area': 7235.0, 'latency': 12.0},
        {'area': 8680.8, 'latency': 15.0},
        {'area': 8630.3, 'latency': 10.0},
        {'area': 8630.3, 'latency': 10.0},
    ],
    'filter': [
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
    ],
}

model = cp_model.CpModel()

vars = {func: model.NewIntVar(0, len(options)-1, func) for func, options in functions.items()}

area_vars = []
latency_vars = []

for func in functions:
    option_areas = [int(opt['area']) for opt in functions[func]]
    area_var = model.NewIntVar(min(option_areas), max(option_areas), f"{func}_area")
    model.AddElement(vars[func], option_areas, area_var)
    area_vars.append(area_var)
    
    option_lats = [int(opt['latency']) for opt in functions[func]]
    lat_var = model.NewIntVar(min(option_lats), max(option_lats), f"{func}_lat")
    model.AddElement(vars[func], option_lats, lat_var)
    latency_vars.append(lat_var)

total_area = sum(area_vars)
total_latency = sum(latency_vars)

target_area = 6000
area_diff = model.NewIntVar(0, 100000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - target_area)

model.Minimize(area_diff * 100 + total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    config = []
    for func in functions:
        opt_idx = solver.Value(vars[func])
        config.append(f"{func} {opt_idx}")
    print("solution:", ", ".join(config))
else:
    print
