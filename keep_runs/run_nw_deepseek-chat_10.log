for func, data in functions.items():
    function_vars[func] = model.NewIntVar(0, len(data["options"]) - 1, func)

# Define binary indicator variables for each option
option_vars = {}
for func, data in functions.items():
    option_vars[func] = [
        model.NewBoolVar(f"{func}_option_{i}") for i in range(len(data["options"]))
