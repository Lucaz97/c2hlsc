from ortools.sat.python import cp_model

# Define the problem data
functions = {
    "fill_matrix": {
        "options": [
            {"area": 2206.1, "latency": 1293.0},
            {"area": 2206.1, "latency": 1293.0},
            {"area": 2215.5, "latency": 1308.0},
            {"area": 2206.1, "latency": 1293.0},
            {"area": 2206.1, "latency": 1293.0},
        ]
    },
    "reverse_string": {
        "options": [
            {"area": 2541.5, "latency": 1.0},
            {"area": 2541.5, "latency": 1.0},
            {"area": 2338.5, "latency": 1.0},
            {"area": 2338.5, "latency": 1.0},
            {"area": 2541.5, "latency": 1.0},
        ]
    },
    "traceback": {
        "options": [
            {"area": 10612.2, "latency": 8.0},
            {"area": 10612.2, "latency": 8.0},
            {"area": 10612.2, "latency": 8.0},
            {"area": 10612.2, "latency": 8.0},
            {"area": 10612.2, "latency": 8.0},
        ]
    },
    "needwun": {
        "options": [
            {"area": 12140.0, "latency": 1303.0},
            {"area": 12140.0, "latency": 1303.0},
            {"area": 12140.0, "latency": 1303.0},
            {"area": 12140.0, "latency": 1303.0},
            {"area": 12140.0, "latency": 1303.0},
        ]
    },
}

# Create the model
model = cp_model.CpModel()

# Define decision variables
function_vars = {}
for func, data in functions.items():
    function_vars[func] = model.NewIntVar(0, len(data["options"]) - 1, func)

# Define the objective: minimize latency
latency = sum(
    functions[func]["options"][function_vars[func]]["latency"]
    for func in functions
)
model.Minimize(latency)

# Define the constraint: total area <= 6000
total_area = sum(
    functions[func]["options"][function_vars[func]]["area"]
    for func in functions
)
model.Add(total_area <= 6000)

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Print the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Optimal configuration found:")
    for func, var in function_vars.items():
        option_index = solver.Value(var)
        print(f"{func}: option {option_index} (area: {functions[func]['options'][option_index]['area']}, latency: {functions[func]['options'][option_index]['latency']})")
    print(f"Total area: {solver.Value(total_area)}")
    print(f"Total latency: {solver.Value(latency)}")
else:
    print("No feasible solution found.")
'''
