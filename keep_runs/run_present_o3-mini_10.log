python: '''
from ortools.sat.python import cp_model

# We have 6 functions that we need to configure:
#  0: copyKey_hls (indices 0 to 4)
#  1: copyBlock_hls (indices 0 to 4)
#  2: generateRoundKeys80_hls (indices 0 to 4)
#  3: addRoundKey_hls (indices 0 to 4)
#  4: pLayer_hls (indices 0 to 4)
#  5: present80_encryptBlock_hls (indices 0 to 4)
#
# Note that effective design area may be derived from the call graph multiplicity:
#   - copyKey_hls is called twice (in generateRoundKeys80)
#   - copyBlock_hls is called twice (in generateRoundKeys80) and once in pLayer (so 3 times total)
#   - generateRoundKeys80_hls is called once (in present80_encryptBlock)
#   - addRoundKey_hls is called twice (in present80_encryptBlock)
#   - pLayer_hls is called once (in present80_encryptBlock)
#   - present80_encryptBlock_hls is called once (in main)
#
# We have the following option lists for each function as tuples: (area, latency, throughput)
# (We use throughput only as a tie-breaker if needed; primary objectives are latency minimization and area closeness.)
#
options = {
    'copyKey_hls': [
        (529.7, 1.0, 2.0),
        (529.7, 1.0, 2.0),
        (529.7, 1.0, 2.0),
        (1527.9, 19.0, 22.0),
        (529.7, 1.0, 2.0)
    ],
    'copyBlock_hls': [
        (427.6, 1.0, 2.0),
        (427.6, 1.0, 2.0),
        (427.6, 1.0, 2.0),
        (1175.3, 15.0, 18.0),
        (1175.3, 15.0, 18.0)
    ],
    'generateRoundKeys80_hls': [
        (2354.3, 596.0, 599.0),
        (2336.0, 596.0, 599.0),
        (1558.8, 286.0, 289.0),
        (1546.0, 286.0, 289.0),
        (1546.0, 286.0, 289.0)
    ],
    'addRoundKey_hls': [
        (126.1, 0.0, 2.0),
        (2056.9, 30.0, 34.0),
        (126.1, 0.0, 2.0),
        (126.1, 0.0, 2.0),
        (126.1, 0.0, 2.0)
    ],
    'pLayer_hls': [
        (23.9, 0.0, 2.0),
        (902.8, 79.0, 82.0),
        (23.9, 0.0, 2.0),
        (876.8, 79.0, 82.0),
        (23.9, 0.0, 2.0)
    ],
    'present80_encryptBlock_hls': [
        (14572.9, 1128.0, 1132.0),
        (20121.8, 544.0, 546.0),
        (13035.3, 584.0, 586.0),
        (13077.4, 1137.0, 1139.0),
        (13066.8, 1137.0, 1139.0)
    ]
}

functions = ['copyKey_hls', 'copyBlock_hls', 'generateRoundKeys80_hls',
             'addRoundKey_hls', 'pLayer_hls', 'present80_encryptBlock_hls']

# Multiplicity (how many times each function appears in the effective design)
multiplicity = {
    'copyKey_hls': 2,
    'copyBlock_hls': 3,
    'generateRoundKeys80_hls': 1,
    'addRoundKey_hls': 2,
    'pLayer_hls': 1,
    'present80_encryptBlock_hls': 1
}

target_area = 70000

# Create model
model = cp_model.CpModel()

# We have a decision variable for each function: which option to use.
vars = {}
for fn in functions:
    num_opts = len(options[fn])
    # decision variable takes integer value in [0, num_opts-1]
    vars[fn] = model.NewIntVar(0, num_opts - 1, fn + '_choice')

# For each function, define expressions for area, latency (and throughput) depending on the selected option.
# As we have floating point numbers, we multiply by a constant factor to convert to integers.
scale = 10  # factor
area_expr = []
lat_expr = []
throughput_expr = []

# We'll build area and latency for each function using element constraints.
aux_areas = {}
aux_lats = {}

for fn in functions:
    num_opts = len(options[fn])
    # Define lists of scaled parameters:
    areas_scaled = [int(round(a*scale)) for (a, lat, thr) in options[fn]]
    lats_scaled = [int(round(lat*scale)) for (a, lat, thr) in options[fn]]
    # Create auxiliary IntVar for area and latency for this function
    a_var = model.NewIntVarFromDomain(cp_model.Domain.FromValues(areas_scaled), fn + '_area')
    l_var = model.NewIntVarFromDomain(cp_model.Domain.FromValues(lats_scaled), fn + '_lat')
    aux_areas[fn] = a_var
    aux_lats[fn] = l_var

    # Add element constraints linking the choice with the corresponding values.
    model.AddElement(vars[fn], areas_scaled, a_var)
    model.AddElement(vars[fn], lats_scaled, l_var)
    
    # Multiply by multiplicity
    area_expr.append(a_var * multiplicity[fn])
    lat_expr.append(l_var * multiplicity[fn])  # assume latency sums along calls

# Total effective area and latency
total_area = sum(area_expr)
total_latency = sum(lat_expr)

# Primary objective is to minimize total latency.
# Secondary objective: area closeness to target, i.e., minimize |total_area - target_area|.
# We can combine objectives by lexicographic ordering: first minimize latency, then the absolute difference.
abs_area_diff = model.NewIntVar(0, int(1e6), 'abs_area_diff')
model.Add(abs_area_diff >= total_area - int(target_area*scale))
model.Add(abs_area_diff >= int(target_area*scale) - total_area)

model.Minimize(total_latency * 10000 + abs_area_diff)  # Weighted sum: latency is primary

solver = cp_model.CpSolver()
solver.parameters.max_time_in_seconds = 10.0

class VarArraySolutionPrinter(cp_model.CpSolverSolutionCallback):
    def __init__(self, vars, aux_areas, aux_lats, total_area, total_latency):
        cp_model.CpSolverSolutionCallback.__init__(self)
        self.vars = vars
        self.aux_areas = aux_areas
        self.aux_lats = aux_lats
        self.total_area = total_area
        self.total_latency = total_latency

    def OnSolutionCallback(self):
        sol = {}
        for fn, var in self.vars.items():
            sol[fn] = self.Value(var)
        print("Solution:")
        for fn, choice in sol.items():
            a = self.Value(self.aux_areas[fn])
            l = self.Value(self.aux_lats[fn])
            print(f"{fn}: option {choice} (area: {a/scale}, latency: {l/scale})")
        print("Total effective area:", self.Value(self.total_area)/scale)
        print("Total effective latency:", self.Value(self.total_latency)/scale)
        print("Absolute area diff:", self.Value(abs_area_diff)/scale)
        print()

printer = VarArraySolutionPrinter(vars, aux_areas, aux_lats, total_area, total_latency)
status = solver.Solve(model, printer)

if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Best solution:")
    best_config = {}
    for fn in functions:
        best_config[fn] = solver.Value(vars[fn])
    for fn, opt in best_config.items():
        a, l, thr = options[fn][opt]
        print(f"{fn}: option {opt} (area: {a}, latency: {l}, throughput: {thr})")
    print("Total effective area:", solver.Value(total_area)/scale)
    print("Total effective latency:", solver.Value(total_latency)/scale)
    print("Absolute area difference:", solver.Value(abs_area_diff)/scale)
else:
    print("No solution found.")
'''
