python: '''
from ortools.sat.python import cp_model

functions = {
    'fill_matrix': [
        {'area': 2206.1, 'latency': 1293.0},
        {'area': 2144.7, 'latency': 1293.0},
        {'area': 2597.8, 'latency': 213.0},
        {'area': 2407.3, 'latency': 2538.0},
        {'area': 2698.4, 'latency': 213.0},
    ],
    'reverse_string': [
        {'area': 1804.2, 'latency': 31.0},
        {'area': 1719.0, 'latency': 31.0},
        {'area': 1719.0, 'latency': 31.0},
        {'area': 1906.1, 'latency': 31.0},
        {'area': 3611.2, 'latency': 95.0},
    ],
    'traceback': [
        {'area': 10173.9, 'latency': 34.0},
        {'area': 10173.9, 'latency': 34.0},
        {'area': 10173.9, 'latency': 34.0},
        {'area': 9416.3, 'latency': 127.0},
        {'area': 10173.9, 'latency': 34.0},
    ],
    'needwun': [
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
    ],
}

model = cp_model.CpModel()

# Create decision variables for each function's option index
fm = model.NewIntVar(0, 4, 'fill_matrix')
rs = model.NewIntVar(0, 4, 'reverse_string')
tb = model.NewIntVar(0, 4, 'traceback')
nw = model.NewIntVar(0, 4, 'needwun')

# Create area variables using element constraints
fm_area = model.NewIntVar(0, 3000, 'fm_area')
model.AddElement(fm, [int(f['area']) for f in functions['fill_matrix']], fm_area)

rs_area = model.NewIntVar(0, 4000, 'rs_area')
model.AddElement(rs, [int(f['area']) for f in functions['reverse_string']], rs_area)

tb_area = model.NewIntVar(0, 11000, 'tb_area')
model.AddElement(tb, [int(f['area']) for f in functions['traceback']], tb_area)

nw_area = model.NewIntVar(11000, 12000, 'nw_area')
model.AddElement(nw, [int(f['area']) for f in functions['needwun']], nw_area)

total_area = model.NewIntVar(0, 30000, 'total_area')
model.Add(total_area == fm_area + rs_area + tb_area + nw_area)

# Create latency variables using element constraints
fm_lat = model.NewIntVar(0, 3000, 'fm_lat')
model.AddElement(fm, [int(f['latency']) for f in functions['fill_matrix']], fm_lat)

rs_lat = model.NewIntVar(0, 100, 'rs_lat')
model.AddElement(rs, [int(f['latency']) for f in functions['reverse_string']], rs_lat)

tb_lat = model.NewIntVar(0, 200, 'tb_lat')
model.AddElement(tb, [int(f['latency']) for f in functions['traceback']], tb_lat)

nw_lat = model.NewIntVar(0, 300, 'nw_lat')
model.AddElement(nw, [int(f['latency']) for f in functions['needwun']], nw_lat)

total_latency = model.NewIntVar(0, 5000, 'total_latency')
model.Add(total_latency == fm_lat + rs_lat + tb_lat + nw_lat)

# Objective: minimize absolute difference from target area (6000) first, then minimize latency
delta = model.NewIntVar(0, 10000, 'delta')
model.AddAbsEquality(delta, total_area - 6000)

# Multi-objective optimization: first minimize delta, then latency
model.Minimize(delta * 1000 + total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f"Configuration:")
    print(f"fill_matrix: {solver.Value(fm)}")
    print(f"reverse_string: {solver.Value(rs)}")
    print(f"traceback: {solver.Value(tb)}")
    print(f"needwun: {solver.Value(nw)}")
    print(f"Total area: {solver.Value(total_area)}")
    print(f"Total latency: {solver.Value(total_latency)}")
else:
    print("No feasible solution found.")
'''
