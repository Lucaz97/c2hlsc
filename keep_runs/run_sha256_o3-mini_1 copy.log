void sha256_transform_hls(unsigned int state[8], unsigned char data[64])
{
    unsigned int m[64];
    unsigned int a, b, c, d, e, f, g, h;
    unsigned int t1, t2;
    int i;

    // Initialize working variables from state.
    a = state[0];
    b = state[1];
    c = state[2];
    d = state[3];
    e = state[4];
    f = state[5];
    g = state[6];
    h = state[7];

    // Fuse the message schedule computation and compression rounds into one fully-unrolled loop.
    // For i in 0..63, if i < 16 we load from the input data.
    // Otherwise, compute the message word from previous words.
    // Then immediately perform the compression round using the computed m[i].
    #pragma HLS unroll yes
    for (i = 0; i < 64; i++) {
        unsigned int msg_word;
        if (i < 16) {
            msg_word = ((unsigned int)data[i * 4]     << 24) |
                       ((unsigned int)data[i * 4 + 1] << 16) |
                       ((unsigned int)data[i * 4 + 2] << 8)  |
                       ((unsigned int)data[i * 4 + 3]);
        } else {
            msg_word = SIG1(m[i - 2]) + m[i - 7] + SIG0(m[i - 15]) + m[i - 16];
        }
        m[i] = msg_word; // save for use in later iterations

        t1 = h + EP1(e) + CH(e, f, g) + k[i] + msg_word;
        t2 = EP0(a) + MAJ(a, b, c);

        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }

    // Update the state with the results of the transform.
    state[0] += a;
    state[1] += b;
    state[2] += c;
    state[3] += d;
    state[4] += e;
    state[5] += f;
    state[6] += g;
    state[7] += h;
}

void sha256_transform(state_t *state, data_t data[])
{
    sha256_transform_hls(*state, data[0]);
}
