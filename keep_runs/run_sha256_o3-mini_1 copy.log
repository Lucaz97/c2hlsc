void sha256_transform_hls(unsigned int state[8], unsigned char data[64])
{
    unsigned int m[64];
    unsigned int a, b, c, d, e, f, g, h;
    unsigned int t1, t2;
    int i, j;

    // Initialize working variables from the state.
    a = state[0];
    b = state[1];
    c = state[2];
    d = state[3];
    e = state[4];
    f = state[5];
    g = state[6];
    h = state[7];

    // -------------------------------------------------------------------------
    // Process rounds 0 .. 15:
    // In these rounds, the message word is loaded directly from input data.
    // This loop is fully unrolled to minimize latency.
    // -------------------------------------------------------------------------
    for (i = 0, j = 0; i < 16; ++i, j += 4) {
    #pragma HLS unroll
        m[i] = ((unsigned int)data[j] << 24) | ((unsigned int)data[j + 1] << 16)
             | ((unsigned int)data[j + 2] << 8)  | ((unsigned int)data[j + 3]);

        t1 = h + EP1(e) + CH(e, f, g) + k[i] + m[i];
        t2 = EP0(a) + MAJ(a, b, c);
        h  = g;
        g  = f;
        f  = e;
        e  = d + t1;
        d  = c;
        c  = b;
        b  = a;
        a  = t1 + t2;
    }

    // -------------------------------------------------------------------------
    // Process rounds 16 .. 63:
    // The message schedule is computed from previously stored m[] values.
    // This loop is fully unrolled, eliminating loop overhead and the branch needed for i<16.
    // -------------------------------------------------------------------------
    for (i = 16; i < 64; ++i) {
    #pragma HLS unroll
        m[i] = SIG1(m[i - 2]) + m[i - 7] + SIG0(m[i - 15]) + m[i - 16];

        t1 = h + EP1(e) + CH(e, f, g) + k[i] + m[i];
        t2 = EP0(a) + MAJ(a, b, c);
        h  = g;
        g  = f;
        f  = e;
        e  = d + t1;
        d  = c;
        c  = b;
        b  = a;
        a  = t1 + t2;
    }

    // Update the state with this chunk's results.
    state[0] += a;
    state[1] += b;
    state[2] += c;
    state[3] += d;
    state[4] += e;
    state[5] += f;
    state[6] += g;
    state[7] += h;
}

void sha256_transform(state_t *state, data_t data[])
{
    sha256_transform_hls(*state, data[0]);
}
