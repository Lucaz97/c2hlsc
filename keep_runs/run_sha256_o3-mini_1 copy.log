void sha256_transform_hls(unsigned int state[8], unsigned char data[64])
{
    unsigned int m[64];
    unsigned int a, b, c, d, e, f, g, h;
    unsigned int t1, t2;
    int i, j;

    // Compute the first 16 message words from input data.
    // Fully unroll this loop to form all m[0..15] in parallel.
    for(i = 0, j = 0; i < 16; ++i, j += 4) {
    #pragma HLS unroll
        m[i] = ((unsigned int)data[j] << 24) | ((unsigned int)data[j + 1] << 16)
             | ((unsigned int)data[j + 2] << 8)  | ((unsigned int)data[j + 3]);
    }

    // Compute the remaining 48 message words. They depend sequentially on previous words.
    // Use pipelining with initiation interval of 1 to minimize scheduling latency.
    for(; i < 64; ++i) {
    #pragma HLS pipeline init_interval=1
        m[i] = SIG1(m[i - 2]) + m[i - 7] + SIG0(m[i - 15]) + m[i - 16];
    }

