python: '''
from ortools.sat.python import cp_model

# Data for each function's options: each option as a tuple (area, latency)
# For functions with name f, we'll index options starting at 0.

functions = {
    'AddRoundKey_hls': [
        (752.6, 34.0),  # option 0
        (739.4, 31.0),  # option 1
        (739.4, 31.0),  # option 2
        (734.6, 31.0),  # option 3
        (1900.5, 16.0)  # option 4
    ],
    'SubBytes_hls': [
        (1889.1, 15.0), # option 0
        (831.0, 21.0),  # option 1
        (825.5, 15.0),  # option 2
        (1889.1, 15.0), # option 3
        (829.0, 15.0)   # option 4
    ],
    'ShiftRows_hls': [
        (975.6, 19.0),  # option 0
        (23.9, 0.0),    # option 1
        (23.9, 0.0),    # option 2
        (23.9, 0.0),    # option 3
        (23.9, 0.0)     # option 4
    ],
    'xtime': [
        (77.0, 1.0),    # option 0
        (77.0, 1.0),    # option 1
        (82.0, 1.0),    # option 2
        (77.0, 1.0),    # option 3
        (77.0, 1.0)     # option 4
    ],
    'MixColumns_hls': [
        (866.6, 0.0),   # option 0
        (866.6, 0.0),   # option 1
        (639.9, 3.0),   # option 2
        (866.6, 0.0),   # option 3
        (866.6, 0.0)    # option 4
    ],
    'Cipher_hls': [
        (4869.2, 194.0), # option 0
        (9768.5, 175.0), # option 1
        (4869.2, 194.0), # option 2
        (8622.0, 202.0), # option 3
        (9768.5, 175.0)  # option 4
    ]
}

target_area = 10000.0
# Weight for area deviation in objective
penalty_weight = 0.1

model = cp_model.CpModel()

# Decision variables: for each function f, create an integer variable that picks an option index.
choice = {}
for f, opts in functions.items():
    # domain is 0 .. (len(opts)-1)
    choice[f] = model.NewIntVar(0, len(opts)-1, f + '_choice')

# Since the data are floats, we'll scale them to integers.
scale = 100  # scale factor
def to_int(x):
    return int(round(x * scale))

# Pre-calculate scaled areas and latencies per function per option.
scaled_data = {}
for f, opts in functions.items():
    scaled_data[f] = [(to_int(area), to_int(latency)) for (area, latency) in opts]

# Create lists of options for each function (for easier referencing later)
# We'll compute total_area and total_latency as linear expressions.
# However, CP-SAT does not directly support non-linear expressions or absolute value, so we linearize.

# For each function f, we need indicator variables for each option.
indicator = {}
for f, opts in scaled_data.items():
    n = len(opts)
    indicator[f] = [model.NewBoolVar(f + '_opt_' + str(i)) for i in range(n)]
    # Link the indicator to the choice: exactly one option must be chosen.
    model.Add(sum(indicator[f]) == 1)
    # Add reification: if indicator[f][i] is true then choice[f] == i
    # But we don't strictly need the choice variable if we use indicator variables in the objective.
    for i in range(n):
        # choice[f] == i <=> indicator[f][i] is 1 is implied by summing.
        # We can link: indicator[f][i] == 1 => choice[f] == i. We don't use choice elsewhere.
        pass

# Total area and latency expressed as integer linear expressions.
total_area = sum(indicator[f][i] * scaled_data[f][i][0] for f in scaled_data for i in range(len(scaled_data[f])))
total_latency = sum(indicator[f][i] * scaled_data[f][i][1] for f in scaled_data for i in range(len(scaled_data[f])))

# To handle absolute deviation: deviation = |total_area - target_area_scaled|
target_area_scaled = to_int(target_area)
deviation = model.NewIntVar(0, 1000000, 'deviation')
model.Add(total_area - target_area_scaled <= deviation)
model.Add(target_area_scaled - total_area <= deviation)

# Objective: minimize total_latency + penalty_weight * deviation
# Scale penalty_weight so that the objective is integer.
# Let lambda_scaled = penalty_weight (which is 0.1), but also scale it by 'scale'.
lambda_scaled = int(round(penalty_weight * scale))  # 0.1 * 100 = 10
model.Minimize(total_latency + lambda_scaled * deviation)

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Solution:")
    total_area_val = solver.Value(total_area) / scale
    total_latency_val = solver.Value(total_latency) / scale
    print("Total_Area:", total_area_val)
    print("Total_Latency:", total_latency_val)
    for f in functions.keys():
        n = len(functions[f])
        for i in range(n):
            if solver.Value(indicator[f][i]) == 1:
                area_val, latency_val = functions[f][i]
                print(f, "option", i, "-> area:", area_val, "latency:", latency_val)
else:
    print("No solution found.")
'''
