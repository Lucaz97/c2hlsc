```c
int odd_factorial(int n)
{
  // Use a tree reduction to compute the product of odd numbers.
  // Assume that n is small enough so that the number of odd numbers is ≤ 64.
  int vals[64];
  int count = 0;
  
  // Collect all odd numbers less than n.
  for (int i = 1; i < n; i += 2)
  {
    vals[count++] = i;
  }

  // Tree reduction: pairwise multiply to reduce the dependency chain depth.
  while (count > 1)
  {
    int new_count = (count + 1) >> 1; // new_count = (count+1)/2
    for (int i = 0; i < count/2; i++)
    {
      #pragma hls_unroll yes
      vals[i] = vals[2*i] * vals[2*i + 1];
    }
    // Handle an odd number of elements: pass the last element to the next level.
    if (count & 1)
      vals[new_count - 1] = vals[count - 1];
    
    count = new_count;
  }

  // If no odd numbers were multiplied (e.g. when n <= 1) return 1.
  return (count == 0) ? 1 : vals[0];
}
```
