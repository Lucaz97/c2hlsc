int even_sum(int n)
{
  // Using closed-form expression to compute the sum of even numbers.
  // This computes the sum: 2 + 4 + ... + (largest even < n)
  // Let m = floor((n-1)/2), then the sum equals m*(m+1)
  int m = (n - 1) / 2;
  return m * (m + 1);
}
```
