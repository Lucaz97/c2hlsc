int even_sum(int n)
{
  #pragma HLS inline  // Inline the function to reduce interface overhead

  // Compute an adjusted value to correctly calculate m = floor((n - adjust)/2)
  // For odd n, adjust = 1 so that m = (n-1)/2, and for even n, adjust = 2 so that m = (n-2)/2.
  int adjust = (n & 1) ? 1 : 2;
  int m = (n - adjust) >> 1;  // Division by 2 using a right shift
  
  // The sum of even numbers below n is:
  //   m*(m+1)
  // where m equals (n-1)/2 for odd n and (n-2)/2 for even n.
  return m * (m + 1);
}
```
