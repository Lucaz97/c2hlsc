int fibonacci(int n)
{
  // Early exit for very small n to avoid unnecessary iterations.
  if(n < 2)
    return n;
  
  int a = 0;
  int b = 1;
  int c = 0;
  
  // Full unrolling minimizes loop-related latency.
  #pragma hls_unroll yes
  for (int i = 2; i < n; i++)
  {
    c = a + b;
    a = b;
    b = c;
  }
  
  return c;
}
```
