int even_sum(int n)
{
  // Use two accumulators to break the loop‐carried dependency.
  // This tree‐like reduction will help lower the critical path,
  // thus reducing latency while keeping area lower than the closed‐form version.
  int acc0 = 0, acc1 = 0;
  int i;
  #pragma hls_pipeline_init_interval 1
  for (i = 2; i < n; i += 4)
  {
    #pragma hls_unroll factor=2
    acc0 += i;
    if (i + 2 < n)
      acc1 += (i + 2);
  }
  return acc0 + acc1;
}
```
