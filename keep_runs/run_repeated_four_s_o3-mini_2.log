void compute6(int n[5])
{
  // Copy the input array from external memory into a local array.
  int local[5];
  for (int i = 0; i < 5; i++)
  {
    local[i] = n[i];
  }

  // Pipeline the loop for latency optimization.
  #pragma hls_pipeline_init_interval 1
  for (int i = 0; i < 5; i++)
  {
    // Use a local copy of the current element
    int a = local[i];
    int result0 = odd_factorial(a);
    int result1 = fibonacci(a);
    int result2 = even_sum(result0 - result1);
    int result3 = even_sum(result2 - result1);
    local[i] = result3;
  }

  // Write back the results to the output array.
  for (int i = 0; i < 5; i++)
  {
    n[i] = local[i];
  }
}
