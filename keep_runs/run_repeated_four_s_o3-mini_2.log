int even_sum(int n)
{
  // We use the closed‐form expression:
  //   sum = k*(k+1)   where k = (n-1)/2
  // To target a latency of 1 cycle while keeping area down,
  // we direct the multiplication result to be implemented using a DSP block.
  // This helps reduce the combinational area, aiming for an area score
  // closer to our best iterative solution yet with the minimal latency.
  int k = (n - 1) >> 1;
  int result = k * (k + 1);
  #pragma HLS RESOURCE variable=result core=Mul_DSP
  return result;
}
