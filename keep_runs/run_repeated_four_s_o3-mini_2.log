int fibonacci(int n)
{
  // For n <= 1, return n directly. For n == 2, result is 1.
  if(n < 2) return n;
  if(n == 2) return 1;
  
  int a = 0;
  int b = 1;
  int iter = n - 2; // number of iterations originally performed

  // Process two iterations per loop iteration to reduce latency.
  // This transformation computes two Fibonacci updates in one pipelined loop iteration.
  for (; iter > 1; iter -= 2)
  {
    #pragma hls_pipeline_init_interval 1
    int c = a + b;  // first update: F(i) = a + b
    int d = b + c;  // second update: F(i+1) = b + c
    a = c;
    b = d;
  }

  // If there's one iteration remaining, process it.
  if(iter == 1)
  {
    #pragma hls_pipeline_init_interval 1
    int c = a + b;
    a = b;
    b = c;
  }

  // In the original function, the returned value is the last computed Fibonacci number.
  // Here, b holds the final Fibonacci number corresponding to index n-1.
  return b;
}
```
