python: ''' 
from ortools.linear_solver import pywraplp

# Data for each function option:
# Format: function: list of (area, latency, throughput)
functions_options = {
    'shift': [
        (1451.8, 2.0, 4.0),
        (1929.7, 2.0, 4.0),
        (1451.8, 2.0, 4.0),
        (1546.9, 3.0, 5.0),
        (1451.8, 2.0, 4.0)
    ],
    'mac': [
        (4346.7, 2.0, 3.0),
        (6690.9, 6.0, 7.0),
        (4346.7, 2.0, 3.0),
        (4346.7, 2.0, 3.0),
        (6690.9, 6.0, 7.0)
    ],
    'fir': [
        (5043.1, 10.0, 11.0),
        (5043.1, 10.0, 11.0),
        (6135.1, 5.0, 6.0),
        (4901.3, 10.0, 11.0),
        (6219.2, 5.0, 6.0)
    ],
    'iir': [
        (8132.5, 16.0, 22.0),
        (8160.4, 16.0, 22.0),
        (8160.4, 16.0, 22.0),
        (8160.4, 16.0, 22.0),
        (8630.3, 10.0, 11.0)
    ],
    'filter': [
        (3440.3, 1.0, 2.0),
        (3440.3, 1.0, 2.0),
        (3440.3, 1.0, 2.0),
        (3440.3, 1.0, 2.0),
        (3440.3, 1.0, 2.0)
    ]
}

# We assume that the top-level accelerator (the collection of functions)
# should have a total area close to 6000 per module. Since we have 5 functions,
# we set a target total area of 5 * 6000 = 30000.
target_area = 30000.0

# Create the MILP solver.
solver = pywraplp.Solver.CreateSolver('CBC')
if not solver:
    raise Exception("Solver not created.")

# Decision variables: x[f][i] = 1 if option i is chosen for function f.
x = {}
for f, opts in functions_options.items():
    x[f] = []
    for i in range(len(opts)):
        x[f].append(solver.IntVar(0, 1, f"x_{f}_{i}"))

# One option per function constraint.
for f, opts in functions_options.items():
    solver.Add(sum(x[f][i] for i in range(len(opts))) == 1)

# Calculate total_latency and total_area.
total_latency = solver.Sum(x[f][i] * functions_options[f][i][1]
                           for f in functions_options
                           for i in range(len(functions_options[f])))

total_area = solver.Sum(x[f][i] * functions_options[f][i][0]
                        for f in functions_options
                        for i in range(len(functions_options[f])))

# To linearize the absolute value of (total_area - target_area),
# we introduce an auxiliary variable 'dev' >= 0 and add:
dev = solver.NumVar(0, solver.infinity(), 'dev')
solver.Add(total_area - target_area <= dev)
solver.Add(target_area - total_area <= dev)

# Our objective is to minimize latency while keeping area close to target.
# We form a composite objective: minimize total_latency + beta * dev.
# beta is chosen to balance the scale of latency (around 10-20) and area deviation (which can be several thousands).
beta = 0.01

objective = solver.Sum(total_latency + beta * dev)
solver.Minimize(objective)

status = solver.Solve()

if status == pywraplp.Solver.OPTIMAL:
    print("Optimal solution found:")
    print("Total latency =", total_latency.solution_value())
    print("Total area   =", total_area.solution_value())
    print("Deviation    =", dev.solution_value())
    print("Selected options per function:")
    for f in functions_options:
        for i in range(len(functions_options[f])):
            if x[f][i].solution_value() > 0.5:
                area, lat, thr = functions_options[f][i]
                print(f"  {f}: option {i} -> area: {area}, latency: {lat}, throughput: {thr}")
else:
    print("No optimal solution found.")
'''
