```c
int fibonacci(int n)
{
    // For n less than 2, return n directly.
    if (n < 2)
        return n;

    // Use matrix exponentiation:
    // [F(n+1) F(n)  ] = [1 1]^n
    // [F(n)   F(n-1)]   [1 0]
    // Here we compute R = M^(n-1) so that R[0][0] = F(n).
    int r00 = 1, r01 = 0, r10 = 0, r11 = 1; // Identity matrix
    int m00 = 1, m01 = 1, m10 = 1, m11 = 0; // Fibonacci Q-matrix

    int e = n - 1; // exponent

    while (e > 0)
    {
        // Pipeline the loop to reduce latency.
        #pragma hls_pipeline_init_interval 1
        if (e & 1)
        {
            // Multiply result matrix (r) by matrix m:
            int t00 = r00 * m00 + r01 * m10;
            int t01 = r00 * m01 + r01 * m11;
            int t10 = r10 * m00 + r11 * m10;
            int t11 = r10 * m01 + r11 * m11;
            r00 = t00; r01 = t01; r10 = t10; r11 = t11;
        }
        // Square the matrix m.
        {
            int t00 = m00 * m00 + m01 * m10;
            int t01 = m00 * m01 + m01 * m11;
            int t10 = m10 * m00 + m11 * m10;
            int t11 = m10 * m01 + m11 * m11;
            m00 = t00; m01 = t01; m10 = t10; m11 = t11;
        }
        e >>= 1;
    }

    return r00;
}
