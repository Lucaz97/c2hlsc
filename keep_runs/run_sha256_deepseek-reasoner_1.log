python: '''
from ortools.sat.python import cp_model

# Convert float values to integers by scaling (×10)
transform_opts = [
    (340788, 80), (340507, 80), (353646, 65), 
    (353646, 65), (353646, 65)  # Area values multiplied by 10
]
update_opts = [
    (436245, 68), (439339, 68), (434415, 68),
    (709148, 396), (439339, 68)  # Area values multiplied by 10
]

model = cp_model.CpModel()
t = model.NewIntVar(0, 4, 'transform')
u = model.NewIntVar(0, 4, 'update')

# Create area and latency variables with integer coefficients
transform_area = model.NewIntVar(0, 400000, 't_area')
update_area = model.NewIntVar(0, 800000, 'u_area')
total_area = model.NewIntVar(0, 1200000, 'total_area')

transform_lat = model.NewIntVar(0, 100, 't_lat')
update_lat = model.NewIntVar(0, 400, 'u_lat')
total_latency = model.NewIntVar(0, 500, 'total_lat')

# Add element constraints for area and latency
model.AddElement(t, [op[0] for op in transform_opts], transform_area)
model.AddElement(u, [op[0] for op in update_opts], update_area)
model.Add(total_area == transform_area + update_area)

model.AddElement(t, [op[1] for op in transform_opts], transform_lat)
model.AddElement(u, [op[1] for op in update_opts], update_lat)
model.Add(total_latency == transform_lat + update_lat)

# Objective: minimize latency ×1000 + |total_area - 700000| 
# (700000 represents original 70000 target ×10 scaling)
abs_diff = model.NewIntVar(0, 500000, 'abs_diff')
model.AddAbsEquality(abs_diff, total_area - 700000)
model.Minimize(total_latency * 1000 + abs_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f'Solution: transform={solver.Value(t)}, update={solver.Value(u)}')
    print(f'Total area: {solver.Value(total_area)/10:.1f}')
    print(f'Total latency: {solver.Value(total_latency)}')
else:
    print('No solution found')
'''
