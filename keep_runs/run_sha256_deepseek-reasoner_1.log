from ortools.sat.python import cp_model

transform_opts = [
    (34078.8, 80), (34050.7, 80), (35364.6, 65), 
    (35364.6, 65), (35364.6, 65)
]
update_opts = [
    (43624.5, 68), (43933.9, 68), (43441.5, 68),
    (70914.8, 396), (43933.9, 68)
]

model = cp_model.CpModel()
t = model.NewIntVar(0,4, 'transform')
u = model.NewIntVar(0,4, 'update')

area = model.NewIntVar(0, 200000, 'area')
latency = model.NewIntVar(0, 1000, 'latency')

model.Add(area == sum([
    cp_model.LinearExpr.Term(t, transform_opts[i][0]) + 
    cp_model.LinearExpr.Term(u, update_opts[j][0]) 
    for i in range(5) for j in range(5)
]))
model.Add(latency == sum([
    cp_model.LinearExpr.Term(t, transform_opts[i][1]) + 
    cp_model.LinearExpr.Term(u, update_opts[j][1]) 
    for i in range(5) for j in range(5)
]))

# Minimize weighted sum of latency and area difference from 70000
obj = model.NewIntVar(0, 2000000, 'obj')
model.Add(obj == latency * 1000 + abs(area - 70000))
model.Minimize(obj)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f'Optimal: t={solver.Value(t)}, u={solver.Value(u)}')
    print(f'Area: {solver.Value(area)}, Latency: {solver.Value(latency)}')
else:
    print('No optimal found')
'''
