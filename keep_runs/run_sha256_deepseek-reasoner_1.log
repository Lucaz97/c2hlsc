#include <stdint.h>

void sha256_update_hls(unsigned char data_int[64], unsigned int* datalen_int, unsigned int state[8], unsigned long long* bitlen_int, unsigned char data[64], size_t len) {
    uint8_t local_datalen = (uint8_t)(*datalen_int);
    unsigned long long local_bitlen = *bitlen_int;

    #pragma HLS ARRAY_PARTITION variable=data_int complete dim=1
    #pragma HLS BIND_STORAGE variable=data_int type=ram_s2p impl=lutram

    Update_Loop:
    for (size_t i = 0; i < len; ++i) {
        data_int[local_datalen] = data[i];
        if (++local_datalen == 64) {
            sha256_transform_hls(state, data_int);
            local_bitlen += 512;
            local_datalen = 0;
        }
    }

    *datalen_int = (unsigned int)local_datalen;
    *bitlen_int = local_bitlen;
}

void sha256_update(data_t *data_int, unsigned int *datalen_int, state_t *state, unsigned long long *bitlen_int, data_t *data, size_t len) {
    sha256_update_hls(*data_int, datalen_int, *state, bitlen_int, *data, len);
}
```

Key optimizations:
1. **Array Partitioning**: Full partitioning of `data_int` array into registers using `complete dim=1` to eliminate BRAM access latency
2. **LUTRAM Binding**: Force implementation using LUT-based RAMs with `BIND_STORAGE` for better timing characteristics
3. **Precision Reduction**: Use `uint8_t` for counter variable to optimize comparison and increment operations
4. **Type Consistency**: Maintain `size_t` loop counter for clean range checking
5. **Memory Isolation**: Keep critical path operations completely in registers to avoid controller FSM bloat

This version focuses on reducing datapath latency through aggressive resource typing while containing area growth through LUTRAM optimization.
