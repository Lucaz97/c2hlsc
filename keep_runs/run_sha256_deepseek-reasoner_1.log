```c
void sha256_transform_hls(unsigned int state[8], unsigned char data[64]) {
  #pragma HLS array_partition variable=state complete
  unsigned int a, b, c, d, e, f, g, h;
  unsigned int m[64];
  #pragma HLS array_partition variable=m block factor=16
  #pragma HLS array_rom variable=k

  // Optimized message scheduling with expression balancing
  #pragma HLS unroll yes
  MSG_LOOP:
  for (int i = 0; i < 64; ++i) {
    #pragma HLS expression_balance
    if (i < 16) {
      unsigned int j = i*4;
      m[i] = (data[j] << 24) | (data[j+1] << 16) | (data[j+2] << 8) | data[j+3];
    } else {
      m[i] = SIG1(m[i-2]) + m[i-7] + SIG0(m[i-15]) + m[i-16];
    }
  }

  a = state[0]; b = state[1]; c = state[2]; d = state[3];
  e = state[4]; f = state[5]; g = state[6]; h = state[7];

  // Optimized computation core with staggered operations
  #pragma HLS unroll yes
  COMPRESS_LOOP:
  for (int i = 0; i < 64; ++i) {
    #pragma HLS expression_balance
    #pragma HLS latency min=1 max=3
    unsigned int t1 = h + EP1(e) + CH(e,f,g) + k[i] + m[i];
    unsigned int t2 = EP0(a) + MAJ(a,b,c);
    
    // Staggered register updates to break critical path
    unsigned int new_a = t1 + t2;
    unsigned int new_e = d + t1;
    
    h = g; g = f; f = e; 
    e = new_e;
    d = c; c = b; b = a;
    a = new_a;
  }

  state[0] += a; state[1] += b; state[2] += c; state[3] += d;
  state[4] += e; state[5] += f; state[6] += g; state[7] += h;
}

void sha256_transform(state_t *state, data_t *data) {
  sha256_transform_hls(*state, *data);
}
```

