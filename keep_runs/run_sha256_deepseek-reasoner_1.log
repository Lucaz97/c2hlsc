void sha256_update_hls(unsigned char data_int[64], unsigned int* datalen_int, unsigned int state[8], unsigned long long* bitlen_int, unsigned char data[64], size_t len) {
    unsigned int local_datalen = *datalen_int;
    unsigned long long local_bitlen = *bitlen_int;
    size_t i = 0;

    // Handle partial block from initial state
    if (local_datalen > 0 && len > 0) {
        unsigned int space = 64 - local_datalen;
        unsigned int fill = (len < space) ? len : space;

        Partial_Fill:
        for (unsigned int j = 0; j < fill; ++j) {
            #pragma HLS UNROLL factor=4
            data_int[local_datalen + j] = data[j];
        }
        
        i += fill;
        local_datalen += fill;
        len -= fill;
        
        if (local_datalen == 64) {
            sha256_transform_hls(state, data_int);
            local_bitlen += 512;
            local_datalen = 0;
        }
    }

    // Process full blocks with optimized copy
    Full_Blocks:
    while (len >= 64) {
        #pragma HLS LOOP_TRIPCOUNT min=0 max=32
        Block_Copy:
        for (int j = 0; j < 64; ++j) {
            #pragma HLS UNROLL
            data_int[j] = data[i + j];
        }
        
        sha256_transform_hls(state, data_int);
        local_bitlen += 512;
        i += 64;
        len -= 64;
    }

    // Final partial block
    if (len > 0) {
        Final_Copy:
        for (size_t j = 0; j < len; ++j) {
            #pragma HLS UNROLL factor=4
            data_int[local_datalen + j] = data[i + j];
        }
        local_datalen += len;
    }

    *datalen_int = local_datalen;
    *bitlen_int = local_bitlen;
}

void sha256_update(data_t *data_int, unsigned int *datalen_int, state_t *state, unsigned long long *bitlen_int, data_t *data, size_t len) {
    sha256_update_hls(*data_int, datalen_int, *state, bitlen_int, *data, len);
}
