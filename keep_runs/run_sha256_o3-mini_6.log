void sha256_transform_hls(unsigned int state[8], unsigned char data[64])
{
  unsigned int a, b, c, d, e, f, g, h;
  unsigned int i;
  unsigned int t1, t2;
  unsigned int m[64];
  // Partitioning the m array completely to allow simultaneous accesses,
  // reducing any memory-read bottlenecks in the pipelined loops.
  #pragma HLS ARRAY_PARTITION variable=m complete dim=1

  // Merge the two message schedule loops into one.
  // For i < 16, load from data.
  // For i >= 16, compute the extended message schedule.
  LOOP_M: for(i = 0; i < 64; i++) {
    #pragma hls_pipeline_init_interval 1
    if (i < 16) {
      unsigned int j = i * 4;
      m[i] = ((unsigned int)data[j] << 24) |
             ((unsigned int)data[j + 1] << 16) |
             ((unsigned int)data[j + 2] << 8) |
             data[j + 3];
    } else {
      m[i] = SIG1(m[i - 2]) + m[i - 7] + SIG0(m[i - 15]) + m[i - 16];
    }
  }

  a = state[0];
  b = state[1];
  c = state[2];
  d = state[3];
  e = state[4];
  f = state[5];
  g = state[6];
  h = state[7];

  // Compression loop: Fully pipeline with an initiation interval of 1.
  LOOP_C: for (i = 0; i < 64; i++) {
    #pragma hls_pipeline_init_interval 1
    t1 = h + EP1(e) + CH(e, f, g) + k[i] + m[i];
    t2 = EP0(a) + MAJ(a, b, c);
    h  = g;
    g  = f;
    f  = e;
    e  = d + t1;
    d  = c;
    c  = b;
    b  = a;
    a  = t1 + t2;
  }

  state[0] += a;
  state[1] += b;
  state[2] += c;
  state[3] += d;
  state[4] += e;
  state[5] += f;
  state[6] += g;
  state[7] += h;
}

void sha256_transform(unsigned int (*state)[8], unsigned char (*data)[64])
{
  sha256_transform_hls(*state, *data);
}
