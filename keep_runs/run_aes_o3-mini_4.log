from ortools.sat.python import cp_model

# Multiply all values by 10 (to use integers)
# Target area = 10000, multiplied by 10 -> 100000
target_area = 100000
lower_bound = 95000
upper_bound = 105000

# Function options as lists of tuples: (area, latency) multiplied by 10
AddRoundKey = [(7526, 340), (7394, 310), (7394, 310), (7346, 310), (19005, 160)]
SubBytes = [(18891, 150), (8310, 210), (8255, 150), (18891, 150), (8290, 150)]
ShiftRows = [(9756, 190), (239, 0), (239, 0), (239, 0), (239, 0)]
xtime = [(770, 10), (770, 10), (820, 10), (770, 10), (770, 10)]
MixColumns = [(8666, 0), (8666, 0), (6399, 30), (8666, 0), (8666, 0)]
Cipher = [(48692, 1940), (97685, 1750), (48692, 1940), (86220, 2020), (97685, 1750)]

functions = {
    'AddRoundKey_hls': AddRoundKey,
    'SubBytes_hls': SubBytes,
    'ShiftRows_hls': ShiftRows,
    'xtime': xtime,
    'MixColumns_hls': MixColumns,
    'Cipher_hls': Cipher
}

model = cp_model.CpModel()

# Create indicator variables for choosing one option per function
indicator = {}
for func, opts in functions.items():
    indicator[func] = []
    for i in range(len(opts)):
        ind = model.NewBoolVar(f'{func}_option_{i}')
        indicator[func].append(ind)
    model.Add(sum(indicator[func]) == 1)

# Linear expressions for total area and total latency
total_area_expr = sum(
    indicator[func][i] * functions[func][i][0]
    for func in functions
    for i in range(len(functions[func]))
)
total_latency_expr = sum(
    indicator[func][i] * functions[func][i][1]
    for func in functions
    for i in range(len(functions[func]))
)

# Add constraints to force total area to be near the target [lower_bound, upper_bound]
model.Add(total_area_expr >= lower_bound)
model.Add(total_area_expr <= upper_bound)

# Objective: minimize total latency under the area constraints.
model.Minimize(total_latency_expr)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in [cp_model.OPTIMAL, cp_model.FEASIBLE]:
    config = {}
    print("Solution with area constraints:")
    for func in functions:
        for i in range(len(functions[func])):
            if solver.Value(indicator[func][i]) == 1:
                config[func] = i
                area_val = functions[func][i][0] / 10.0
                lat_val = functions[func][i][1] / 10.0
                print(f"{func}: option {i}, area = {area_val}, latency = {lat_val}")
    total_area_val = solver.Value(total_area_expr)
    total_latency_val = solver.Value(total_latency_expr)
    print(f"Total area = {total_area_val/10.0}")
    print(f"Total latency = {total_latency_val/10.0}")
else:
    print("No solution found with the area constraints.")
