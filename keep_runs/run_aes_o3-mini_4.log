from ortools.sat.python import cp_model

# Multiply all values by 10 (to convert float to integer)
# Define target area in multiplied units (target=10000, so 10000*10 = 100000)
target_area = 100000

# Function options as lists of tuples: (area, latency)
AddRoundKey = [(7526, 340), (7394, 310), (7394, 310), (7346, 310), (19005, 160)]
SubBytes = [(18891, 150), (8310, 210), (8255, 150), (18891, 150), (8290, 150)]
ShiftRows = [(9756, 190), (239, 0), (239, 0), (239, 0), (239, 0)]
xtime = [(770, 10), (770, 10), (820, 10), (770, 10), (770, 10)]
MixColumns = [(8666, 0), (8666, 0), (6399, 30), (8666, 0), (8666, 0)]
Cipher = [(48692, 1940), (97685, 1750), (48692, 1940), (86220, 2020), (97685, 1750)]

functions = {
    'AddRoundKey_hls': AddRoundKey,
    'SubBytes_hls': SubBytes,
    'ShiftRows_hls': ShiftRows,
    'xtime': xtime,
    'MixColumns_hls': MixColumns,
    'Cipher_hls': Cipher
}

model = cp_model.CpModel()

# Decision variables: for each function, choose an index option
choices = {}
for func, opts in functions.items():
    choices[func] = model.NewIntVar(0, len(opts)-1, func + '_choice')

# Create expressions for total area and total latency
total_area = sum([ 
    sum([ (opts[i][0] * (choices[func] == i)) for i in range(len(opts)) ])
    for func, opts in functions.items()
])
total_latency = sum([ 
    sum([ (opts[i][1] * (choices[func] == i)) for i in range(len(opts)) ])
    for func, opts in functions.items()
])

# However, the above summations are not directly linear because (choices[func]==i) is a Boolean.
# Instead, we create indicator variables.
indicator = {}
for func, opts in functions.items():
    indicator[func] = []
    for i in range(len(opts)):
        ind = model.NewBoolVar(f'{func}_is_{i}')
        indicator[func].append(ind)
    # Exactly one option must be taken
    model.Add(sum(indicator[func]) == 1)
    # Link indicator to the choice variable
    # choices[func] equals i if indicator[func][i] is true.
    model.AddDecisionStrategy([choices[func]], cp_model.CHOOSE_FIRST, cp_model.SELECT_MIN_VALUE)
    # We impose: choices[func] == i  <==> indicator[func][i] == 1.
    # Instead, we use: sum(i * indicator[func][i]) == choices[func]
    model.Add(sum(i * indicator[func][i] for i in range(len(opts))) == choices[func])

# Now express total_area and total_latency linearly using indicators.
total_area_expr = sum( indicator[func][i] * functions[func][i][0]
                       for func in functions for i in range(len(functions[func])) )
total_latency_expr = sum( indicator[func][i] * functions[func][i][1]
                          for func in functions for i in range(len(functions[func])) )

# Introduce an auxiliary variable for area deviation: deviation = |total_area - target_area|
dev = model.NewIntVar(0, 1000000, 'deviation')
model.Add(dev >= total_area_expr - target_area)
model.Add(dev >= target_area - total_area_expr)

# We want to primarily minimize latency and secondarily the area deviation.
# We use a weighted sum objective with a large weight for latency.
lambda_weight = 100000  # weight for latency deviation
model.Minimize(total_latency_expr * lambda_weight + dev)

# Solve the model.
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    config = {}
    print("Solution:")
    for func in functions:
        opt = solver.Value(choices[func])
        config[func] = opt
        print(f"{func}: option {opt}, area={functions[func][opt][0]/10.0}, latency={functions[func][opt][1]/10.0}")
    total_area_val = solver.Value(total_area_expr)
    total_latency_val = solver.Value(total_latency_expr)
    print(f"Total area = {total_area_val/10.0}")
    print(f"Total latency = {total_latency_val/10.0}")
    print(f"Area deviation = {abs(total_area_val - target_area)/10.0}")
else:
    print("No solution found.")
'''
