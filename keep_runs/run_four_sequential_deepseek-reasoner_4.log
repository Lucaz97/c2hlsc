int even_sum(int n) {
    if(n <= 2) return 0;
    
    // Bitmask method for largest even < n
    int m = (n - 1) & ~1;
    // Optimized formula decomposition
    int half_m = m >> 1;
    #pragma HLS RESOURCE variable=half_m core=AddSub
    
    // Split multiplication into optimized operations
    return half_m * half_m + half_m;
}
```

