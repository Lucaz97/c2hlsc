update_latencies = [83.0, 84.0, 84.0, 84.0, 84.0]

model = cp_model.CpModel()
t = model.NewIntVar(0, 4, 'transform')
u = model.NewIntVar(0, 4, 'update')

# Create element constraints for area and latency
t_area = model.NewIntVar(0, 100000, 't_area')
model.AddElement(t, [int(a*10) for a in transform_areas], t_area)

u_area = model.NewIntVar(0, 100000, 'u_area')
model.AddElement(u, [int(a*10) for a in update_areas], u_area)

total_area = model.NewIntVar(0, 200000, 'total_area')
model.Add(total_area == t_area + u_area)

t_latency = model.NewIntVar(0, 1000, 't_latency')
model.AddElement(t, [int(l) for l in transform_latencies], t_latency)

u_latency = model.NewIntVar(0, 1000, 'u_latency')
model.AddElement(u, [int(l) for l in update_latencies], u_latency)

total_latency = model.NewIntVar(0, 1000, 'total_latency')
model.Add(total_latency == t_latency + u_latency)

diff = model.NewIntVar(0, 200000, 'diff')
model.AddAbsEquality(diff, total_area - int(70000*10))

model.Minimize(diff * 1000 + total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f"Optimal: transform {solver.Value(t)}, update {solver.Value(u)}, "
          f"area {(solver.Value(t_area) + solver.Value(u_area))/10}, "
