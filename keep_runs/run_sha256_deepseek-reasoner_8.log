from ortools.sat.python import cp_model

transform_options = [
    {'area': 34078.8, 'latency': 80.0},
    {'area': 34078.8, 'latency': 80.0},
    {'area': 34078.8, 'latency': 80.0},
    {'area': 35724.6, 'latency': 96.0},
    {'area': 34082.3, 'latency': 80.0}
]

update_options = [
    {'area': 41794.1, 'latency': 83.0},
    {'area': 41461.4, 'latency': 84.0},
    {'area': 41894.0, 'latency': 84.0},
    {'area': 41461.4, 'latency': 84.0},
    {'area': 41461.4, 'latency': 84.0}
]

target = 70000

model = cp_model.CpModel()

t = model.NewIntVar(0, 4, 'transform')
u = model.NewIntVar(0, 4, 'update')

area = model.NewIntVar(0, 200000, 'area')
model.Add(area == transform_options[t]['area'] + update_options[u]['area'])

latency = model.NewIntVar(0, 1000, 'latency')
model.Add(latency == transform_options[t]['latency'] + update_options[u]['latency'])

diff = model.NewIntVar(0, 200000, 'diff')
model.AddAbsEquality(diff, area - target)

model.Minimize(diff * 1000 + latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f"Optimal: transform {solver.Value(t)}, update {solver.Value(u)}, "
          f"area {solver.Value(area)}, latency {solver.Value(latency)}")
else:
    print("No solution found")
