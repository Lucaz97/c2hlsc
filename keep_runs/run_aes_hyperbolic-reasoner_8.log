from ortools.sat.python import cp_model

# Functions and their call counts
functions = {
    'AddRoundKey_hls': {'calls': 3, 'options': [
        {'area': 752.6, 'latency': 34},
        {'area': 752.6, 'latency': 34},
        {'area': 1816.7, 'latency': 49},
        {'area': 752.6, 'latency': 34},
        {'area': 752.6, 'latency': 34}
    ]},
    'SubBytes_hls': {'calls': 1, 'options': [
        {'area': 826.5, 'latency': 33},
        {'area': 825.9, 'latency': 33},
        {'area': 825.9, 'latency': 33},
        {'area': 825.9, 'latency': 33},
        {'area': 825.9, 'latency': 33}
    ]},
    'ShiftRows_hls': {'calls': 1, 'options': [
        {'area': 23.9, 'latency': 0},
        {'area': 23.9, 'latency': 0},
        {'area': 23.9, 'latency': 0},
        {'area': 23.9, 'latency': 0},
        {'area': 23.9, 'latency': 0}
    ]},
    'xtime': {'calls': 4, 'options': [
        {'area': 77.0, 'latency': 1},
        {'area': 77.0, 'latency': 1},
        {'area': 77.0, 'latency': 1},
        {'area': 77.0, 'latency': 1},
        {'area': 77.0, 'latency': 1}
    ]},
    'MixColumns_hls': {'calls': 1, 'options': [
        {'area': 635.9, 'latency': 6},
        {'area': 635.9, 'latency': 6},
        {'area': 635.9, 'latency': 6},
        {'area': 635.9, 'latency': 6},
        {'area': 635.9, 'latency': 6}
    ]},
    'Cipher_hls': {'calls': 1, 'options': [
        {'area': 2632.8, 'latency': 1091},
        {'area': 3685.5, 'latency': 1011},
        {'area': 2632.8, 'latency': 1091},
        {'area': 3685.5, 'latency': 1011},
        {'area': 2665.5, 'latency': 1029}
    ]}
}

model = cp_model.CpModel()

# Variables: option index for each function
vars = {}
for func in functions:
    vars[func] = model.NewIntVar(0, len(functions[func]['options'])-1, func)

# Total area and latency expressions
total_area = 0
total_latency = 0
for func in functions:
    calls = functions[func]['calls']
    options = functions[func]['options']
    for idx, opt in enumerate(options):
        # Add area contribution
        area = opt['area'] * calls
        total_area += model.NewIntVar(0, int(area), f'area_{func}_{idx}') * (vars[func] == idx)
        # Add latency contribution
        latency = opt['latency'] * calls
        total_latency += model.NewIntVar(0, int(latency), f'latency_{func}_{idx}') * (vars[func] == idx)

# Target area: 10000, allow some flexibility
target_area = 10000
tolerance = 500  # Adjust as needed
model.Add(total_area >= target_area - tolerance)
model.Add(total_area <= target_area + tolerance)

# Minimize total latency
model.Minimize(total_latency)

# Solve
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal solution found:")
    for func in functions:
        opt_idx = solver.Value(vars[func])
        print(f"{func}: option {opt_idx} (area: {functions[func]['options'][opt_idx]['area']}, latency: {functions[func]['options'][opt_idx]['latency']})")
    print(f"Total area: {solver.Value(total_area)}")
    print(f"Total latency: {solver.Value(total_latency)}")
else:
    print("No solution found.")
'''

