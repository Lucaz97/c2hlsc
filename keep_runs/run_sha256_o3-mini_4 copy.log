from ortools.sat.python import cp_model

# Options for sha256_transform_hls: index: (area, latency, throughput)
# Note: options 0,1,3,4 are identical.
transform_options = {
    0: (33382.7, 65.0, 67.0),
    1: (33382.7, 65.0, 67.0),
    2: (35576.5, 65.0, 67.0),
    3: (33382.7, 65.0, 67.0),
    4: (33382.7, 65.0, 67.0)
}

# Options for sha256_update_hls: index: (area, latency, throughput)
update_options = {
    0: (37553.5, 68.0, 70.0),
    1: (42773.7, 266.0, 270.0),
    2: (37846.5, 68.0, 70.0),
    3: (38479.4, 68.0, 70.0),
    4: (47480.7, 266.0, 268.0)
}

# Our goal is to minimize total latency and have total area as close as possible to 70000.
# For simplicity we assume that total latency is the sum of isolated function latencies.
# (In synthesis reports, overall latency seems imposed by the parent, but we use this model.)
# We use a weighted objective: primary objective is to minimize latency, secondary is to minimize the distance of area from target

target_area = 70000.0

model = cp_model.CpModel()

# Decision variables: choose one option per function
t = model.NewIntVar(0, 4, 't')  # for sha256_transform_hls
u = model.NewIntVar(0, 4, 'u')  # for sha256_update_hls

# Because our options are continuous values, we precompute latency and area for each choice.
# We'll use lists to index each option.
transform_latency = [int(round(transform_options[i][1]*100)) for i in range(5)]  # scaled to integer
transform_area    = [int(round(transform_options[i][0]*10)) for i in range(5)]    # scaled to integer

update_latency = [int(round(update_options[i][1]*100)) for i in range(5)]
update_area    = [int(round(update_options[i][0]*10)) for i in range(5)]

# Compute total latency and total area based on decisions.
# We use element constraints.
total_latency = model.NewIntVar(0, 10000, 'total_latency')
total_area = model.NewIntVar(0, 1000000, 'total_area')

model.AddElement(t, transform_latency, total_latency_part := model.NewIntVar(0, 10000, 'lat_part'))
model.AddElement(u, update_latency, total_latency_update := model.NewIntVar(0, 10000, 'lat_update'))
model.Add(total_latency, total_latency_part + total_latency_update)
# Similarly for area:
model.AddElement(t, transform_area, total_area_part := model.NewIntVar(0, 1000000, 'area_part'))
model.AddElement(u, update_area, total_area_update := model.NewIntVar(0, 1000000, 'area_update'))
model.Add(total_area, total_area_part + total_area_update)

# Our primary objective is to minimize total_latency.
# Our secondary objective is to minimize the absolute difference of total_area from target_area.
# Because CP-SAT does not handle absolute values directly in objective, we introduce an auxiliary variable.

# Scale target_area similarly: target_area *10.
target_area_scaled = int(round(target_area*10))

area_diff = model.NewIntVar(0, 1000000, 'area_diff')
# To model absolute value: area_diff >= total_area - target_area_scaled and area_diff >= target_area_scaled - total_area.
model.Add(total_area - target_area_scaled <= area_diff)
model.Add(target_area_scaled - total_area <= area_diff)

# We combine objectives with a weighted sum:
# Since latency is critical, we multiply latency by a high weight.
# Our objective function: minimize (W * total_latency + area_diff)
W = 1000
model.Minimize(W * total_latency + area_diff)

# Exclude already explored configurations.
# Already tried combinations (t, u): (0,0), (0,1), (0,2), (0,3),
# (1,0), (1,2), (1,3), (1,4),
# (2,0), (2,1), (2,2), (2,3), (2,4),
# (3,0), (3,1), (3,2), (3,4),
# (4,0), (4,1), (4,2), (0,4), (3,4) 
# (Some are repeated due to identical transform options.)
tried = {(0,0), (0,1), (0,2), (0,3),
         (1,0), (1,2), (1,3), (1,4),
         (2,0), (2,1), (2,2), (2,3), (2,4),
         (3,0), (3,1), (3,2), (3,4),
         (4,0), (4,1), (4,2), (4,3), (4,4)}
# We'll add constraints to exclude these tuples.
for (tt, uu) in tried:
    # Enforce: not (t == tt and u == uu)
    b = model.NewBoolVar('')
    model.Add(t == tt).OnlyEnforceIf(b)
    model.Add(t != tt).OnlyEnforceIf(b.Not())
    b2 = model.NewBoolVar('')
    model.Add(u == uu).OnlyEnforceIf(b2)
    model.Add(u != uu).OnlyEnforceIf(b2.Not())
    model.AddBoolAnd([b, b2]).OnlyEnforceIf(model.NewBoolVar('').Not())  # dummy; effectively, force exclusion.
    # Instead, add: (t != tt) OR (u != uu)
    model.AddBoolOr([t != tt, u != uu])

solver = cp_model.CpSolver()
status = solver.Solve(model)
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    chosen_t = solver.Value(t)
    chosen_u = solver.Value(u)
    tot_lat = solver.Value(total_latency) / 100.0
    tot_area = solver.Value(total_area) / 10.0
    diff_area = abs(tot_area - target_area)
    print("Best configuration:")
    print("sha256_transform_hls option", chosen_t, "with (area,latency,throughput):", transform_options[chosen_t])
    print("sha256_update_hls option", chosen_u, "with (area,latency,throughput):", update_options[chosen_u])
    print("Total estimated latency:", tot_lat)
    print("Total estimated area:", tot_area)
    print("Area difference from target:", diff_area)
else:
    print("No configuration found.")
'''
