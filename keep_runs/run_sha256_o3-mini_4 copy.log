    0: (37553.5, 68.0, 70.0),
    1: (42773.7, 266.0, 270.0),
    2: (37846.5, 68.0, 70.0),
    3: (38479.4, 68.0, 70.0),
    4: (47480.7, 266.0, 268.0)
}

target_area = 70000.0

model = cp_model.CpModel()

# Decision variables for function options
t = model.NewIntVar(0, 4, 't')  # sha256_transform_hls option
u = model.NewIntVar(0, 4, 'u')  # sha256_update_hls option

# Pre-scale latency and area values (latency scaled by 100, area by 10)
transform_latency = [int(round(transform_options[i][1] * 100)) for i in range(5)]
transform_area    = [int(round(transform_options[i][0] * 10)) for i in range(5)]
update_latency    = [int(round(update_options[i][1] * 100)) for i in range(5)]
update_area       = [int(round(update_options[i][0] * 10)) for i in range(5)]

# Create variables for selected latency and area of each function
lat_transform = model.NewIntVar(0, 10000, 'lat_transform')
lat_update    = model.NewIntVar(0, 10000, 'lat_update')
area_transform = model.NewIntVar(0, 1000000, 'area_transform')
area_update = model.NewIntVar(0, 1000000, 'area_update')

model.AddElement(t, transform_latency, lat_transform)
model.AddElement(t, transform_area, area_transform)
model.AddElement(u, update_latency, lat_update)
model.AddElement(u, update_area, area_update)

# Total latency and area
total_latency = model.NewIntVar(0, 10000, 'total_latency')
total_area = model.NewIntVar(0, 1000000, 'total_area')
model.Add(total_latency == lat_transform + lat_update)
model.Add(total_area == area_transform + area_update)

# Absolute area difference from target
target_area_scaled = int(round(target_area * 10))
area_diff = model.NewIntVar(0, 1000000, 'area_diff')
model.Add(total_area - target_area_scaled <= area_diff)
model.Add(target_area_scaled - total_area <= area_diff)

# Objective: primary minimize total latency (weighted heavily) and secondary minimize area difference
W = 1000
model.Minimize(W * total_latency + area_diff)

# Exclude already explored configurations.
tried = {(0,0), (0,1), (0,2), (0,3),
         (1,0), (1,2), (1,3), (1,4),
         (2,0), (2,1), (2,2), (2,3), (2,4),
         (3,0), (3,1), (3,2), (3,4),
         (4,0), (4,1), (4,2), (4,3), (4,4)}

for (tt, uu) in tried:
    # Create Boolean literals for equality checks
    b1 = model.NewBoolVar(f"eq_t_{tt}_{uu}")
    b2 = model.NewBoolVar(f"eq_u_{tt}_{uu}")
    model.Add(t == tt).OnlyEnforceIf(b1)
    model.Add(t != tt).OnlyEnforceIf(b1.Not())
    model.Add(u == uu).OnlyEnforceIf(b2)
    model.Add(u != uu).OnlyEnforceIf(b2.Not())
    # Exclude configuration: not(b1 and b2)
    model.AddBoolOr([b1.Not(), b2.Not()])

solver = cp_model.CpSolver()
status = solver.Solve(model)
if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    chosen_t = solver.Value(t)
    chosen_u = solver.Value(u)
    tot_lat = solver.Value(total_latency) / 100.0
    tot_area = solver.Value(total_area) / 10.0
    diff_area = abs(tot_area - target_area)
    print("Best configuration:")
    print("sha256_transform_hls option", chosen_t, "with (area, latency, throughput):", transform_options[chosen_t])
    print("sha256_update_hls option", chosen_u, "with (area, latency, throughput):", update_options[chosen_u])
    print("Total estimated latency:", tot_lat)
    print("Total estimated area:", tot_area)
    print("Area difference from target:", diff_area)
else:
    print("No configuration found.")
