from ortools.sat.python import cp_model

# Options for sha256_transform_hls: index: (area, latency, throughput)
transform_options = {
    0: (33382.7, 65.0, 67.0),
    1: (33382.7, 65.0, 67.0),
    2: (35576.5, 65.0, 67.0),
    3: (33382.7, 65.0, 67.0),
    4: (33382.7, 65.0, 67.0)
}

