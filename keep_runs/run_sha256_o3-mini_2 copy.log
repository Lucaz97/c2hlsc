python: '''
from ortools.sat.python import cp_model

# Data conversion: Multiply areas by 10 to convert to integer values.
# Using integer representation: area in tenths and latency as integer (already integer).
transform_options = [
    {"area": int(33382.7 * 10), "latency": 65},  # index 0
    {"area": int(33382.7 * 10), "latency": 65},  # index 1
    {"area": int(35576.5 * 10), "latency": 65},  # index 2
    {"area": int(33382.7 * 10), "latency": 65},  # index 3
    {"area": int(33382.7 * 10), "latency": 65}   # index 4
]

update_options = [
    {"area": int(37553.5 * 10), "latency": 68},   # index 0
    {"area": int(42773.7 * 10), "latency": 266},   # index 1
    {"area": int(37846.5 * 10), "latency": 68},    # index 2
    {"area": int(38479.4 * 10), "latency": 68},    # index 3
    {"area": int(47480.7 * 10), "latency": 266}    # index 4
]

# Targets
target_area = int(70000 * 10)  # 700000 in our scale

model = cp_model.CpModel()

# Decision variables: indices for transform and update options, domain 0 to 4.
t = model.NewIntVar(0, 4, 't')
u = model.NewIntVar(0, 4, 'u')

# Create lists of constants for area and latency for transform and update.
transform_area = [opt["area"] for opt in transform_options]
transform_latency = [opt["latency"] for opt in transform_options]
update_area = [opt["area"] for opt in update_options]
update_latency = [opt["latency"] for opt in update_options]

# Create model variables for chosen area and latency via element constraints.
t_area = model.NewIntVar(min(transform_area), max(transform_area), 't_area')
model.AddElement(t, transform_area, t_area)

t_latency = model.NewIntVar(min(transform_latency), max(transform_latency), 't_latency')
model.AddElement(t, transform_latency, t_latency)

u_area = model.NewIntVar(min(update_area), max(update_area), 'u_area')
model.AddElement(u, update_area, u_area)

u_latency = model.NewIntVar(min(update_latency), max(update_latency), 'u_latency')
model.AddElement(u, update_latency, u_latency)

# Compute total latency and total area.
total_latency = model.NewIntVar(0, 1000, 'total_latency')
model.Add(total_latency == t_latency + u_latency)

total_area = model.NewIntVar(0, 10000000, 'total_area')
model.Add(total_area == t_area + u_area)

# Compute absolute difference from target area.
area_diff = model.NewIntVar(0, 10000000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - target_area)

# Define objective: prioritize latency then area difference.
# Scale latency heavily so that any latency difference outweighs area diff.
scale_factor = 1000000
objective = model.NewIntVar(0, 1000000000, 'objective')
model.Add(objective == total_latency * scale_factor + area_diff)
model.Minimize(objective)

# Solve the model.
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    best_t = solver.Value(t)
    best_u = solver.Value(u)
    best_latency = solver.Value(total_latency)
    best_area = solver.Value(total_area)
    best_area_diff = abs(best_area - target_area)
    print("Best solution:")
    print("sha256_transform_hls option:", best_t)
    print("sha256_update_hls option:", best_u)
    print("Total latency:", best_latency)
    # Convert area back to float
    print("Total area:", best_area / 10.0)
    print("Difference from target area:", best_area_diff / 10.0)
else:
    print("No solution found.")
'''
