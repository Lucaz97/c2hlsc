        // Compute temporary values in a staged manner.
        t1 = k[i] + m[i] + ep1_e + ch_efg + h;
        t2 = ep0_a + maj_abc;

        // Update the working variables in order.
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }

    // Update the hash state.
    state[0] += a;
    state[1] += b;
    state[2] += c;
    state[3] += d;
    state[4] += e;
    state[5] += f;
    state[6] += g;
    state[7] += h;
}

void sha256_transform(state_t *state, data_t data[])
{
    sha256_transform_hls(*state, data[0]);
}
