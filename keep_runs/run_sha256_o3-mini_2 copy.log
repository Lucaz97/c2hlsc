void sha256_transform_hls(unsigned int state[8], unsigned char data[64])
{
    unsigned int a, b, c, d, e, f, g, h;
    unsigned int t1, t2;
    // Local message schedule array.
    unsigned int m[64];
    // Fully partition the m array so that dependent accesses can occur in the same cycle.
    #pragma HLS array_partition variable=m complete

    // Initialize working variables with current hash state.
    a = state[0];
    b = state[1];
    c = state[2];
    d = state[3];
    e = state[4];
    f = state[5];
    g = state[6];
    h = state[7];

    // Merge the message schedule computation and the compression loop into a single pipelined loop.
    // For i < 16 the word is converted from the input data.
    // For i >= 16 the word is computed based on previous words.
    #pragma hls_pipeline_init_interval 1
    for (unsigned int i = 0; i < 64; i++)
    {
        if (i < 16)
            m[i] = (data[4 * i] << 24) | (data[4 * i + 1] << 16) | (data[4 * i + 2] << 8) | data[4 * i + 3];
        else
            m[i] = SIG1(m[i - 2]) + m[i - 7] + SIG0(m[i - 15]) + m[i - 16];

        t1 = h + EP1(e) + CH(e, f, g) + k[i] + m[i];
        t2 = EP0(a) + MAJ(a, b, c);
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }

    // Update the state with the results from this transform.
    state[0] += a;
    state[1] += b;
    state[2] += c;
    state[3] += d;
    state[4] += e;
    state[5] += f;
    state[6] += g;
    state[7] += h;
}

void sha256_transform(state_t *state, data_t data[])
{
    sha256_transform_hls(*state, data[0]);
}
