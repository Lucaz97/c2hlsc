  present_key_t newKey;
  unsigned char i;
  unsigned char j;
  copyKey_hls(suppliedKey, key);
  
  block_t tempBlock;
  #pragma hls_unroll yes
  for (int k = 0; k < PRESENT_BLOCK_SIZE_BYTES; k++) {
    tempBlock[k] = key[k];
  }
  copyBlock_hls(tempBlock, keys[0]);
  
