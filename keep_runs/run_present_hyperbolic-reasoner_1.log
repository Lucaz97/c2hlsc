    unsigned char updated_key_7 = newKey[7] ^ (i >> 1);
    
    // Phase 3: Final key assembly
    FINAL_KEY: for(int k = 0; k < PRESENT_80_KEY_SIZE_BYTES; k++) {
      #pragma HLS unroll
      key[k] = (k == 0) ? transformed_key_0 : 
