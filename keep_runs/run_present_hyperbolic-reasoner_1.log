void generateRoundKeys80_hls(unsigned char suppliedKey[PRESENT_80_KEY_SIZE_BYTES], unsigned char keys[ROUNDS][ROUND_KEY_SIZE_BYTES])
{
  #pragma HLS array_partition variable=keys complete dim=2
  unsigned char key[PRESENT_80_KEY_SIZE_BYTES];
  #pragma HLS array_partition variable=key complete
  unsigned char newKey[PRESENT_80_KEY_SIZE_BYTES];
  #pragma HLS array_partition variable=newKey complete

  // Parallel key initialization
  key[0] = suppliedKey[0]; key[1] = suppliedKey[1]; key[2] = suppliedKey[2];
  key[3] = suppliedKey[3]; key[4] = suppliedKey[4]; key[5] = suppliedKey[5];
  key[6] = suppliedKey[6]; key[7] = suppliedKey[7]; key[8] = suppliedKey[8];
  key[9] = suppliedKey[9];

  // Direct parallel write of initial key
  keys[0][0] = key[0]; keys[0][1] = key[1]; keys[0][2] = key[2]; keys[0][3] = key[3];
  keys[0][4] = key[4]; keys[0][5] = key[5]; keys[0][6] = key[6]; keys[0][7] = key[7];

  KEY_GEN_LOOP: for (unsigned char i = 1; i < 32; i++) {
    #pragma HLS pipeline II=1
    
    // Phase 1: Parallel rotation without temporary array
    const unsigned char k0 = (key[7] << 5) | (key[8] >> 3);
    const unsigned char k1 = (key[8] << 5) | (key[9] >> 3);
    const unsigned char k2 = (key[9] << 5) | (key[0] >> 3);
    const unsigned char k3 = (key[0] << 5) | (key[1] >> 3);
    const unsigned char k4 = (key[1] << 5) | (key[2] >> 3);
    const unsigned char k5 = (key[2] << 5) | (key[3] >> 3);
    const unsigned char k6 = (key[3] << 5) | (key[4] >> 3);
    const unsigned char k7 = (key[4] << 5) | (key[5] >> 3);
    const unsigned char k8 = (key[5] << 5) | (key[6] >> 3);
    const unsigned char k9 = (key[6] << 5) | (key[7] >> 3);

    // Phase 2: Direct parallel transformation and update
    key[0] = (sBox[k0 >> 4] << 4) | (k0 & 0xF);
    key[1] = k1; key[2] = k2; key[3] = k3; key[4] = k4;
    key[5] = k5; key[6] = k6; 
    key[7] = k7 ^ (i >> 1);
    key[8] = k8 ^ (i << 7);
    key[9] = k9;

    // Phase 3: Direct parallel key storage
    keys[i][0] = key[0]; keys[i][1] = key[1]; keys[i][2] = key[2]; keys[i][3] = key[3];
    keys[i][4] = key[4]; keys[i][5] = key[5]; keys[i][6] = key[6]; keys[i][7] = key[7];
  }
}

void generateRoundKeys80(present_key_t *suppliedKey, keys_t *keys)
{
  generateRoundKeys80_hls(*suppliedKey, *keys);
}
