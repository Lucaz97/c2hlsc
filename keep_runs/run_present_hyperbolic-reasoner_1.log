void pLayer_hls(block_t block) {
  #pragma HLS ARRAY_PARTITION variable=block complete
  block_t initial;
  #pragma HLS ARRAY_PARTITION variable=initial complete
  
  copyBlock_hls(block, initial);

  for (unsigned char i = 0; i < 8; i++) {
    #pragma HLS UNROLL yes
    const unsigned char base = 4 * (i % 2);
    const unsigned char shift = 3 - (i >> 1);
    
    // Corrected bit mapping with proper shift-and-mask combination
    block[i] = 
      (((initial[base+3] >> shift)       & 0x01) << 0) |
      (((initial[base+3] >> (shift + 4)) & 0x01) << 1) |
      (((initial[base+2] >> shift)       & 0x01) << 2) |
