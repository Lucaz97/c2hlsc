{
  unsigned char key[PRESENT_80_KEY_SIZE_BYTES];
  #pragma HLS array_partition variable=key complete
  unsigned char newKey[PRESENT_80_KEY_SIZE_BYTES];
  #pragma HLS array_partition variable=newKey complete
  
