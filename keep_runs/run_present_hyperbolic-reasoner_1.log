    temp |= ((initial[(4*(i%2))+0] & (8 >> (i >> 1))) != 0) << 6;
    temp |= ((initial[(4*(i%2))+0] & (8 >> (i >> 1) << 4)) != 0) << 7;

    block[i] = temp;
  }
}

void pLayer(block_t *block) {
  pLayer_hls(*block);
}
