    (33382.7, 65.0, 67.0),  # option 0
    (35576.5, 65.0, 67.0),  # option 1
    (43155.2, 475.0, 477.0),# option 2
    (33382.7, 65.0, 67.0),  # option 3
    (33382.7, 65.0, 67.0)   # option 4
]

update_options = [
    (37894.0, 67.0, 70.0),   # option 0
    (37553.5, 68.0, 70.0),   # option 1
    (53610.6, 204.0, 206.0), # option 2
    (37846.5, 68.0, 70.0),   # option 3
    (54724.8, 204.0, 206.0)  # option 4
]

target_area = 70000.0

# Enumerate all possible combinations
results = []
for i, (a_t, lat_t, thr_t) in enumerate(transform_options):
    for j, (a_u, lat_u, thr_u) in enumerate(update_options):
        total_area = a_t + a_u
        total_latency = lat_t + lat_u  # Assuming sequential execution
        area_error = abs(total_area - target_area)
        results.append((i, j, total_area, total_latency, area_error))

# First, filter for combinations with the lowest latency (minimize latency)
min_latency = min(r[3] for r in results)
candidates = [r for r in results if r[3] == min_latency]

# From these, choose the one with area closest to target_area
best = min(candidates, key=lambda x: x[4])
best_transform_option, best_update_option, best_area, best_latency, best_area_error = best

print("Best configuration:")
print("sha256_transform_hls index:", best_transform_option)
print("sha256_update_hls index:", best_update_option)
print("Total area: {:.2f}".format(best_area))
