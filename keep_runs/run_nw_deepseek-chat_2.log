# Target area (scaled to integer)
target_area = int(9000 * SCALE)

# Create the model
model = cp_model.CpModel()

# Variables
option_vars = {}
for func, options in functions.items():
    option_vars[func] = model.NewIntVar(0, len(options) - 1, f"{func}_option")

# Area and latency expressions
total_area = 0
total_latency = 0
for func, options in functions.items():
    area_list = [int(option["area"] * SCALE) for option in options]
    latency_list = [int(option["latency"] * SCALE) for option in options]
    
    area = model.NewIntVar(0, max(area_list), f"{func}_area")
    latency = model.NewIntVar(0, max(latency_list), f"{func}_latency")
    
    model.AddElement(option_vars[func], area_list, area)
    model.AddElement(option_vars[func], latency_list, latency)
    
    total_area += area
    total_latency += latency

# Area constraint
model.Add(total_area <= target_area)

# Objective: minimize latency
model.Minimize(total_latency)

# Solve
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Optimal configuration found:")
    for func in functions:
        option = solver.Value(option_vars[func])
        print(f"{func}: option {option} (area: {functions[func][option]['area']}, latency: {functions[func][option]['latency']})")
else:
    print("No feasible solution found.")
