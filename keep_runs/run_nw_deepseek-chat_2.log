#include "../include/ac_float.h"
#include "../include/ac_fixed.h"
#include <stdint.h>


#include <stdio.h>

#define ALEN 16
#define BLEN 16

#define MATCH_SCORE 1
#define MISMATCH_SCORE -1
#define GAP_SCORE -1

#define ALIGN '\\'
#define SKIPA '^'
#define SKIPB '<'

#define MAX(A, B) (((A) > (B)) ? (A) : (B))

// fill_matrix option 1

void fill_matrix_hls(char seqA[16], char seqB[16], int M[16 + 1][16 + 1], char ptr[16 + 1][16 + 1])
{
  int score;
  int up_left;
  int up;
  int left;
  int max;
  int row;
  int row_up;
  int a_idx;
  int b_idx;

  // Initialize the first row and column of the matrix M
  for (a_idx = 0; a_idx < (16 + 1); a_idx++)
  {
    M[0][a_idx] = a_idx * (-1);
  }

  for (b_idx = 0; b_idx < (16 + 1); b_idx++)
  {
    M[b_idx][0] = b_idx * (-1);
  }

  // Fill the matrix without pragmas
  for (b_idx = 1; b_idx < (16 + 1); b_idx++)
  {
    for (a_idx = 1; a_idx < (16 + 1); a_idx++)
    {
      score = (seqA[a_idx - 1] == seqB[b_idx - 1]) ? MATCH_SCORE : MISMATCH_SCORE;
      row_up = b_idx - 1;
      row = b_idx;
      up_left = M[row_up][a_idx - 1] + score;
      up = M[row_up][a_idx] + GAP_SCORE;
      left = M[row][a_idx - 1] + GAP_SCORE;
      max = MAX(up_left, MAX(up, left));
      M[row][a_idx] = max;
      if (max == left)
      {
        ptr[row][a_idx] = SKIPB;
      }
      else if (max == up)
      {
        ptr[row][a_idx] = SKIPA;
      }
      else
      {
        ptr[row][a_idx] = ALIGN;
      }
    }
  }
}

void fill_matrix(char seqA[16], char seqB[16], int M[16 + 1][16 + 1], char ptr[16 + 1][16 + 1])
{
  fill_matrix_hls(seqA, seqB, M, ptr);
}
// reverse_string option 3

void reverse_string(char str[16 + 16], int length)
{
  int start = 0;
  int end = length - 1;
  #pragma hls_pipeline_init_interval 1
  #pragma hls_unroll factor=2
  while (start < end)
  {
    char temp = str[start];
    str[start] = str[end];
    str[end] = temp;
    start++;
    end--;
  }
}

