from ortools.sat.python import cp_model

# Function options data
functions = {
    "fill_matrix": [
        {"area": 2206.1, "latency": 1293.0},
        {"area": 2206.1, "latency": 1293.0},
        {"area": 2215.5, "latency": 1308.0},
        {"area": 2206.1, "latency": 1293.0},
        {"area": 2206.1, "latency": 1293.0},
    ],
    "reverse_string": [
        {"area": 2541.5, "latency": 1.0},
        {"area": 2541.5, "latency": 1.0},
        {"area": 2338.5, "latency": 1.0},
        {"area": 2338.5, "latency": 1.0},
        {"area": 2541.5, "latency": 1.0},
    ],
    "traceback": [
        {"area": 10612.2, "latency": 8.0},
        {"area": 10612.2, "latency": 8.0},
        {"area": 10612.2, "latency": 8.0},
        {"area": 10612.2, "latency": 8.0},
        {"area": 10612.2, "latency": 8.0},
    ],
    "needwun": [
        {"area": 12140.0, "latency": 1303.0},
        {"area": 12140.0, "latency": 1303.0},
        {"area": 12140.0, "latency": 1303.0},
        {"area": 12140.0, "latency": 1303.0},
        {"area": 12140.0, "latency": 1303.0},
    ],
}

# Target area
target_area = 6000

# Create the model
model = cp_model.CpModel()

# Variables
option_vars = {}
for func, options in functions.items():
    option_vars[func] = model.NewIntVar(0, len(options) - 1, f"{func}_option")

# Area constraint
total_area = sum(
    functions[func][option_vars[func]].area for func in functions
)
model.Add(total_area <= target_area)

# Objective: minimize latency
total_latency = sum(
    functions[func][option_vars[func]].latency for func in functions
)
model.Minimize(total_latency)

# Solve
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Optimal configuration found:")
    for func in functions:
        option = solver.Value(option_vars[func])
        print(f"{func}: option {option} (area: {functions[func][option].area}, latency: {functions[func][option].latency})")
else:
    print("No feasible solution found.")
'''
