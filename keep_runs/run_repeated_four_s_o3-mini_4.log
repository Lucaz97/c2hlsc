int fibonacci(int n)
{
    // Fast doubling algorithm for Fibonacci numbers:
    // Computes F(n) in O(log n) iterations.
    // This implementation is optimized for latency by fully unrolling the loop,
    // yielding a purely combinational chain (subject to clock constraints) for the iterative stage.
    //
    // Note: We assume n >= 0. For n==0 we return 0.
    //
    // The algorithm maintains a pair (a, b) such that initially:
    //    a = F(0) and b = F(1)
    // For each bit (from most-significant to least-significant) of n, we update:
    //     c = a*(2*b - a)
    //     d = a*a + b*b
    // and then:
    //     if the current bit of n is 1, then set a = d, b = c + d;
    //     else set a = c, b = d.
    // After processing all bits, 'a' holds F(n).
    
    if (n == 0)
      return 0;
      
    // Determine the most-significant bit (msb) position of 'n'
    int msb = 31;
    while (msb >= 0 && (((n >> msb) & 1) == 0))
    {
        msb--;
    }
    
    int a = 0;  // F(0)
    int b = 1;  // F(1)
    
    // Process each bit from msb down to 0.
    for (int i = msb; i >= 0; i--)
    {
        #pragma hls_unroll yes
        int c = a * (2 * b - a);  // = F(2k) if a=F(k), b=F(k+1)
        int d = a * a + b * b;    // = F(2k+1)
        
        if ((n >> i) & 1)
        {
            a = d;
            b = c + d;
        }
        else
        {
            a = c;
            b = d;
        }
    }
    
    return a;
}
