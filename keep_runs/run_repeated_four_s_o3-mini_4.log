{
    // Optimized fast-doubling algorithm for low latency with full loop unrolling.
    // This implementation iterates over a fixed 32-bit range to compute F(n) using
    // the fast-doubling formulas:
    //   c = a * (2*b - a)   => F(2k)
    //   d = a*a + b*b       => F(2k+1)
    // When the current bit of n is 1, update (a,b) as (d, c+d); otherwise update as (c,d).
    // The loop is unrolled fully to minimize latency. A flag "started" is used so that
    // the computations begin only when the first (most-significant) 1-bit is encountered.
    //
    // This guarantees that:
    //   fibonacci(4) returns 3
    //   fibonacci(5) returns 5
    //
    // For n==0, the function returns 0.
    if (n == 0)
        return 0;
    
    int a = 0;  // Will eventually hold F(n)
    int b = 1;  // Holds F(n+1)
    int started = 0;  // Flag to begin processing once the first 1-bit is seen

    // Loop over all 32 bits (for a 32-bit integer) from MSB to LSB.
    // The loop is unrolled completely to optimize latency.
    for (int i = 31; i >= 0; i--)
    {
        #pragma hls_unroll yes
        // Begin updates once we see the first '1'
        if (started || ((n >> i) & 1))
        {
            started = 1;
            int c = a * (2 * b - a);  // F(2k)
            int d = a * a + b * b;    // F(2k+1)
            
            if ((n >> i) & 1)
            {
                a = d;
                b = c + d;
            }
            else
            {
                a = c;
                b = d;
            }
        }
    }
    
    return a;
}
