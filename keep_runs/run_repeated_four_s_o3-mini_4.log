```c
int odd_factorial(int n)
{
  // This implementation uses a tree‐reduction method to compute the product of odd numbers.
  // It reduces the multiplication chain depth from O(n) to O(log n), thus reducing latency.
  // Note: An upper bound on n is assumed such that the number of factors fits into the fixed array.
  int factors[64]; // supports up to 127 as n; adjust size as needed
  int count = 0;

  // Populate the factor array with odd numbers in the range [1, n)
  odd_fill: for (int i = 1; i < n; i += 2) {
    #pragma hls_unroll yes
    factors[count] = i;
    count++;
  }
  
  // Perform a tree reduction on the factors.
  // Instead of a long chain of multiplications, we multiply pairwise in parallel.
  while (count > 1) {
    int new_count = (count + 1) >> 1; // equivalent to (count+1)/2
    odd_tree: for (int i = 0; i < (count >> 1); i++) {
      #pragma hls_unroll yes
      factors[i] = factors[2*i] * factors[2*i+1];
    }
    // If there's an odd element, carry it forward.
    if (count & 1) {
      factors[new_count - 1] = factors[count - 1];
    }
    count = new_count;
  }
  
  return factors[0];
}
```
