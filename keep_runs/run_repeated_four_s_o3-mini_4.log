{
    // Optimized fast-doubling algorithm using an iterative approach
    // and targeting low latency via pipelined loops.
    //
    // This version computes F(n) with the convention:
    //   F(0)=0, F(1)=1, F(2)=1, F(3)=2, F(4)=3, F(5)=5, etc.
    //
    // The iterative fast-doubling algorithm uses the recurrences:
    //   c = a * (2*b - a)      --> F(2k)
    //   d = a*a + b*b          --> F(2k+1)
    // and then, for each bit of n (except the most-significant one), 
    // it updates:
    //   if (bit == 1):  a = d, b = c+d;
    //   else:           a = c, b = d;
    //
    // Here we initialize the doubling pair as (a, b) = (1, 1) 
    // which corresponds to (F(1), F(2)).
    // Then we iterate over the remaining bits (from msb-1 downto 0).
    //
    // For example:
    //   n = 4 (binary 100) => msb = 2, iterating i = 1, 0:
    //     i = 1, bit = 0  -> (a, b) becomes (1, 2)
    //     i = 0, bit = 0  -> (a, b) becomes (3, 5)
    //   Result: fibonacci(4) returns 3.
    // Similarly, n = 5 (binary 101) returns 5.
    
    if (n == 0)
        return 0;
    if (n == 1)
        return 1;
        
    // Determine the position of the most-significant 1-bit in n.
    int msb = 31;
    while (msb >= 0 && (((n >> msb) & 1) == 0))
        msb--;
    
    // Initialize the doubling pair to (F(1), F(2)) = (1, 1).
    int a = 1;
    int b = 1;
    
    // Process bits from msb-1 downto 0.
    // This loop is pipelined to optimize latency.
    for (int i = msb - 1; i >= 0; i--)
    {
        #pragma hls_pipeline_init_interval 1
        int c = a * (2 * b - a);  // Computes F(2k)
        int d = a * a + b * b;    // Computes F(2k+1)
        
        if ((n >> i) & 1)
        {
            a = d;       // For bit == 1: new a = F(2k+1)
            b = c + d;   // new b = F(2k+2)
        }
        else
        {
            a = c;       // For bit == 0: new a = F(2k)
            b = d;       // new b = F(2k+1)
        }
    }
    
    return a;
}
