int fibonacci(int n)
{
  // This optimized version computes two iterations per loop cycle
  // to reduce the overall latency by decreasing the sequential loop iterations.
  // Note: The original loop iterates (n-2) times. When (n-2) is even, the final
  // Fibonacci value is held in variable b; when odd it is held in variable c.
  //
  // Assumes n > 2.
  
  int a = 0;
  int b = 1;
  int c = 0; // temporary result (will hold F(n-1) if (n-2) is odd)
  int d;
  int i = 2;
  
  // Process two Fibonacci steps per iteration.
  // Loop runs while at least two iterations remain.
  for (; i < n - 1; i += 2)
  {
    #pragma hls_pipeline_init_interval 1
    c = a + b;  // computes F(i)
    d = b + c;  // computes F(i+1)
    a = c;
    b = d;
  }
  
  // Handle a leftover iteration if (n-2) is odd.
  if (i < n)
  {
    #pragma hls_pipeline_init_interval 1
    c = a + b;  // computes the final Fibonacci number
    b = c;
  }
  
  // Return the result:
  // If (n-2) is even, the last computed Fibonacci value is in 'b'.
  // If (n-2) is odd, it is in 'c'.
  if (((n - 2) & 1) == 0) // even: (n-2)%2==0
    return b;
  else
    return c;
}
