python: '''
from ortools.sat.python import cp_model

model = cp_model.CpModel()

# Fixed parameters for options.
# Transform options: index 0,1,3,4 have same area and latency; index 2 is unique.
transform_area = [33383, 33383, 35577, 33383, 33383]  # rounded values
transform_latency = [65, 65, 65, 65, 65]

# Update options:
update_area = [37554, 42774, 37847, 38479, 47481]  # rounded values
update_latency = [68, 266, 68, 68, 266]

target_area = 70000

# Decision variables: which option to choose.
t = model.NewIntVar(0, 4, 't')
u = model.NewIntVar(0, 4, 'u')

# Create arrays for areas and latencies.
# We use element constraints since our CP-SAT solver supports them.
transform_area_const = transform_area
update_area_const = update_area
transform_latency_const = transform_latency
update_latency_const = update_latency

# Define variables for the chosen area and latency.
t_area = model.NewIntVar(0, 100000, 't_area')
u_area = model.NewIntVar(0, 100000, 'u_area')
t_latency = model.NewIntVar(0, 1000, 't_latency')
u_latency = model.NewIntVar(0, 1000, 'u_latency')

model.AddElement(t, transform_area_const, t_area)
model.AddElement(u, update_area_const, u_area)
model.AddElement(t, transform_latency_const, t_latency)
model.AddElement(u, update_latency_const, u_latency)

# Total area as the sum
total_area = model.NewIntVar(0, 200000, 'total_area')
model.Add(total_area == t_area + u_area)

# We want to minimize the difference from the target area.
# Also add a penalty for high update latency.
# Define binary indicator for high update latency (i.e. if update_latency > 68, then penalty)
high_latency = model.NewBoolVar('high_latency')
model.Add(u_latency > 68).OnlyEnforceIf(high_latency)
model.Add(u_latency <= 68).OnlyEnforceIf(high_latency.Not())

# Use a penalty constant.
penalty = 5000

# The objective is to minimize diff = |total_area - target_area| + penalty * high_latency.
# CP-SAT doesn't support absolute values directly, so we linearize.
diff = model.NewIntVar(0, 200000, 'diff')
model.Add(diff >= total_area - target_area)
model.Add(diff >= target_area - total_area)

# Linear objective: diff + penalty * high_latency.
# Since high_latency is BoolVar, we convert it to integer.
model.Minimize(diff + penalty * high_latency)

solver = cp_model.CpSolver()
solver.parameters.max_time_in_seconds = 10.0

status = solver.Solve(model)

if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    chosen_t = solver.Value(t)
    chosen_u = solver.Value(u)
    chosen_area = solver.Value(total_area)
    chosen_diff = solver.Value(diff)
    chosen_high = solver.Value(high_latency)
    print("Optimal configuration (OR-Tools):")
    print("sha256_transform_hls option:", chosen_t)
    print("sha256_update_hls option:", chosen_u)
    print("Estimated total area:", chosen_area)
    print("Area diff from target:", chosen_diff)
    print("High latency update penalty applied:" , bool(chosen_high))
else:
    print("No feasible solution found.")
'''
