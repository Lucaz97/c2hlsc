from ortools.sat.python import cp_model

model = cp_model.CpModel()

# Define options for sha256_transform_hls
transform_options = [
    {"option": 0, "area": 33383, "latency": 65},
    {"option": 1, "area": 33383, "latency": 65},
    {"option": 2, "area": 35577, "latency": 65},
    {"option": 3, "area": 33383, "latency": 65},
    {"option": 4, "area": 33383, "latency": 65},
]

# Define options for sha256_update_hls
update_options = [
    {"option": 0, "area": 37554, "latency": 68},
    {"option": 1, "area": 42774, "latency": 266},
    {"option": 2, "area": 37847, "latency": 68},
    {"option": 3, "area": 38479, "latency": 68},
    {"option": 4, "area": 47481, "latency": 266},
]

target_area = 70000

# Decision variables for selecting options (indices)
t = model.NewIntVar(0, 4, 't')
u = model.NewIntVar(0, 4, 'u')

# Arrays for area and latency values
transform_area_list = [opt["area"] for opt in transform_options]
update_area_list    = [opt["area"] for opt in update_options]
transform_latency_list = [opt["latency"] for opt in transform_options]
update_latency_list    = [opt["latency"] for opt in update_options]

# Variables for selected area and latency values using Element constraint
t_area = model.NewIntVar(0, 100000, 't_area')
u_area = model.NewIntVar(0, 100000, 'u_area')
t_latency = model.NewIntVar(0, 1000, 't_latency')
u_latency = model.NewIntVar(0, 1000, 'u_latency')

model.AddElement(t, transform_area_list, t_area)
model.AddElement(u, update_area_list, u_area)
model.AddElement(t, transform_latency_list, t_latency)
model.AddElement(u, update_latency_list, u_latency)

# Define total area as sum of the selected areas
total_area = model.NewIntVar(0, 200000, 'total_area')
model.Add(total_area == t_area + u_area)

# Calculate absolute difference from target area
area_diff = model.NewIntVar(0, 200000, 'area_diff')
model.Add(area_diff >= total_area - target_area)
model.Add(area_diff >= target_area - total_area)

# Create a Boolean variable for low-latency update option (68 cycles)
is_low_latency = model.NewBoolVar('is_low_latency')
