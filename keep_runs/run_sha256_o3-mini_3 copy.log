python: '''
from ortools.sat.python import cp_model

model = cp_model.CpModel()

# Define options for transform and update with rounded area values (in units)
transform_options = [
    {"option": 0, "area": 33383, "latency": 65},
    {"option": 1, "area": 33383, "latency": 65},
    {"option": 2, "area": 35577, "latency": 65},
    {"option": 3, "area": 33383, "latency": 65},
    {"option": 4, "area": 33383, "latency": 65},
]

update_options = [
    {"option": 0, "area": 37554, "latency": 68},
    {"option": 1, "area": 42774, "latency": 266},
    {"option": 2, "area": 37847, "latency": 68},
    {"option": 3, "area": 38479, "latency": 68},
    {"option": 4, "area": 47481, "latency": 266},
]

target_area = 70000

# Decision variables for selecting options
t = model.NewIntVar(0, 4, 't')
u = model.NewIntVar(0, 4, 'u')

# Constants arrays
transform_area_const = [opt["area"] for opt in transform_options]
update_area_const    = [opt["area"] for opt in update_options]
transform_latency_const = [opt["latency"] for opt in transform_options]
update_latency_const    = [opt["latency"] for opt in update_options]

# Variables for the selected areas and latencies
t_area = model.NewIntVar(0, 100000, 't_area')
u_area = model.NewIntVar(0, 100000, 'u_area')
t_latency = model.NewIntVar(0, 1000, 't_latency')
u_latency = model.NewIntVar(0, 1000, 'u_latency')

model.AddElement(t, transform_area_const, t_area)
model.AddElement(u, update_area_const, u_area)
model.AddElement(t, transform_latency_const, t_latency)
model.AddElement(u, update_latency_const, u_latency)

# Total isolated area estimate
total_area = model.NewIntVar(0, 200000, 'total_area')
model.Add(total_area == t_area + u_area)

# Compute the absolute difference from the target area
diff = model.NewIntVar(0, 200000, 'diff')
model.Add(diff >= total_area - target_area)
model.Add(diff >= target_area - total_area)

# Now, favor configurations with high update latency (which in synthesis seem to reduce area)
# Create a Boolean variable that is true when update latency is low (i.e. 68) 
low_latency = model.NewBoolVar('low_latency')
model.Add(u_latency == 68).OnlyEnforceIf(low_latency)
model.Add(u_latency != 68).OnlyEnforceIf(low_latency.Not())

# Apply a penalty for low latency update option to favor high latency options.
penalty = 5000
model.Minimize(diff + penalty * low_latency)

solver = cp_model.CpSolver()
solver.parameters.max_time_in_seconds = 10.0
status = solver.Solve(model)

if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    print("Optimal configuration (OR-Tools):")
    print("sha256_transform_hls option:", solver.Value(t))
    print("sha256_update_hls option:", solver.Value(u))
    print("Estimated total area:", solver.Value(total_area))
    print("Area diff from target:", solver.Value(diff))
    print("Low latency penalty applied:", bool(solver.Value(low_latency)))
else:
    print("No feasible solution found.")
'''
