from ortools.sat.python import cp_model

# Define the available options for each function.
# We have two groups for sha256_transform_hls:
# For options 0,1,3,4: area = 33382.7, latency = 65, throughput = 67
# For option 2:         area = 35576.5, latency = 65, throughput = 67
transform_options = [
    {"option": 0, "area": 33382.7, "latency": 65},
    {"option": 1, "area": 33382.7, "latency": 65},
    {"option": 2, "area": 35576.5, "latency": 65},
    {"option": 3, "area": 33382.7, "latency": 65},
    {"option": 4, "area": 33382.7, "latency": 65},
]

# For sha256_update_hls, there are two groups:
# Low latency options (0,2,3): area, latency=68, throughput=70
# High latency options (1,4):   area, latency=266, throughput ~=269-270
update_options = [
    {"option": 0, "area": 37553.5, "latency": 68},
    {"option": 1, "area": 42773.7, "latency": 266},
    {"option": 2, "area": 37846.5, "latency": 68},
    {"option": 3, "area": 38479.4, "latency": 68},
    {"option": 4, "area": 47480.7, "latency": 266},
]

# Our target area.
target_area = 70000

# The overall design latency from synthesis appears fixed at 266
# for the valid configurations. In our simplified model,
# when using a low latency update option, the effective latency
# would be max(65,68)=68, whereas with a high latency update option it is 266.
# Since synthesis reports always yield 266, we treat latency as fixed.
# Thus, we focus on minimizing the absolute difference from the target area.

# We'll enumerate all combinations.
best_diff = None
best_combo = None

for t in transform_options:
    for u in update_options:
        # Calculate total area as sum of isolated areas.
        total_area = t["area"] + u["area"]
        diff = abs(total_area - target_area)
        # Also consider that low latency update is preferred.
        # We add a penalty if update latency is high.
        latency_penalty = 0
        if u["latency"] > 68:
            latency_penalty = 10000  # arbitrary penalty to favor low latency option.
        cost = diff + latency_penalty

        if best_diff is None or cost < best_diff:
            best_diff = cost
            best_combo = (t["option"], u["option"], total_area, u["latency"])

print("Optimal configuration (isolated estimation):")
print("sha256_transform_hls option:", best_combo[0])
print("sha256_update_hls option:", best_combo[1])
print("Estimated total area:", best_combo[2])
print("Update latency:", best_combo[3])
'''
