latency_generateRoundKeys80 = model.NewIntVar(0, 1000000, 'latency_generateRoundKeys80')
model.AddElement(generateRoundKeys80, generateRoundKeys80_latency, latency_generateRoundKeys80)

# Latency for generateRoundKeys80 branch: its own latency plus 2*(copyKey latency) + 2*(copyBlock_gen latency)
latency_gen = model.NewIntVar(0, 1000000, 'latency_gen')
