# Use a weighted sum with high weight for latency.
weight = 1000000
max_objective = 10**14
objective = model.NewIntVar(0, max_objective, 'objective')
model.Add(objective == total_latency * weight + area_deviation)
model.Minimize(objective)

# Optionally, set a time limit to help the solver.
solver = cp_model.CpSolver()
