latency_addRoundKey_1 = model.NewIntVar(0, 1000000, 'latency_addRoundKey_1')
model.AddElement(addRoundKey_1, addRoundKey_latency, latency_addRoundKey_1)

latency_addRoundKey_2 = model.NewIntVar(0, 1000000, 'latency_addRoundKey_2')
model.AddElement(addRoundKey_2, addRoundKey_latency, latency_addRoundKey_2)

latency_present80 = model.NewIntVar(0, 1000000, 'latency_present80')
model.AddElement(present80, present80_latency, latency_present80)

# Total latency: sum along the execution chain.
total_latency = model.NewIntVar(0, 10000000, 'total_latency')
model.Add(total_latency == latency_present80 + latency_gen +
