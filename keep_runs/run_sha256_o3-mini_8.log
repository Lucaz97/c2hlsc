void sha256_transform_hls(unsigned int state[8], unsigned char data[64])
{
  unsigned int a, b, c, d, e, f, g, h;
  unsigned int t1, t2;
  unsigned int m[64];
  unsigned int i, j;

  // First loop: Fully unroll the first 16 iterations since each iteration is independent.
  #pragma hls_unroll yes
  for (i = 0, j = 0; i < 16; ++i, j += 4) {
    m[i] = ((unsigned int)data[j] << 24) |
           ((unsigned int)data[j + 1] << 16) |
           ((unsigned int)data[j + 2] << 8) |
           ((unsigned int)data[j + 3]);
  }

  // Second loop: Pipeline the message expansion loop.
  for (; i < 64; ++i) {
    #pragma hls_pipeline_init_interval 1
    m[i] = SIG1(m[i - 2]) + m[i - 7] + SIG0(m[i - 15]) + m[i - 16];
  }

  a = state[0];
  b = state[1];
  c = state[2];
  d = state[3];
  e = state[4];
  f = state[5];
  g = state[6];
  h = state[7];

  // Main round loop: Pipeline the loop and break down the arithmetic into smaller steps.
  for (i = 0; i < 64; ++i) {
    #pragma hls_pipeline_init_interval 1

    // Break down the t1 computation into smaller additions
    unsigned int s1 = EP1(e);
    unsigned int ch  = CH(e, f, g);
    unsigned int partial1 = h + s1;       // First stage
    unsigned int partial2 = partial1 + ch;  // Second stage
    unsigned int partial3 = partial2 + k[i];// Third stage
    t1 = partial3 + m[i];                 // Fourth stage

    // Break down the t2 computation as well
    unsigned int s0 = EP0(a);
    unsigned int maj = MAJ(a, b, c);
    t2 = s0 + maj;

    // Update working variables
    h = g;
    g = f;
    f = e;
    e = d + t1;
    d = c;
    c = b;
    b = a;
    a = t1 + t2;
  }

  // Final state update (the eight additions can be seen as parallel combinational updates)
  state[0] += a;
  state[1] += b;
  state[2] += c;
  state[3] += d;
  state[4] += e;
  state[5] += f;
  state[6] += g;
  state[7] += h;
}

void sha256_transform(unsigned int (*state)[8], unsigned char (*data)[64])
{
  sha256_transform_hls(*state, *data);
}
