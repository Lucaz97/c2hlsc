void sha256_transform_hls(unsigned int state[8], unsigned char data[64])
{
  unsigned int a, b, c, d, e, f, g, h;
  unsigned int t1, t2;
  unsigned int m[64];
  unsigned int i, j;

  // For the 16-word message schedule, use partial unrolling (factor=4) 
  // to reduce iteration overhead while avoiding long combinational paths.
  for (i = 0, j = 0; i < 16; ++i, j += 4) {
    #pragma hls_unroll factor=4
    m[i] = ((unsigned int)data[j] << 24) |
           ((unsigned int)data[j + 1] << 16) |
           ((unsigned int)data[j + 2] << 8) |
           ((unsigned int)data[j + 3]);
  }

  // Pipeline the message expansion loop to improve throughput and latency.
  for (; i < 64; ++i) {
    #pragma hls_pipeline_init_interval 1
    m[i] = SIG1(m[i - 2]) + m[i - 7] + SIG0(m[i - 15]) + m[i - 16];
  }

  a = state[0];
  b = state[1];
  c = state[2];
  d = state[3];
  e = state[4];
  f = state[5];
  g = state[6];
  h = state[7];

  // Pipeline the main round computation loop.
  for (i = 0; i < 64; ++i) {
    #pragma hls_pipeline_init_interval 1
    t1 = h + EP1(e) + CH(e, f, g) + k[i] + m[i];
    t2 = EP0(a) + MAJ(a, b, c);
    h = g;
    g = f;
    f = e;
    e = d + t1;
    d = c;
    c = b;
    b = a;
    a = t1 + t2;
  }

  state[0] += a;
  state[1] += b;
  state[2] += c;
  state[3] += d;
  state[4] += e;
  state[5] += f;
  state[6] += g;
  state[7] += h;
}

void sha256_transform(unsigned int (*state)[8], unsigned char (*data)[64])
{
  sha256_transform_hls(*state, *data);
}
