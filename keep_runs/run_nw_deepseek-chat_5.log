            print(f'needwun: {i}')
    print(f'Total Latency: {solver.Objective().Value()}')
    print(f'Total Area: {sum(area["fill_matrix"][i] * fill_matrix_vars[i].solution_value() for i in range(5)) + sum(area["reverse_string"][i] * reverse_string_vars[i].solution_value() for i in range(5)) + sum(area["traceback"][i] * traceback_vars[i].solution_value() for i in range(5)) + sum(area["needwun"][i] * needwun_vars[i].solution_value() for i in range(5))}')
