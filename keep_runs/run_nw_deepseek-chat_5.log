reverse_string_vars = [solver.IntVar(0, 1, f'reverse_string_{i}') for i in range(5)]
traceback_vars = [solver.IntVar(0, 1, f'traceback_{i}') for i in range(5)]
needwun_vars = [solver.IntVar(0, 1, f'needwun_{i}') for i in range(5)]

