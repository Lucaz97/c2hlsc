from ortools.sat.python import cp_model

# Define the problem
model = cp_model.CpModel()

# Variables
fill_matrix_options = [0, 1, 2, 3, 4]
reverse_string_options = [4]
traceback_options = [0, 1, 2, 3, 4]
needwun_options = [0, 1, 2, 3, 4]

# Decision variables
fill_matrix = model.NewIntVar(0, 4, 'fill_matrix')
reverse_string = model.NewIntVar(4, 4, 'reverse_string')
traceback = model.NewIntVar(0, 4, 'traceback')
needwun = model.NewIntVar(0, 4, 'needwun')

# Latency and area data (scaled to integers)
latency = {
    'fill_matrix': [12930, 12930, 13080, 12930, 12930],  # Scaled by 10
    'reverse_string': [10],  # Scaled by 10
    'traceback': [80, 80, 80, 80, 80],  # Scaled by 10
    'needwun': [13030, 13030, 13030, 13030, 13030],  # Scaled by 10
}

area = {
    'fill_matrix': [22061, 22061, 22155, 22061, 22061],  # Scaled by 10
    'reverse_string': [25415],  # Scaled by 10
    'traceback': [106122, 106122, 106122, 106122, 106122],  # Scaled by 10
    'needwun': [121400, 121400, 121400, 121400, 121400],  # Scaled by 10
}

# Helper function to use Element constraint
def add_element_constraint(model, array, index_var):
    element_var = model.NewIntVar(0, 1000000, 'element_var')
    model.AddElement(index_var, array, element_var)
    return element_var

# Objective: Minimize latency
fill_matrix_latency = add_element_constraint(model, latency['fill_matrix'], fill_matrix)
reverse_string_latency = add_element_constraint(model, latency['reverse_string'], reverse_string - 4)  # reverse_string is fixed at option 4
traceback_latency = add_element_constraint(model, latency['traceback'], traceback)
needwun_latency = add_element_constraint(model, latency['needwun'], needwun)

total_latency = model.NewIntVar(0, 1000000, 'total_latency')
model.Add(total_latency == fill_matrix_latency + reverse_string_latency + traceback_latency + needwun_latency)
model.Minimize(total_latency)

# Constraint: Total area should be as close as possible to 300000 (scaled by 10)
fill_matrix_area = add_element_constraint(model, area['fill_matrix'], fill_matrix)
reverse_string_area = add_element_constraint(model, area['reverse_string'], reverse_string - 4)  # reverse_string is fixed at option 4
traceback_area = add_element_constraint(model, area['traceback'], traceback)
needwun_area = add_element_constraint(model, area['needwun'], needwun)

total_area = model.NewIntVar(0, 1000000, 'total_area')
model.Add(total_area == fill_matrix_area + reverse_string_area + traceback_area + needwun_area)
model.Add(total_area <= 300000)  # Scaled by 10

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print(f"Optimal configuration found:")
    print(f"fill_matrix: {solver.Value(fill_matrix)}")
    print(f"reverse_string: {solver.Value(reverse_string)}")
    print(f"traceback: {solver.Value(traceback)}")
    print(f"needwun: {solver.Value(needwun)}")
    print(f"Total latency: {solver.Value(total_latency) / 10}")  # Scaled back
    print(f"Total area: {solver.Value(total_area) / 10}")  # Scaled back
else:
    print("No feasible solution found.")
