    'traceback': [106122, 106122, 106122, 106122, 106122],  # Scaled by 10
    'needwun': [121400, 121400, 121400, 121400, 121400],  # Scaled by 10
}

# Helper function to use Element constraint
def add_element_constraint(model, array, index_var):
    element_var = model.NewIntVar(0, 1000000, 'element_var')
    model.AddElement(index_var, array, element_var)
    return element_var

# Objective: Minimize latency
fill_matrix_latency = add_element_constraint(model, latency['fill_matrix'], fill_matrix)
reverse_string_latency = add_element_constraint(model, latency['reverse_string'], reverse_string - 4)  # reverse_string is fixed at option 4
