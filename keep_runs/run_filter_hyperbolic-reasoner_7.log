            {'area': 4669, 'latency': 6},
            {'area': 4669, 'latency': 6},
            {'area': 4669, 'latency': 6},
            {'area': 4669, 'latency': 6},
            {'area': 4669, 'latency': 6},
        ],
        'iir': [
            {'area': 7226, 'latency': 12},
            {'area': 7235, 'latency': 12},
            {'area': 8681, 'latency': 15},
            {'area': 8630, 'latency': 10},
            {'area': 8630, 'latency': 10},
        ],
        'filter': [
            {'area': 4581, 'latency': 7},
            {'area': 4581, 'latency': 7},
            {'area': 4581, 'latency': 7},
            {'area': 4581, 'latency': 7},
            {'area': 4581, 'latency': 7},
        ],
    }

    call_counts = {'shift': 2, 'mac': 3, 'fir': 1, 'iir': 1, 'filter': 1}

    selections = {}
    for func in functions:
        selections[func] = model.NewIntVar(0, len(functions[func])-1, func)

    total_area = 0
    for func in functions:
        areas = [opt['area'] for opt in functions[func]]
        area_var = model.NewIntVar(0, sum(areas), f'{func}_area')
        model.AddElement(selections[func], areas, area_var)
        total_area += area_var * call_counts[func]

    target_area = 6000
    model.Add(total_area <= target_area + 500)
    model.Add(total_area >= target_area - 500)

    total_latency = 0
    for func in functions:
        latencies = [opt['latency'] for opt in functions[func]]
        latency_var = model.NewIntVar(0, sum(latencies), f'{func}_latency')
