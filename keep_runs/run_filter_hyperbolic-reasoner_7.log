from ortools.sat.python import cp_model

# Define the functions and their options
functions = {
    'shift': [
        {'area': 1451.8, 'latency': 2.0},
        {'area': 1451.8, 'latency': 2.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 1107.1, 'latency': 9.0}
    ],
    'mac': [
        {'area': 4346.7, 'latency': 2.0},
        {'area': 3951.4, 'latency': 6.0},
        {'area': 4625.0, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0}
    ],
    'fir': [
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0}
    ],
    'iir': [
        {'area': 7225.5, 'latency': 12.0},
        {'area': 7235.0, 'latency': 12.0},
        {'area': 8680.8, 'latency': 15.0},
        {'area': 8630.3, 'latency': 10.0},
        {'area': 8630.3, 'latency': 10.0}
    ],
    'filter': [
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0}
    ]
}

# Call graph dependencies (number of calls)
call_counts = {
    'iir': {'shift': 2, 'mac': 2},
    'fir': {'shift': 1, 'mac': 1},
    'filter': {'fir': 1, 'iir': 1},
    'main': {'filter': 1}
}

# Calculate total area and latency considering hierarchy
def calculate_metrics(selections):
    total_area = 0
    total_latency = 0
    
    # Calculate contributions from each function instance
    # Start from leaf nodes and propagate up
    instances = {}
    
    # Count instances based on call graph
    instances['shift'] = call_counts['iir']['shift'] * call_counts['filter']['iir'] + call_counts['fir']['shift'] * call_counts['filter']['fir']
    instances['mac'] = call_counts['iir']['mac'] * call_counts['filter']['iir'] + call_counts['fir']['mac'] * call_counts['filter']['fir']
    instances['fir'] = call_counts['filter']['fir']
    instances['iir'] = call_counts['filter']['iir']
    instances['filter'] = 1
    
    # Calculate total area
    for func in ['shift', 'mac', 'fir', 'iir', 'filter']:
        total_area += instances[func] * functions[func][selections[func]]['area']
    
    # Calculate critical path latency: main -> filter -> max(fir, iir)
    fir_latency = functions['fir'][selections['fir']]['latency']
    iir_latency = functions['iir'][selections['iir']]['latency']
    critical_path = max(fir_latency, iir_latency) + functions['filter'][selections['filter']]['latency']
    total_latency = critical_path
    
    return total_area, total_latency

model = cp_model.CpModel()

# Create variables for each function's option index
selections = {
    func: model.NewIntVar(0, len(options)-1, func) 
    for func, options in functions.items()
}

# Calculate total area and latency
total_area = sum(
    functions[func][selections[func]].get_indices().index() * call_counts.get(func, 1) 
    for func in functions
)
# This approach is incorrect; need to use AddElement for proper indexing

# Instead, use helper variables and Element constraints
area_vars = []
latency_vars = []

for func in functions:
    idx = selections[func]
    areas = [functions[func][i]['area'] for i in range(len(functions[func]))]
    latencies = [functions[func][i]['latency'] for i in range(len(functions[func]))]
    
    area_var = model.NewIntVar(0, int(max(areas)*10), f'{func}_area')
    model.AddElement(idx, [int(a*10) for a in areas], area_var)
    area_vars.append(area_var * call_counts.get(func, 1))
    
    latency_var = model.NewIntVar(0, int(max(latencies)*10), f'{func}_latency')
    model.AddElement(idx, [int(l*10) for l in latencies], latency_var)
    latency_vars.append(latency_var)

total_area_var = model.NewIntVar(0, 100000, 'total_area')
model.Add(total_area_var == sum(area_vars))

# Critical path latency: filter_latency + max(fir_latency, iir_latency)
max_fir_iir = model.NewIntVar(0, 1000, 'max_fir_iir')
model.AddMaxEquality(max_fir_iir, [latency_vars[2], latency_vars[3]])
total_latency_var = model.NewIntVar(0, 1000, 'total_latency')
model.Add(total_latency_var == latency_vars[4] + max_fir_iir)

# Objective: minimize latency and stay close to 6000 area
target_area = 6000
area_diff = model.NewIntVar(0, 100000, 'area_diff')
model.AddAbsEquality(area_diff, total_area_var - int(target_area*10))

# Minimize a combination of latency and area difference
model.Minimize(total_latency_var * 1000 + area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal solution found:")
    for func in functions:
        print(f"{func}: option {solver.Value(selections[func])}")
    print(f"Total area: {solver.Value(total_area_var)/10}")
    print(f"Total latency: {solver.Value(total_latency_var)/10}")
else:
    print("No optimal solution found")
'''
