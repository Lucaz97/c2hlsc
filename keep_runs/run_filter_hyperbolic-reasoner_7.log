from ortools.sat.python import cp_model

def main():
    model = cp_model.CpModel()
    
    functions = {
        'shift': [
            {'area': 1451.8, 'latency': 2.0},
            {'area': 1451.8, 'latency': 2.0},
            {'area': 23.9, 'latency': 0.0},
            {'area': 23.9, 'latency': 0.0},
            {'area': 1107.1, 'latency': 9.0}
        ],
        'mac': [
            {'area': 4346.7, 'latency': 2.0},
            {'area': 3951.4, 'latency': 6.0},
            {'area': 4625.0, 'latency': 8.0},
            {'area': 4417.5, 'latency': 8.0},
            {'area': 4417.5, 'latency': 8.0}
        ],
        'fir': [
            {'area': 4669.1, 'latency': 6.0},
            {'area': 4669.1, 'latency': 6.0},
            {'area': 4669.1, 'latency': 6.0},
            {'area': 4669.1, 'latency': 6.0},
            {'area': 4669.1, 'latency': 6.0}
        ],
        'iir': [
            {'area': 7225.5, 'latency': 12.0},
            {'area': 7235.0, 'latency': 12.0},
            {'area': 8680.8, 'latency': 15.0},
            {'area': 8630.3, 'latency': 10.0},
            {'area': 8630.3, 'latency': 10.0}
        ],
        'filter': [
            {'area': 4581.3, 'latency': 7.0},
            {'area': 4581.3, 'latency': 7.0},
            {'area': 4581.3, 'latency': 7.0},
            {'area': 4581.3, 'latency': 7.0},
            {'area': 4581.3, 'latency': 7.0}
        ]
    }

    call_counts = {
        'shift': 3,  # Called 3 times in total
        'mac': 3,     # Called 3 times in total
        'fir': 1,
        'iir': 1,
        'filter': 1
    }

    selections = {
        func: model.NewIntVar(0, len(options)-1, func)
        for func, options in functions.items()
    }

    total_area = 0
    total_latency = 0

    for func in functions:
        # Create a list of areas and latencies for each function
        areas = [option['area'] for option in functions[func]]
        latencies = [option['latency'] for option in functions[func]]
        
        # Use Element constraint to get selected area and latency
        selected_area = model.NewIntVar(0, int(max(areas)*2), f'{func}_area')
        model.AddElement(selections[func], areas, selected_area)
        
        selected_latency = model.NewIntVar(0, int(max(latencies)*2), f'{func}_latency')
        model.AddElement(selections[func], latencies, selected_latency)
        
        # Add to totals with call count consideration
        total_area += selected_area * call_counts[func]
        total_latency += selected_latency * call_counts[func]

    target_area = 6000
    area_diff = model.NewIntVar(0, 100000, 'area_diff')
    model.AddAbsEquality(area_diff, total_area - target_area)

    model.Minimize(total_latency * 1000 + area_diff)

    solver = cp_model.CpSolver()
    status = solver.Solve(model)

    if status == cp_model.OPTIMAL:
        print('Optimal solution found:')
        for func in functions:
            print(f'{func}: Option {solver.Value(selections[func])}')
        print(f'Total latency: {solver.Value(total_latency)}')
        print(f'Total area: {solver.Value(total_area)}')
    else:
        print('No optimal solution found.')

if __name__ == '__main__':
    main()
'''
