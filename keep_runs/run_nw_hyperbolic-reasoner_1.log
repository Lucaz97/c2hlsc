void reverse_string(char str[16 + 16], int length)
{
  #pragma HLS inline
  #pragma HLS pipeline II=1
  #pragma HLS unroll factor=16
  
  for(int i = 0; i < 16; i++) {
    #pragma HLS unroll
    if(i < (length/2)) {
      int end = length-1-i;
      char temp = str[i];
      str[i] = str[end];
      str[end] = temp;
    }
  }
}
