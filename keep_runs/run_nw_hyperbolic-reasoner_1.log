void fill_matrix(char seqA[16], char seqB[16], int M[16 + 1][16 + 1], char ptr[16 + 1][16 + 1])
{
  // Optimized array partitioning for row-wise access
  #pragma HLS array_partition variable=M dim=1 complete
  #pragma HLS array_partition variable=ptr dim=1 complete
  #pragma HLS array_partition variable=seqA dim=1 cyclic factor=4
  #pragma HLS array_partition variable=seqB dim=1 cyclic factor=4

  // Parallel initialization (2 cycles)
  #pragma HLS unroll yes
  for (int a_idx = 0; a_idx <= 16; a_idx++) {
    M[0][a_idx] = -a_idx;
  }

  #pragma HLS unroll yes
  for (int b_idx = 0; b_idx <= 16; b_idx++) {
    M[b_idx][0] = -b_idx;
  }

  // Optimized wavefront processing with balanced unrolling
  for (int d = 2; d <= 32; d++) {
    #pragma HLS pipeline II=1
    const int start_row = MAX(1, d - 16);
    const int end_row = MIN(16, d - 1);
    
    // Partial unrolling with dependency-aware factor
    #pragma HLS unroll factor=4
    for (int b_idx = start_row; b_idx <= end_row; b_idx++) {
      const int a_idx = d - b_idx;
      
      const int score = (seqA[a_idx-1] == seqB[b_idx-1]) ? 
                       MATCH_SCORE : MISMATCH_SCORE;
      const int up_left = M[b_idx-1][a_idx-1] + score;
      const int up = M[b_idx-1][a_idx] + GAP_SCORE;
      const int left = M[b_idx][a_idx-1] + GAP_SCORE;
      
      const int max_val = MAX(up_left, MAX(up, left));
      
      M[b_idx][a_idx] = max_val;
      ptr[b_idx][a_idx] = (max_val == left) ? SKIPB : 
                         ((max_val == up) ? SKIPA : ALIGN);
    }
  }
}
```

