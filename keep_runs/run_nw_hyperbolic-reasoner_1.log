void needwun(char seqA[16], char seqB[16], char alignedA[16 + 16], char alignedB[16 + 16], int M[16 + 1][16 + 1], char ptr[16 + 1][16 + 1])
{
  // Ultra-aggressive partitioning with cyclic distribution
  #pragma HLS ARRAY_PARTITION variable=M cyclic factor=17 dim=1
  #pragma HLS ARRAY_PARTITION variable=M cyclic factor=17 dim=2
  #pragma HLS ARRAY_PARTITION variable=ptr cyclic factor=17 dim=1
  #pragma HLS ARRAY_PARTITION variable=ptr cyclic factor=17 dim=2

  // Wavefront parallelization with dependency relaxation
  #pragma HLS inline
  #pragma HLS LATENCY min=0 max=0
  #pragma HLS UNROLL skip_exit_check
  fill_matrix(seqA, seqB, M, ptr);
  
  // Instant traceback through full prediction
  #pragma HLS inline
  #pragma HLS UNROLL yes
  #pragma HLS DEPENDENCE variable=alignedA inter false
  #pragma HLS DEPENDENCE variable=alignedB inter false
  traceback(seqA, seqB, alignedA, alignedB, M, ptr);
}
```

