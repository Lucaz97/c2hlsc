from ortools.sat.python import cp_model

model = cp_model.CpModel()

# Variables
fill_matrix = model.NewIntVar(0, 4, 'fill_matrix')
reverse_string = model.NewIntVar(0, 4, 'reverse_string')
traceback = model.NewIntVar(0, 4, 'traceback')
needwun = model.NewIntVar(0, 4, 'needwun')

# Area data (float values multiplied by 10 to convert to integers)
area = {
    'fill_matrix': [22061, 21447, 25978, 24073, 26984],
    'reverse_string': [18042, 17190, 17190, 19061, 36112],
    'traceback': [101739, 101739, 101739, 94163, 101739],
    'needwun': [118095] * 5,
}

# Latency data (float values multiplied by 10)
latency = {
    'fill_matrix': [12930, 12930, 2130, 25380, 2130],
    'reverse_string': [310, 310, 310, 310, 950],
    'traceback': [340, 340, 340, 1270, 340],
    'needwun': [2500] * 5,
}

# Total area calculation
fill_matrix_area = model.NewIntVar(0, 300000, 'fm_area')
model.AddElement(fill_matrix, area['fill_matrix'], fill_matrix_area)

reverse_string_area = model.NewIntVar(0, 50000, 'rs_area')
model.AddElement(reverse_string, area['reverse_string'], reverse_string_area)

traceback_area = model.NewIntVar(0, 200000, 'tb_area')
model.AddElement(traceback, area['traceback'], traceback_area)

needwun_area = model.NewIntVar(0, 200000, 'nw_area')
model.AddElement(needwun, area['needwun'], needwun_area)

total_area = model.NewIntVar(0, 1000000, 'total_area')
model.Add(total_area == fill_matrix_area + reverse_string_area + traceback_area + needwun_area)

# Target area (6000 * 10 = 60000)
target_area = 60000
area_diff = model.NewIntVar(0, 1000000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - target_area)

# Total latency calculation
fill_matrix_lat = model.NewIntVar(0, 30000, 'fm_lat')
model.AddElement(fill_matrix, latency['fill_matrix'], fill_matrix_lat)

reverse_string_lat = model.NewIntVar(0, 1000, 'rs_lat')
model.AddElement(reverse_string, latency['reverse_string'], reverse_string_lat)

traceback_lat = model.NewIntVar(0, 2000, 'tb_lat')
model.AddElement(traceback, latency['traceback'], traceback_lat)

needwun_lat = model.NewIntVar(0, 3000, 'nw_lat')
model.AddElement(needwun, latency['needwun'], needwun_lat)

total_latency = model.NewIntVar(0, 100000, 'total_latency')
model.Add(total_latency == fill_matrix_lat + reverse_string_lat + traceback_lat + needwun_lat)

# Objective: minimize latency and area difference (weighted sum)
model.Minimize(total_latency * 1000 + area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f"Solution:")
    print(f"fill_matrix: {solver.Value(fill_matrix)}")
    print(f"reverse_string: {solver.Value(reverse_string)}")
    print(f"traceback: {solver.Value(traceback)}")
    print(f"needwun: {solver.Value(needwun)}")
    print(f"Total latency: {solver.Value(total_latency)/10}")
    print(f"Total area: {solver.Value(total_area)/10}")
else:
    print("No optimal solution found")
