void traceback(char seqA[16], char seqB[16], char alignedA[16 + 16], char alignedB[16 + 16], int M[16 + 1][16 + 1], char ptr[16 + 1][16 + 1])
{
  int a_idx = 16;
  int b_idx = 16;
  int a_str_idx = 0;
  int b_str_idx = 0;

  // Preserve original control flow with strict execution order
  while ((a_idx > 0) || (b_idx > 0)) {
    #pragma HLS pipeline II=1
    #pragma HLS protocol fixed
    int r = b_idx;
    char direction = ptr[r][a_idx];

    // Original index update pattern with explicit dependencies
    if (direction == '\\') {
      alignedA[a_str_idx] = seqA[a_idx - 1];
      alignedB[b_str_idx] = seqB[b_idx - 1];
      a_idx--;
      b_idx--;
      a_str_idx++;
      b_str_idx++;
    } else if (direction == '<') {
      alignedA[a_str_idx] = seqA[a_idx - 1];
      alignedB[b_str_idx] = '-';
      a_idx--;
      a_str_idx++;
    } else {
      alignedA[a_str_idx] = '-';
      alignedB[b_str_idx] = seqB[b_idx - 1];
      b_idx--;
      b_str_idx++;
    }
  }

  // Exact length reversal without buffer modification
  reverse_string(alignedA, a_str_idx);
  reverse_string(alignedB, b_str_idx);
}
