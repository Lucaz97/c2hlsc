void reverse_string(char str[16 + 16], int length)
{
  #pragma HLS array_partition variable=str complete
  #pragma HLS inline off

  char buffer[32];
  #pragma HLS array_partition variable=buffer complete

  // Full parallel reversal with correct index mapping
  ReverseRead:
  for(int j = 0; j < 32; j++) {
    #pragma HLS unroll
    int src_idx = (j < length) ? (length - 1 - j) : j;
    buffer[j] = str[src_idx];
  }

  // Single-cycle parallel writeback
  WriteBack:
  for(int j = 0; j < 32; j++) {
    #pragma HLS unroll
    str[j] = buffer[j];
  }
}
