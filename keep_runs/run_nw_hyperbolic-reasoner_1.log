```c
void reverse_string(char str[16 + 16], int length)
{
  #pragma HLS array_partition variable=str complete
  #pragma HLS inline off
  
  // Single-cycle parallel swap implementation
  const int half_len = length >> 1;
  char buffer[32];
  
  // Parallel read and conditional swap
  for(int i = 0; i < 16; i++) {
    #pragma HLS unroll
    int end = length-1-i;
    char a = str[i];
    char b = str[end];
    buffer[i] = (i < half_len) ? b : a;
    buffer[end] = (i < half_len) ? a : b;
  }

  // Parallel write-back
  for(int i = 0; i < 32; i++) {
    #pragma HLS unroll
    str[i] = buffer[i];
  }
}
```

