void reverse_string(char str[16 + 16], int length)
{
  #pragma HLS array_partition variable=str complete
  #pragma HLS inline off
  
  // Parallel swap engine with length-aware masking
  const int max_swaps = 16;
  const int half_len = length >> 1;
  
  SwapEngine:
  for(int i = 0; i < max_swaps; i++) {
    #pragma HLS unroll
    if(i < half_len) {
      int end = length-1-i;
      char temp = str[i];
      str[i] = str[end];
      str[end] = temp;
    }
  }
}
```

