void traceback(char seqA[16], char seqB[16], char alignedA[16 + 16], char alignedB[16 + 16], int M[16 + 1][16 + 1], char ptr[16 + 1][16 + 1])
{
  int a_idx = 16;
  int b_idx = 16;
  int a_str_idx = 0;
  int b_str_idx = 0;

  // Preserve original control flow with latency-oriented optimizations
  #pragma HLS loop_tripcount max=32
  while ((a_idx > 0) || (b_idx > 0)) {
    #pragma HLS pipeline II=1
    #pragma HLS latency min=32 max=32  // Force full sequence processing
    
    int r = b_idx;
    char direction = ptr[r][a_idx];

    // Maintain strict execution order with speculative writes
    if (direction == '\\') {
      alignedA[a_str_idx] = seqA[a_idx - 1];
      alignedB[b_str_idx] = seqB[b_idx - 1];
      a_idx--;
      b_idx--;
    } else if (direction == '<') {
      alignedA[a_str_idx] = seqA[a_idx - 1];
      alignedB[b_str_idx] = '-';
      a_idx--;
    } else {
      alignedA[a_str_idx] = '-';
      alignedB[b_str_idx] = seqB[b_idx - 1];
      b_idx--;
    }
    
    // Unified index increment to prevent partial updates
    a_str_idx += (direction == '\\' || direction == '<') ? 1 : 0;
    b_str_idx += (direction == '\\' || direction == ' ') ? 1 : 0;
  }

  // Direct reversal without null terminators
  reverse_string(alignedA, a_str_idx);
  reverse_string(alignedB, b_str_idx);
}
