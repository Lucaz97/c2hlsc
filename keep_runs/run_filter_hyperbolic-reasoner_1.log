void fir(int input, int *output, int taps[5])
{
  #pragma HLS ARRAY_PARTITION variable=delay_lane complete dim=1
  #pragma HLS PIPELINE II=1
  static int delay_lane[5] = {};
  
  // Force cross-function boundary optimizations
  #pragma HLS inline recursive
  #pragma HLS allocation function instances=shift limit=1
  shift(input, delay_lane, 5);

  // Optimize arithmetic carry chain
  #pragma HLS inline recursive
  #pragma HLS expression balance
  #pragma HLS latency min=1 max=3
  *output = mac(delay_lane, taps, 5);
}
```

