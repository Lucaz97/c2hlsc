void iir(int input, int *output, int feedforward_taps[5], int feedback_taps[5])
{
  #pragma HLS FUNCTION_INSTANTIATE variable=feedforward_taps,feedback_taps
  static int input_delay_lane[5] = {};
  #pragma HLS ARRAY_PARTITION variable=input_delay_lane complete
  static int output_delay_lane[5] = {};
  #pragma HLS ARRAY_PARTITION variable=output_delay_lane complete

  // Direct parallel shift implementation
  const int new_input_0 = input;
  const int new_input_1 = input_delay_lane[0];
  const int new_input_2 = input_delay_lane[1];
  const int new_input_3 = input_delay_lane[2];
  const int new_input_4 = input_delay_lane[3];

  // Optimized 3-stage adder tree with operand isolation
  const int feedforward = 
    ((new_input_0 * feedforward_taps[0] + new_input_1 * feedforward_taps[1]) +
     (new_input_2 * feedforward_taps[2] + new_input_3 * feedforward_taps[3])) +
    new_input_4 * feedforward_taps[4];

  // Symmetric feedback path
  const int feedback = 
    ((output_delay_lane[0] * feedback_taps[0] + output_delay_lane[1] * feedback_taps[1]) +
     (output_delay_lane[2] * feedback_taps[2] + output_delay_lane[3] * feedback_taps[3])) +
    output_delay_lane[4] * feedback_taps[4];

  *output = feedforward + feedback;

  // Direct output shift with constant propagation
  output_delay_lane[4] = output_delay_lane[3];
  output_delay_lane[3] = output_delay_lane[2];
  output_delay_lane[2] = output_delay_lane[1];
  output_delay_lane[1] = output_delay_lane[0];
  output_delay_lane[0] = *output;

  // Update input delay line in parallel
  input_delay_lane[0] = new_input_0;
  input_delay_lane[1] = new_input_1;
  input_delay_lane[2] = new_input_2;
  input_delay_lane[3] = new_input_3;
  input_delay_lane[4] = new_input_4;
}
```

**Key Optimizations:**
1. **Operand Isolation:** Used intermediate constants for shift values to prevent unnecessary logic propagation
2. **3-Stage Adder Tree:** Optimized adder structure with ((a+b)+(c+d))+e pattern for minimal logic depth
