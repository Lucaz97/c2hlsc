int mac(int delay_lane[5], int taps[5], int size)
{
  // Conditional parallel multipliers with zero forcing
  int m0 = size > 0 ? delay_lane[0] * taps[0] : 0;
  int m1 = size > 1 ? delay_lane[1] * taps[1] : 0;
  int m2 = size > 2 ? delay_lane[2] * taps[2] : 0;
  int m3 = size > 3 ? delay_lane[3] * taps[3] : 0;
  int m4 = size > 4 ? delay_lane[4] * taps[4] : 0;

  // Optimized adder structure: ((m0 + m1) + (m2 + m3)) + m4
  // Creates 3-level balanced tree with carry-save optimization
  int stage0 = m0 + m1;
  int stage1 = m2 + m3;
  int stage2 = stage0 + stage1;
  
  return stage2 + m4;
}
```

