int mac(int delay_lane[5], int taps[5], int size)
{
  // Parallel multiply-accumulate with size-aware selection
  int accum[5] = {0};
  
  accum[0] = (size > 0) ? delay_lane[0] * taps[0] : 0;
  accum[1] = (size > 1) ? delay_lane[1] * taps[1] : 0;
  accum[2] = (size > 2) ? delay_lane[2] * taps[2] : 0;
  accum[3] = (size > 3) ? delay_lane[3] * taps[3] : 0;
  accum[4] = (size > 4) ? delay_lane[4] * taps[4] : 0;

