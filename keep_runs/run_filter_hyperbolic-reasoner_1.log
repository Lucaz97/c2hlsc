vars = {func: model.NewIntVar(0, len(options)-1, func) for func, options in functions.items()}

# Latency and area variables
total_latency = model.NewIntVar(0, 1000, 'total_latency')
total_area = model.NewIntVar(0, 100000, 'total_area')

# Helper function to get latency of a function considering its options and dependencies
def get_latency(func):
    option = vars[func]
    func_latency = sum(functions[func][option]['latency'] for _ in range(len(call_graph[func])))
    return func_latency

# Constraints based on call graph dependencies
# For simplicity, assume total latency is sum of all function latencies (this is a simplification)
model.Add(total_latency == sum(
    [functions[func][vars[func]].get('latency', 0) for func in functions]
))

# Area is sum of all function areas (another simplification)
model.Add(total_area == sum(
    [functions[func][vars[func]].get('area', 0) for func in functions]
))

# Target area is 6000, minimize the difference
target_area = 6000
area_diff = model.NewIntVar(0, 10000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - target_area)

# Objective: minimize latency and area difference
model.Minimize(total_latency * 1000 + area_diff)

# Solve
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output results
if status == cp_model.OPTIMAL:
    print("Optimal configuration found:")
    for func in functions:
        print(f"{func}: option {solver.Value(vars[func])}")
    print(f"Total latency: {solver.Value(total_latency)}")
    print(f"Total area: {solver.Value(total_area)}")
else:
    print("No solution found.")
