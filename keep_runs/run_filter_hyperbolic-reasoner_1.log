void shift(int input, int delay_lane[5], int size)
{
  // Force constant loop bounds through NUM_TAPS definition
  #pragma HLS loop_trip min=4 max=4  // Assume size=5 based on NUM_TAPS
  for (int i = size - 1; i > 0; i--)
  {
    #pragma HLS unroll yes  // Full unroll now possible with known trip count
    delay_lane[i] = delay_lane[i - 1];
  }

  delay_lane[0] = input;
}
