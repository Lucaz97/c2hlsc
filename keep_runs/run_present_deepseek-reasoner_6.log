void generateRoundKeys80_hls(present_key_t suppliedKey, keys_t keys) {
    present_key_t key;
    present_key_t newKey;
    unsigned char i;
    unsigned char j;

    // Optimized key copy with partial unrolling
    #pragma HLS array_partition variable=key cyclic factor=2
    #pragma HLS array_partition variable=newKey cyclic factor=2
    for (j = 0; j < PRESENT_80_KEY_SIZE_BYTES; j++) {
        #pragma HLS unroll factor=2
        key[j] = suppliedKey[j];
    }

    // Direct initial key storage with full unroll
    for (j = 0; j < PRESENT_BLOCK_SIZE_BYTES; j++) {
        #pragma HLS unroll
        keys[0][j] = key[j];
    }

    // Main processing loop with balanced pipeline
    for (i = 1; i < ROUNDS; i++) {
        #pragma HLS pipeline II=2
        #pragma HLS latency max=31  // Allow pipeline balancing

        // Optimized key rotation with precomputed indices
        for (j = 0; j < PRESENT_80_KEY_SIZE_BYTES; j++) {
            #pragma HLS unroll factor=5
            const unsigned char idx1 = (j + 7) % 10;
            const unsigned char idx2 = (j + 8) % 10;
            newKey[j] = (key[idx1] << 5) | (key[idx2] >> 3);
        }

        // Parallelized key update with operation chaining
        for (j = 0; j < PRESENT_80_KEY_SIZE_BYTES; j++) {
            #pragma HLS unroll factor=2
            key[j] = (j == 0) ? ((sBox[newKey[0] >> 4] << 4) | (newKey[0] & 0xF)) :
                    (j == 7) ? (newKey[7] ^ (i >> 1)) :
                    (j == 8) ? (newKey[8] ^ (i << 7)) :
                    newKey[j];
        }

        // Optimized final key storage
        for (j = 0; j < PRESENT_BLOCK_SIZE_BYTES; j++) {
            #pragma HLS unroll
            keys[i][j] = key[j];
        }
    }
}

void generateRoundKeys80(present_key_t *suppliedKey, keys_t *keys) {
    generateRoundKeys80_hls(*suppliedKey, *keys);
}
