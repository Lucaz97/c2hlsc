void generateRoundKeys80_hls(present_key_t suppliedKey, keys_t keys) {
    present_key_t key;
    #pragma HLS array_partition variable=key complete
    present_key_t newKey;
    #pragma HLS array_partition variable=newKey complete
    unsigned char i;
    unsigned char j;

    // Optimized key initialization with partitioned array
    for (j = 0; j < PRESENT_80_KEY_SIZE_BYTES; j++) {
        #pragma HLS unroll
        key[j] = suppliedKey[j];
    }

    // Direct unrolled initial key storage
    for (j = 0; j < PRESENT_BLOCK_SIZE_BYTES; j++) {
        #pragma HLS unroll
        keys[0][j] = key[j];
    }

    // Sequentially process rounds with fully optimized iterations
    for (i = 1; i < ROUNDS; i++) {
        #pragma HLS latency min=1 max=1  // Force minimal iteration latency

        // Parallel key rotation with precomputed indices
        for (j = 0; j < PRESENT_80_KEY_SIZE_BYTES; j++) {
            #pragma HLS unroll
            const unsigned char idx1 = (j < 3) ? j + 7 : j - 3;
            const unsigned char idx2 = (j < 2) ? j + 8 : j - 2;
            newKey[j] = (key[idx1] << 5) | (key[idx2] >> 3);
        }

        // Parallel key update with sBox optimization
        key[0] = (sBox[newKey[0] >> 4] << 4) | (newKey[0] & 0xF);
        for (j = 1; j < PRESENT_80_KEY_SIZE_BYTES; j++) {
            #pragma HLS unroll
            key[j] = newKey[j];
        }
        key[8] ^= i << 7;
        key[7] ^= i >> 1;

        // Direct unrolled final key storage
        for (j = 0; j < PRESENT_BLOCK_SIZE_BYTES; j++) {
            #pragma HLS unroll
            keys[i][j] = key[j];
        }
    }
}

void generateRoundKeys80(present_key_t *suppliedKey, keys_t *keys) {
    generateRoundKeys80_hls(*suppliedKey, *keys);
}
