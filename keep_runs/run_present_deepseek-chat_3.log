Since we are unable to find a better configuration through manual exploration, let's use the **Google OR-Tools library** to solve the optimization problem. The goal is to minimize latency while keeping the total area as close as possible to 70000. We will define the problem and let the solver find the optimal combination of function options.

Here is the Python script to solve the optimization problem:

```python
python: '''
from ortools.sat.python import cp_model

# Define the model
model = cp_model.CpModel()

# Function options and their properties
functions = {
    "copyKey_hls": [
        {"area": 529.7, "latency": 1.0},
        {"area": 529.7, "latency": 1.0},
        {"area": 529.7, "latency": 1.0},
        {"area": 529.7, "latency": 1.0},
        {"area": 529.7, "latency": 1.0}
    ],
    "copyBlock_hls": [
        {"area": 427.6, "latency": 1.0},
        {"area": 758.8, "latency": 3.0},
        {"area": 427.6, "latency": 1.0},
        {"area": 427.6, "latency": 1.0},
        {"area": 427.6, "latency": 1.0}
    ],
    "generateRoundKeys80_hls": [
        {"area": 2354.3, "latency": 596.0},
        {"area": 2354.3, "latency": 596.0},
        {"area": 2354.3, "latency": 596.0},
        {"area": 2354.3, "latency": 596.0},
        {"area": 2255.4, "latency": 577.0}
    ],
    "addRoundKey_hls": [
        {"area": 126.1, "latency": 0.0},
        {"area": 498.6, "latency": 2.0},
        {"area": 126.1, "latency": 0.0},
        {"area": 416.7, "latency": 6.0},
        {"area": 126.1, "latency": 0.0}
    ],
    "pLayer_hls": [
        {"area": 1007.7, "latency": 150.0},
        {"area": 1007.7, "latency": 150.0},
        {"area": 1007.7, "latency": 150.0},
        {"area": 1007.7, "latency": 150.0},
        {"area": 1007.7, "latency": 150.0}
    ],
    "present80_encryptBlock_hls": [
        {"area": 13263.6, "latency": 6136.0},
        {"area": 13263.6, "latency": 6136.0},
        {"area": 13263.6, "latency": 6136.0},
        {"area": 13263.6, "latency": 6136.0},
        {"area": 18778.2, "latency": 5857.0}
    ]
}

# Variables to represent the selected option for each function
selected_options = {}
for func in functions:
    selected_options[func] = model.NewIntVar(0, len(functions[func]) - 1, func)

# Objective: Minimize latency
latency = model.NewIntVar(0, 100000, "latency")
model.Add(latency == sum(
    functions[func][selected_options[func]].get("latency", 0) for func in functions
))
model.Minimize(latency)

# Constraint: Total area should be as close as possible to 70000
total_area = model.NewIntVar(0, 100000, "total_area")
model.Add(total_area == sum(
    functions[func][selected_options[func]].get("area", 0) for func in functions
))
model.Add(total_area <= 70000)

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Optimal configuration found:")
    for func in functions:
        option_index = solver.Value(selected_options[func])
        print(f"{func}: option {option_index} (area: {functions[func][option_index]['area']}, latency: {functions[func][option_index]['latency']})")
    print(f"Total area: {solver.Value(total_area)}")
    print(f"Total latency: {solver.Value(latency)}")
else:
    print("No feasible solution found.")
'''
