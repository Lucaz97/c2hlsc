    unsigned char temp = key[0];
    unsigned char sBoxVal = sBox[temp >> 4];
    key[0] = (sBoxVal << 4) | (temp & 0xF);

    // XOR operations with minimal dependencies
    unsigned char xorVal1 = i << 7;
    unsigned char xorVal2 = i >> 1;
    key[8] ^= xorVal1;
    key[7] ^= xorVal2;

    copyBlock_hls(key, keys[i]);
  }
