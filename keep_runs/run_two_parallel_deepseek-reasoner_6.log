python: '''
from ortools.sat.python import cp_model

# Scale factors to avoid floats (multiply by 10)
SCALE = 10

# Function options data with scaled integer values
functions = {
    'even_sum': [
        *[{'area': int(1349.7 * SCALE), 'latency': int(2.0 * SCALE)} for _ in range(4)],
        {'area': int(3014.2 * SCALE), 'latency': int(1.0 * SCALE)}
    ]
}

model = cp_model.CpModel()
even_sum_var = model.NewIntVar(0, 4, 'even_sum')

# Scaled area/latency lists
area_list = [option['area'] for option in functions['even_sum']]
latency_list = [option['latency'] for option in functions['even_sum']]

# Variables to hold selected scaled values
selected_area = model.NewIntVar(0, 40000, 'selected_area')
selected_latency = model.NewIntVar(0, 100, 'selected_latency')

# Link variables using element constraint
model.AddElement(even_sum_var, area_list, selected_area)
model.AddElement(even_sum_var, latency_list, selected_latency)

# Compute total scaled area: compute2_base (1251.9*10=12519) + even_sum_area
total_area_scaled = 12519 + selected_area

# Area difference from target (4000*10=40000)
area_diff = model.NewIntVar(0, 100000, 'area_diff')
model.AddAbsEquality(area_diff, total_area_scaled - 40000)

# Objective: minimize (area_diff * 1000 + latency) keeping original scale weights
# (area_diff in 0.1 units, latency in 0.1 units)
objective = model.NewIntVar(0, 100000000, 'objective')
model.Add(objective == area_diff * 1000 + selected_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    selected = solver.Value(even_sum_var)
    actual_area = (12519 + solver.Value(selected_area)) / SCALE
    actual_latency = solver.Value(selected_latency) / SCALE
    print(f"Best option: {selected}, area: {actual_area:.1f}, latency: {actual_latency:.1f}")
else:
    print("No solution found")
'''
