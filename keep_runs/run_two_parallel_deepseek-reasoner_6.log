from ortools.sat.python import cp_model

# Function options data with scaled integer values (multiply by 10)
functions = {
    'even_sum': [
        *[{'area': 13497, 'latency': 20} for _ in range(4)],  # 1349.7*10=13497, 2.0*10=20
        {'area': 30142, 'latency': 10}   # 3014.2*10=30142, 1.0*10=10
    ]
}

model = cp_model.CpModel()
even_sum_var = model.NewIntVar(0, 4, 'even_sum')

# Scaled area/latency lists
area_list = [option['area'] for option in functions['even_sum']]
latency_list = [option['latency'] for option in functions['even_sum']]

# Integer variables to hold scaled values
selected_area = model.NewIntVar(0, 40000, 'selected_area')
selected_latency = model.NewIntVar(0, 100, 'selected_latency')

# Link using AddElement with integer lists
model.AddElement(even_sum_var, area_list, selected_area)
model.AddElement(even_sum_var, latency_list, selected_latency)

# Compute total area (convert back to original scale)
compute2_base = (4266.1 - 3014.2) * 10  # 1251.9*10=12519
total_area_scaled = compute2_base + selected_area
total_area = total_area_scaled / 10  # Convert back to original scale

# Area difference from target (4000)
area_diff = model.NewIntVar(0, 100000, 'area_diff')
model.AddAbsEquality(area_diff, int((total_area - 4000) * 10))  # Compare scaled difference

# Objective: minimize (area_diff*1000 + latency)
objective = model.NewIntVar(0, 10000000, 'objective')
model.Add(objective == area_diff * 1000 + (selected_latency // 10) * 100)  # latency scaled by 10

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    selected = solver.Value(even_sum_var)
    actual_area = (solver.Value(total_area_scaled)) / 10
    actual_latency = solver.Value(selected_latency) / 10
    print(f"Best option: {selected}, area: {actual_area:.1f}, latency: {actual_latency:.1f}")
else:
    print("No solution found")
