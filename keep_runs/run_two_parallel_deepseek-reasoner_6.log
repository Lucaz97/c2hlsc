from ortools.sat.python import cp_model

# Function options data
functions = {
    'odd_factorial': [{'area': 3696.9, 'latency': 2.0} for _ in range(5)],
    'even_sum': [
        *[{'area': 1349.7, 'latency': 2.0} for _ in range(4)],
        {'area': 3014.2, 'latency': 1.0}
    ],
    'compute2': [{'area': 4266.1, 'latency': 3.0} for _ in range(5)]
}

# Since odd_factorial and compute2 options don't vary, focus on even_sum
even_sum_options = functions['even_sum']

model = cp_model.CpModel()

# Variables: even_sum choice (0-4)
even_sum_var = model.NewIntVar(0, 4, 'even_sum')

# Objective: minimize (area_diff + latency)
# Area target is 4000
# Assuming total area is compute2's area (4266.1) which includes even_sum's area
# So adjust compute2's area based on even_sum's option. Need to model this correctly.
# However, previous synthesis with even_sum 4 gave total area 4266.1, which matches compute2's area. 
# This suggests that compute2's area is fixed, and even_sum's area is part of it. But how?

# Hypothesize that changing even_sum's option affects compute2's area as follows:
# compute2's base area (without even_sum) + even_sum's area
# Assume compute2's base area is 4266.1 - even_sum's area (default, which is 3014.2 for option4)
# So when using even_sum option x, total area = (4266.1 - 3014.2) + even_sum_options[x]['area']
base_area = 4266.1 - 3014.2  # 1251.9
total_area = base_area + even_sum_options[even_sum_var]['area']

area_diff = model.NewIntVar(0, 10000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - 4000)

# Minimize area_diff and latency (prioritize area_diff first, then latency)
# Combine into a single objective with weighted sum
latency = even_sum_options[even_sum_var]['latency']
objective = model.NewIntVar(0, 10000, 'objective')
model.Add(objective == area_diff * 1000 + latency * 100)
model.Minimize(objective)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    selected = solver.Value(even_sum_var)
    print(f"Best even_sum option: {selected}, area: {total_area}, latency: {even_sum_options[selected]['latency']}")
else:
    print("No solution found")
'''
