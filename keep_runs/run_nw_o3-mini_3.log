python: '''import sys
from ortools.linear_solver import pywraplp

# Data for each function option
# Each entry is a tuple: (area, latency, throughput)
# Options are indexed starting at 0.
fill_matrix = [
    (2206.1, 1293.0, 1366.0),
    (2206.1, 1293.0, 1366.0),
    (2206.1, 1293.0, 1366.0),
    (2595.0, 213.0, 287.0),
    (2595.0, 213.0, 287.0)
]

reverse_string = [
    (2239.7, 1.0, 4.0),
    (1719.0, 31.0, 34.0),
    (2239.7, 1.0, 4.0),
    (12357.4, 15.0, 17.0),
    (4634.2, 1.0, 4.0)
]

traceback = [
    (10091.2, 160.0, 164.0),
    (10091.2, 160.0, 164.0),
    (10696.2, 132.0, 136.0),
    (4689.9, 43.0, 46.0),
    (10547.6, 140.0, 144.0)
]

needwun = [
    (12142.1, 261.0, 334.0),
    (12142.1, 261.0, 334.0),
    (12142.1, 261.0, 334.0),
    (12142.1, 261.0, 334.0),
    (12142.1, 261.0, 334.0)
]

# For simplicity, we assume that the overall design latency is dominated by the parent function (needwun) latency,
# provided that the child functions are synthesized with the best available option.
# However, the synthesis results we observed indicate that selecting lower-latency options for 
# fill_matrix and traceback further reduce the overall latency.
#
# Here we model an approximate aggregated latency as:
#    overall_latency = needwun_latency + fill_matrix_latency_modifier + traceback_latency_modifier + reverse_string_latency_modifier
#
# In our observed synthesis reports, a configuration using:
#    fill_matrix option 3, reverse_string option 0, traceback option 3, needwun option 0
# yields an overall latency of about 261.
# This suggests that the parent (needwun) may internally select the best performing child.
#
# For our optimization, we set the following approximate model:
#    overall_latency = needwun_choice_latency   + delta
# where delta is 0 if both fill_matrix and traceback use their "aggressive" (low-latency) options.
# We assume that the low-latency options are:
#    fill_matrix: index 3 or 4 (latency 213)
#    traceback: index 3 (latency 43)
# and for reverse_string, we assume the best latency is 1 (from indexes 0,2,4)
#
# We then add a penalty if a higher-latency option is chosen for any child:
#   penalty_fill = fill_matrix_latency - 213  (if fill_matrix option is not one of the aggressive ones, this is >0)
#   penalty_trace = traceback_latency - 43      (if not option 3)
#   penalty_rev = reverse_string_latency - 1     (if not in {0,2,4})
#
# Overall penalty = penalty_fill + penalty_trace + penalty_rev.
#
# The aggregated latency model becomes:
#    overall_latency = needwun_latency + penalty_fill + penalty_trace + penalty_rev
#
# We also sum the areas of the chosen options as an approximate measure.
#
# Our goal is to minimize overall_latency and also keep the total_area close to 6000.
#
# We use a weighted objective: minimize (overall_latency + alpha * deviation)
# where deviation = abs(total_area - 6000).
#
# Since absolute values are non linear, we linearize using two nonnegative variables d_plus and d_minus such that:
#    total_area - 6000 = d_plus - d_minus, with d_plus, d_minus >= 0, and d_plus + d_minus is the absolute deviation.
#
# We select a weight alpha to trade-off area closeness (e.g., alpha = 0.1).
#
alpha = 0.1

# Create the solver
solver = pywraplp.Solver.CreateSolver('SCIP')
if not solver:
    print("Solver not created.")
    sys.exit(1)

# Decision variables for each function option: binary variable indicating if option is selected.
fm = [solver.BoolVar(f'fm_{i}') for i in range(len(fill_matrix))]
rs = [solver.BoolVar(f'rs_{i}') for i in range(len(reverse_string))]
tb = [solver.BoolVar(f'tb_{i}') for i in range(len(traceback))]
nw = [solver.BoolVar(f'nw_{i}') for i in range(len(needwun))]

# Each function must select exactly one option.
solver.Add(solver.Sum(fm) == 1)
solver.Add(solver.Sum(rs) == 1)
solver.Add(solver.Sum(tb) == 1)
solver.Add(solver.Sum(nw) == 1)

# Compute total area (as sum of the areas of each chosen option).
total_area = (
    solver.Sum([fm[i] * fill_matrix[i][0] for i in range(len(fill_matrix))]) +
    solver.Sum([rs[i] * reverse_string[i][0] for i in range(len(reverse_string))]) +
    solver.Sum([tb[i] * traceback[i][0] for i in range(len(traceback))]) +
    solver.Sum([nw[i] * needwun[i][0] for i in range(len(needwun))])
)

# Compute latency components:
# For needwun, all options have same latency, so we can simply add:
nw_latency = solver.Sum([nw[i] * needwun[i][1] for i in range(len(needwun))])

# For fill_matrix, we add penalty = (latency - 213) if option latency > 213.
penalties_fm = []
for i, (area, lat, thr) in enumerate(fill_matrix):
    penalty = max(0, lat - 213)
    penalties_fm.append(fm[i] * penalty)
fm_penalty = solver.Sum(penalties_fm)

# For traceback, penalty = (latency - 43)
penalties_tb = []
for i, (area, lat, thr) in enumerate(traceback):
    penalty = max(0, lat - 43)
    penalties_tb.append(tb[i] * penalty)
tb_penalty = solver.Sum(penalties_tb)

# For reverse_string, penalty = (latency - 1) if latency > 1.
penalties_rs = []
for i, (area, lat, thr) in enumerate(reverse_string):
    penalty = max(0, lat - 1)
    penalties_rs.append(rs[i] * penalty)
rs_penalty = solver.Sum(penalties_rs)

# Overall latency approximation:
overall_latency = nw_latency + fm_penalty + tb_penalty + rs_penalty

# Linearize the absolute deviation: total_area - 6000 = d_plus - d_minus
d_plus = solver.NumVar(0, solver.infinity(), 'd_plus')
d_minus = solver.NumVar(0, solver.infinity(), 'd_minus')
solver.Add(total_area - 6000 == d_plus - d_minus)
deviation = d_plus + d_minus

# Objective: minimize overall_latency + alpha * deviation
solver.Minimize(overall_latency + alpha * deviation)

status = solver.Solve()
if status == pywraplp.Solver.OPTIMAL:
    # Retrieve chosen options
    fm_choice = [i for i in range(len(fill_matrix)) if fm[i].solution_value() > 0.5][0]
    rs_choice = [i for i in range(len(reverse_string)) if rs[i].solution_value() > 0.5][0]
    tb_choice = [i for i in range(len(traceback)) if tb[i].solution_value() > 0.5][0]
    nw_choice = [i for i in range(len(needwun)) if nw[i].solution_value() > 0.5][0]
    print("Selected configuration:")
    print(f"fill_matrix {fm_choice}, reverse_string {rs_choice}, traceback {tb_choice}, needwun {nw_choice}")
    print("Overall approximated latency:", overall_latency.solution_value())
    print("Total area:", total_area.solution_value())
    print("Deviation from target (6000):", deviation.solution_value())
else:
    print("No optimal solution found.")
