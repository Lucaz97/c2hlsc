python: '''
from ortools.sat.python import cp_model

# Scale factors to handle decimals as integers
SCALE = 10

functions = {
    'fill_matrix': [
        {'area': int(2206.1 * SCALE), 'latency': int(1293.0 * SCALE)},
        {'area': int(2144.7 * SCALE), 'latency': int(1293.0 * SCALE)},
        {'area': int(2597.8 * SCALE), 'latency': int(213.0 * SCALE)},
        {'area': int(2407.3 * SCALE), 'latency': int(2538.0 * SCALE)},
        {'area': int(2698.4 * SCALE), 'latency': int(213.0 * SCALE)},
    ],
    'reverse_string': [
        {'area': int(1804.2 * SCALE), 'latency': int(31.0 * SCALE)},
        {'area': int(1719.0 * SCALE), 'latency': int(31.0 * SCALE)},
        {'area': int(1719.0 * SCALE), 'latency': int(31.0 * SCALE)},
        {'area': int(1906.1 * SCALE), 'latency': int(31.0 * SCALE)},
        {'area': int(3611.2 * SCALE), 'latency': int(95.0 * SCALE)},
    ],
    'traceback': [
        {'area': int(10173.9 * SCALE), 'latency': int(34.0 * SCALE)},
        {'area': int(10173.9 * SCALE), 'latency': int(34.0 * SCALE)},
        {'area': int(10173.9 * SCALE), 'latency': int(34.0 * SCALE)},
        {'area': int(9416.3 * SCALE), 'latency': int(127.0 * SCALE)},
        {'area': int(10173.9 * SCALE), 'latency': int(34.0 * SCALE)},
    ],
    'needwun': [
        {'area': int(11809.5 * SCALE), 'latency': int(250.0 * SCALE)},
        {'area': int(11809.5 * SCALE), 'latency': int(250.0 * SCALE)},
        {'area': int(11809.5 * SCALE), 'latency': int(250.0 * SCALE)},
        {'area': int(11809.5 * SCALE), 'latency': int(250.0 * SCALE)},
        {'area': int(11809.5 * SCALE), 'latency': int(250.0 * SCALE)},
    ],
}

model = cp_model.CpModel()

# Decision variables for each function's option
fill = model.NewIntVar(0, 4, 'fill')
reverse = model.NewIntVar(0, 4, 'reverse')
trace = model.NewIntVar(0, 4, 'trace')
needwun_var = model.NewIntVar(0, 4, 'needwun')

# Area and latency variables using AddElement to handle indexing
fill_area = model.NewIntVar(0, 30000, 'fill_area')
model.AddElement(fill, [f['area'] for f in functions['fill_matrix']], fill_area)

fill_latency = model.NewIntVar(0, 30000, 'fill_latency')
model.AddElement(fill, [f['latency'] for f in functions['fill_matrix']], fill_latency)

reverse_area = model.NewIntVar(0, 40000, 'reverse_area')
model.AddElement(reverse, [f['area'] for f in functions['reverse_string']], reverse_area)

reverse_latency = model.NewIntVar(0, 1000, 'reverse_latency')
model.AddElement(reverse, [f['latency'] for f in functions['reverse_string']], reverse_latency)

trace_area = model.NewIntVar(0, 120000, 'trace_area')
model.AddElement(trace, [f['area'] for f in functions['traceback']], trace_area)

trace_latency = model.NewIntVar(0, 2000, 'trace_latency')
model.AddElement(trace, [f['latency'] for f in functions['traceback']], trace_latency)

needwun_area = model.NewIntVar(0, 120000, 'needwun_area')
model.AddElement(needwun_var, [f['area'] for f in functions['needwun']], needwun_area)

needwun_latency = model.NewIntVar(0, 3000, 'needwun_latency')
model.AddElement(needwun_var, [f['latency'] for f in functions['needwun']], needwun_latency)

# Total calculations
total_area = model.NewIntVar(0, 300000, 'total_area')
model.Add(total_area == fill_area + reverse_area + trace_area + needwun_area)

total_latency = model.NewIntVar(0, 300000, 'total_latency')
model.Add(total_latency == fill_latency + reverse_latency + trace_latency + needwun_latency)

# Target handling (scaled by SCALE)
target = 6000 * SCALE
delta = model.NewIntVar(0, 100000, 'delta')
model.AddAbsEquality(delta, total_area - target)

# Minimize: (latency * 1000) + delta (both scaled)
model.Minimize(total_latency * 1000 + delta)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f"fill_matrix: {solver.Value(fill)}")
    print(f"reverse_string: {solver.Value(reverse)}")
    print(f"traceback: {solver.Value(trace)}")
    print(f"needwun: {solver.Value(needwun_var)}")
    print(f"Total area: {solver.Value(total_area)/SCALE}")
    print(f"Total latency: {solver.Value(total_latency)/SCALE}")
else:
    print("No solution found.")
