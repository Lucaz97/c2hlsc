        {'area': 1719.0, 'latency': 31.0},
        {'area': 1906.1, 'latency': 31.0},
        {'area': 3611.2, 'latency': 95.0},
    ],
    'traceback': [
        {'area': 10173.9, 'latency': 34.0},
        {'area': 10173.9, 'latency': 34.0},
        {'area': 10173.9, 'latency': 34.0},
        {'area': 9416.3, 'latency': 127.0},
        {'area': 10173.9, 'latency': 34.0},
    ],
    'needwun': [
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
    ],
}

model = cp_model.CpModel()
fill = model.NewIntVar(0, 4, 'fill')
reverse = model.NewIntVar(0, 4, 'reverse')
trace = model.NewIntVar(0, 4, 'trace')
needwun_var = model.NewIntVar(0, 4, 'needwun')

total_area = model.NewIntVar(0, 100000, 'total_area')
model.Add(total_area == sum([
    functions['fill_matrix'][fill]['area'],
    functions['reverse_string'][reverse]['area'],
    functions['traceback'][trace]['area'],
    functions['needwun'][needwun_var]['area']
]))

total_latency = model.NewIntVar(0, 100000, 'total_latency')
model.Add(total_latency == sum([
    functions['fill_matrix'][fill]['latency'],
    functions['reverse_string'][reverse]['latency'],
    functions['traceback'][trace]['latency'],
    functions['needwun'][needwun_var]['latency']
]))

target = 6000
delta = model.NewIntVar(0, 100000, 'delta')
model.AddAbsEquality(delta, total_area - target)

model.Minimize(total_latency * 1000 + delta)

