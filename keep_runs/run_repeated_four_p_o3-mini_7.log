int fibonacci(int n)
{
  // Handle small n values to mimic the original behavior.
  // The original implementation computes F(n-1) for n>=2.
  if(n < 2)
    return n;

  // Instead of computing F(n) directly, we compute F(m) where m = n - 1.
  int m = n - 1;
  int a = 0; // Represents F(0)
  int b = 1; // Represents F(1)

  // Determine the index of the most significant bit set in m.
  int msb = 31;
  while(msb >= 0 && (((m >> msb) & 1) == 0))
  {
    msb--;
  }

  // Use the fast doubling method to compute Fibonacci numbers.
  // For the given m, we iterate from msb down to 0.
  // The loop is fully unrolled to minimize latency.
  for (int i = msb; i >= 0; i--)
  {
    #pragma hls_unroll yes
    int d = a * (2 * b - a);    // d = F(2k)
    int e = a * a + b * b;      // e = F(2k + 1)
    if ((m >> i) & 1)
    {
      a = e;         // F(2k+1)
      b = d + e;     // F(2k+2)
    }
    else
    {
      a = d;         // F(2k)
      b = e;         // F(2k+1)
    }
  }

  // Return F(n-1) to match the original design.
  return a;
}
