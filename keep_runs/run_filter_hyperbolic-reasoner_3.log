from ortools.sat.python import cp_model

functions = {
    'shift': [
        {'area': 1451.8, 'latency': 2.0},
        {'area': 1451.8, 'latency': 2.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 1107.1, 'latency': 9.0},
    ],
    'mac': [
        {'area': 4346.7, 'latency': 2.0},
        {'area': 3951.4, 'latency': 6.0},
        {'area': 4625.0, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
    ],
    'fir': [
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
    ],
    'iir': [
        {'area': 7225.5, 'latency': 12.0},
        {'area': 7235.0, 'latency': 12.0},
        {'area': 8680.8, 'latency': 15.0},
        {'area': 8630.3, 'latency': 10.0},
        {'area': 8630.3, 'latency': 10.0},
    ],
    'filter': [
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
    ],
}

call_counts = {
    'shift': 3,
    'mac': 3,
    'fir': 1,
    'iir': 1,
    'filter': 1,
}

model = cp_model.CpModel()

shift_var = model.NewIntVar(0, 4, 'shift')
mac_var = model.NewIntVar(0, 4, 'mac')
fir_var = model.NewIntVar(0, 4, 'fir')
iir_var = model.NewIntVar(0, 4, 'iir')
filter_var = model.NewIntVar(0, 4, 'filter')

def get_area(func, option):
    return int(functions[func][option]['area'] * call_counts[func] * 10)  # Scale to avoid float

def get_latency(func, option):
    return int(functions[func][option]['latency'] * call_counts[func] * 10)

total_area = (
    get_area('shift', shift_var) +
    get_area('mac', mac_var) +
    get_area('fir', fir_var) +
    get_area('iir', iir_var) +
    get_area('filter', filter_var)
)

total_latency = (
    get_latency('shift', shift_var) +
    get_latency('mac', mac_var) +
    get_latency('fir', fir_var) +
    get_latency('iir', iir_var) +
    get_latency('filter', filter_var)
)

target_area = 6000 * 10  # Scaled
delta = model.NewIntVar(0, 1000000, 'delta')
model.AddAbsEquality(delta, total_area - target_area)

model.Minimize(delta + total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    config = {
        'shift': solver.Value(shift_var),
        'mac': solver.Value(mac_var),
        'fir': solver.Value(fir_var),
        'iir': solver.Value(iir_var),
        'filter': solver.Value(filter_var),
    }
    print(f"solution: shift {config['shift']}, mac {config['mac']}, fir {config['fir']}, iir {config['iir']}, filter {config['filter']}")
else:
    print("No solution found. Consider relaxing constraints.")
