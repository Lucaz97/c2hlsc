python: '''
from ortools.sat.python import cp_model

# Data for each function option: (area, latency, throughput)
# Options are indexed from 0.
data = {
    'shift': [
        (1451.8, 2, 4),
        (1929.7, 2, 4),
        (1451.8, 2, 4),
        (1546.9, 3, 5),
        (1451.8, 2, 4)
    ],
    'mac': [
        (4346.7, 2, 3),
        (6690.9, 6, 7),
        (4346.7, 2, 3),
        (4346.7, 2, 3),
        (6690.9, 6, 7)
    ],
    'fir': [
        (5043.1, 10, 11),
        (5043.1, 10, 11),
        (6135.1, 5, 6),
        (4901.3, 10, 11),
        (6219.2, 5, 6)
    ],
    'iir': [
        (8132.5, 16, 22),
        (8160.4, 16, 22),
        (8160.4, 16, 22),
        (8160.4, 16, 22),
        (8630.3, 10, 11)
    ],
    'filter': [
        (3440.3, 1, 2),
        (3440.3, 1, 2),
        (3440.3, 1, 2),
        (3440.3, 1, 2),
        (3440.3, 1, 2)
    ]
}

functions = ['shift', 'mac', 'fir', 'iir', 'filter']
model = cp_model.CpModel()

# Decision variables for each function option.
choices = {}
for fname in functions:
    n_options = len(data[fname])
    choices[fname] = model.NewIntVar(0, n_options - 1, fname + '_choice')

# Scale factors to handle float values
scale = 10

def scale_list(lst):
    return [int(scale * v) for v in lst]

# Pre-scaled area and latency arrays per function.
area_vals = {fname: scale_list([opt[0] for opt in data[fname]]) for fname in functions}
latency_vals = {fname: scale_list([opt[1] for opt in data[fname]]) for fname in functions}

latency_vars = {}
area_vars = {}
for fname in functions:
    n = len(data[fname])
    latency_var = model.NewIntVar(min(latency_vals[fname]), max(latency_vals[fname]), fname + '_lat')
    area_var = model.NewIntVar(min(area_vals[fname]), max(area_vals[fname]), fname + '_area')
    model.AddElement(choices[fname], latency_vals[fname], latency_var)
    model.AddElement(choices[fname], area_vals[fname], area_var)
    latency_vars[fname] = latency_var
    area_vars[fname] = area_var

# Compute total latency and total area (as the sum of the individual ones).
total_latency = sum(latency_vars[f] for f in functions)
total_area = sum(area_vars[f] for f in functions)

# Target area: 6000 scaled.
target_area = 6000 * scale
area_deviation = model.NewIntVar(0, 1000000, 'area_dev')
model.AddAbsEquality(area_deviation, total_area - target_area)

# Adjust lambda coefficient to more heavily penalize area deviation.
lambda_coef = 10  # increased weight for area deviation
model.Minimize(total_latency + lambda_coef * area_deviation)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in [cp_model.OPTIMAL, cp_model.FEASIBLE]:
    print("Solution:")
    for fname in functions:
        choice = solver.Value(choices[fname])
        a = solver.Value(area_vars[fname]) / scale
        l = solver.Value(latency_vars[fname]) / scale
        print(f"{fname}: option {choice}, area = {a}, latency = {l}")
    print("Total area:", solver.Value(total_area) / scale)
    print("Total latency:", solver.Value(total_latency) / scale)
    print("Area deviation from target:", solver.Value(area_deviation) / scale)
else:
    print("No solution found.")
'''
