python: ''' 
from ortools.sat.python import cp_model

# Data for each function option: (area, latency, throughput)
# Options are indexed from 0.
data = {
    'shift': [
        (1451.8, 2, 4),
        (1929.7, 2, 4),
        (1451.8, 2, 4),
        (1546.9, 3, 5),
        (1451.8, 2, 4)
    ],
    'mac': [
        (4346.7, 2, 3),
        (6690.9, 6, 7),
        (4346.7, 2, 3),
        (4346.7, 2, 3),
        (6690.9, 6, 7)
    ],
    'fir': [
        (5043.1, 10, 11),
        (5043.1, 10, 11),
        (6135.1, 5, 6),
        (4901.3, 10, 11),
        (6219.2, 5, 6)
    ],
    'iir': [
        (8132.5, 16, 22),
        (8160.4, 16, 22),
        (8160.4, 16, 22),
        (8160.4, 16, 22),
        (8630.3, 10, 11)
    ],
    'filter': [
        (3440.3, 1, 2),
        (3440.3, 1, 2),
        (3440.3, 1, 2),
        (3440.3, 1, 2),
        (3440.3, 1, 2)
    ]
}

# List of functions to consider.
functions = ['shift', 'mac', 'fir', 'iir', 'filter']

model = cp_model.CpModel()

# Decision variables: for each function, an integer variable for the selected option.
choices = {}
for fname in functions:
    n_options = len(data[fname])
    choices[fname] = model.NewIntVar(0, n_options - 1, fname + '_choice')

# Since cp_model works with integers, we multiply area and latency values by 10 (or 100)
# to avoid float issues.
scale = 10
def int_vals(values):
    return [int(scale * v) for v in values]

# Prepare arrays of scaled areas and latencies for each function.
area_vals = {fname: int_vals([opt[0] for opt in data[fname]]) for fname in functions}
latency_vals = {fname: int_vals([opt[1] for opt in data[fname]]) for fname in functions}

# Our design: We assume that the overall performance is dictated by the sum of latencies along the call chain.
# For simplicity, we define total_latency as the sum over all accelerated functions.
# And the total_area as the sum over all functions.
total_latency = sum(model.NewIntVarFromDomain(cp_model.Domain.FromValues(latency_vals[fname]), 
                                              fname+'_lat') for fname in functions)
# Instead, we use element constraints to link each decision variable with its latency and area.
latency_vars = {}
area_vars = {}
for fname in functions:
    n = len(data[fname])
    latency_var = model.NewIntVar(min(latency_vals[fname]), max(latency_vals[fname]), fname + '_lat')
    area_var = model.NewIntVar(min(area_vals[fname]), max(area_vals[fname]), fname + '_area')
    model.AddElement(choices[fname], latency_vals[fname], latency_var)
    model.AddElement(choices[fname], area_vals[fname], area_var)
    latency_vars[fname] = latency_var
    area_vars[fname] = area_var

total_latency = sum(latency_vars[f] for f in functions)
total_area = sum(area_vars[f] for f in functions)

# The goal: minimize total latency while keeping total_area as close as possible to the target.
# Here, our target total area (scaled) is 6000 * scale.
target_area = 6000 * scale

# Introduce an absolute deviation variable for area.
area_deviation = model.NewIntVar(0, 1000000, 'area_dev')
model.AddAbsEquality(area_deviation, total_area - target_area)

# Combine objectives: weighted sum of total_latency and area_deviation.
# Weight chosen to prioritize latency minimization, while penalizing area deviation modestly.
# You can adjust lambda_coef if needed.
lambda_coef = 1  # weight for area deviation
model.Minimize(total_latency + lambda_coef * area_deviation)

# Solve the model.
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Solution:")
    for fname in functions:
        print(f"{fname}: option {solver.Value(choices[fname])}, area = {solver.Value(area_vars[fname])/scale}, latency = {solver.Value(latency_vars[fname])/scale}")
    print("Total area:", solver.Value(total_area)/scale)
    print("Total latency:", solver.Value(total_latency)/scale)
    print("Area deviation from target:", solver.Value(area_deviation)/scale)
else:
    print("No solution found.")
'''                   

