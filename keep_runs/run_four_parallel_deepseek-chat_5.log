from ortools.sat.python import cp_model

# Function options data
functions = {
    "fibonacci": [
        {"area": 1640.9, "latency": 2.0},
        {"area": 1728.2, "latency": 2.0},
        {"area": 1728.2, "latency": 2.0},
        {"area": 1640.9, "latency": 2.0},
        {"area": 1640.9, "latency": 2.0},
    ],
    "odd_sum": [
        {"area": 1287.7, "latency": 2.0},
        {"area": 1210.9, "latency": 2.0},
        {"area": 1287.7, "latency": 2.0},
        {"area": 1210.9, "latency": 2.0},
        {"area": 1210.9, "latency": 2.0},
    ],
    "even_sum": [
        {"area": 1349.7, "latency": 2.0},
        {"area": 2397.2, "latency": 3.0},
        {"area": 2136.8, "latency": 4.0},
        {"area": 1230.0, "latency": 2.0},
        {"area": 1509.2, "latency": 2.0},
    ],
    "compute3": [
        {"area": 3053.8, "latency": 9.0},
        {"area": 3053.8, "latency": 9.0},
        {"area": 3053.8, "latency": 9.0},
        {"area": 3053.8, "latency": 9.0},
        {"area": 3053.8, "latency": 9.0},
    ],
}

# Model
model = cp_model.CpModel()

# Variables
fibonacci_var = model.NewIntVar(0, 4, "fibonacci")
odd_sum_var = model.NewIntVar(0, 4, "odd_sum")
even_sum_var = model.NewIntVar(0, 4, "even_sum")
compute3_var = model.NewIntVar(0, 4, "compute3")

# Intermediate variables for latency and area
fibonacci_latency = model.NewIntVar(0, 100, "fibonacci_latency")
odd_sum_latency = model.NewIntVar(0, 100, "odd_sum_latency")
even_sum_latency = model.NewIntVar(0, 100, "even_sum_latency")
compute3_latency = model.NewIntVar(0, 100, "compute3_latency")

fibonacci_area = model.NewIntVar(0, 10000, "fibonacci_area")
odd_sum_area = model.NewIntVar(0, 10000, "odd_sum_area")
even_sum_area = model.NewIntVar(0, 10000, "even_sum_area")
compute3_area = model.NewIntVar(0, 10000, "compute3_area")

# Boolean variables to link function options to latency and area
fibonacci_bool = [model.NewBoolVar(f"fibonacci_bool_{i}") for i in range(5)]
odd_sum_bool = [model.NewBoolVar(f"odd_sum_bool_{i}") for i in range(5)]
even_sum_bool = [model.NewBoolVar(f"even_sum_bool_{i}") for i in range(5)]
compute3_bool = [model.NewBoolVar(f"compute3_bool_{i}") for i in range(5)]

# Constraints to link function options to latency and area
for i in range(5):
    model.Add(fibonacci_var == i).OnlyEnforceIf(fibonacci_bool[i])
    model.Add(fibonacci_latency == int(functions["fibonacci"][i]["latency"])).OnlyEnforceIf(fibonacci_bool[i])
    model.Add(fibonacci_area == int(functions["fibonacci"][i]["area"])).OnlyEnforceIf(fibonacci_bool[i])

    model.Add(odd_sum_var == i).OnlyEnforceIf(odd_sum_bool[i])
    model.Add(odd_sum_latency == int(functions["odd_sum"][i]["latency"])).OnlyEnforceIf(odd_sum_bool[i])
    model.Add(odd_sum_area == int(functions["odd_sum"][i]["area"])).OnlyEnforceIf(odd_sum_bool[i])

    model.Add(even_sum_var == i).OnlyEnforceIf(even_sum_bool[i])
    model.Add(even_sum_latency == int(functions["even_sum"][i]["latency"])).OnlyEnforceIf(even_sum_bool[i])
    model.Add(even_sum_area == int(functions["even_sum"][i]["area"])).OnlyEnforceIf(even_sum_bool[i])

    model.Add(compute3_var == i).OnlyEnforceIf(compute3_bool[i])
    model.Add(compute3_latency == int(functions["compute3"][i]["latency"])).OnlyEnforceIf(compute3_bool[i])
    model.Add(compute3_area == int(functions["compute3"][i]["area"])).OnlyEnforceIf(compute3_bool[i])

# Objective: Minimize latency
total_latency = fibonacci_latency + odd_sum_latency + even_sum_latency + compute3_latency
model.Minimize(total_latency)

# Area constraint: Total area should be as close as possible to 2800
total_area = fibonacci_area + odd_sum_area + even_sum_area + compute3_area
model.Add(total_area <= 2800)

# Solver
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print(f"Optimal configuration found:")
    print(f"fibonacci: {solver.Value(fibonacci_var)}")
    print(f"odd_sum: {solver.Value(odd_sum_var)}")
    print(f"even_sum: {solver.Value(even_sum_var)}")
    print(f"compute3: {solver.Value(compute3_var)}")
    print(f"Total latency: {solver.ObjectiveValue()}")
    print(f"Total area: {solver.Value(total_area)}")
else:
    print("No feasible solution found.")
'''
