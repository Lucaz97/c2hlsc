  #pragma HLS ARRAY_PARTITION variable=RoundKey cyclic factor=16 dim=1
  for (uint8_t i = 0; i < 4; ++i) {
    #pragma HLS UNROLL yes
    for (uint8_t j = 0; j < 4; ++j) {
      #pragma HLS UNROLL yes
      state[i][j] ^= RoundKey[(round << 4) + (i << 2) + j];
    }
  }
}

