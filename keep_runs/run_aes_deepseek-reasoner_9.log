from ortools.sat.python import cp_model

functions = {
    'AddRoundKey_hls': [
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1900.5, 'latency': 16.0},
        {'area': 1900.5, 'latency': 16.0},
    ],
    'SubBytes_hls': [
        {'area': 826.5, 'latency': 33.0} for _ in range(5)
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0} for _ in range(5)
    ],
    'xtime': [
        {'area': 77.0, 'latency': 1.0} for _ in range(5)
    ],
    'MixColumns': [
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.3, 'latency': 6.0},
        {'area': 635.3, 'latency': 6.0},
        {'area': 648.1, 'latency': 6.0},
    ],
    'Cipher': [
        {'area': 3714.0, 'latency': 672.0},
        {'area': 4418.2, 'latency': 644.0},
        {'area': 4418.2, 'latency': 644.0},
        {'area': 6683.8, 'latency': 626.0},
        {'area': 4418.2, 'latency': 644.0},
    ],
}

model = cp_model.CpModel()

# Variables only for parent functions (Cipher)
cipher_var = model.NewIntVar(0, 4, 'Cipher')

# Extract Cipher options
cipher_areas = [int(opt['area'] * 100) for opt in functions['Cipher']]
cipher_latencies = [int(opt['latency'] * 100) for opt in functions['Cipher']]

# Total area and latency from Cipher only
total_area = model.NewIntVar(min(cipher_areas), max(cipher_areas), 'total_area')
total_latency = model.NewIntVar(min(cipher_latencies), max(cipher_latencies), 'total_latency')

model.AddElement(cipher_var, cipher_areas, total_area)
model.AddElement(cipher_var, cipher_latencies, total_latency)

# Area constraints (9,500-10,500)
model.Add(total_area >= 9500 * 100)
model.Add(total_area <= 10500 * 100)

model.Minimize(total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    cipher_opt = solver.Value(cipher_var)
    print(f"solution: Cipher {cipher_opt} (Auto-selected child options)")
else:
    print("No solution found")
