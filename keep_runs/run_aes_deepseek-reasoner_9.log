  MixColumns_hls(state); \
  AddRoundKey_hls(r, state, RoundKey);

static void Cipher(state_t *state, const round_t *RoundKey)
{
  #pragma HLS ARRAY_PARTITION variable=state complete dim=0
  Cipher_hls(*state, *RoundKey);
}
