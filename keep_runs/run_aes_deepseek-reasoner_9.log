static void Cipher_hls(state_t state, const round_t RoundKey)
{
  #pragma HLS ARRAY_PARTITION variable=state complete dim=0
  #pragma HLS ARRAY_PARTITION variable=RoundKey complete dim=1
  
  AddRoundKey_hls(0, state, RoundKey);

  // Full manual unrolling with hierarchical optimization
  #pragma HLS INLINE recursive
  UNROLL_ROUND(1); UNROLL_ROUND(2); UNROLL_ROUND(3);
  UNROLL_ROUND(4); UNROLL_ROUND(5); UNROLL_ROUND(6);
  UNROLL_ROUND(7); UNROLL_ROUND(8); UNROLL_ROUND(9);

