static void MixColumns_hls(state_t state) {
  #pragma HLS unroll yes
  for (int i = 0; i < 4; ++i) {
    #pragma HLS latency min=3 max=3
    // Stage 1: Independent value loading
    uint8_t a = state[i][0], b = state[i][1], c = state[i][2], d = state[i][3];
    
    // Stage 2: Parallel GF operations
    uint8_t Tm0 = xtime(a ^ b);
    uint8_t Tm1 = xtime(b ^ c);
    uint8_t Tm2 = xtime(c ^ d);
    uint8_t Tm3 = xtime(d ^ a);

    // Stage 3: Direct transformation without Tmp
    state[i][0] = Tm0 ^ b ^ c ^ d;
    state[i][1] = Tm1 ^ a ^ c ^ d;
    state[i][2] = Tm2 ^ a ^ b ^ d;
    state[i][3] = Tm3 ^ a ^ b ^ c;
  }
}

static void MixColumns(state_t *state) {
  #pragma HLS inline
  MixColumns_hls(*state);
}
