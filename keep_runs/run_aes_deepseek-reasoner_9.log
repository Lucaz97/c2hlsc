static void ShiftRows_hls(state_t state) {
  #pragma HLS array_partition variable=state complete dim=0
  #pragma HLS interface variable=state register

  // Parallel read phase
  const uint8_t initial_state[4][4] = {
    {state[0][0], state[0][1], state[0][2], state[0][3]},
    {state[1][0], state[1][1], state[1][2], state[1][3]},
    {state[2][0], state[2][1], state[2][2], state[2][3]},
    {state[3][0], state[3][1], state[3][2], state[3][3]}
  };

  // Parallel write phase with direct rotational mapping
  state[0][1] = initial_state[1][1];
  state[1][1] = initial_state[2][1];
  state[2][1] = initial_state[3][1];
  state[3][1] = initial_state[0][1];

  state[0][2] = initial_state[2][2];
  state[2][2] = initial_state[0][2];
  state[1][2] = initial_state[3][2];
  state[3][2] = initial_state[1][2];

  state[0][3] = initial_state[3][3];
  state[3][3] = initial_state[2][3];
  state[2][3] = initial_state[1][3];
  state[1][3] = initial_state[0][3];
}

static void ShiftRows(state_t *state) {
  ShiftRows_hls(*state);
}
