static void MixColumns_hls(state_t state) {
  #pragma HLS unroll yes
  for (int i = 0; i < 4; ++i) {
    #pragma HLS latency min=3 max=3
    // Phase 1: Parallel input loading
    uint8_t a = state[i][0], b = state[i][1], c = state[i][2], d = state[i][3];
    
    // Phase 2: Parallel GF decomposition
    uint8_t ab_xor = a ^ b;
    uint8_t bc_xor = b ^ c;
    uint8_t cd_xor = c ^ d;
    uint8_t da_xor = d ^ a;
    uint8_t Tmp = ab_xor ^ cd_xor;
    
    // Phase 3: Pipelined GF multiplications
    #pragma HLS expression_balance
    uint8_t Tm0 = xtime(ab_xor);
    uint8_t Tm1 = xtime(bc_xor);
    uint8_t Tm2 = xtime(cd_xor);
    uint8_t Tm3 = xtime(da_xor);

    // Phase 4: Parallel output computation
    state[i][0] = a ^ Tm0 ^ Tmp;
    state[i][1] = b ^ Tm1 ^ Tmp;
    state[i][2] = c ^ Tm2 ^ Tmp;
    state[i][3] = d ^ Tm3 ^ Tmp;
  }
}

static void MixColumns(state_t *state) {
  #pragma HLS inline
  MixColumns_hls(*state);
}
