        {'area': 77.0, 'latency': 1.0} for _ in range(5)
    ],
    'MixColumns': [
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.3, 'latency': 6.0},
        {'area': 635.3, 'latency': 6.0},
        {'area': 648.1, 'latency': 6.0},
    ],
    'Cipher': [
        {'area': 3714.0, 'latency': 672.0},
        {'area': 4418.2, 'latency': 644.0},
        {'area': 4418.2, 'latency': 644.0},
        {'area': 6683.8, 'latency': 626.0},
        {'area': 4418.2, 'latency': 644.0},
    ],
}

model = cp_model.CpModel()
option_vars = {}
area_vars = {}
latency_vars = {}

for func in functions:
    option_vars[func] = model.NewIntVar(0, 4, func)
    areas = [int(opt['area'] * 100) for opt in functions[func]]
    latencies = [int(opt['latency'] * 100) for opt in functions[func]]
    area_var = model.NewIntVar(min(areas), max(areas), f'area_{func}')
    latency_var = model.NewIntVar(min(latencies), max(latencies), f'latency_{func}')
    model.AddElement(option_vars[func], areas, area_var)
    model.AddElement(option_vars[func], latencies, latency_var)
    area_vars[func] = area_var
    latency_vars[func] = latency_var

total_area = sum(area_vars[func] for func in functions)
total_latency = sum(latency_vars[func] for func in functions)
target_area = 10000 * 100
model.Add(total_area <= target_area + 50000)  # Allow up to 10500
model.Add(total_area >= target_area - 50000)  # Allow down to 9500

model.Minimize(total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Solution:")
    for func in functions:
        opt = solver.Value(option_vars[func])
        print(f"{func} {opt}", end=', ')
    print(f"\nTotal Area: {solver.Value(total_area)/100}, Total Latency: {solver.Value(total_latency)/100}")
else:
    print("No solution found.")
