void sha256_transform_hls(unsigned int state[8], unsigned char data[64])
{
  unsigned int a, b, c, d, e, f, g, h;
  unsigned int i, t1, t2;
  unsigned int m[64];
  unsigned int j;

  // Stage 1: Load the first 16 words from input data.
  // Fully unrolling these small‐iterations minimizes latency.
  #pragma HLS unroll yes
