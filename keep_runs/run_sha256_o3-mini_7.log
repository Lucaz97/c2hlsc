void sha256_update_hls(unsigned char data_int[64],
                       unsigned int datalen_int[1],
                       unsigned int state[8],
                       unsigned long long bitlen_int[1],
                       const unsigned char *data,
                       unsigned int len)
{
    unsigned int local_datalen = datalen_int[0];
    unsigned int i = 0;
    unsigned int j = 0;

    // If there is data left from previous update, fill the current block first.
    if (local_datalen > 0) {
        unsigned int fill = 64 - local_datalen;
        if (len < fill) {
            for(i = 0; i < len; i++) {
                data_int[local_datalen + i] = data[i];
            }
            local_datalen += len;
            datalen_int[0] = local_datalen;
            return;
        }
        else {
            for(i = 0; i < fill; i++) {
                data_int[local_datalen + i] = data[i];
            }
            sha256_transform_hls(state, data_int);
            bitlen_int[0] += 512;
            local_datalen = 0;
            i = fill;
        }
    }

    // Process all full 64-byte chunks directly.
    for (; i + 63 < len; i += 64) {
        for (j = 0; j < 64; j++) {
            data_int[j] = data[i + j];
        }
        sha256_transform_hls(state, data_int);
        bitlen_int[0] += 512;
    }

    // Copy the remaining bytes into data_int.
    for (; i < len; i++) {
        data_int[local_datalen] = data[i];
        local_datalen++;
    }
    datalen_int[0] = local_datalen;
}

void sha256_update(data_t *data_int,
                   unsigned int *datalen_int,
                   state_t *state,
                   unsigned long long int *bitlen_int,
                   data_t data[],
                   size_t len)
{
    sha256_update_hls(*data_int,
                      datalen_int,
                      *state,
                      bitlen_int,
                      (const unsigned char *)data,
                      (unsigned int)len);
}
