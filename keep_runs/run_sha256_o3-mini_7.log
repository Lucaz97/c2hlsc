  // Stage 2: Expand the message schedule (words 16..63)
  // Fully unrolling these iterations creates a combinational network.
  #pragma HLS unroll yes
  for (i = 16; i < 64; ++i)
    m[i] = SIG1(m[i - 2]) + m[i - 7] + SIG0(m[i - 15]) + m[i - 16];

  // Initialize working variables with current hash state.
  a = state[0];
  b = state[1];
  c = state[2];
  d = state[3];
  e = state[4];
  f = state[5];
  g = state[6];
  h = state[7];

  // Stage 3: Main compression loop.
  // To reduce the effective sequential depth (and hence cycle latency)
  // we combine two rounds per loop iteration.
  // This halves the number of sequential steps relative to the original 64 rounds.
  #pragma HLS unroll yes
  for (i = 0; i < 32; i++) {
