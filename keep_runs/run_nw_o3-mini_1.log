void needwun(char seqA[16], char seqB[16],
             char alignedA[16 + 16],
             char alignedB[16 + 16],
             int M[16 + 1][16 + 1],
             char ptr[16 + 1][16 + 1])
{
    // Apply the dataflow directive so that, if possible, the synthesis tool
    // can schedule operations from fill_matrix and traceback as separate processes.
    // Although traceback depends on the result of fill_matrix (so full overlap is not possible),
    // this gives more scheduling freedom and can reduce the effective latency in some cases.
    #pragma HLS dataflow

    // Force inlining of the child function bodies to expose all internal logic
    // to the scheduler.
    #pragma HLS inline region
    fill_matrix(seqA, seqB, M, ptr);

    #pragma HLS inline region
    traceback(seqA, seqB, alignedA, alignedB, M, ptr);
}
