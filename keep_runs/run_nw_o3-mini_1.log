void fill_matrix(char seqA[16], char seqB[16], int M[16 + 1][16 + 1], char ptr[16 + 1][16 + 1])
{
  int score;
  int up_left;
  int up;
  int left;
  int max;
  int i, j;
  int d;
  int i_min;
  int i_max;

  // Initialize first row and first column; these loops are small so fully unroll them.
  for (i = 0; i < (16 + 1); i++) {
    #pragma hls_unroll yes
    M[0][i] = -i;
  }
  for (i = 0; i < (16 + 1); i++) {
    #pragma hls_unroll yes
    M[i][0] = -i;
  }

  // Compute the DP table in anti-diagonal order.
  // In this version, we pipeline the inner loop instead of fully unrolling it, 
  // which helps reduce area while still keeping latency low.
  // d is the anti-diagonal index and runs from 2 to 32 for a 17x17 matrix.
  for (d = 2; d <= (16 + 16); d++) {
    // Determine the valid range for row index i:
    i_min = (d > 16) ? (d - 16) : 1;
    i_max = (d - 1 < 16) ? (d - 1) : 16;
    for (i = i_min; i <= i_max; i++) {
      #pragma hls_pipeline_init_interval 1
      j = d - i;
      // Compute the match or mismatch score. Note that seqA and seqB are 0-indexed.
      score = (seqA[j - 1] == seqB[i - 1]) ? MATCH_SCORE : MISMATCH_SCORE;
      up_left = M[i - 1][j - 1] + score;
      up      = M[i - 1][j]     + GAP_SCORE;
      left    = M[i][j - 1]     + GAP_SCORE;
      max = (up_left > ((up > left) ? up : left)) ? up_left : ((up > left) ? up : left);
      M[i][j] = max;
      
      if (max == left)
      {
        ptr[i][j] = SKIPB;
      }
      else if (max == up)
      {
        ptr[i][j] = SKIPA;
      }
      else
      {
        ptr[i][j] = ALIGN;
      }
    }
  }
}
