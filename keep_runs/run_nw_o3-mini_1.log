void traceback(char seqA[16], char seqB[16],
               char alignedA[16 + 16], char alignedB[16 + 16],
               int M[16 + 1][16 + 1], char ptr[16 + 1][16 + 1])
{
  int a_idx     = ALEN;
  int b_idx     = BLEN;
  int a_str_idx = 0;
  int b_str_idx = 0;

  // Because the maximum number of steps is fixed (ALEN+BLEN = 32),
  // we can break the dependency chain into segments.
  // Here we divide the 32 iterations into 8 segments of 4 iterations each.
  // The inner loop is fully unrolled to combine 4 steps into a short combinational chain,
  // and the outer loop is pipelined (II=1) to insert pipeline registers between segments.
  const int inner_iter = 4;
  const int seg_iter = (ALEN + BLEN + inner_iter - 1) / inner_iter;  // 32/4=8

  for (int seg = 0; seg < seg_iter; seg++) {
    #pragma HLS PIPELINE II=1
    for (int j = 0; j < inner_iter; j++) {
      #pragma HLS UNROLL yes
      if ((a_idx > 0) || (b_idx > 0))
      {
        // Evaluate the traceback direction for the current cell.
        char direction = ptr[b_idx][a_idx];
        if (direction == ALIGN) {
          alignedA[a_str_idx++] = seqA[a_idx - 1];
          alignedB[b_str_idx++] = seqB[b_idx - 1];
          a_idx--;
          b_idx--;
        }
        else if (direction == SKIPB) {
          alignedA[a_str_idx++] = seqA[a_idx - 1];
          alignedB[b_str_idx++] = '-';
          a_idx--;
        }
        else {
          alignedA[a_str_idx++] = '-';
          alignedB[b_str_idx++] = seqB[b_idx - 1];
          b_idx--;
        }
      }
    }
  }

  // Reverse the aligned strings to complete the traceback result.
  reverse_string(alignedA, a_str_idx);
  reverse_string(alignedB, b_str_idx);
}
