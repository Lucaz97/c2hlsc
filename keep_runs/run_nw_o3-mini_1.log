void fill_matrix(char seqA[16], char seqB[16], int M[16 + 1][16 + 1], char ptr[16 + 1][16 + 1])
{
  int score;
  int up_left;
  int up;
  int left;
  int max;
  int row;
  int row_up;
  int a_idx;
  int b_idx;

  // Initialize first row of the scoring matrix
  for (a_idx = 0; a_idx < (16 + 1); a_idx++)
  {
    #pragma hls_unroll yes
    M[0][a_idx] = a_idx * (-1);
  }

  // Initialize first column of the scoring matrix
  for (b_idx = 0; b_idx < (16 + 1); b_idx++)
  {
    #pragma hls_unroll yes
    M[b_idx][0] = b_idx * (-1);
  }

  // Main dynamic programming loop
  for (b_idx = 1; b_idx < (16 + 1); b_idx++)
  {
    for (a_idx = 1; a_idx < (16 + 1); a_idx++)
    {
      #pragma hls_pipeline_init_interval 1
      score = (seqA[a_idx - 1] == seqB[b_idx - 1]) ? MATCH_SCORE : MISMATCH_SCORE;
      row_up = b_idx - 1;
      row = b_idx;
      up_left = M[row_up][a_idx - 1] + score;
      up = M[row_up][a_idx] + GAP_SCORE;
      left = M[row][a_idx - 1] + GAP_SCORE;
      max = (up_left > ((up > left) ? up : left)) ? up_left : ((up > left) ? up : left);
      M[row][a_idx] = max;
      
      if (max == left)
      {
        ptr[row][a_idx] = SKIPB;
      }
      else if (max == up)
      {
        ptr[row][a_idx] = SKIPA;
      }
      else
      {
        ptr[row][a_idx] = ALIGN;
      }
    }
  }
}
