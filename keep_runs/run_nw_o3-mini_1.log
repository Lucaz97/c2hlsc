void reverse_string(char str[16 + 16], int length)
{
    int half = length >> 1;
    for (int i = 0; i < half; i++) {
        #pragma hls_unroll yes
        // Use XOR‐swap to exchange elements without an extra temporary variable.
        str[i]          ^= str[length - i - 1];
        str[length - i - 1] ^= str[i];
        str[i]          ^= str[length - i - 1];
    }
}
```
