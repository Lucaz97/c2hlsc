  int row_up;
  int a_idx;
  int b_idx;

  // Fully unroll initialization loops to minimize latency
  for (a_idx = 0; a_idx < (16 + 1); a_idx++)
  {
    #pragma hls_unroll yes
    M[0][a_idx] = a_idx * (-1);
  }
  for (b_idx = 0; b_idx < (16 + 1); b_idx++)
  {
    #pragma hls_unroll yes
    M[b_idx][0] = b_idx * (-1);
