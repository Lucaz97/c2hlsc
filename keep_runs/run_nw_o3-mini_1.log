void fill_matrix_hls(char seqA[ALEN], char seqB[BLEN], int M[ALEN + 1][BLEN + 1], char ptr[ALEN + 1][BLEN + 1])
{
  int score;
  int up_left;
  int up;
  int left;
  int max;
  int row;
  int row_up;
  int a_idx;
  int b_idx;

  // Fully unroll the small initialization loops in hardware by writing
  // them as regular loops in HLS-friendly C code.
  for (a_idx = 0; a_idx < (ALEN + 1); a_idx++)
  {
    M[0][a_idx] = -a_idx;
  }
  for (b_idx = 0; b_idx < (BLEN + 1); b_idx++)
  {
    M[b_idx][0] = -b_idx;
  }

  // Calculate matrix values. The outer loop is pipelined by the HLS tool
  // and the inner loop is kept sequential to respect the dependencies.
  for (b_idx = 1; b_idx < (BLEN + 1); b_idx++)
  {
    for (a_idx = 1; a_idx < (ALEN + 1); a_idx++)
    {
      score = (seqA[a_idx - 1] == seqB[b_idx - 1]) ? MATCH_SCORE : MISMATCH_SCORE;
      row_up = b_idx - 1;
      row = b_idx;
      up_left = M[row_up][a_idx - 1] + score;
      up = M[row_up][a_idx] + GAP_SCORE;
      left = M[row][a_idx - 1] + GAP_SCORE;
      max = (up_left > ((up > left) ? up : left)) ? up_left : ((up > left) ? up : left);
      M[row][a_idx] = max;

      if (max == left)
      {
        ptr[row][a_idx] = SKIPB;
      }
      else if (max == up)
      {
        ptr[row][a_idx] = SKIPA;
      }
      else
      {
        ptr[row][a_idx] = ALIGN;
      }
    }
  }
}

void fill_matrix(char seqA[ALEN], char seqB[BLEN], int M[ALEN + 1][BLEN + 1], char ptr[ALEN + 1][BLEN + 1])
{
  fill_matrix_hls(seqA, seqB, M, ptr);
}
