// In this revision we force full inlining of the entire call hierarchy by using a recursive
// inlining directive. This gives the HLS tool full visibility into the combined dataflow
// of fill_matrix and traceback, which can help reduce the overall latency further.
// Note: In many HLS flows, the maximum latency reduction for needwun is limited by the internal
// dependencies of these child functions. Further improvements may require optimizations
// within fill_matrix and traceback.
__attribute__((always_inline))
void needwun(char seqA[16], char seqB[16],
             char alignedA[16 + 16],
             char alignedB[16 + 16],
             int M[16 + 1][16 + 1],
             char ptr[16 + 1][16 + 1])
{
    // Force the HLS compiler to recursively inline all functions that are called within needwun
    // so that any potential inter-function optimization opportunities can be exploited.
    #pragma HLS inline region recursive

    fill_matrix(seqA, seqB, M, ptr);
    traceback(seqA, seqB, alignedA, alignedB, M, ptr);
}
