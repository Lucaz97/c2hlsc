void traceback(char seqA[16], char seqB[16],
               char alignedA[16 + 16], char alignedB[16 + 16],
               int M[16 + 1][16 + 1], char ptr[16 + 1][16 + 1])
{
  int a_idx    = ALEN;
  int b_idx    = BLEN;
  int a_str_idx = 0;
  int b_str_idx = 0;
  // The maximum number of backtrace iterations is fixed.
  const int max_iter = ALEN + BLEN;

  // Fully unroll the loop to create a combinational chain that resolves
  // the sequential dependency in a single (or few) clock cycles.
  // This is aimed at minimizing latency.
  for (int i = 0; i < max_iter; i++) {
    #pragma HLS UNROLL yes
    // Only execute if there is work remaining.
    if ((a_idx > 0) || (b_idx > 0))
    {
      if (ptr[b_idx][a_idx] == ALIGN) {
        alignedA[a_str_idx++] = seqA[a_idx - 1];
        alignedB[b_str_idx++] = seqB[b_idx - 1];
        a_idx--;
        b_idx--;
      }
      else if (ptr[b_idx][a_idx] == SKIPB) {
        alignedA[a_str_idx++] = seqA[a_idx - 1];
        alignedB[b_str_idx++] = '-';
        a_idx--;
      }
      else {
        alignedA[a_str_idx++] = '-';
        alignedB[b_str_idx++] = seqB[b_idx - 1];
        b_idx--;
      }
    }
  }

  // Reverse the aligned sequences.
  reverse_string(alignedA, a_str_idx);
  reverse_string(alignedB, b_str_idx);
}
