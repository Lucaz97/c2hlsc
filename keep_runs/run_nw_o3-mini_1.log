void traceback(char seqA[16], char seqB[16],
               char alignedA[16 + 16], char alignedB[16 + 16],
               int M[16 + 1][16 + 1], char ptr[16 + 1][16 + 1])
{
  // Use the defined constants for clarity
  int a_idx = ALEN;
  int b_idx = BLEN;
  int a_str_idx = 0;
  int b_str_idx = 0;
  // The maximum number of iterations is bounded by ALEN+BLEN.
  int max_iter = ALEN + BLEN;

  // Transform the while loop to a fixed-bound for loop with a break.
  // Fully unroll the loop to eliminate the sequential iteration overhead,
  // thereby reducing the overall latency.
  for (int i = 0; i < max_iter; i++) {
    #pragma HLS UNROLL yes
    if ((a_idx == 0) && (b_idx == 0))
      break;

    // Using ptr[b_idx][a_idx] instead of ptr[r][a_idx] since r == b_idx.
    if (ptr[b_idx][a_idx] == ALIGN) {
      alignedA[a_str_idx++] = seqA[a_idx - 1];
      alignedB[b_str_idx++] = seqB[b_idx - 1];
      a_idx--;
      b_idx--;
    }
    else if (ptr[b_idx][a_idx] == SKIPB) {
      alignedA[a_str_idx++] = seqA[a_idx - 1];
      alignedB[b_str_idx++] = '-';
      a_idx--;
    }
    else {
      alignedA[a_str_idx++] = '-';
      alignedB[b_str_idx++] = seqB[b_idx - 1];
      b_idx--;
    }
  }

  // Reverse the aligned sequences.
  reverse_string(alignedA, a_str_idx);
  reverse_string(alignedB, b_str_idx);
}
