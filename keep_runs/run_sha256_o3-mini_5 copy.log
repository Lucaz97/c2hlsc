python: '''from ortools.sat.python import cp_model

# Data for each function option (index, area, latency)
# For sha256_transform_hls: 5 options, indexed 0..4
transform_options = [
    (0, 33383, 65),  # Option 0, rounding the area values to nearest integer
    (1, 33383, 65),  # Option 1
    (2, 35577, 65),  # Option 2
    (3, 33383, 65),  # Option 3
    (4, 33383, 65)   # Option 4
]

# For sha256_update_hls: 5 options, indexed 0..4
update_options = [
    (0, 37554, 68),  # Option 0
    (1, 42774, 266), # Option 1
    (2, 37847, 68),  # Option 2
    (3, 38479, 68),  # Option 3
    (4, 47481, 266)  # Option 4
]

# Target total area
target_area = 70000

# Weight factor for area error
# We use a weighted sum objective: objective = total_latency + weight * area_deviation.
# Latency values are around 65-266 while area errors can be in the thousands so the weight is chosen to have a balanced tradeoff.
weight = 1  # you can adjust this weight based on tradeoffs

model = cp_model.CpModel()

# Decision variables: indices for transform and update
transform_var = model.NewIntVar(0, len(transform_options)-1, 'transform')
update_var = model.NewIntVar(0, len(update_options)-1, 'update')

# Create lookup arrays for area and latency for each function
transform_area = [area for (_, area, _) in transform_options]
transform_latency = [lat for (_, _, lat) in transform_options]

update_area = [area for (_, area, _) in update_options]
update_latency = [lat for (_, _, lat) in update_options]

# Define total area and total latency as linear expressions:
# Since options data is known, we build element constraints.
total_area = model.NewIntVar(0, 1000000, 'total_area')
total_latency = model.NewIntVar(0, 1000000, 'total_latency')

model.Add(total_area == 
          cp_model.LinearExpr.WeightedSum([transform_var, update_var], [0,0]) 
          + cp_model.LinearExpr.Element(transform_area, transform_var) + cp_model.LinearExpr.Element(update_area, update_var))
model.Add(total_latency == cp_model.LinearExpr.Element(transform_latency, transform_var) + cp_model.LinearExpr.Element(update_latency, update_var))

# Now, define the absolute area deviation: deviation = |total_area - target_area|
deviation = model.NewIntVar(0, 1000000, 'deviation')
diff = model.NewIntVar(-1000000, 1000000, 'diff')
model.Add(diff == total_area - target_area)
model.AddAbsEquality(deviation, diff)

# Define objective: minimize total latency plus weighted area deviation.
# We want to primarily minimize latency and then have area as close to target as possible.
objective = model.NewIntVar(0, 10000000, 'objective')
model.Add(objective == total_latency + weight * deviation)
model.Minimize(objective)

# Solve.
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    chosen_transform = solver.Value(transform_var)
    chosen_update = solver.Value(update_var)
    best_latency = solver.Value(total_latency)
    best_area = solver.Value(total_area)
    area_error = solver.Value(deviation)
    print("Solution:")
    print("sha256_transform_hls option", chosen_transform, 
          "-> area =", transform_area[chosen_transform], 
          "latency =", transform_latency[chosen_transform])
    print("sha256_update_hls option", chosen_update, 
          "-> area =", update_area[chosen_update], 
          "latency =", update_latency[chosen_update])
    print("Total latency =", best_latency)
    print("Total area =", best_area, " (error =", area_error, "from", target_area,")")
else:
    print("No solution found.")
'''
