python: '''from ortools.sat.python import cp_model

# Data for each function option (index, area, latency)
# For sha256_transform_hls: 5 options, indexed 0..4
transform_options = [
    (0, 33383, 65),  # Option 0
    (1, 33383, 65),  # Option 1
    (2, 35577, 65),  # Option 2
    (3, 33383, 65),  # Option 3
    (4, 33383, 65)   # Option 4
]

# For sha256_update_hls: 5 options, indexed 0..4
update_options = [
    (0, 37554, 68),  # Option 0
    (1, 42774, 266), # Option 1
    (2, 37847, 68),  # Option 2
    (3, 38479, 68),  # Option 3
    (4, 47481, 266)  # Option 4
]

# Target total area
target_area = 70000

# Weight factor for area deviation relative to latency
weight = 1  # adjust if needed

model = cp_model.CpModel()

# Decision variables: indices for transform and update
transform_var = model.NewIntVar(0, len(transform_options)-1, 'transform')
update_var = model.NewIntVar(0, len(update_options)-1, 'update')

# Create arrays for areas and latencies
transform_area = [opt[1] for opt in transform_options]
transform_latency = [opt[2] for opt in transform_options]

update_area = [opt[1] for opt in update_options]
update_latency = [opt[2] for opt in update_options]

# Create intermediate variables for selected areas and latencies
transform_area_var = model.NewIntVar(min(transform_area), max(transform_area), 'transform_area_var')
transform_latency_var = model.NewIntVar(min(transform_latency), max(transform_latency), 'transform_latency_var')
update_area_var = model.NewIntVar(min(update_area), max(update_area), 'update_area_var')
update_latency_var = model.NewIntVar(min(update_latency), max(update_latency), 'update_latency_var')

model.AddElement(transform_var, transform_area, transform_area_var)
model.AddElement(transform_var, transform_latency, transform_latency_var)
model.AddElement(update_var, update_area, update_area_var)
model.AddElement(update_var, update_latency, update_latency_var)

# Total area and total latency
total_area = model.NewIntVar(0, 200000, 'total_area')
total_latency = model.NewIntVar(0, 1000, 'total_latency')

model.Add(total_area == transform_area_var + update_area_var)
model.Add(total_latency == transform_latency_var + update_latency_var)

# Define absolute deviation: deviation = |total_area - target_area|
deviation = model.NewIntVar(0, 100000, 'deviation')
diff = model.NewIntVar(-100000, 100000, 'diff')
model.Add(diff == total_area - target_area)
model.AddAbsEquality(deviation, diff)

# Objective: minimize total_latency plus weighted deviation
objective = model.NewIntVar(0, 1000000, 'objective')
model.Add(objective == total_latency + weight * deviation)
model.Minimize(objective)

# Solve the model.
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    chosen_transform = solver.Value(transform_var)
    chosen_update = solver.Value(update_var)
    best_latency = solver.Value(total_latency)
    best_area = solver.Value(total_area)
    area_error = solver.Value(deviation)
    print("Solution:")
    print("sha256_transform_hls option", chosen_transform,
          "-> area =", transform_area[chosen_transform],
          "latency =", transform_latency[chosen_transform])
    print("sha256_update_hls option", chosen_update,
          "-> area =", update_area[chosen_update],
          "latency =", update_latency[chosen_update])
    print("Total latency =", best_latency)
    print("Total area =", best_area, "(error =", area_error, "from", target_area, ")")
else:
    print("No solution found.")
'''
