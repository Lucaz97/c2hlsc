python: '''
from ortools.sat.python import cp_model

functions = {
    'fill_matrix': [
        {'area': 2206.1, 'latency': 1293.0},
        {'area': 2144.7, 'latency': 1293.0},
        {'area': 2597.8, 'latency': 213.0},
        {'area': 2407.3, 'latency': 2538.0},
        {'area': 2698.4, 'latency': 213.0},
    ],
    'reverse_string': [
        {'area': 1804.2, 'latency': 31.0},
        {'area': 1719.0, 'latency': 31.0},
        {'area': 1719.0, 'latency': 31.0},
        {'area': 1906.1, 'latency': 31.0},
        {'area': 3611.2, 'latency': 95.0},
    ],
    'traceback': [
        {'area': 10173.9, 'latency': 34.0},
        {'area': 10173.9, 'latency': 34.0},
        {'area': 10173.9, 'latency': 34.0},
        {'area': 9416.3, 'latency': 127.0},
        {'area': 10173.9, 'latency': 34.0},
    ],
    'needwun': [
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
    ],
}

target_area = 6000

model = cp_model.CpModel()

# Create variables and element constraints
config_vars = {}
area_vars = {}
latency_vars = {}

for f_name, options in functions.items():
    config_vars[f_name] = model.NewIntVar(0, len(options)-1, f_name)
    
    # Create area and latency variables with element constraints
    area_values = [int(opt['area']*10) for opt in options]  # Scale to integers
    latency_values = [int(opt['latency']*10) for opt in options]
    
    area_vars[f_name] = model.NewIntVar(0, int(1e6), f"{f_name}_area")
    latency_vars[f_name] = model.NewIntVar(0, int(1e6), f"{f_name}_latency")
    
    model.AddElement(config_vars[f_name], area_values, area_vars[f_name])
    model.AddElement(config_vars[f_name], latency_values, latency_vars[f_name])

# Create total expressions
total_area = sum(area_vars[f] for f in functions)
total_latency = sum(latency_vars[f] for f in functions)

# Area difference constraint (scaled by 10)
area_diff = model.NewIntVar(0, int(1e6), 'area_diff')
model.AddAbsEquality(area_diff, total_area - int(target_area*10))

# Minimize weighted sum of latency and area difference
model.Minimize(total_latency * 1000 + area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    config = {f: solver.Value(config_vars[f]) for f in functions}
    print("Best configuration:")
    for f, idx in config.items():
        print(f"{f}: option {idx} (area: {functions[f][idx]['area']}, latency: {functions[f][idx]['latency']})")
    print(f"Total latency: {solver.Value(total_latency)/10:.1f}")
    print(f"Total area: {solver.Value(total_area)/10:.1f}")
    print(f"Area difference: {abs(solver.Value(total_area)/10 - target_area):.1f}")
else:
    print("No solution found")
'''
