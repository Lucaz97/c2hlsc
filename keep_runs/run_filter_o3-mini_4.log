python: ''' 
from ortools.sat.python import cp_model
import math

# Scale factor to work with integers.
scale = 10

# Data for each function: list of (area, latency, throughput)
functions = {
    "shift": [(1451.8, 2.0, 4.0), (1929.7, 2.0, 4.0), (1451.8, 2.0, 4.0), (1546.9, 3.0, 5.0), (1451.8, 2.0, 4.0)],
    "mac":   [(4346.7, 2.0, 3.0), (6690.9, 6.0, 7.0), (4346.7, 2.0, 3.0), (4346.7, 2.0, 3.0), (6690.9, 6.0, 7.0)],
    "fir":   [(5043.1, 10.0, 11.0), (5043.1, 10.0, 11.0), (6135.1, 5.0, 6.0), (4901.3, 10.0, 11.0), (6219.2, 5.0, 6.0)],
    "iir":   [(8132.5, 16.0, 22.0), (8160.4, 16.0, 22.0), (8160.4, 16.0, 22.0), (8160.4, 16.0, 22.0), (8630.3, 10.0, 11.0)],
    "filter": [(3440.3, 1.0, 2.0)] * 5  # All filter options are identical.
}

# Precompute scaled integer values for areas and latencies.
areas = { f: [int(round(opt[0]*scale)) for opt in opts] for f, opts in functions.items() }
latencies = { f: [int(round(opt[1]*scale)) for opt in opts] for f, opts in functions.items() }
# Note: Throughput is not directly used in the optimization here.

# Create the CP-SAT model.
model = cp_model.CpModel()

# Decision variables: choice index for each function.
choice = {}
for f, opts in functions.items():
    choice[f] = model.NewIntVar(0, len(opts)-1, f + "_choice")

# Create variables for each function's area and latency.
area_vars = {}
latency_vars = {}
for f in functions:
    area_vars[f] = model.NewIntVar(0, 100000, f + "_area")
    latency_vars[f] = model.NewIntVar(0, 100000, f + "_latency")
    model.AddElement(choice[f], areas[f], area_vars[f])
    model.AddElement(choice[f], latencies[f], latency_vars[f])

# For this optimization, we assume a simplistic additive model.
# Total area is the sum of the areas of all functions.
total_area = model.NewIntVar(0, 100000, "total_area")
model.Add(total_area == sum(area_vars[f] for f in functions))

# Total latency is taken as the sum of latencies.
total_latency = model.NewIntVar(0, 100000, "total_latency")
model.Add(total_latency == sum(latency_vars[f] for f in functions))

# The target area (scaled by 'scale').
target_area = 6000 * scale

# Define an auxiliary variable for the absolute difference from the target area.
area_diff = model.NewIntVar(0, 100000, "area_diff")
model.Add(area_diff == abs(total_area - target_area))

# Our objective is to minimize latency first and then area difference.
# We combine them into one objective by weighting latency heavily.
# Objective = total_latency * W + area_diff, where W is a large weight.
W = 10000
objective = model.NewIntVar(0, 10000000, "objective")
model.Add(objective == total_latency * W + area_diff)
model.Minimize(objective)

# Solve the model.
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    result = { f: solver.Value(choice[f]) for f in functions }
    print("Optimal function option selection:")
    for f in functions:
        idx = result[f]
        print(f + ": option", idx, "(area =", areas[f][idx]/scale, ", latency =", latencies[f][idx]/scale, ")")
    print("Total area =", solver.Value(total_area)/scale)
    print("Total latency =", solver.Value(total_latency)/scale)
    print("Area difference from target =", abs(solver.Value(total_area) - target_area)/scale)
else:
    print("No solution found")
'''
