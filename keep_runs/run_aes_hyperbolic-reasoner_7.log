    ],
    'SubBytes_hls': [
        {'area': 8265, 'latency': 330},
        {'area': 8259, 'latency': 330},
        {'area': 8259, 'latency': 330},
        {'area': 8259, 'latency': 330},
        {'area': 8259, 'latency': 330},
    ],
    'ShiftRows_hls': [
        {'area': 239, 'latency': 0},
        {'area': 239, 'latency': 0},
        {'area': 239, 'latency': 0},
        {'area': 239, 'latency': 0},
        {'area': 239, 'latency': 0},
    ],
    'xtime': [
        {'area': 770, 'latency': 10},
        {'area': 770, 'latency': 10},
        {'area': 770, 'latency': 10},
        {'area': 770, 'latency': 10},
        {'area': 770, 'latency': 10},
    ],
    'MixColumns_hls': [
        {'area': 6359, 'latency': 60},
        {'area': 6359, 'latency': 60},
        {'area': 6359, 'latency': 60},
        {'area': 6359, 'latency': 60},
        {'area': 6359, 'latency': 60},
    ],
    'Cipher_hls': [
        {'area': 26328, 'latency': 10910},
        {'area': 36855, 'latency': 10110},
        {'area': 26328, 'latency': 10910},
        {'area': 36855, 'latency': 10110},
        {'area': 26655, 'latency': 10290},
    ],
}

call_counts = {
    'AddRoundKey_hls': 3,
    'SubBytes_hls': 1,
    'ShiftRows_hls': 1,
    'MixColumns_hls': 1,
    'xtime': 4,
    'Cipher_hls': 1,
}

model = cp_model.CpModel()

# Create variables for each function's option (0-4)
option_vars = {func: model.NewIntVar(0, 4, f'{func}_option') for func in functions}

# Total area and latency calculations using integer arithmetic
total_area = 0
total_latency = 0

for func in functions:
    # Get pre-scaled integer values
    areas = [functions[func][i]['area'] for i in range(5)]
    latencies = [functions[func][i]['latency'] * call_counts[func] for i in range(5)]
    
    # Area contribution
    area_var = model.NewIntVar(0, max(areas), f'{func}_area')
    model.AddElement(option_vars[func], areas, area_var)
    total_area += area_var
    
    # Latency contribution
    latency_var = model.NewIntVar(0, max(latencies), f'{func}_latency')
    model.AddElement(option_vars[func], latencies, latency_var)
    total_latency += latency_var

# Target area constraints (10000*10 ±5%)
model.Add(total_area >= 95000)  # 95% of 100000
model.Add(total_area <= 105000) # 105% of 100000

# Objective: minimize total latency
model.Minimize(total_latency)

# Solve
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output results
if status == cp_model.OPTIMAL:
    print("Optimal Configuration:")
    for func in functions:
        opt = solver.Value(option_vars[func])
        print(f"{func}: option {opt} (area: {functions[func][opt]['area']/10}, latency: {functions[func][opt]['latency']/10})")
    print(f"Total Area: {solver.Value(total_area)/10}")
    print(f"Total Latency: {solver.Value(total_latency)/10}")
else:
    print("No solution found. Status:", solver.StatusName(status))
