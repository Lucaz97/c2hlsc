from ortools.sat.python import cp_model

# Define the functions and their options
functions = {
    'AddRoundKey_hls': [
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1816.7, 'latency': 49.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
    ],
    'SubBytes_hls': [
        {'area': 826.5, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
    ],
    'xtime': [
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
    ],
    'MixColumns_hls': [
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
    ],
    'Cipher_hls': [
        {'area': 2632.8, 'latency': 1091.0},
        {'area': 3685.5, 'latency': 1011.0},
        {'area': 2632.8, 'latency': 1091.0},
        {'area': 3685.5, 'latency': 1011.0},
        {'area': 2665.5, 'latency': 1029.0},
    ],
}

# Call graph contributions (number of calls per function)
call_counts = {
    'AddRoundKey_hls': 3,
    'SubBytes_hls': 1,
    'ShiftRows_hls': 1,
    'MixColumns_hls': 1,
    'xtime': 4,
    'Cipher_hls': 1,
}

model = cp_model.CpModel()

# Create variables for each function's option
option_vars = {func: model.NewIntVar(0, 4, f'{func}_option') for func in functions}

# Total area and latency calculations
total_area = 0
total_latency = 0
for func in functions:
    # Area contribution
    areas = [functions[func][i]['area'] * 10 for i in range(5)]  # Scale to avoid floats
    area_var = model.NewIntVar(0, int(max(areas)), f'{func}_area')
    model.AddElement(option_vars[func], areas, area_var)
    total_area += area_var

    # Latency contribution
    latency = [functions[func][i]['latency'] * call_counts[func] * 10 for i in range(5)]
    latency_var = model.NewIntVar(0, int(max(latency)), f'{func}_latency')
    model.AddElement(option_vars[func], latency, latency_var)
    total_latency += latency_var

# Target area constraints (10000 ± 5%)
target_area = 10000 * 10
deviation = 500  # 5% of 10000
model.Add(total_area >= target_area - deviation)
model.Add(total_area <= target_area + deviation)

# Objective: minimize total latency
model.Minimize(total_latency)

# Solve
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output results
if status == cp_model.OPTIMAL:
    print("Optimal Configuration:")
    for func in functions:
        opt = solver.Value(option_vars[func])
        print(f"{func}: option {opt} (area: {functions[func][opt]['area']}, latency: {functions[func][opt]['latency']})")
    print(f"Total Area: {solver.Value(total_area)/10}")
    print(f"Total Latency: {solver.Value(total_latency)/10}")
else:
    print("No optimal solution found.")
