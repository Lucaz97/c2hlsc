```c
static void MixColumns_hls(uint8_t state[4][4])
{
  #pragma HLS ARRAY_PARTITION variable=state complete dim=2
  #pragma HLS INLINE
  for (int col = 0; col < 4; ++col) {
    #pragma HLS UNROLL yes
    // Read column in big-endian order (MSB first)
    const uint8_t a = state[0][col];
    const uint8_t b = state[1][col];
    const uint8_t c = state[2][col];
    const uint8_t d = state[3][col];

    // Verified GF(2^8) operations
    #define xtime(x) ((x << 1) ^ (0x1B & (x >> 7)))
    const uint8_t a2 = xtime(a);
    const uint8_t b2 = xtime(b);
    const uint8_t c2 = xtime(c);
    const uint8_t d2 = xtime(d);

    // AES-128 MixColumns matrix operations
    state[0][col] = a2 ^ b2 ^ b ^ c ^ d;  // 02a + 03b + 01c + 01d
    state[1][col] = a ^ b2 ^ c2 ^ c ^ d;  // 01a + 02b + 03c + 01d
    state[2][col] = a ^ b ^ c2 ^ d2 ^ d;  // 01a + 01b + 02c + 03d
    state[3][col] = a2 ^ a ^ b ^ c ^ d2;  // 03a + 01b + 01c + 02d
  }
}

static void MixColumns(state_t *state)
{
  MixColumns_hls(*state);
}
