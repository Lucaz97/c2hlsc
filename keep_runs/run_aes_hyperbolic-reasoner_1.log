static void AddRoundKey_hls(uint8_t round, uint8_t state[4][4], const uint8_t RoundKey[176])
{
  #pragma HLS ARRAY_PARTITION variable=state complete dim=0
  #pragma HLS ARRAY_PARTITION variable=RoundKey block factor=16 dim=1

  const uint16_t base = round << 4;
  uint8_t round_key[16];
  #pragma HLS ARRAY_PARTITION variable=round_key complete

  // Burst read round key
  KEY_LOAD: for (int k = 0; k < 16; ++k) {
    #pragma HLS PIPELINE II=1
    round_key[k] = RoundKey[base + k];
  }

  // Parallel XOR operations
  #pragma HLS INLINE
  PARALLEL_XOR: for (int k = 0; k < 16; ++k) {
    #pragma HLS UNROLL
    const uint8_t i = k >> 2;
    const uint8_t j = k & 0x03;
    state[i][j] ^= round_key[k];
  }
}

static void AddRoundKey(uint8_t round, state_t *state, const round_t *RoundKey)
{
  AddRoundKey_hls(round, (*state), *RoundKey);
}
