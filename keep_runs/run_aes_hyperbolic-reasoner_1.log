static void ShiftRows_hls(uint8_t state[4][4])
{
  #pragma HLS ARRAY_PARTITION variable=state complete dim=2
  #pragma HLS PIPELINE II=1

  // Column 1 rotation with parallel read/write
  uint8_t col1[4] = {state[0][1], state[1][1], state[2][1], state[3][1]};
  state[0][1] = col1[1];
  state[1][1] = col1[2];
  state[2][1] = col1[3];
  state[3][1] = col1[0];

  // Column 2 swaps with independent operations
  uint8_t col2_a = state[0][2];
  uint8_t col2_b = state[2][2];
  state[0][2] = col2_b;
  state[2][2] = col2_a;
  
  uint8_t col2_c = state[1][2];
  uint8_t col2_d = state[3][2];
  state[1][2] = col2_d;
  state[3][2] = col2_c;

  // Column 3 rotation using circular buffer
  uint8_t col3[4] = {state[0][3], state[1][3], state[2][3], state[3][3]};
  state[0][3] = col3[3];
  state[1][3] = col3[0];
  state[2][3] = col3[1];
  state[3][3] = col3[2];
}

static void ShiftRows(state_t *state)
{
  #pragma HLS INLINE
  ShiftRows_hls(*state);
}
```

