static void AddRoundKey_hls(uint8_t round, uint8_t state[4][4], const uint8_t RoundKey[176])
{
  const uint16_t base = round * 16;
  
  #pragma HLS PIPELINE II=1
  for (uint8_t i = 0; i < 4; ++i)
  {
    #pragma HLS UNROLL factor=4
    for (uint8_t j = 0; j < 4; ++j)
    {
      #pragma HLS UNROLL factor=4
      state[i][j] ^= RoundKey[base + (i << 2) + j];
    }
  }
}

static void AddRoundKey(uint8_t round, state_t *state, const round_t *RoundKey)
{
  AddRoundKey_hls(round, (*state), *RoundKey);
}
```

This version combines:
1. Explicit base address calculation to help HLS with offset analysis
2. Partial loop unrolling (factor=4) instead of full unrolling to balance resource usage
3. Added pipeline pragma with II=1 to enable throughput optimization
4. Used shift operation (i << 2) instead of multiplication for index calculation
5. Maintained original functionality while providing more optimization hints to the HLS tool
