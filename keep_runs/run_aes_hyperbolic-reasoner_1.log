static void MixColumns_hls(uint8_t state[4][4])
{
  #pragma HLS ARRAY_PARTITION variable=state complete dim=2
  #pragma HLS INLINE
  for (int col = 0; col < 4; ++col) {
    #pragma HLS UNROLL yes
    const uint8_t a = state[0][col];
    const uint8_t b = state[1][col];
    const uint8_t c = state[2][col];
    const uint8_t d = state[3][col];

    // Optimized GF(2^8) operations with verified xtime
