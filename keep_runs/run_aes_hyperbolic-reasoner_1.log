static void MixColumns_hls(uint8_t state[4][4])
{
  #pragma HLS INLINE
  uint8_t i;
  uint8_t Tmp;
  uint8_t t;
  for (i = 0; i < 4; ++i)
  {
    #pragma HLS UNROLL yes
    // Precompute all XOR operations first
    t = state[i][0];
    Tmp = state[i][0] ^ state[i][1] ^ state[i][2] ^ state[i][3];
    
    // Parallelize xtime transformations
    uint8_t Tm0 = xtime(state[i][0] ^ state[i][1]);
    uint8_t Tm1 = xtime(state[i][1] ^ state[i][2]);
    uint8_t Tm2 = xtime(state[i][2] ^ state[i][3]);
    uint8_t Tm3 = xtime(state[i][3] ^ t);

    // Parallelize final XOR operations
    state[i][0] ^= Tm0 ^ Tmp;
    state[i][1] ^= Tm1 ^ Tmp;
    state[i][2] ^= Tm2 ^ Tmp;
    state[i][3] ^= Tm3 ^ Tmp;
  }
}

static void MixColumns(state_t *state)
{
  MixColumns_hls(*state);
}
