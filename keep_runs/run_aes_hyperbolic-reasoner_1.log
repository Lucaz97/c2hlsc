static void AddRoundKey_hls(uint8_t round, uint8_t state[4][4], const uint8_t RoundKey[176])
{
  #pragma HLS ARRAY_PARTITION variable=state complete dim=2
  #pragma HLS ARRAY_PARTITION variable=state complete dim=1
  #pragma HLS ARRAY_PARTITION variable=RoundKey cyclic factor=16

  const uint16_t base = round << 4;
  
  #pragma HLS INLINE
  UNROLL_LOOP: for (int k = 0; k < 16; ++k) {
    #pragma HLS UNROLL
    const uint8_t i = k >> 2;
    const uint8_t j = k & 0x03;
    state[i][j] ^= RoundKey[base + k];
  }
}

static void AddRoundKey(uint8_t round, state_t *state, const round_t *RoundKey)
{
  AddRoundKey_hls(round, (*state), *RoundKey);
}
