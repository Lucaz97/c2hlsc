int fibonacci(int n)
{
  int a = 0;
  int b = 1;
  int c = 0;
  // The loop originally performs (n-2) iterations.
  // By grouping two Fibonacci updates per loop iteration we halve the iteration count,
  // reducing the overall latency.
  int m = n - 2;

  #pragma hls_pipeline_init_interval 1
  for (int i = 0; i < (m / 2); i++)
  {
    // First Fibonacci update
    c = a + b;
    a = b;
    b = c;
    // Second Fibonacci update
    c = a + b;
    a = b;
    b = c;
  }
  
  // If (n-2) was odd, perform the one remaining iteration.
  if (m % 2)
  {
    c = a + b;
    a = b;
    b = c;
  }
  
  return c;
}
```
