int fibonacci(int n)
{
  // Handle special cases to mimic the original function behavior.
  if (n < 2)
    return n;
  if (n == 2)
    return 1;

  // We want to compute the result of (n-2) iterations of:
  //    c = a + b, with initial a = 0, b = 1.
  // Mathematically, the iterative loop returns F(n-1), where F is the Fibonacci sequence
  // with F(0)=0 and F(1)=1.
  // It is known that raising the Fibonacci matrix
  //    M = [ [1, 1],
  //          [1, 0] ]
  // to the power k yields:
  //    M^k = [ [F(k+1), F(k)],
  //            [F(k),   F(k-1)] ]
  // Thus, setting k = n-2, we have F(n-1) = M^(n-2)[0][0].
  int R[2][2] = { {1, 0}, {0, 1} }; // Identity matrix.
  int B[2][2] = { {1, 1}, {1, 0} }; // Base Fibonacci matrix.
  int p = n - 2;

  #pragma hls_loop_tripcount min=0 max=32
  #pragma hls_pipeline_init_interval 1
  while(p)
  {
    if (p & 1)
    {
      int t0 = R[0][0]*B[0][0] + R[0][1]*B[1][0];
      int t1 = R[0][0]*B[0][1] + R[0][1]*B[1][1];
      int t2 = R[1][0]*B[0][0] + R[1][1]*B[1][0];
      int t3 = R[1][0]*B[0][1] + R[1][1]*B[1][1];
      R[0][0] = t0; R[0][1] = t1;
      R[1][0] = t2; R[1][1] = t3;
    }
    int s0 = B[0][0]*B[0][0] + B[0][1]*B[1][0];
    int s1 = B[0][0]*B[0][1] + B[0][1]*B[1][1];
    int s2 = B[1][0]*B[0][0] + B[1][1]*B[1][0];
    int s3 = B[1][0]*B[0][1] + B[1][1]*B[1][1];
    B[0][0] = s0; B[0][1] = s1;
    B[1][0] = s2; B[1][1] = s3;
    p = p >> 1;
  }

  // Return the computed value F(n-1) which matches the original iterative implementation.
  return R[0][0];
}
