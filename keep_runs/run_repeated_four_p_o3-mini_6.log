int fibonacci(int n)
{
  // Use volatile to force strict ordering in the unrolled loop.
  volatile int a = 0;
  volatile int b = 1;
  int c;

  #pragma hls_unroll yes
  for (int i = 2; i < n; i++)
  {
    c = a + b;
    a = b;
    b = c;
  }

  // For the given expected behavior:
