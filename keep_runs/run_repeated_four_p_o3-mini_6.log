int fibonacci(int n)
{
  // Handle small n to preserve original behavior.
  if (n < 2)
    return (n == 0) ? 0 : 1;
  if (n == 2)
    return 1;

  // We'll compute F(n-1) using matrix exponentiation.
  // The matrix M = [ [1, 1],
  //                  [1, 0] ]
  // satisfies: M^(n-2) * [1, 0]^T = [F(n-1), F(n-2)]^T.
  // So, we return F(n-1) as the (1,0) element of the product.
  int R[2][2] = { {1, 0}, {0, 1} }; // Identity matrix
  int B[2][2] = { {1, 1}, {1, 0} }; // Base Fibonacci matrix
  int p = n - 2;

  // Pipeline the exponentiation loop to target minimal latency.
  #pragma hls_loop_tripcount min=0 max=32
  #pragma hls_pipeline_init_interval 1
  while(p)
  {
    if (p & 1)
    {
      // Multiply R = R * B.
      int t0 = R[0][0]*B[0][0] + R[0][1]*B[1][0];
      int t1 = R[0][0]*B[0][1] + R[0][1]*B[1][1];
      int t2 = R[1][0]*B[0][0] + R[1][1]*B[1][0];
      int t3 = R[1][0]*B[0][1] + R[1][1]*B[1][1];
      R[0][0] = t0; R[0][1] = t1;
      R[1][0] = t2; R[1][1] = t3;
    }
    // Square B: B = B * B.
    int s0 = B[0][0]*B[0][0] + B[0][1]*B[1][0];
    int s1 = B[0][0]*B[0][1] + B[0][1]*B[1][1];
    int s2 = B[1][0]*B[0][0] + B[1][1]*B[1][0];
    int s3 = B[1][0]*B[0][1] + B[1][1]*B[1][1];
    B[0][0] = s0; B[0][1] = s1;
    B[1][0] = s2; B[1][1] = s3;
    p = p >> 1;
  }

  // Multiply R by the vector [1, 0] to obtain:
  //   [ R[0][0] ]
  //   [ R[1][0] ]
  // Return the lower element which equals F(n-1) and preserves the original function behavior.
  return R[1][0];
}
