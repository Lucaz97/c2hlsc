  //     i=3: c = 1+1 = 2  → a=1, b=2
  //     i=4: c = 1+2 = 3  → a=2, b=3
  //     returning c yields 3.
  //
  //   For n == 6:
  //     i=2: c = 0+1 = 1  → a=1, b=1
  //     i=3: c = 1+1 = 2  → a=1, b=2
  //     i=4: c = 1+2 = 3  → a=2, b=3
  //     i=5: c = 2+3 = 5  → a=3, b=5
  //     returning c yields 5.
