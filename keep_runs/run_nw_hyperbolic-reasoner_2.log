python: '''
from ortools.sat.python import cp_model

functions = {
    'fill_matrix': [
        {'area': 2206.1, 'latency': 1293.0},
        {'area': 2144.7, 'latency': 1293.0},
        {'area': 2597.8, 'latency': 213.0},
        {'area': 2407.3, 'latency': 2538.0},
        {'area': 2698.4, 'latency': 213.0},
    ],
    'reverse_string': [
        {'area': 1804.2, 'latency': 31.0},
        {'area': 1719.0, 'latency': 31.0},
        {'area': 1719.0, 'latency': 31.0},
        {'area': 1906.1, 'latency': 31.0},
        {'area': 3611.2, 'latency': 95.0},
    ],
    'traceback': [
        {'area': 10173.9, 'latency': 34.0},
        {'area': 10173.9, 'latency': 34.0},
        {'area': 10173.9, 'latency': 34.0},
        {'area': 9416.3, 'latency': 127.0},
        {'area': 10173.9, 'latency': 34.0},
    ],
    'needwun': [
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
    ],
}

model = cp_model.CpModel()
scale_factor = 10  # Scale to handle decimals

# Create decision variables
fill = model.NewIntVar(0, 4, 'fill')
reverse = model.NewIntVar(0, 4, 'reverse')
trace = model.NewIntVar(0, 4, 'trace')
need = model.NewIntVar(0, 4, 'need')

# Create scaled area/latency variables
fill_area = model.NewIntVar(0, 30000, 'fill_area')
fill_lat = model.NewIntVar(0, 30000, 'fill_lat')
reverse_area = model.NewIntVar(0, 40000, 'reverse_area')
reverse_lat = model.NewIntVar(0, 1000, 'reverse_lat')
trace_area = model.NewIntVar(0, 120000, 'trace_area')
trace_lat = model.NewIntVar(0, 2000, 'trace_lat')
need_area = model.NewIntVar(0, 120000, 'need_area')
need_lat = model.NewIntVar(0, 3000, 'need_lat')

# Add element constraints
model.AddElement(fill, [int(f['area']*scale_factor) for f in functions['fill_matrix']], fill_area)
model.AddElement(fill, [int(f['latency']*scale_factor) for f in functions['fill_matrix']], fill_lat)
model.AddElement(reverse, [int(f['area']*scale_factor) for f in functions['reverse_string']], reverse_area)
model.AddElement(reverse, [int(f['latency']*scale_factor) for f in functions['reverse_string']], reverse_lat)
model.AddElement(trace, [int(f['area']*scale_factor) for f in functions['traceback']], trace_area)
model.AddElement(trace, [int(f['latency']*scale_factor) for f in functions['traceback']], trace_lat)
model.AddElement(need, [int(f['area']*scale_factor) for f in functions['needwun']], need_area)
model.AddElement(need, [int(f['latency']*scale_factor) for f in functions['needwun']], need_lat)

# Total calculations
total_area = model.NewIntVar(0, 300000, 'total_area')
model.Add(total_area == fill_area + reverse_area + trace_area + need_area)

total_latency = model.NewIntVar(0, 300000, 'total_latency')
model.Add(total_latency == fill_lat + reverse_lat + trace_lat + need_lat)

# Target constraint
target_scaled = 6000 * scale_factor
diff = model.NewIntVar(0, 200000, 'diff')
model.AddAbsEquality(diff, total_area - target_scaled)

# Objective: minimize latency + area difference
model.Minimize(total_latency + diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f"Solution: fill_matrix {solver.Value(fill)}, "
          f"reverse_string {solver.Value(reverse)}, "
          f"traceback {solver.Value(trace)}, "
          f"needwun {solver.Value(need)}")
    print(f"Estimated area: {(solver.Value(total_area)/scale_factor):.1f}")
    print(f"Estimated latency: {(solver.Value(total_latency)/scale_factor):.1f}")
else:
    print("No solution found")
'''
