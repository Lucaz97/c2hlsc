python: '''
from ortools.linear_solver import pywraplp

# Data for each function: list of tuples (option_index, area, latency, throughput)
functions = {
    'shift': [
        (0, 1451.8, 2.0, 4.0),
        (1, 1929.7, 2.0, 4.0),
        (2, 1451.8, 2.0, 4.0),
        (3, 1546.9, 3.0, 5.0),
        (4, 1451.8, 2.0, 4.0)
    ],
    'mac': [
        (0, 4346.7, 2.0, 3.0),
        (1, 6690.9, 6.0, 7.0),
        (2, 4346.7, 2.0, 3.0),
        (3, 4346.7, 2.0, 3.0),
        (4, 6690.9, 6.0, 7.0)
    ],
    'fir': [
        (0, 5043.1, 10.0, 11.0),
        (1, 5043.1, 10.0, 11.0),
        (2, 6135.1, 5.0, 6.0),
        (3, 4901.3, 10.0, 11.0),
        (4, 6219.2, 5.0, 6.0)
    ],
    'iir': [
        (0, 8132.5, 16.0, 22.0),
        (1, 8160.4, 16.0, 22.0),
        (2, 8160.4, 16.0, 22.0),
        (3, 8160.4, 16.0, 22.0),
        (4, 8630.3, 10.0, 11.0)
    ],
    'filter': [
        (0, 3440.3, 1.0, 2.0),
        (1, 3440.3, 1.0, 2.0),
        (2, 3440.3, 1.0, 2.0),
        (3, 3440.3, 1.0, 2.0),
        (4, 3440.3, 1.0, 2.0)
    ]
}

# List of function names to optimize over
func_names = list(functions.keys())

# Create solver
solver = pywraplp.Solver.CreateSolver('SCIP')
if not solver:
    print('Solver not found.')
    exit(1)

# Decision variables: x[f][i] is 1 if option i in function f is selected.
x = {}
for f in func_names:
    x[f] = {}
    for (i, area, latency, throughput) in functions[f]:
        x[f][i] = solver.BoolVar(f'x_{f}_{i}')

# Each function must select exactly one option.
for f in func_names:
    solver.Add(solver.Sum([x[f][i] for i in x[f]]) == 1)

# Compute total latency and total area as the sum over functions.
total_latency = solver.Sum([x[f][i] * latency for f in func_names 
                              for (i, area, latency, throughput) in functions[f] if i in x[f]])
total_area = solver.Sum([x[f][i] * area for f in func_names 
                           for (i, area, latency, throughput) in functions[f] if i in x[f]])

# We want to minimize latency and have total area as close as possible to a target.
target_area = 6000.0

# Introduce auxiliary variables for absolute deviation from target_area.
diff = solver.NumVar(-solver.infinity(), solver.infinity(), 'diff')
diff_pos = solver.NumVar(0.0, solver.infinity(), 'diff_pos')
diff_neg = solver.NumVar(0.0, solver.infinity(), 'diff_neg')

# Link diff with total_area and target.
solver.Add(diff == total_area - target_area)
solver.Add(diff == diff_pos - diff_neg)
solver.Add(diff_pos + diff_neg >= 0)

# Weight to balance the objective terms: latency is primary (minimize latency)
# and we add a penalty for area deviation.
# We choose a small weight because the area numbers are much larger than latency.
weight = 0.001

# Objective: minimize total_latency + weight * (absolute deviation from target_area)
objective = solver.Sum([total_latency, weight * (diff_pos + diff_neg)])
solver.Minimize(objective)

status = solver.Solve()

if status == pywraplp.Solver.OPTIMAL:
    print('Optimal solution found:')
    solution = {}
    for f in func_names:
        for (i, area, latency, throughput) in functions[f]:
            if x[f][i].solution_value() > 0.5:
                solution[f] = i
                print(f'{f}: option {i} (area={area}, latency={latency}, throughput={throughput})')
    print('Total latency:', total_latency.solution_value())
    print('Total area:', total_area.solution_value())
    print('Absolute area deviation:', (diff_pos.solution_value() + diff_neg.solution_value()))
else:
    print('No optimal solution found.')
'''
