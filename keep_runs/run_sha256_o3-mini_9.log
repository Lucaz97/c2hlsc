void sha256_update_hls(unsigned char data_int[64],
                       unsigned int *datalen_int,
                       unsigned int state[8],
                       unsigned long long int *bitlen_int,
                       unsigned char data[64],
                       size_t len)
{
    // Local index over the input data.
    size_t offset = 0;
    // Use a local copy to reduce memory dependency.
    unsigned int local_datalen = *datalen_int;

    // If there's a partially filled block, complete it first.
    if (local_datalen != 0) {
        unsigned int fill = 64 - local_datalen;
        if (len < fill) {
            // Pipeline the copy for the incomplete block.
            for (; offset < len; offset++) {
                #pragma HLS pipeline init_interval 1
                data_int[local_datalen + offset] = data[offset];
            }
            local_datalen += len;
            *datalen_int = local_datalen;
            return;
        } else {
            for (; offset < fill; offset++) {
                #pragma HLS pipeline init_interval 1
                data_int[local_datalen + offset] = data[offset];
            }
            // Inline the transform call to reduce function-call overhead.
            #pragma HLS inline
            sha256_transform_hls(state, data_int);
            *bitlen_int += 512;
            local_datalen = 0;
