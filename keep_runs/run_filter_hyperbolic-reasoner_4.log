    ],
}

# Create variables for each function's option index
shift_var = model.NewIntVar(0, 4, 'shift')
mac_var = model.NewIntVar(0, 4, 'mac')
iir_var = model.NewIntVar(0, 4, 'iir')
fir_var = model.NewIntVar(0, 4, 'fir')
filter_var = model.NewIntVar(0, 4, 'filter')

# Create area and latency expressions using Element
shift_area = model.NewIntVar(0, int(1e6), 'shift_area')
model.AddElement(shift_var, [int(f['area']) for f in functions['shift']], shift_area)

mac_area = model.NewIntVar(0, int(1e6), 'mac_area')
model.AddElement(mac_var, [int(f['area']) for f in functions['mac']], mac_area)

iir_area = model.NewIntVar(0, int(1e6), 'iir_area')
model.AddElement(iir_var, [int(f['area']) for f in functions['iir']], iir_area)

fir_area = model.NewIntVar(0, int(1e6), 'fir_area')
model.AddElement(fir_var, [int(f['area']) for f in functions['fir']], fir_area)

filter_area = model.NewIntVar(0, int(1e6), 'filter_area')
model.AddElement(filter_var, [int(f['area']) for f in functions['filter']], filter_area)

total_area = model.NewIntVar(0, int(1e6), 'total_area')
model.Add(total_area == shift_area + mac_area + iir_area + fir_area + filter_area)

shift_latency = model.NewIntVar(0, 100, 'shift_latency')
model.AddElement(shift_var, [int(f['latency']) for f in functions['shift']], shift_latency)

mac_latency = model.NewIntVar(0, 100, 'mac_latency')
model.AddElement(mac_var, [int(f['latency']) for f in functions['mac']], mac_latency)

iir_latency = model.NewIntVar(0, 100, 'iir_latency')
model.AddElement(iir_var, [int(f['latency']) for f in functions['iir']], iir_latency)

fir_latency = model.NewIntVar(0, 100, 'fir_latency')
model.AddElement(fir_var, [int(f['latency']) for f in functions['fir']], fir_latency)

filter_latency = model.NewIntVar(0, 100, 'filter_latency')
model.AddElement(filter_var, [int(f['latency']) for f in functions['filter']], filter_latency)

total_latency = model.NewIntVar(0, 1000, 'total_latency')
model.Add(total_latency == shift_latency + mac_latency + iir_latency + fir_latency + filter_latency)

# Objective: minimize latency with area penalty
area_diff = model.NewIntVar(0, int(1e6), 'area_diff')
model.AddAbsEquality(area_diff, total_area - 6000)
model.Minimize(total_latency * 1000 + area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
