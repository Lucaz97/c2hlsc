python: '''
from ortools.linear_solver import pywraplp

# We have 4 functions: odd_factorial, fibonacci, even_sum, compute4.
# Decision variables: select option index for each function.
# There are 5 options per function.
# For our simulation we assume:
#   Total latency = compute4_latency + odd_factorial_latency + fibonacci_latency + 2 * even_sum_latency
#   Total area   = compute4_area   + odd_factorial_area   + fibonacci_area   + even_sum_area
#
# Our goal is to minimize latency while keeping total area as close as possible to target_area.
# We use a weighted sum objective: latency + w * abs(total_area - target_area)
# We'll pick weighting factor w = 0.001 (this weight can be tuned)
#
# Note: Because the options are discrete, we use integer programming with binary variables.
# Let x[i][j] be binary variable that is 1 if function i uses option j.
# Functions indices 0: odd_factorial, 1: fibonacci, 2: even_sum, 3: compute4.

functions = ['odd_factorial', 'fibonacci', 'even_sum', 'compute4']
num_options = 5
target_area = 4000.0
w = 0.001  # weight factor for area deviation

# Options: each list index corresponds to option j values (area, latency)
options = {
    'odd_factorial': [
        (3696.9, 2.0),
        (34972.0, 8.0),
        (4039.1, 3.0),
        (3696.9, 2.0),
        (3696.9, 2.0)
    ],
    'fibonacci': [
        (1640.9, 2.0),
        (1640.9, 2.0),
        (5184.3, 7.0),
        (1800.0, 3.0),
        (1942.5, 3.0)
    ],
    'even_sum': [
        (1349.7, 2.0),
        (3014.2, 1.0),
        (3014.2, 1.0),
        (3014.2, 1.0),
        (3014.2, 1.0)
    ],
    'compute4': [
        (8098.5, 5.0),
        (8098.5, 5.0),
        (5401.9, 6.0),
        (8098.5, 5.0),
        (5506.9, 7.0)
    ]
}

# Setup solver
solver = pywraplp.Solver.CreateSolver('SCIP')
if not solver:
    raise Exception("Solver not created.")

# Create binary decision variables
x = {}
for f in functions:
    x[f] = []
    for j in range(num_options):
        x[f].append(solver.BoolVar(f'x_{f}_{j}'))

# Each function must have exactly one option selected.
for f in functions:
    solver.Add(sum(x[f][j] for j in range(num_options)) == 1)

# Compute total area and latency.
# For latency, note that even_sum option latency is counted twice.
total_area = solver.NumVar(0, solver.infinity(), 'total_area')
total_latency = solver.NumVar(0, solver.infinity(), 'total_latency')

# Express total area and latency in terms of decision variables:
area_expr = []
latency_expr = []
for f in functions:
    if f == 'even_sum':
        # even_sum area is counted once for area, but latency is added twice.
        area_expr += [sum(options[f][j][0] * x[f][j] for j in range(num_options))]
        latency_expr += [2 * sum(options[f][j][1] * x[f][j] for j in range(num_options))]
    else:
        area_expr += [sum(options[f][j][0] * x[f][j] for j in range(num_options))]
        latency_expr += [sum(options[f][j][1] * x[f][j] for j in range(num_options))]

solver.Add(total_area == sum(area_expr))
solver.Add(total_latency == sum(latency_expr))

# To linearize the absolute value term, introduce a variable delta >= |total_area - target_area|.
delta = solver.NumVar(0, solver.infinity(), 'delta')
solver.Add(total_area - target_area <= delta)
solver.Add(target_area - total_area <= delta)

# Objective: minimize total_latency + w * delta
objective = solver.Objective()
objective.SetMinimization()
objective.SetCoefficient(total_latency, 1.0)
objective.SetCoefficient(delta, w)

status = solver.Solve()

if status == pywraplp.Solver.OPTIMAL:
    solution = {}
    for f in functions:
        for j in range(num_options):
            if x[f][j].solution_value() > 0.5:
                solution[f] = j
    print("Optimal configuration:")
    for f in functions:
        area_val = options[f][solution[f]][0]
        latency_val = options[f][solution[f]][1]
        print(f"{f}: option {solution[f]}, area = {area_val}, latency = {latency_val}")
    print("Total area =", total_area.solution_value())
    print("Total latency =", total_latency.solution_value())
    print("Penalty (w * |area - target|) =", w * delta.solution_value())
else:
    print("No optimal solution found.")
'''    

