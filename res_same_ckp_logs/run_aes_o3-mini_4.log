python: '''import itertools
from ortools.sat.python import cp_model

# Define options for each function as lists of (index, area, latency)
# For functions with duplicate options, we list each instance with its index.
# AddRoundKey_hls options (indices 0-4)
addround_options = [
    (0, 2165.3, 23.0),
    (1, 752.6, 34.0),
    (2, 1620.1, 26.0),
    (3, 2165.3, 23.0),
    (4, 752.6, 34.0)
]

# SubBytes_hls options (indices 0-4)
subbytes_options = [
    (0, 1156.4, 6.0),
    (1, 1160.4, 3.0),
    (2, 1889.1, 15.0),
    (3, 1160.4, 3.0),
    (4, 1156.4, 6.0)
]

# ShiftRows_hls options (indices 0-4; all identical)
shiftrows_options = [(i, 23.9, 0.0) for i in range(5)]

# xtime options (indices 0-4; all identical)
xtime_options = [(i, 77.0, 1.0) for i in range(5)]

# MixColumns_hls options (indices 0-4; note: 0,2,3,4 are identical)
mixcolumns_options = [
    (0, 866.6, 0.0),
    (1, 902.4, 2.0),
    (2, 866.6, 0.0),
    (3, 866.6, 0.0),
    (4, 866.6, 0.0)
]

# Cipher_hls options (indices 0-4)
cipher_options = [
    (0, 6500.2, 331.0),
    (1, 5826.0, 366.0),
    (2, 6517.8, 366.0),
    (3, 6544.0, 434.0),
    (4, 5931.4, 421.0)
]

# For our purpose, we consider a simple additive model:
# Total_Area = sum(area_i for each function)
# Total_Latency = sum(latency_i for each function)
# Our goal is to minimize latency while keeping area as close as possible to the target area of 3800.
# We define an objective function: total_latency + alpha * |total_area - target|
# Choose alpha to weight area deviation appropriately.
target_area = 3800.0
alpha = 0.1  # weight factor

# We'll search over all combinations (brute-force enumeration)
best_obj = None
best_config = None

for add in addround_options:
    for sub in subbytes_options:
        for shift in shiftrows_options:
            for xt in xtime_options:
                for mix in mixcolumns_options:
                    for cip in cipher_options:
                        total_area = add[1] + sub[1] + shift[1] + xt[1] + mix[1] + cip[1]
                        total_latency = add[2] + sub[2] + shift[2] + xt[2] + mix[2] + cip[2]
                        obj = total_latency + alpha * abs(total_area - target_area)
                        if best_obj is None or obj < best_obj:
                            best_obj = obj
                            best_config = {
                                'AddRoundKey_hls': add[0],
                                'SubBytes_hls': sub[0],
                                'ShiftRows_hls': shift[0],
                                'xtime': xt[0],
                                'MixColumns_hls': mix[0],
                                'Cipher_hls': cip[0],
                                'Total_Area': total_area,
                                'Total_Latency': total_latency,
                                'Objective': obj
                            }

print("Best configuration found:")
print("AddRoundKey_hls", best_config['AddRoundKey_hls'],
      "SubBytes_hls", best_config['SubBytes_hls'],
      "ShiftRows_hls", best_config['ShiftRows_hls'],
      "xtime", best_config['xtime'],
      "MixColumns_hls", best_config['MixColumns_hls'],
      "Cipher_hls", best_config['Cipher_hls'])
print("Total Area: %.2f, Total Latency: %.2f, Objective: %.2f" % 
      (best_config['Total_Area'], best_config['Total_Latency'], best_config['Objective']))
'''
