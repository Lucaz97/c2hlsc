from ortools.sat.python import cp_model

functions = {
    'AddRoundKey_hls': [
        {'area': 2165.3, 'latency': 23.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1620.1, 'latency': 26.0},
        {'area': 2165.3, 'latency': 23.0},
        {'area': 752.6, 'latency': 34.0},
    ],
    'SubBytes_hls': [
        {'area': 1156.4, 'latency': 6.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1889.1, 'latency': 15.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1156.4, 'latency': 6.0},
    ],
    'ShiftRows_hls': [{'area': 23.9, 'latency': 0.0}]*5,
    'xtime': [{'area': 77.0, 'latency': 1.0}]*5,
    'MixColumns_hls': [
        {'area': 866.6, 'latency': 0.0},
        {'area': 902.4, 'latency': 2.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
    ],
    'Cipher_hls': [
        {'area': 6500.2, 'latency': 331.0},
        {'area': 5826.0, 'latency': 366.0},
        {'area': 6517.8, 'latency': 366.0},
        {'area': 6544.0, 'latency': 434.0},
        {'area': 5931.4, 'latency': 421.0},
    ],
}

target = 3800
model = cp_model.CpModel()

# Create variables and element constraints for area/latency
area_vars = []
latency_vars = []

for func in functions:
    options = functions[func]
    idx_var = model.NewIntVar(0, len(options)-1, f'{func}_idx')
    
    # Create area/latency arrays for element constraints
    area_array = [int(opt['area']*10) for opt in options]  # Scale to integer
    latency_array = [int(opt['latency']*10) for opt in options]
    
    # Create element variables
    area_element = model.NewIntVar(0, 100000, f'{func}_area')
    latency_element = model.NewIntVar(0, 10000, f'{func}_latency')
    
    model.AddElement(idx_var, area_array, area_element)
    model.AddElement(idx_var, latency_array, latency_element)
    
    area_vars.append(area_element)
    latency_vars.append(latency_element)
    
    # Store index variable for solution
    globals()[f'{func}_var'] = idx_var

total_area = sum(area_vars)
total_latency = sum(latency_vars)

# Deviation from target (scaled by 10)
deviation = model.NewIntVar(0, 200000, 'deviation')
model.AddAbsEquality(deviation, total_area - int(target*10))

# Minimize: deviation + latency (both scaled by 10)
model.Minimize(deviation + total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in [cp_model.OPTIMAL, cp_model.FEASIBLE]:
    config = []
    for func in functions:
        opt_idx = solver.Value(globals()[f'{func}_var'])
        config.append(f"{func} {opt_idx}")
    print("solution: " + ", ".join(config))
else:
    print("No solution found")
