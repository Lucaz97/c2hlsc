python: '''
from ortools.sat.python import cp_model

# Function options data
functions = {
    'AddRoundKey_hls': [
        {'area': 2165.3, 'latency': 23.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1620.1, 'latency': 26.0},
        {'area': 2165.3, 'latency': 23.0},
        {'area': 752.6, 'latency': 34.0},
    ],
    'SubBytes_hls': [
        {'area': 1156.4, 'latency': 6.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1889.1, 'latency': 15.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1156.4, 'latency': 6.0},
    ],
    'ShiftRows_hls': [{'area': 23.9, 'latency': 0.0}] * 5,
    'MixColumns_hls': [
        {'area': 866.6, 'latency': 0.0},
        {'area': 902.4, 'latency': 2.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
    ],
    'xtime': [{'area': 77.0, 'latency': 1.0}] * 5,
    'Cipher_hls': [
        {'area': 6500.2, 'latency': 331.0},
        {'area': 5826.0, 'latency': 366.0},
        {'area': 6517.8, 'latency': 366.0},
        {'area': 6544.0, 'latency': 434.0},
        {'area': 5931.4, 'latency': 421.0},
    ],
}

target_area = 3800
tolerance = 500  # Allowed deviation from target

model = cp_model.CpModel()

# Variables for each function's option (0-4)
option_vars = {func: model.NewIntVar(0, 4, func) for func in functions}

# Auxiliary variables to compute total area and latency
total_area = sum(
    model.NewIntVar(0, int(1e6), 'total_area'))
for func in functions:
    for idx, opt in enumerate(functions[func]):
        model.Add(total_area == sum([functions[f][option_vars[f]]['area'] for f in functions)).OnlyEnforceIf(option_vars[func] == idx)

total_latency = sum(
    model.NewIntVar(0, int(1e6), 'total_latency'))
for func in functions:
    for idx, opt in enumerate(functions[func]):
        model.Add(total_latency == sum([functions[f][option_vars[f]]['latency'] for f in functions)).OnlyEnforceIf(option_vars[func] == idx)

# Constraints: total_area within target ± tolerance
model.Add(total_area >= target_area - tolerance)
model.Add(total_area <= target_area + tolerance)

# Objective: minimize total_latency
model.Minimize(total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal Configuration:")
    for func in functions:
        opt_idx = solver.Value(option_vars[func])
        print(f"{func}: Option {opt_idx} (Area: {functions[func][opt_idx]['area']}, Latency: {functions[func][opt_idx]['latency']})")
    print(f"Total Area: ~{solver.Value(total_area)}, Total Latency: {solver.Value(total_latency)}")
else:
    print("No feasible solution found within tolerance.")
