    latency_contributions.append(latency_contrib)

# Total area and latency calculations
total_area = sum(area_contributions)
total_latency = sum(latency_contributions)

# Area constraint
model.Add(total_area >= target_area - tolerance)
model.Add(total_area <= target_area + tolerance)

# Objective: minimize latency
model.Minimize(total_latency)

# Solve
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal Configuration:")
    total_area_val = 0
    total_latency_val = 0
    for func in functions:
        opt_idx = solver.Value(option_vars[func])
        area = functions[func][opt_idx]['area']
        latency = functions[func][opt_idx]['latency']
        print(f"{func}: Option {opt_idx} (Area: {area}, Latency: {latency})")
        total_area_val += area
        total_latency_val += latency
    print(f"Total Area: {total_area_val}, Total Latency: {total_latency_val}")
else:
    print("No feasible solution found within tolerance.")
