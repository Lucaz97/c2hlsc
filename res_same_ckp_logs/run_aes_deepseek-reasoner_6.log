        {'area': 1160.4, 'latency': 3.0},
        {'area': 1889.1, 'latency': 15.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1156.4, 'latency': 6.0},
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
    ],
    'MixColumns_hls': [
        {'area': 866.6, 'latency': 0.0},
        {'area': 902.4, 'latency': 2.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
    ],
    'xtime': [
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
    ],
    'Cipher_hls': [
        {'area': 6500.2, 'latency': 331.0},
        {'area': 5826.0, 'latency': 366.0},
        {'area': 6517.8, 'latency': 366.0},
        {'area': 6544.0, 'latency': 434.0},
        {'area': 5931.4, 'latency': 421.0},
    ],
}

# Target area
target_area = 3800.0

# Create model
model = cp_model.CpModel()

# Variables: option index for each function
vars = {func: model.NewIntVar(0, len(options)-1, func) for func, options in functions.items()}

# Total area and latency expressions
total_area_expr = sum(functions[func][vars[func]]['area'] for func in functions)
total_latency_expr = sum(functions[func][vars[func]]['latency'] for func in functions)

# Area difference from target
area_diff = model.NewIntVar(0, int(1e5), 'area_diff')
model.AddAbsEquality(area_diff, total_area_expr - target_area)

# Objective: minimize latency + area difference (prioritize latency)
model.Minimize(total_latency_expr * 1000 + area_diff)

# Solve
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal configuration found:")
    config = []
    for func in functions:
        opt_idx = solver.Value(vars[func])
        config.append(f"{func} {opt_idx}")
    print(", ".join(config))
    print(f"Total area: {solver.Value(total_area_expr):.1f}")
    print(f"Total latency: {solver.Value(total_latency_expr):.1f}")
else:
    print("No optimal solution found.")
