python: '''import itertools
from ortools.sat.python import cp_model

# Data for each function option in the form (area, latency, throughput)
# Options are indexed from 0.
# Note: For functions with duplicate entries, we list them as separate options.
AddRoundKey = [(2165.3, 23.0, 26.0),
               (752.6, 34.0, 38.0),
               (1620.1, 26.0, 30.0),
               (2165.3, 23.0, 26.0),
               (752.6, 34.0, 38.0)]

SubBytes = [(1156.4, 6.0, 10.0),
            (1160.4, 3.0, 7.0),
            (1889.1, 15.0, 17.0),
            (1160.4, 3.0, 7.0),
            (1156.4, 6.0, 10.0)]

ShiftRows = [(23.9, 0.0, 2.0)] * 5

xtime = [(77.0, 1.0, 2.0)] * 5

MixColumns = [(866.6, 0.0, 2.0),
              (902.4, 2.0, 6.0),
              (866.6, 0.0, 2.0),
              (866.6, 0.0, 2.0),
              (866.6, 0.0, 2.0)]

Cipher = [(6500.2, 331.0, 335.0),
          (5826.0, 366.0, 370.0),
          (6517.8, 366.0, 370.0),
          (6544.0, 434.0, 438.0),
          (5931.4, 421.0, 425.0)]

# Note: The reported total synthesis results already combine child functions.
# To approximate the overall design, we assume the top-level (Cipher) already includes calls to
# AddRoundKey, SubBytes, ShiftRows, MixColumns and the others (xtime is used by MixColumns).
# However, our decision variables also include child functions; we assume that selecting
# a particular option for a parent forces the use of the selected options for its children.
# For this example, we simply sum the areas and latencies of all chosen functions.
#
# Our goal is: minimize total latency, with a soft constraint that the total area is as close as possible to target_area.
target_area = 3800.0

# Build list for each function to iterate over decisions.
functions = {
    'AddRoundKey': AddRoundKey,
    'SubBytes': SubBytes,
    'ShiftRows': ShiftRows,
    'xtime': xtime,
    'MixColumns': MixColumns,
    'Cipher': Cipher
}

# Create a list of function names for iteration.
func_names = list(functions.keys())

# Brute force search over all combinations (5^6 = 15625 possibilities) to find Pareto-optimal solutions.
results = []
for combo in itertools.product(range(5), repeat=len(func_names)):
    total_area = 0.0
    total_latency = 0.0
    # Sum the options for each function in the configuration.
    for i, opt_index in enumerate(combo):
        area, lat, thr = functions[func_names[i]][opt_index]
        total_area += area
        total_latency += lat
    # Compute deviation from target_area.
    area_deviation = abs(total_area - target_area)
    results.append((combo, total_area, total_latency, area_deviation))

# We now sort the results: first by latency then by area deviation.
results.sort(key=lambda x: (x[2], x[3]))

# Get the best configuration.
best_combo, best_area, best_latency, best_dev = results[0]
print("Best combination:")
for i, opt_index in enumerate(best_combo):
    print(f"{func_names[i]} option {opt_index} -> {functions[func_names[i]][opt_index]}")
print(f"Total area: {best_area}, Total latency: {best_latency}, Area deviation: {best_dev}")
'''
