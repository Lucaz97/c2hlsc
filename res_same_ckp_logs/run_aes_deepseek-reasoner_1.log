        {'area': 1889.1, 'latency': 15.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1156.4, 'latency': 6.0},
    ],
    'ShiftRows_hls': [{'area': 23.9, 'latency': 0.0}]*5,
    'xtime': [{'area': 77.0, 'latency': 1.0}]*5,
    'MixColumns_hls': [
        {'area': 866.6, 'latency': 0.0},
        {'area': 902.4, 'latency': 2.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
    ],
    'Cipher_hls': [
        {'area': 6500.2, 'latency': 331.0},
        {'area': 5826.0, 'latency': 366.0},
        {'area': 6517.8, 'latency': 366.0},
        {'area': 6544.0, 'latency': 434.0},
        {'area': 5931.4, 'latency': 421.0},
    ],
}

target_area = 3800

model = cp_model.CpModel()

# Create variables and helper structures
func_vars = {}
area_vars = {}
latency_vars = {}

for func in functions:
    options = functions[func]
    func_var = model.NewIntVar(0, len(options)-1, func)
    func_vars[func] = func_var
    
    # Create area and latency variables
    area_var = model.NewIntVar(0, int(1e6), f"{func}_area")
    latency_var = model.NewIntVar(0, int(1e6), f"{func}_latency")
    area_vars[func] = area_var
    latency_vars[func] = latency_var
    
    # Link index selection to area/latency values using element constraints
    model.AddElement(func_var, [round(opt['area']*10) for opt in options], area_var)
    model.AddElement(func_var, [round(opt['latency']*10) for opt in options], latency_var)

# Calculate totals with scaling to maintain precision
total_area = sum(area_vars.values())
total_latency = sum(latency_vars.values())

# Area difference with target (scaled by 10)
target_scaled = round(target_area * 10)
area_diff = model.NewIntVar(0, 100000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - target_scaled)

# Minimize weighted sum: latency (scaled x10) + area_diff
model.Minimize(total_latency + area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    config = []
    for func in functions:
        idx = solver.Value(func_vars[func])
        config.append(f"{func} {idx}")
    print("solution: " + ", ".join(config))
else:
    print("No optimal solution found.")
