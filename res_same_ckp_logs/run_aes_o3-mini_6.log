python: '''
import math

# Define target area and weight for area penalty in the objective function.
target_area = 3800.0
area_weight = 0.1  # weight factor to trade-off area deviation

# Define options for each function as lists of tuples (area, latency, throughput)
# Options are indexed starting at 0.

addRoundKey_options = [
    (2165.3, 23.0, 26.0),  # option 0
    (752.6, 34.0, 38.0),   # option 1
    (1620.1, 26.0, 30.0),  # option 2
    (2165.3, 23.0, 26.0),  # option 3 (duplicate of 0)
    (752.6, 34.0, 38.0)    # option 4 (duplicate of 1)
]

subBytes_options = [
    (1156.4, 6.0, 10.0),   # option 0
    (1160.4, 3.0, 7.0),    # option 1
    (1889.1, 15.0, 17.0),  # option 2
    (1160.4, 3.0, 7.0),    # option 3 (duplicate of 1)
    (1156.4, 6.0, 10.0)    # option 4 (duplicate of 0)
]

shiftRows_options = [
    (23.9, 0.0, 2.0)       # option 0 (all five options are identical)
]

xtime_options = [
    (77.0, 1.0, 2.0)       # option 0 (all identical)
]

mixColumns_options = [
    (866.6, 0.0, 2.0),     # option 0
    (902.4, 2.0, 6.0),     # option 1
    (866.6, 0.0, 2.0),     # option 2 (duplicate of 0)
    (866.6, 0.0, 2.0),     # option 3 (duplicate of 0)
    (866.6, 0.0, 2.0)      # option 4 (duplicate of 0)
]

cipher_options = [
    (6500.2, 331.0, 335.0),  # option 0
    (5826.0, 366.0, 370.0),  # option 1
    (6517.8, 366.0, 370.0),  # option 2
    (6544.0, 434.0, 438.0),  # option 3
    (5931.4, 421.0, 425.0)   # option 4
]

# Note: In the call graph, AddRoundKey is invoked three times in Cipher.
# SubBytes, ShiftRows, and MixColumns (which in turn uses xtime four times) are each invoked once.
# For simplicity, we assume latency adds linearly and area contributions add linearly with the following multipliers:
# - AddRoundKey: count = 3
# - SubBytes: count = 1
# - ShiftRows: count = 1
# - xtime: count = 4  (inside MixColumns)
# - MixColumns: count = 1
# - Cipher: count = 1

# We define a function to compute total area and total latency for a given combination.
def evaluate_config(ar, sb, sr, xt, mc, c):
    total_area = (3 * addRoundKey_options[ar][0] +
                  1 * subBytes_options[sb][0] +
                  1 * shiftRows_options[sr][0] +
                  1 * mixColumns_options[mc][0] +
                  4 * xtime_options[xt][0] +
                  1 * cipher_options[c][0])
    total_latency = (3 * addRoundKey_options[ar][1] +
                     1 * subBytes_options[sb][1] +
                     1 * shiftRows_options[sr][1] +
                     1 * mixColumns_options[mc][1] +
                     4 * xtime_options[xt][1] +
                     1 * cipher_options[c][1])
    return total_area, total_latency

best_obj = math.inf
best_config = None
best_area = None
best_latency = None

# Brute-force search over all combinations.
for ar in range(len(addRoundKey_options)):
    for sb in range(len(subBytes_options)):
        for sr in range(len(shiftRows_options)):
            for xt in range(len(xtime_options)):
                for mc in range(len(mixColumns_options)):
                    for c in range(len(cipher_options)):
                        area, latency = evaluate_config(ar, sb, sr, xt, mc, c)
                        obj = latency + area_weight * abs(area - target_area)
                        if obj < best_obj:
                            best_obj = obj
                            best_config = (ar, sb, sr, xt, mc, c)
                            best_area = area
                            best_latency = latency

print("Best configuration found:")
print("AddRoundKey_hls option:", best_config[0])
print("SubBytes_hls option:", best_config[1])
print("ShiftRows_hls option:", best_config[2])
print("xtime option:", best_config[3])
print("MixColumns_hls option:", best_config[4])
print("Cipher_hls option:", best_config[5])
print("Total Area: {:.2f}".format(best_area))
print("Total Latency: {:.2f}".format(best_latency))
print("Objective value: {:.2f}".format(best_obj))
'''
