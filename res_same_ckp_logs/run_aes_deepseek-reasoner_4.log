from ortools.sat.python import cp_model

functions = {
    'AddRoundKey_hls': [
        {'area': 2165.3, 'latency': 23.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1620.1, 'latency': 26.0},
        {'area': 2165.3, 'latency': 23.0},
        {'area': 752.6, 'latency': 34.0},
    ],
    'SubBytes_hls': [
        {'area': 1156.4, 'latency': 6.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1889.1, 'latency': 15.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1156.4, 'latency': 6.0},
    ],
    'ShiftRows_hls': [{'area': 23.9, 'latency': 0.0}] * 5,
    'xtime': [{'area': 77.0, 'latency': 1.0}] * 5,
    'MixColumns_hls': [
        {'area': 866.6, 'latency': 0.0},
        {'area': 902.4, 'latency': 2.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
    ],
    'Cipher_hls': [
        {'area': 6500.2, 'latency': 331.0},
        {'area': 5826.0, 'latency': 366.0},
        {'area': 6517.8, 'latency': 366.0},
        {'area': 6544.0, 'latency': 434.0},
        {'area': 5931.4, 'latency': 421.0},
    ]
}

target_area = 3800
tolerance = 500  # Increased tolerance to find feasible solution

model = cp_model.CpModel()
selections = {func: model.NewIntVar(0, len(opts)-1, func) for func, opts in functions.items()}

area_terms = []
latency_terms = []

for func, opts in functions.items():
    areas = [int(opt['area'] * 10) for opt in opts]
    latencies = [int(opt['latency'] * 10) for opt in opts]
    
    area_var = model.NewIntVar(0, sum(areas), f'{func}_area')
    model.AddElement(selections[func], areas, area_var)
    area_terms.append(area_var)
    
    latency_var = model.NewIntVar(0, sum(latencies), f'{func}_latency')
    model.AddElement(selections[func], latencies, latency_var)
    latency_terms.append(latency_var)

total_area = model.NewIntVar(0, 100000, 'total_area')
model.Add(total_area == sum(area_terms))

total_latency = model.NewIntVar(0, 100000, 'total_latency')
model.Add(total_latency == sum(latency_terms))

model.Add(total_area >= (target_area - tolerance) * 10)
model.Add(total_area <= (target_area + tolerance) * 10)

model.Minimize(total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("solution:")
    for func in functions:
        idx = solver.Value(selections[func])
        print(f"{func} {idx}", end=', ')
    print(f"\\nTotal area: {solver.Value(total_area)/10:.1f}")
    print(f"Total latency: {solver.Value(total_latency)/10:.1f}")
else:
    print("No solution found")
'''
