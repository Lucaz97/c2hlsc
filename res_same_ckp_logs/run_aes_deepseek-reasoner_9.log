        {'area': 1160.4, 'latency': 3.0},
        {'area': 1889.1, 'latency': 15.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1156.4, 'latency': 6.0},
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
    ],
    'MixColumns_hls': [
        {'area': 866.6, 'latency': 0.0},
        {'area': 902.4, 'latency': 2.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
    ],
    'xtime': [
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
    ],
    'Cipher_hls': [
        {'area': 6500.2, 'latency': 331.0},
        {'area': 5826.0, 'latency': 366.0},
        {'area': 6517.8, 'latency': 366.0},
        {'area': 6544.0, 'latency': 434.0},
        {'area': 5931.4, 'latency': 421.0},
    ],
}

target_area = 3800

model = cp_model.CpModel()

# Create variables for each function's option choice
option_vars = {func: model.NewIntVar(0, 4, func) for func in functions}

# Create total area and latency expressions
total_area = sum(
    [functions[func][option_vars[func]].get('area', 0) for func in functions)
total_latency = sum(
    [functions[func][option_vars[func]].get('latency', 0) for func in functions)

# Add area constraint with 5% tolerance
model.Add(total_area >= target_area * 0.95)
model.Add(total_area <= target_area * 1.05)

# Minimize latency
model.Minimize(total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal Configuration:")
    for func in functions:
        opt_idx = solver.Value(option_vars[func])
        print(f"{func}: {opt_idx} (Area: {functions[func][opt_idx]['area']}, Latency: {functions[func][opt_idx]['latency']})")
    print(f"Total Area: {sum(functions[func][solver.Value(option_vars[func])]['area'] for func in functions)}")
    print(f"Total Latency: {sum(functions[func][solver.Value(option_vars[func])]['latency'] for func in functions)}")
else:
    print("No feasible solution found within area constraints.")
