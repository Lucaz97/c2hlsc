import itertools

# Define function options with area and latency
functions = {
    'AddRoundKey_hls': [
        {'area': 2165.3, 'latency': 23.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1620.1, 'latency': 26.0},
        {'area': 2165.3, 'latency': 23.0},
        {'area': 752.6, 'latency': 34.0},
    ],
    'SubBytes_hls': [
        {'area': 1156.4, 'latency': 6.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1889.1, 'latency': 15.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1156.4, 'latency': 6.0},
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0} for _ in range(5)
    ],
    'MixColumns_hls': [
        {'area': 866.6, 'latency': 0.0},
        {'area': 902.4, 'latency': 2.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
    ],
    'xtime': [
        {'area': 77.0, 'latency': 1.0} for _ in range(5)
    ],
    'Cipher_hls': [
        {'area': 6500.2, 'latency': 331.0},
        {'area': 5826.0, 'latency': 366.0},
        {'area': 6517.8, 'latency': 366.0},
        {'area': 6544.0, 'latency': 434.0},
        {'area': 5931.4, 'latency': 421.0},
    ],
}

target_area = 3800
tolerance = 0.05  # 5% tolerance

# Generate all possible combinations of options
func_names = list(functions.keys())
option_indices = [range(len(options)) for options in functions.values()]

best_config = None
min_latency = float('inf')

for combination in itertools.product(*option_indices):
    total_area = sum(functions[func][idx]['area'] for func, idx in zip(func_names, combination))
    total_latency = sum(functions[func][idx]['latency'] for func, idx in zip(func_names, combination))
    
    if (target_area*(1-tolerance) <= total_area <= target_area*(1+tolerance)):
        if total_latency < min_latency:
            min_latency = total_latency
            best_config = combination

if best_config:
    print("Best Configuration:")
    for func, idx in zip(func_names, best_config):
        print(f"{func}: {idx} (Area: {functions[func][idx]['area']}, Latency: {functions[func][idx]['latency']})")
    print(f"Total Area: {sum(functions[func][idx]['area'] for func, idx in zip(func_names, best_config))}")
    print(f"Total Latency: {min_latency}")
else:
    print("No feasible solution found within area constraints.")
'''
