        {'area': 5826.0, 'latency': 366.0},
        {'area': 6517.8, 'latency': 366.0},
        {'area': 6544.0, 'latency': 434.0},
        {'area': 5931.4, 'latency': 421.0}
    ]
}

# Create the solver
solver = pywraplp.Solver.CreateSolver('SCIP')

# Define the decision variables
x = {}
for func in functions:
    for i in range(len(functions[func])):
        x[(func, i)] = solver.IntVar(0, 1, f'x_{func}_{i}')

# Constraint: Only one option per function
