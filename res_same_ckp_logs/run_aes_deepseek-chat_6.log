        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0}
    ],
    'xtime': [
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0}
    ],
    'MixColumns_hls': [
        {'area': 866.6, 'latency': 0.0},
        {'area': 902.4, 'latency': 2.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0}
    ],
    'Cipher_hls': [
        {'area': 6500.2, 'latency': 331.0},
        {'area': 5826.0, 'latency': 366.0},
        {'area': 6517.8, 'latency': 366.0},
        {'area': 6544.0, 'latency': 434.0},
        {'area': 5931.4, 'latency': 421.0}
    ]
}

# Create the solver
solver = pywraplp.Solver.CreateSolver('SCIP')

# Define the decision variables
x = {}
for func in functions:
    for i in range(len(functions[func])):
        x[(func, i)] = solver.IntVar(0, 1, f'x_{func}_{i}')

# Constraint: Only one option per function
for func in functions:
    solver.Add(sum(x[(func, i)] for i in range(len(functions[func]))) == 1)

# Relaxed Constraint: Total area should be as close as possible to 8500 (further relaxed from 8000)
total_area = sum(x[(func, i)] * functions[func][i]['area'] for func in functions for i in range(len(functions[func])))
solver.Add(total_area <= 8500)

# Objective: Minimize latency
total_latency = sum(x[(func, i)] * functions[func][i]['latency'] for func in functions for i in range(len(functions[func])))
solver.Minimize(total_latency)

# Solve the problem
status = solver.Solve()

# Extract the solution
if status == pywraplp.Solver.OPTIMAL:
    solution = {}
    for func in functions:
        for i in range(len(functions[func])):
            if x[(func, i)].solution_value() > 0.5:
                solution[func] = i
    print("Optimal solution found:")
    print(solution)
else:
    print("No optimal solution found.")
'''
