from ortools.sat.python import cp_model

# Define the functions and their options
functions = {
    'AddRoundKey_hls': [
        {'area': 2165.3, 'latency': 23.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1620.1, 'latency': 26.0},
        {'area': 2165.3, 'latency': 23.0},
        {'area': 752.6, 'latency': 34.0}
    ],
    'SubBytes_hls': [
        {'area': 1156.4, 'latency': 6.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1889.1, 'latency': 15.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1156.4, 'latency': 6.0}
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0} for _ in range(5)
    ],
    'MixColumns_hls': [
        {'area': 866.6, 'latency': 0.0},
        {'area': 902.4, 'latency': 2.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0}
    ],
    'xtime': [
        {'area': 77.0, 'latency': 1.0} for _ in range(5)
    ]
}

# Call counts in Cipher
call_counts = {
    'AddRoundKey_hls': 3,
    'SubBytes_hls': 1,
    'ShiftRows_hls': 1,
    'MixColumns_hls': 1,
    'xtime': 4  # Called 4 times within MixColumns
}

model = cp_model.CpModel()

# Variables: option index for each function
option_vars = {}
for func in functions:
    option_vars[func] = model.NewIntVar(0, len(functions[func])-1, func)

# Total area and latency
total_area = sum(functions[func][option_vars[func]]['area'] for func in functions)
total_latency = sum(call_counts[func] * functions[func][option_vars[func]]['latency'] for func in functions)

# Objective: minimize latency, with area as close to 3800 as possible
target_area = 3800
area_diff = total_area - target_area
model.Minimize(total_latency * 1000 + abs(area_diff))  # Weight latency more

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print(f"Optimal configuration found with total latency {solver.Value(total_latency)} and area {solver.Value(total_area)}")
    for func in functions:
        opt_idx = solver.Value(option_vars[func])
        print(f"{func} option {opt_idx}: area {functions[func][opt_idx]['area']}, latency {functions[func][opt_idx]['latency']}")
else:
    print("No optimal solution found.")
