python: '''
from ortools.sat.python import cp_model

# Data for each function: list of (area, latency)
# Function names: AddRoundKey_hls, SubBytes_hls, ShiftRows_hls, xtime, MixColumns_hls, Cipher_hls

data = {
    'AddRoundKey_hls': [
        (2165.3, 23.0),  # option 0
        (752.6, 34.0),   # option 1
        (1620.1, 26.0),  # option 2
        (2165.3, 23.0),  # option 3
        (752.6, 34.0)    # option 4
    ],
    'SubBytes_hls': [
        (1156.4, 6.0),   # option 0
        (1160.4, 3.0),   # option 1
        (1889.1, 15.0),  # option 2
        (1160.4, 3.0),   # option 3
        (1156.4, 6.0)    # option 4
    ],
    'ShiftRows_hls': [
        (23.9, 0.0),     # option 0
        (23.9, 0.0),     # option 1
        (23.9, 0.0),     # option 2
        (23.9, 0.0),     # option 3
        (23.9, 0.0)      # option 4
    ],
    'xtime': [
        (77.0, 1.0),     # option 0
        (77.0, 1.0),     # option 1
        (77.0, 1.0),     # option 2
        (77.0, 1.0),     # option 3
        (77.0, 1.0)      # option 4
    ],
    'MixColumns_hls': [
        (866.6, 0.0),    # option 0
        (902.4, 2.0),    # option 1
        (866.6, 0.0),    # option 2
        (866.6, 0.0),    # option 3
        (866.6, 0.0)     # option 4
    ],
    'Cipher_hls': [
        (6500.2, 331.0),  # option 0
        (5826.0, 366.0),  # option 1
        (6517.8, 366.0),  # option 2
        (6544.0, 434.0),  # option 3
        (5931.4, 421.0)   # option 4
    ]
}

# List of function names in our optimization
func_names = list(data.keys())

# Target area
target_area = 3800.0

# Weight factor for area penalty in the objective.
# Chosen to trade off latency and area deviation. Adjust as needed.
area_weight = 0.1

model = cp_model.CpModel()

# Decision variables: for each function, we choose one option (as an integer index)
choice = {}
for f in func_names:
    num_options = len(data[f])
    choice[f] = model.NewIntVar(0, num_options - 1, f + '_choice')

# Because CP-SAT works with integers, we scale areas and latencies.
# Multiply by 10 to preserve one decimal digit.
scale = 10
scaled_target_area = int(target_area * scale)

# Create lists for area and latency for each option (scaled)
scaled_area = {}
scaled_latency = {}
for f in func_names:
    scaled_area[f] = [int(round(opt[0]*scale)) for opt in data[f]]
    scaled_latency[f] = [int(round(opt[1]*scale)) for opt in data[f]]

# Create variables for selected area and latency per function
sel_area = {}
sel_latency = {}
for f in func_names:
    num_options = len(data[f])
    sel_area[f] = model.NewIntVar(0, max(scaled_area[f]), f + '_area')
    sel_latency[f] = model.NewIntVar(0, max(scaled_latency[f]), f + '_latency')
    # Define element constraints:
    model.AddElement(choice[f], scaled_area[f], sel_area[f])
    model.AddElement(choice[f], scaled_latency[f], sel_latency[f])

# Assume total latency is the sum of latencies across functions.
# Note: In the real design, latencies are not simply additive because of the call graph hierarchy,
# but for this optimization we assume a simplified additive model.
total_latency = model.NewIntVar(0, 100000, 'total_latency')
model.Add(total_latency == sum(sel_latency[f] for f in func_names))

# Similarly, total area as the sum of areas.
total_area = model.NewIntVar(0, 100000, 'total_area')
model.Add(total_area == sum(sel_area[f] for f in func_names))

# Introduce a variable for absolute area deviation: |total_area - target_area|
area_deviation = model.NewIntVar(0, 100000, 'area_deviation')
diff = model.NewIntVar(-100000, 100000, 'diff')
model.Add(diff == total_area - scaled_target_area)
model.AddAbsEquality(area_deviation, diff)

# Objective: minimize total latency + area_weight * area_deviation.
# Since CP-SAT requires integer objective, we scale area_weight appropriately.
# For example, let cost = total_latency + (area_weight * 10)*area_deviation. 
# Here area_weight is 0.1, multiplied by 10 gives 1; so objective = total_latency + area_deviation.
objective = model.NewIntVar(0, 1000000, 'objective')
model.Add(objective == total_latency + area_deviation)
model.Minimize(objective)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in [cp_model.OPTIMAL, cp_model.FEASIBLE]:
    print("Optimal solution found:")
    for f in func_names:
        opt = solver.Value(choice[f])
        area_val = solver.Value(sel_area[f]) / scale
        lat_val = solver.Value(sel_latency[f]) / scale
        print(f + ": option {opt}, area = {area_val}, latency = {lat_val}")
    tot_area = solver.Value(total_area) / scale
    tot_latency = solver.Value(total_latency) / scale
    dev = solver.Value(area_deviation) / scale
    obj = solver.Value(objective)
    print(f"Total area = {tot_area}, Total latency = {tot_latency}, Area deviation = {dev}")
    print(f"Objective = {obj}")
else:
    print("No solution found.")
'''
