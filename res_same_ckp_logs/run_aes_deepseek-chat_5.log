ShiftRows_vars = [solver.IntVar(0, 1, f'ShiftRows_{i}') for i in ShiftRows_options]
xtime_vars = [solver.IntVar(0, 1, f'xtime_{i}') for i in xtime_options]
MixColumns_vars = [solver.IntVar(0, 1, f'MixColumns_{i}') for i in MixColumns_options]
