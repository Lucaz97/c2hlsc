        {"area": 1160.4, "latency": 3.0},
        {"area": 1889.1, "latency": 15.0},
        {"area": 1160.4, "latency": 3.0},
        {"area": 1156.4, "latency": 6.0},
    ],
    "ShiftRows_hls": [
        {"area": 23.9, "latency": 0.0},
        {"area": 23.9, "latency": 0.0},
        {"area": 23.9, "latency": 0.0},
        {"area": 23.9, "latency": 0.0},
        {"area": 23.9, "latency": 0.0},
    ],
    "xtime": [
        {"area": 77.0, "latency": 1.0},
        {"area": 77.0, "latency": 1.0},
        {"area": 77.0, "latency": 1.0},
        {"area": 77.0, "latency": 1.0},
        {"area": 77.0, "latency": 1.0},
    ],
    "MixColumns_hls": [
        {"area": 866.6, "latency": 0.0},
        {"area": 902.4, "latency": 2.0},
        {"area": 866.6, "latency": 0.0},
        {"area": 866.6, "latency": 0.0},
        {"area": 866.6, "latency": 0.0},
    ],
    "Cipher_hls": [
        {"area": 6500.2, "latency": 331.0},
        {"area": 5826.0, "latency": 366.0},
        {"area": 6517.8, "latency": 366.0},
        {"area": 6544.0, "latency": 434.0},
        {"area": 5931.4, "latency": 421.0},
    ],
}

# Variables to represent the selected option for each function
selected_options = {}
for func, options in functions.items():
    selected_options[func] = model.NewIntVar(0, len(options) - 1, f"{func}_option")

# Total area and latency
total_area = model.NewIntVar(0, 100000, "total_area")
total_latency = model.NewIntVar(0, 100000, "total_latency")

# Use Element constraint to select area and latency based on the chosen option
for func, options in functions.items():
    areas = [int(opt["area"]) for opt in options]
    latencies = [int(opt["latency"]) for opt in options]
    model.AddElement(selected_options[func], areas, total_area)
    model.AddElement(selected_options[func], latencies, total_latency)

# Objective: Minimize latency while keeping area close to 4500
target_area = 4500
area_diff = model.NewIntVar(0, 10000, "area_diff")
model.AddAbsEquality(area_diff, total_area - target_area)
model.Minimize(total_latency + area_diff)

# Solve the problem
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Optimal configuration found:")
    for func in functions:
        option_index = solver.Value(selected_options[func])
        print(f"{func}: Option {option_index}")
    print(f"Total Area: {solver.Value(total_area)}")
    print(f"Total Latency: {solver.Value(total_latency)}")
else:
    print("No feasible solution found.")
