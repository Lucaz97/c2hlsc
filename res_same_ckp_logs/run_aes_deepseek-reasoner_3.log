from ortools.sat.python import cp_model

functions = {
    'AddRoundKey_hls': [
        {'area': 2165.3, 'latency': 23.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1620.1, 'latency': 26.0},
        {'area': 2165.3, 'latency': 23.0},
        {'area': 752.6, 'latency': 34.0},
    ],
    'SubBytes_hls': [
        {'area': 1156.4, 'latency': 6.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1889.1, 'latency': 15.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1156.4, 'latency': 6.0},
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
    ],
    'xtime': [
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
    ],
    'MixColumns_hls': [
        {'area': 866.6, 'latency': 0.0},
        {'area': 902.4, 'latency': 2.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
    ],
    'Cipher_hls': [
        {'area': 6500.2, 'latency': 331.0},
        {'area': 5826.0, 'latency': 366.0},
        {'area': 6517.8, 'latency': 366.0},
        {'area': 6544.0, 'latency': 434.0},
        {'area': 5931.4, 'latency': 421.0},
    ],
}

target_area = 3800

model = cp_model.CpModel()

vars = {func: model.NewIntVar(0, 4, func) for func in functions}

area_vars = []
latency_vars = []
for func in functions:
    options = functions[func]
    # Area contribution
    max_area = max(opt['area'] for opt in options)
    area = model.NewIntVar(0, int(max_area * 5), f'area_{func}')
    model.Add(area == sum(opt['area'] * (vars[func] == i) for i, opt in enumerate(options)))
    area_vars.append(area)
    # Latency contribution
    max_latency = max(opt['latency'] for opt in options)
    latency = model.NewIntVar(0, int(max_latency * 5), f'latency_{func}')
    model.Add(latency == sum(opt['latency'] * (vars[func] == i) for i, opt in enumerate(options)))
    latency_vars.append(latency)

total_area = sum(area_vars)
total_latency = sum(latency_vars)

area_diff = model.NewIntVar(0, 100000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - target_area)

model.Minimize(area_diff * 1000 + total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal Solution:")
    for func in functions:
        idx = solver.Value(vars[func])
        print(f"{func}: {idx} (area={functions[func][idx]['area']}, latency={functions[func][idx]['latency']})")
    print(f"Total Area: {solver.Value(total_area)}, Total Latency: {solver.Value(total_latency)}")
else:
    print("No optimal solution found.")
'''
