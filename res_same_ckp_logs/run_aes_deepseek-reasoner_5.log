        {'area': 11604, 'latency': 30},
        {'area': 18891, 'latency': 150},
        {'area': 11604, 'latency': 30},
        {'area': 11564, 'latency': 60}
    ],
    'ShiftRows_hls': [{'area': 239, 'latency': 0}]*5,
    'xtime': [{'area': 770, 'latency': 10}]*5,
    'MixColumns_hls': [
        {'area': 8666, 'latency': 0},
        {'area': 9024, 'latency': 20},
        {'area': 8666, 'latency': 0},
        {'area': 8666, 'latency': 0},
        {'area': 8666, 'latency': 0}
    ],
    'Cipher_hls': [
        {'area': 65002, 'latency': 3310},
        {'area': 58260, 'latency': 3660},
        {'area': 65178, 'latency': 3660},
        {'area': 65440, 'latency': 4340},
        {'area': 59314, 'latency': 4210}
    ]
}

model = cp_model.CpModel()
choices = {}
area_vars = {}
latency_vars = {}

# Create variables and element constraints
for func in functions:
    num_opts = len(functions[func])
    choices[func] = model.NewIntVar(0, num_opts-1, f'{func}_choice')
    area_vars[func] = model.NewIntVar(0, 100000, f'{func}_area')
    latency_vars[func] = model.NewIntVar(0, 100000, f'{func}_latency')
    
    model.AddElement(choices[func], [opt['area'] for opt in functions[func]], area_vars[func])
    model.AddElement(choices[func], [opt['latency'] for opt in functions[func]], latency_vars[func])

total_area = sum(area_vars[func] for func in functions)
total_latency = sum(latency_vars[func] for func in functions)

# Handle absolute deviation properly
target_area = 3800 * 10
deviation = model.NewIntVar(0, 100000, 'deviation')
model.AddAbsEquality(deviation, total_area - target_area)

# Objective: minimize latency + 100*deviation to prioritize area proximity
model.Minimize(total_latency + 100 * deviation)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal configuration:")
