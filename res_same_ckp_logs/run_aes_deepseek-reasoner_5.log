from ortools.sat.python import cp_model

# Define functions and options with scaled integer values
functions = {
    'AddRoundKey_hls': [
        {'area': 21653, 'latency': 230},  # scaled by 10
        {'area': 7526, 'latency': 340},
        {'area': 16201, 'latency': 260},
        {'area': 21653, 'latency': 230},
        {'area': 7526, 'latency': 340}
    ],
    'SubBytes_hls': [
        {'area': 11564, 'latency': 60},
        {'area': 11604, 'latency': 30},
        {'area': 18891, 'latency': 150},
        {'area': 11604, 'latency': 30},
        {'area': 11564, 'latency': 60}
    ],
    'ShiftRows_hls': [
        {'area': 239, 'latency': 0} for _ in range(5)
    ],
    'xtime': [
        {'area': 770, 'latency': 10} for _ in range(5)
    ],
    'MixColumns_hls': [
        {'area': 8666, 'latency': 0},
        {'area': 9024, 'latency': 20},
        {'area': 8666, 'latency': 0},
        {'area': 8666, 'latency': 0},
        {'area': 8666, 'latency': 0}
    ],
    'Cipher_hls': [
        {'area': 65002, 'latency': 3310},
        {'area': 58260, 'latency': 3660},
        {'area': 65178, 'latency': 3660},
        {'area': 65440, 'latency': 4340},
        {'area': 59314, 'latency': 4210}
    ]
}

model = cp_model.CpModel()

choices = {}
selected_areas = {}
selected_latencies = {}

for func in functions:
    num_opts = len(functions[func])
    choices[func] = model.NewIntVar(0, num_opts-1, f'{func}_choice')
    
    # Create area/latency arrays and element constraints
    area_arr = [opt['area'] for opt in functions[func]]
    latency_arr = [opt['latency'] for opt in functions[func]]
    
    sa = model.NewIntVar(min(area_arr), max(area_arr), f'{func}_area')
    sl = model.NewIntVar(min(latency_arr), max(latency_arr), f'{func}_latency')
    
    model.AddElement(choices[func], area_arr, sa)
    model.AddElement(choices[func], latency_arr, sl)
    
    selected_areas[func] = sa
    selected_latencies[func] = sl

total_area = sum(selected_areas[func] for func in functions)
total_latency = sum(selected_latencies[func] for func in functions)

target_area = 3800 * 10  # 3800 * 10
deviation = model.NewIntVar(0, 100000, 'deviation')
model.Add(deviation == abs(total_area - target_area))

# Weighted objective: prioritize latency (1:100 ratio)
model.Minimize(total_latency + 100 * deviation)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal configuration (scaled x10):")
    total_a = 0
    total_l = 0
    for func in functions:
        opt_idx = solver.Value(choices[func])
        area = functions[func][opt_idx]['area']
        latency = functions[func][opt_idx]['latency']
        total_a += area
        total_l += latency
        print(f"{func} option {opt_idx}: area={area/10}, latency={latency/10}")
    print(f"Total area: {total_a/10}, latency: {total_l/10}")
else:
    print("No optimal solution found")
'''
