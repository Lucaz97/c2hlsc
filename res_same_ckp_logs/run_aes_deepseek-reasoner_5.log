        print(f"{func}: option {opt_idx} (area={functions[func][opt_idx]['area']/10}, latency={functions[func][opt_idx]['latency']/10})")
    print(f"Total area: {total_a/10} (target: 3800)")
    print(f"Total latency: {total_l/10}")
else:
    print("No solution found")
