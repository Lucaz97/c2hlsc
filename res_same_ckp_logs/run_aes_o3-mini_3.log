from ortools.sat.python import cp_model

# Data for each function option: (area, latency)
# For functions with multiple calls, we'll multiply accordingly.
# We assume the following call multiplicities based on the call graph in Cipher:
#   AddRoundKey: 3 calls
#   SubBytes: 1 call
#   ShiftRows: 1 call (all options identical, so we fix index 0)
#   xtime: 4 calls (all options identical, so fix index 0)
#   MixColumns: 1 call (we choose option 0 as it gives lowest latency)
#   Cipher: 1 call

# Options data (index: (area, latency))
AddRoundKey_options = [
    (2165.3, 23.0),
    (752.6, 34.0),
    (1620.1, 26.0),
    (2165.3, 23.0),
    (752.6, 34.0)
]

SubBytes_options = [
    (1156.4, 6.0),
    (1160.4, 3.0),
    (1889.1, 15.0),
    (1160.4, 3.0),
    (1156.4, 6.0)
]

# Fixed for ShiftRows, xtime, MixColumns:
ShiftRows = (23.9, 0.0)
xtime = (77.0, 1.0)  # used 4 times
MixColumns = (866.6, 0.0)  # selecting option 0

Cipher_options = [
    (6500.2, 331.0),
    (5826.0, 366.0),
    (6517.8, 366.0),
    (6544.0, 434.0),
    (5931.4, 421.0)
]

# Multiplicities for functions that appear multiple times:
mult_AddRoundKey = 3
mult_xtime = 4

# Target area (as given in the problem statement)
target_area = 3800.0

# Create the CP-SAT model.
model = cp_model.CpModel()

# Decision variables: indices for AddRoundKey, SubBytes, Cipher.
# They range over the option indices.
a = model.NewIntVar(0, len(AddRoundKey_options)-1, 'a')
s = model.NewIntVar(0, len(SubBytes_options)-1, 's')
c = model.NewIntVar(0, len(Cipher_options)-1, 'c')

# Since CP-SAT works with integers, multiply all real numbers by 10 to avoid decimals.
scale = 10

# Precompute integer data scaled:
AddRoundKey_area = [int(round(x[0]*scale)) for x in AddRoundKey_options]
AddRoundKey_latency = [int(round(x[1]*scale)) for x in AddRoundKey_options]

SubBytes_area = [int(round(x[0]*scale)) for x in SubBytes_options]
SubBytes_latency = [int(round(x[1]*scale)) for x in SubBytes_options]

Cipher_area = [int(round(x[0]*scale)) for x in Cipher_options]
Cipher_latency = [int(round(x[1]*scale)) for x in Cipher_options]

ShiftRows_area = int(round(ShiftRows[0]*scale))
ShiftRows_latency = int(round(ShiftRows[1]*scale))

xtime_area = int(round(xtime[0]*scale))
xtime_latency = int(round(xtime[1]*scale))

MixColumns_area = int(round(MixColumns[0]*scale))
MixColumns_latency = int(round(MixColumns[1]*scale))

target_area_int = int(round(target_area*scale))

# Create integers for chosen options.
# We use element constraints to link decision variable to area and latency contributions.
a_area = model.NewIntVar(0, max(AddRoundKey_area), 'a_area')
s_area = model.NewIntVar(0, max(SubBytes_area), 's_area')
c_area = model.NewIntVar(0, max(Cipher_area), 'c_area')

a_lat = model.NewIntVar(0, max(AddRoundKey_latency), 'a_lat')
s_lat = model.NewIntVar(0, max(SubBytes_latency), 's_lat')
c_lat = model.NewIntVar(0, max(Cipher_latency), 'c_lat')

model.AddElement(a, AddRoundKey_area, a_area)
model.AddElement(a, AddRoundKey_latency, a_lat)

model.AddElement(s, SubBytes_area, s_area)
model.AddElement(s, SubBytes_latency, s_lat)

model.AddElement(c, Cipher_area, c_area)
model.AddElement(c, Cipher_latency, c_lat)

# Total area and latency calculations.
total_area = (
    c_area +
    mult_AddRoundKey * a_area +
    s_area +
    ShiftRows_area +
    MixColumns_area +
    mult_xtime * xtime_area
)

total_latency = (
    c_lat +
    mult_AddRoundKey * a_lat +
    s_lat +
    ShiftRows_latency +
    MixColumns_latency +
    mult_xtime * xtime_latency
)

# We want to minimize latency while forcing the total area to be as close to the target as possible.
# We create an auxiliary variable for area deviation.
area_deviation = model.NewIntVar(0, 1000000, 'area_deviation')
# Represent deviation as absolute difference.
model.Add(total_area - target_area_int >= 0).OnlyEnforceIf(model.NewBoolVar('dummy_pos'))
model.AddAbsEquality(area_deviation, total_area - target_area_int)

# We now set an objective that combines latency and area deviation.
# We choose a weight factor for area deviation. Adjust weight as needed.
weight = 1   # weight factor; since latency and area are scaled similarly.
objective = model.NewIntVar(0, 10000000, 'objective')
model.Add(objective == total_latency + weight * area_deviation)
model.Minimize(objective)

# Solve.
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("AddRoundKey_hls", solver.Value(a))
    print("SubBytes_hls", solver.Value(s))
    print("Cipher_hls", solver.Value(c))
    print("Total area (scaled):", solver.Value(total_area), "->", solver.Value(total_area)/scale)
    print("Total latency (scaled):", solver.Value(total_latency), "->", solver.Value(total_latency)/scale)
    print("Area deviation (scaled):", solver.Value(area_deviation), "->", solver.Value(area_deviation)/scale)
else:
    print("No solution found.")
''' 

