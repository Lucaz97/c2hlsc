from ortools.sat.python import cp_model

# Data for each function: each option is a tuple (area, latency, throughput)
# Function: AddRoundKey_hls (indices 0..4)
addroundkey = [
    (2165.3, 23.0, 26.0),
    (752.6, 34.0, 38.0),
    (1620.1, 26.0, 30.0),
    (2165.3, 23.0, 26.0),
    (752.6, 34.0, 38.0)
]

# Function: SubBytes_hls (indices 0..4)
subbytes = [
    (1156.4, 6.0, 10.0),
    (1160.4, 3.0, 7.0),
    (1889.1, 15.0, 17.0),
    (1160.4, 3.0, 7.0),
    (1156.4, 6.0, 10.0)
]

# Function: ShiftRows_hls (indices 0..4)
shiftrows = [
    (23.9, 0.0, 2.0),
    (23.9, 0.0, 2.0),
    (23.9, 0.0, 2.0),
    (23.9, 0.0, 2.0),
    (23.9, 0.0, 2.0)
]

# Function: xtime (indices 0..4)
xtime = [
    (77.0, 1.0, 2.0),
    (77.0, 1.0, 2.0),
    (77.0, 1.0, 2.0),
    (77.0, 1.0, 2.0),
    (77.0, 1.0, 2.0)
]

# Function: MixColumns_hls (indices 0..4)
mixcolumns = [
    (866.6, 0.0, 2.0),
    (902.4, 2.0, 6.0),
    (866.6, 0.0, 2.0),
    (866.6, 0.0, 2.0),
    (866.6, 0.0, 2.0)
]

# Function: Cipher_hls (indices 0..4)
cipher = [
    (6500.2, 331.0, 335.0),
    (5826.0, 366.0, 370.0),
    (6517.8, 366.0, 370.0),
    (6544.0, 434.0, 438.0),
    (5931.4, 421.0, 425.0)
]

# Let's assume that the overall performance of the application-critical path is determined by the latency of Cipher_hls,
# which already includes the (best-of) child functions synthesis.
# However, area may come from the entire design.
# For our optimization, we consider both: we want to minimize the latency of Cipher_hls (primary),
# and we want its area to be as close as possible to a target value.
# Note: The target value is 3800. Since none of the Cipher_hls options is near 3800,
# we assume the trade-off will be made with a composite objective:
#   objective = latency + weight * |area - target_area|
# We choose a weight to scale the area difference appropriately.
target_area = 3800.0
# If we assume latency is in the hundreds, a weight like 1.0 gives similar scale. We can tune it.
weight = 1.0

model = cp_model.CpModel()

# Decision variable: choose option for Cipher_hls.
# Since options indices are 0..4, we create an integer variable.
cipher_choice = model.NewIntVar(0, len(cipher) - 1, 'cipher_choice')

# Since CP-SAT handles only integer expressions, we scale all floats (multiply by 10, for instance)
scale = 10

# Prepare scaled data for Cipher_hls
cipher_areas = [int(a * scale) for (a, lat, thr) in cipher]
cipher_latencies = [int(lat * scale) for (a, lat, thr) in cipher]

# Scaled target area
target_area_scaled = int(target_area * scale)

# Create an integer variable for latency and area from chosen option
cipher_latency = model.NewIntVar(min(cipher_latencies), max(cipher_latencies), 'cipher_latency')
cipher_area = model.NewIntVar(min(cipher_areas), max(cipher_areas), 'cipher_area')

# Link choice with latency and area using element constraints
model.AddElement(cipher_choice, cipher_latencies, cipher_latency)
model.AddElement(cipher_choice, cipher_areas, cipher_area)

# Create an integer variable for area deviation (absolute difference)
area_dev = model.NewIntVar(0, 100000, 'area_dev')
# Introduce an auxiliary variable for (cipher_area - target)
diff = model.NewIntVar(-100000, 100000, 'diff')
model.Add(diff == cipher_area - target_area_scaled)
# Absolute value constraint
model.AddAbsEquality(area_dev, diff)

# Composite objective: minimize cipher_latency + weight * area_dev.
# Since weight=1 and our numbers are scaled, objective = cipher_latency + area_dev.
obj = model.NewIntVar(0, 1000000, 'obj')
model.Add(obj == cipher_latency + area_dev)
model.Minimize(obj)

# Solve the model.
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    chosen = solver.Value(cipher_choice)
    chosen_latency = solver.Value(cipher_latency) / scale
    chosen_area = solver.Value(cipher_area) / scale
    area_difference = solver.Value(area_dev) / scale
    obj_val = solver.Value(obj) / scale
    print("Solution:")
    print("Cipher_hls option:", chosen)
    print("Latency:", chosen_latency)
    print("Area:", chosen_area)
    print("Area deviation from", target_area, ":", area_difference)
    print("Objective value:", obj_val)
else:
    print("No solution found.")
'''
