from ortools.sat.python import cp_model

# We optimize configuration for the children functions used by Cipher_hls:
# We consider:
#  - AddRoundKey_hls (used 3 times)
#  - SubBytes_hls (used once)
#  - ShiftRows_hls (used once, all options identical)
#  - MixColumns_hls (used once)
#
# Data for each function is given as list of dictionaries with keys 'area' and 'latency'.
# Note: We assume that each function is instantiated uniformly where called.
# The overall area is computed as:
#    total_area = 3 * area(AddRoundKey) + area(SubBytes) + area(ShiftRows) + area(MixColumns)
# And overall latency is computed as:
#    total_latency = 3 * latency(AddRoundKey) + latency(SubBytes) + latency(ShiftRows) + latency(MixColumns)
#
# Our goal is to minimize latency while keeping total_area as close as possible to TARGET_AREA.
# We combine the two objectives using a penalty weight.
#
TARGET_AREA = 3800.0
PENALTY = 0.1  # penalty weight for area deviation

# Options data
addRoundKey_options = [
    {'area': 2165.3, 'latency': 23.0},
    {'area': 752.6,  'latency': 34.0},
    {'area': 1620.1, 'latency': 26.0},
    {'area': 2165.3, 'latency': 23.0},
    {'area': 752.6,  'latency': 34.0}
]

subBytes_options = [
    {'area': 1156.4, 'latency': 6.0},
    {'area': 1160.4, 'latency': 3.0},
    {'area': 1889.1, 'latency': 15.0},
    {'area': 1160.4, 'latency': 3.0},
    {'area': 1156.4, 'latency': 6.0}
]

shiftRows_options = [
    {'area': 23.9, 'latency': 0.0},
    {'area': 23.9, 'latency': 0.0},
    {'area': 23.9, 'latency': 0.0},
    {'area': 23.9, 'latency': 0.0},
    {'area': 23.9, 'latency': 0.0}
]

mixColumns_options = [
    {'area': 866.6, 'latency': 0.0},
    {'area': 902.4, 'latency': 2.0},
    {'area': 866.6, 'latency': 0.0},
    {'area': 866.6, 'latency': 0.0},
    {'area': 866.6, 'latency': 0.0}
]

# Create the model.
model = cp_model.CpModel()

# Decision variables: indices for each function option.
addround_var = model.NewIntVar(0, len(addRoundKey_options) - 1, 'addRoundKey')
subbytes_var = model.NewIntVar(0, len(subBytes_options) - 1, 'subBytes')
# For ShiftRows, all options are identical; we can fix to option 0.
shiftrows_choice = 0
mixcols_var = model.NewIntVar(0, len(mixColumns_options) - 1, 'mixColumns')

# Since our data are floats, we scale them by 10 to convert to integers.
scale = 10

# Pre-calculate arrays for areas and latencies (scaled as integers).
add_area = [int(round(opt['area'] * scale)) for opt in addRoundKey_options]
add_lat = [int(round(opt['latency'] * scale)) for opt in addRoundKey_options]
sub_area = [int(round(opt['area'] * scale)) for opt in subBytes_options]
sub_lat = [int(round(opt['latency'] * scale)) for opt in subBytes_options]
shift_area = int(round(shiftRows_options[0]['area'] * scale))
shift_lat = int(round(shiftRows_options[0]['latency'] * scale))
mix_area = [int(round(opt['area'] * scale)) for opt in mixColumns_options]
mix_lat = [int(round(opt['latency'] * scale)) for opt in mixColumns_options]

target_area_int = int(round(TARGET_AREA * scale))

# Create integer variables for selected areas and latencies.
add_area_var = model.NewIntVar(0, max(add_area), 'add_area')
add_lat_var = model.NewIntVar(0, max(add_lat), 'add_lat')
sub_area_var = model.NewIntVar(0, max(sub_area), 'sub_area')
sub_lat_var = model.NewIntVar(0, max(sub_lat), 'sub_lat')
mix_area_var = model.NewIntVar(0, max(mix_area), 'mix_area')
mix_lat_var = model.NewIntVar(0, max(mix_lat), 'mix_lat')

# Link the decision variables to the corresponding areas and latencies using Element constraints.
model.AddElement(addround_var, add_area, add_area_var)
model.AddElement(addround_var, add_lat, add_lat_var)

model.AddElement(subbytes_var, sub_area, sub_area_var)
model.AddElement(subbytes_var, sub_lat, sub_lat_var)

model.AddElement(mixcols_var, mix_area, mix_area_var)
model.AddElement(mixcols_var, mix_lat, mix_lat_var)

# Compute total area and total latency.
# Note: AddRoundKey is used 3 times.
total_area = model.NewIntVar(0, 100000, 'total_area')
total_latency = model.NewIntVar(0, 100000, 'total_latency')

model.Add(total_area == 3 * add_area_var + sub_area_var + shift_area + mix_area_var)
model.Add(total_latency == 3 * add_lat_var + sub_lat_var + shift_lat + mix_lat_var)

# We'll minimize an objective that is the total latency plus a penalty for deviating from the target area.
# To linearize the absolute difference |total_area - target_area_int| we introduce an auxiliary variable.
area_deviation = model.NewIntVar(0, 100000, 'area_deviation')
model.Add(area_deviation >= total_area - target_area_int)
model.Add(area_deviation >= target_area_int - total_area)

# Scale penalty similarly.
penalty_scaled = int(round(PENALTY * scale))

# The objective is: total_latency + (penalty_scaled * area_deviation)
objective = model.NewIntVar(0, 1000000, 'objective')
model.Add(objective == total_latency + penalty_scaled * area_deviation)
model.Minimize(objective)

# Solve the model.
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    ar_index = solver.Value(addround_var)
    sb_index = solver.Value(subbytes_var)
    mc_index = solver.Value(mixcols_var)
    tot_area = solver.Value(total_area) / scale
    tot_lat = solver.Value(total_latency) / scale
    area_dev = solver.Value(area_deviation) / scale
    print("Optimal configuration for children functions:")
    print("AddRoundKey_hls option:", ar_index, " (area: {:.1f}, latency: {:.1f})".format(add_area[ar_index]/scale, add_lat[ar_index]/scale))
    print("SubBytes_hls option:", sb_index, " (area: {:.1f}, latency: {:.1f})".format(sub_area[sb_index]/scale, sub_lat[sb_index]/scale))
    print("ShiftRows_hls option:", shiftrows_choice, " (area: {:.1f}, latency: {:.1f})".format(shift_area/scale, shift_lat/scale))
    print("MixColumns_hls option:", mc_index, " (area: {:.1f}, latency: {:.1f})".format(mix_area[mc_index]/scale, mix_lat[mc_index]/scale))
    print("Total children area: {:.1f} (target: {:.1f}, deviation: {:.1f})".format(tot_area, TARGET_AREA, area_dev))
    print("Total children latency: {:.1f}".format(tot_lat))
else:
    print("No solution found.")
'''
