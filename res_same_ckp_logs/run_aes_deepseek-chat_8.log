SubBytes = model.NewIntVar(0, 4, 'SubBytes')
ShiftRows = model.NewIntVar(0, 4, 'ShiftRows')
xtime = model.NewIntVar(0, 4, 'xtime')
MixColumns = model.NewIntVar(0, 4, 'MixColumns')
Cipher = model.NewIntVar(0, 4, 'Cipher')

# Area and latency data (scaled by 10 to handle floating-point values)
area_data = {
    'AddRoundKey': [21653, 7526, 16201, 21653, 7526],
    'SubBytes': [11564, 11604, 18891, 11604, 11564],
    'ShiftRows': [239, 239, 239, 239, 239],
    'xtime': [770, 770, 770, 770, 770],
    'MixColumns': [8666, 9024, 8666, 8666, 8666],
    'Cipher': [65002, 58260, 65178, 65440, 59314]
}

latency_data = {
    'AddRoundKey': [230, 340, 260, 230, 340],
    'SubBytes': [60, 30, 150, 30, 60],
    'ShiftRows': [0, 0, 0, 0, 0],
    'xtime': [10, 10, 10, 10, 10],
    'MixColumns': [0, 20, 0, 0, 0],
    'Cipher': [3310, 3660, 3660, 4340, 4210]
}

# Total area constraint (scaled by 10)
total_area = sum(
    model.NewIntVar(area_data[func][0], area_data[func][-1], f'{func}_area') 
    for func in area_data
)
