        {'area': 1889.1, 'latency': 15.0},
        {'area': 1160.4, 'latency': 3.0},
        {'area': 1156.4, 'latency': 6.0},
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
    ],
    'xtime': [
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
    ],
    'MixColumns_hls': [
        {'area': 866.6, 'latency': 0.0},
        {'area': 902.4, 'latency': 2.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
        {'area': 866.6, 'latency': 0.0},
    ],
    'Cipher_hls': [
        {'area': 6500.2, 'latency': 331.0},
        {'area': 5826.0, 'latency': 366.0},
        {'area': 6517.8, 'latency': 366.0},
        {'area': 6544.0, 'latency': 434.0},
        {'area': 5931.4, 'latency': 421.0},
    ],
}

target_area = 3800

model = cp_model.CpModel()

func_vars = {}
for func in functions:
    func_vars[func] = model.NewIntVar(0, len(functions[func])-1, f'{func}_option')

total_area = 0
total_latency = 0
for func in functions:
    areas = [int(opt['area']*10) for opt in functions[func]]
    latencies = [int(opt['latency']*10) for opt in functions[func]]
    
    area_var = model.NewIntVar(0, max(areas)*10, f'{func}_area')
    model.AddElement(func_vars[func], areas, area_var)
    total_area += area_var
    
    latency_var = model.NewIntVar(0, max(latencies)*10, f'{func}_latency')
    model.AddElement(func_vars[func], latencies, latency_var)
    total_latency += latency_var

diff = model.NewIntVar(0, 100000, 'diff')
model.AddAbsEquality(diff, total_area - int(target_area *10))
model.Minimize(diff * 1000 + total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Closest configuration:")
    config = []
    for func in functions:
        idx = solver.Value(func_vars[func])
        config.append(f"{func} {idx}")
    print("solution: " + ", ".join(config))
else:
    print("No solution found.")
