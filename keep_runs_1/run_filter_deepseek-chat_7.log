from ortools.sat.python import cp_model

# Define the problem
model = cp_model.CpModel()

# Variables for function options
shift_options = [0, 1, 2, 3, 4]
mac_options = [0, 1, 2, 3, 4]
fir_options = [0, 1, 2, 3, 4]
iir_options = [0, 1, 2, 3, 4]
filter_options = [0, 1, 2, 3, 4]

# Decision variables
shift = model.NewIntVar(0, 4, 'shift')
mac = model.NewIntVar(0, 4, 'mac')
fir = model.NewIntVar(0, 4, 'fir')
iir = model.NewIntVar(0, 4, 'iir')
filter = model.NewIntVar(0, 4, 'filter')

# Area and latency data for each function option
area_data = {
    'shift': [1451.8, 1284.3, 1284.3, 1284.3, 23.9],
    'mac': [4346.7, 4230.7, 5809.5, 4230.7, 4230.7],
    'fir': [6219.2, 4901.3, 5941.4, 6219.2, 4901.3],
    'iir': [8629.5, 8969.3, 15128.1, 8207.9, 15128.1],
    'filter': [4784.2, 4784.2, 4784.2, 4784.2, 4784.2],
}

latency_data = {
    'shift': [2.0, 2.0, 2.0, 2.0, 0.0],
    'mac': [2.0, 2.0, 5.0, 2.0, 2.0],
    'fir': [5.0, 10.0, 10.0, 5.0, 10.0],
    'iir': [10.0, 7.0, 7.0, 16.0, 7.0],
    'filter': [8.0, 8.0, 8.0, 8.0, 8.0],
}

# Total area and latency expressions
total_area = (
    area_data['shift'][shift] +
    area_data['mac'][mac] +
    area_data['fir'][fir] +
    area_data['iir'][iir] +
    area_data['filter'][filter]
)

total_latency = (
    latency_data['shift'][shift] +
    latency_data['mac'][mac] +
    latency_data['fir'][fir] +
    latency_data['iir'][iir] +
    latency_data['filter'][filter]
)

# Constraints
model.Add(total_area <= 6000)  # Area should be <= 6000
model.Minimize(total_latency)  # Minimize latency

# Solve the problem
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print(f"Optimal configuration found:")
    print(f"shift: {solver.Value(shift)}")
    print(f"mac: {solver.Value(mac)}")
    print(f"fir: {solver.Value(fir)}")
    print(f"iir: {solver.Value(iir)}")
    print(f"filter: {solver.Value(filter)}")
    print(f"Total Area: {solver.Value(total_area)}")
    print(f"Total Latency: {solver.Value(total_latency)}")
else:
    print("No feasible solution found.")
