from ortools.sat.python import cp_model

# Function options and their area/latency values
functions = {
    "copyKey_hls": [
        {"area": 529.7, "latency": 1.0},
        {"area": 529.7, "latency": 1.0},
        {"area": 529.7, "latency": 1.0},
        {"area": 529.7, "latency": 1.0},
        {"area": 529.7, "latency": 1.0}
    ],
    "copyBlock_hls": [
        {"area": 427.6, "latency": 1.0},
        {"area": 758.8, "latency": 3.0},
        {"area": 1163.7, "latency": 8.0},
        {"area": 1026.9, "latency": 4.0},
        {"area": 427.6, "latency": 1.0}
    ],
    "generateRoundKeys80_hls": [
        {"area": 2354.3, "latency": 596.0},
        {"area": 2354.3, "latency": 596.0},
        {"area": 2354.3, "latency": 596.0},
        {"area": 2354.3, "latency": 596.0},
        {"area": 2354.3, "latency": 596.0}
    ],
    "addRoundKey_hls": [
        {"area": 126.1, "latency": 0.0},
        {"area": 498.6, "latency": 2.0},
        {"area": 424.1, "latency": 14.0},
        {"area": 126.1, "latency": 0.0},
        {"area": 416.7, "latency": 6.0}
    ],
    "pLayer_hls": [
        {"area": 771.3, "latency": 8.0},
        {"area": 1007.7, "latency": 150.0},
        {"area": 771.3, "latency": 8.0},
        {"area": 1007.7, "latency": 150.0},
        {"area": 771.3, "latency": 8.0}
    ],
    "present80_encryptBlock_hls": [
        {"area": 13584.8, "latency": 1745.0},
        {"area": 13584.8, "latency": 1745.0},
        {"area": 13584.8, "latency": 1745.0},
        {"area": 13584.8, "latency": 1745.0},
        {"area": 13584.8, "latency": 1745.0}
    ]
}

# Create the model
model = cp_model.CpModel()

# Variables
options = {}
for func in functions:
    options[func] = model.NewIntVar(0, len(functions[func]) - 1, f"{func}_option")

# Constraints
# Total area should be as close as possible to 10500
total_area = sum(
    functions[func][options[func]].get("area", 0) for func in functions
)
model.Add(total_area <= 10500)

# Objective: Minimize latency
total_latency = sum(
    functions[func][options[func]].get("latency", 0) for func in functions
)
model.Minimize(total_latency)

# Solve
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Optimal configuration found:")
    for func in functions:
        option_index = solver.Value(options[func])
        print(f"{func}: option {option_index} (area: {functions[func][option_index]['area']}, latency: {functions[func][option_index]['latency']})")
    print(f"Total area: {sum(functions[func][solver.Value(options[func])]['area'] for func in functions)}")
    print(f"Total latency: {sum(functions[func][solver.Value(options[func])]['latency'] for func in functions)}")
else:
    print("No feasible solution found.")
