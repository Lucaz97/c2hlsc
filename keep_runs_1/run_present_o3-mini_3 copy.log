from ortools.sat.python import cp_model

# Define the options for each function as tuples: (latency, area)
# Note: Option indices match the order in the list.
copyKey_options = [
    (1, 530),   # option 0 (approximated)
    (1, 530),   # option 1
    (21, 2158), # option 2
    (1, 530),   # option 3
    (1, 530)    # option 4
]

copyBlock_options = [
    (1, 428),    # option 0
    (1, 428),    # option 1
    (1, 428),    # option 2
    (23, 1988),  # option 3
    (1, 428)     # option 4
]

generateRoundKeys80_options = [
    (596, 2354),  # option 0
    (286, 1559),  # option 1
    (885, 2077),  # option 2
    (286, 1559),  # option 3
    (885, 2077)   # option 4
]

addRoundKey_options = [
    (0, 126),    # option 0
    (14, 424),   # option 1
    (0, 126),    # option 2
    (2, 498),    # option 3
    (30, 2057)   # option 4
]

pLayer_options = [
    (150, 1008),   # option 0
    (150, 1008),   # option 1
    (150, 1008),   # option 2
    (0, 24),       # option 3
    (0, 24)        # option 4
]

# present80_encryptBlock: All options are identical.
present80_options = [
    (1137, 13067),  # option 0
    (1137, 13067),  # option 1
    (1137, 13067),  # option 2
    (1137, 13067),  # option 3
    (1137, 13067)   # option 4
]

# Create the model.
model = cp_model.CpModel()

# For each function, create an integer decision variable representing the chosen option.
copyKey_var = model.NewIntVar(0, len(copyKey_options)-1, 'copyKey')
copyBlock_var = model.NewIntVar(0, len(copyBlock_options)-1, 'copyBlock')
genRoundKeys_var = model.NewIntVar(0, len(generateRoundKeys80_options)-1, 'generateRoundKeys80')
addRoundKey_var = model.NewIntVar(0, len(addRoundKey_options)-1, 'addRoundKey')
pLayer_var = model.NewIntVar(0, len(pLayer_options)-1, 'pLayer')
present80_var = model.NewIntVar(0, len(present80_options)-1, 'present80_encryptBlock')

# Since these are not linear functions of the decision variables, we enumerate the possible values.
# We create fixed arrays for latency and area for each function based on the decision variable.
# To allow a linear model, we will use element constraints.

# For each function variable, create corresponding latency and area variables.
def add_function_vars(model, var, options, name):
    latency = model.NewIntVar(0, 10000, name + '_latency')
    area = model.NewIntVar(0, 100000, name + '_area')
    # Create lists for latency and area constants (as integers).
    latencies = [opt[0] for opt in options]
    areas = [opt[1] for opt in options]
    model.AddElement(var, latencies, latency)
    model.AddElement(var, areas, area)
    return latency, area

copyKey_latency, copyKey_area = add_function_vars(model, copyKey_var, copyKey_options, 'copyKey')
copyBlock_latency, copyBlock_area = add_function_vars(model, copyBlock_var, copyBlock_options, 'copyBlock')
genRoundKeys_latency, genRoundKeys_area = add_function_vars(model, genRoundKeys_var, generateRoundKeys80_options, 'generateRoundKeys80')
addRoundKey_latency, addRoundKey_area = add_function_vars(model, addRoundKey_var, addRoundKey_options, 'addRoundKey')
pLayer_latency, pLayer_area = add_function_vars(model, pLayer_var, pLayer_options, 'pLayer')
present80_latency, present80_area = add_function_vars(model, present80_var, present80_options, 'present80_encryptBlock')

# Based on the call graph, certain functions are called multiple times.
# Assume the following replication factors:
# - copyKey is called twice within generateRoundKeys80.
# - copyBlock is called twice within generateRoundKeys80 and once within pLayer (total 3).
# - addRoundKey is called twice within present80_encryptBlock.
# The others are called once.
# We'll add the area contributions accordingly (latency is determined by the synthesis of the top function).
total_area = model.NewIntVar(0, 1000000, 'total_area')
model.Add(total_area == present80_area + genRoundKeys_area + pLayer_area + 2 * addRoundKey_area + 2 * copyKey_area + 3 * copyBlock_area)

# Latency: we assume the reported latency for present80_encryptBlock is the overall latency.
# So overall latency is simply the latency of present80_encryptBlock.
overall_latency = present80_latency

# Our objective is to minimize overall latency plus a penalty for deviation from the target area.
target_area = 70000
# To incorporate absolute deviation, we introduce an auxiliary variable.
area_deviation = model.NewIntVar(0, 1000000, 'area_deviation')
model.Add(area_deviation >= total_area - target_area)
model.Add(area_deviation >= target_area - total_area)

# Weight for area deviation, choose a factor to balance latency and area.
# This factor may be tuned; here we choose 1 as a starting point.
lambda_weight = 1

# Define the objective: minimize latency + lambda * area_deviation.
model.Minimize(overall_latency + lambda_weight * area_deviation)

# Solve the model.
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in (cp_model.OPTIMAL, cp_model.FEASIBLE):
    print("Best configuration found:")
    print("copyKey_hls option:", solver.Value(copyKey_var), "Latency:", solver.Value(copyKey_latency), "Area:", solver.Value(copyKey_area))
    print("copyBlock_hls option:", solver.Value(copyBlock_var), "Latency:", solver.Value(copyBlock_latency), "Area:", solver.Value(copyBlock_area))
    print("generateRoundKeys80_hls option:", solver.Value(genRoundKeys_var), "Latency:", solver.Value(genRoundKeys_latency), "Area:", solver.Value(genRoundKeys_area))
    print("addRoundKey_hls option:", solver.Value(addRoundKey_var), "Latency:", solver.Value(addRoundKey_latency), "Area:", solver.Value(addRoundKey_area))
    print("pLayer_hls option:", solver.Value(pLayer_var), "Latency:", solver.Value(pLayer_latency), "Area:", solver.Value(pLayer_area))
    print("present80_encryptBlock_hls option:", solver.Value(present80_var), "Latency:", solver.Value(present80_latency), "Area:", solver.Value(present80_area))
    print("Total estimated area (with replication):", solver.Value(total_area))
    print("Overall latency (from present80):", solver.Value(overall_latency))
    print("Area deviation from target 70000:", solver.Value(area_deviation))
else:
    print("No solution found.")
