int fibonacci(int n)
{
  // Handle small n values to match the original behavior
  if (n < 3) {
    // For n==0, original code is undefined; for n==1 and n==2, we return 1.
    // This matches the original iterative behavior for n>=2.
    return (n == 0) ? 0 : 1;
  }

  int a = 0;
  int b = 1;
  int c = 0;
  int i = 2;

  // Process two iterations per loop cycle.
  // This "dual stepping" approach reduces the depth of the dependency chain,
  // targeting lower latency.
  //
  // The loop iterations are fully unrolled and pipelined with a zero initiation interval.
  while(i < n - 1)
  {
    #pragma hls_pipeline_init_interval 0
    #pragma hls_unroll yes
    // First iteration of the pair: compute F(i)
    int tmp = a + b;
    // Second iteration: compute F(i+1) in parallel with dependency minimization;
    // the addition can be synthesized as a fast combinational adder.
    int tmp2 = b + tmp;

    a = tmp;    // a becomes F(i)
    b = tmp2;   // b becomes F(i+1)
    c = tmp2;   // store latest result
    i += 2;
  }

  // If there's one iteration left (n is odd), do a final update.
  if(i < n)
  {
    // This final step is pipelined as well.
    #pragma hls_pipeline_init_interval 0
    c = a + b;
  }
  
  return c;
}
