int even_sum(int n)
{
  // For latency optimization, replace the iterative summation with a closed‐form expression.
  // This computes the sum of all even numbers below n.
  // Let k = floor((n-1)/2). Then the even numbers are: 2, 4, ..., 2*k and the sum is given by k*(k+1).
  //
  // This transformation preserves the original functionality while minimizing latency.
  
  // Note: For n <= 2, no even numbers are summed, so return 0.
  if (n <= 2)
    return 0;
 
  int count = (n - 1) / 2;
  return count * (count + 1);
}
