```c
int odd_factorial(int n)
{
  // For n <= 1, the factorial of odd numbers is defined as 1.
  if (n <= 1)
    return 1;

  // Count the number of odd factors to be multiplied.
  int count = n / 2;
  
  // For very large n, fall back to a fully unrolled sequential multiply.
  // (Assuming HLS target uses small n; adjust MAX_ODDS if needed.)
  #define MAX_ODDS 64
  if (count > MAX_ODDS) {
    int res = 1;
    #pragma hls_unroll yes
    for (int i = 1; i < n; i += 2) {
      res = res * i;
    }
    return res;
  }

  // Store odd factors in a local array.
  int odds[MAX_ODDS];
  int idx = 0;
  for (int i = 1; i < n; i += 2) {
    odds[idx++] = i;
  }
  
  // Now perform a tree-based reduction to lower the latency:
  // Instead of doing a sequential chain of multiplications,
  // we multiply pairs in parallel (fully unrolled) to reduce the
  // maximum combinational delay from O(N) to O(log N).
  while (count > 1) {
    int newCount = count >> 1;  // newCount = count / 2
    // Multiply pairs of adjacent numbers.
    #pragma hls_unroll yes
    for (int i = 0; i < (count & ~1); i += 2) {
      odds[i >> 1] = odds[i] * odds[i + 1];
    }
    // If we have an odd number of elements, carry the last one over.
    if (count & 1) {
      odds[newCount] = odds[count - 1];
      newCount++;
    }
    count = newCount;
  }
  
  return odds[0];
}
```
