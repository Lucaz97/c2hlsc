int fibonacci(int n)
{
    // Fast-doubling algorithm to compute Fibonacci numbers.
    // This method reduces the dependency chain from O(n) additions
    // to O(log2(n)) iterations, which minimizes latency.
    // The loop is fully unrolled and pipelined to target zero initiation interval.
    
    // Initialize (a, b) as (F(0), F(1)).
    int a = 0;
    int b = 1;
    int c, d;
    
    // Iterate over a fixed 32-bit width (synthesizable constant loop bound)
    // to process each bit of 'n' (starting from MSB to LSB).
    // For small values of n the extra iterations do not affect functional correctness.
    #pragma hls_unroll yes
    for (int i = 31; i >= 0; i--)
    {
        #pragma hls_pipeline_init_interval 0
        // Compute the doubled values:
        // c = F(2k) = F(k)*(2*F(k+1) − F(k))
        // d = F(2k+1) = F(k)^2 + F(k+1)^2
        c = a * (2 * b - a);
        d = a * a + b * b;
        
        // If the i-th bit of n is 1, then update (a, b) to (F(2k+1), F(2k+2)).
        // Otherwise, update them to (F(2k), F(2k+1)).
        if ((n >> i) & 1)
        {
            a = d;
            b = c + d;
        }
        else
        {
            a = c;
            b = d;
        }
    }
    
    return a;
}
