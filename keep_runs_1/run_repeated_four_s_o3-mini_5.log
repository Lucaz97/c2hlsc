]

# Our call graph: compute6 calls odd_factorial, fibonacci and even_sum (twice).
# The effective latency model: latency_total = compute6_latency + max(child_latency)
# where child_latency = min(odd_factorial_latency, fibonacci_latency, even_sum_latency)
# (even_sum is used twice but assumed to be shared so takes one instance).
# For area, we approximate a composite area as:
# area_total = 0.75 * (compute6_area + odd_factorial_area + fibonacci_area + even_sum_area)
# The factor 0.75 approximates design optimizations (see synthesis report numbers).

def compute_total(opt_odd, opt_fib, opt_even, opt_compute):
    # Unpack values
    _, area_odd, lat_odd, _ = opt_odd
    _, area_fib, lat_fib, _ = opt_fib
    _, area_even, lat_even, _ = opt_even
    _, area_compute, lat_compute, _ = opt_compute
    
    # effective latency = parent's latency + max(child latency)
    total_latency = lat_compute + max(lat_odd, lat_fib, lat_even)
    # approximate area with sharing factor
    total_area = 0.75 * (area_compute + area_odd + area_fib + area_even)
    return total_latency, total_area

# Our objective:
#   primary goal: minimize latency
#   secondary goal: area_total as close as possible to target_area (7000)
# We combine them in a weighted objective.
target_area = 7000
# Weight factor to balance scale (latency ~ tens, area error ~ thousands). Let's use 1/1000.
area_weight = 1/1000.0

best_obj = None
best_config = None

# Iterate over all combinations (5x5x5x5 = 625 possibilities)
for opt_odd in odd_factorial_opts:
    for opt_fib in fibonacci_opts:
        for opt_even in even_sum_opts:
            for opt_compute in compute6_opts:
                latency, area = compute_total(opt_odd, opt_fib, opt_even, opt_compute)
                # Objective: latency + penalty for area difference (absolute difference)
                obj = latency + area_weight * abs(area - target_area)
                if best_obj is None or obj < best_obj:
                    best_obj = obj
                    best_config = (opt_odd[0], opt_fib[0], opt_even[0], opt_compute[0], latency, area)

