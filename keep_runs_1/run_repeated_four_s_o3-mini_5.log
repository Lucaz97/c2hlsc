int fibonacci(int n)
{
    // We want to compute the (n-1)th Fibonacci number (i.e., if n=5, return 3; n=6, return 5).
    // For n >= 2, let m = n - 1. We'll use the fast-doubling algorithm,
    // which computes F(m) and F(m+1) in O(log m) iterations.
    // The loop is fully unrolled and pipelined to minimize latency.
    
    // For n less than 2, return n directly.
    if(n < 2)
        return n;
        
    int m = n - 1;  // We need F(n-1)
    int a = 0;      // Will hold F(m)
    int b = 1;      // Will hold F(m+1)
    int c, d;       // Temporary variables for calculations
    
    // Iterate over all 32 bit positions. For most bits of m that are zero,
    // the computation will simply update a and b without changing the value.
    #pragma hls_unroll yes
    for (int i = 31; i >= 0; i--)
    {
        #pragma hls_pipeline_init_interval 0
        // Compute:
        // c = F(2k) = F(k) * [2*F(k+1) - F(k)]
        // d = F(2k+1) = F(k)^2 + F(k+1)^2
        c = a * (2 * b - a);
        d = a * a + b * b;
        
        // If the i-th bit of m is 1, update (a, b) = (d, c+d);
        // Otherwise, update (a, b) = (c, d).
        if ((m >> i) & 1)
        {
            a = d;
            b = c + d;
        }
        else
        {
            a = c;
            b = d;
        }
    }
    
    return a;
}
