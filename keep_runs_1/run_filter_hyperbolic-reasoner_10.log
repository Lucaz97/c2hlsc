python: '''
from ortools.sat.python import cp_model

# Define the functions and their options
functions = {
    'shift': [
        {'area': 1451.8, 'latency': 2.0},
        {'area': 1451.8, 'latency': 2.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 1107.1, 'latency': 9.0},
    ],
    'mac': [
        {'area': 4346.7, 'latency': 2.0},
        {'area': 3951.4, 'latency': 6.0},
        {'area': 4625.0, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
    ],
    'iir': [
        {'area': 7225.5, 'latency': 12.0},
        {'area': 7235.0, 'latency': 12.0},
        {'area': 8680.8, 'latency': 15.0},
        {'area': 8630.3, 'latency': 10.0},
        {'area': 8630.3, 'latency': 10.0},
    ],
    'fir': [
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
    ],
    'filter': [
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
    ],
}

model = cp_model.CpModel()

option_vars = {}
area_vars = {}
latency_vars = {}

# Create variables and element constraints
for func in functions:
    options = functions[func]
    option_var = model.NewIntVar(0, len(options)-1, f'{func}_option')
    option_vars[func] = option_var
    
    # Area
    area_array = [int(opt['area'] * 10) for opt in options]
    area_var = model.NewIntVar(0, sum(area_array), f'{func}_area')
    model.AddElement(option_var, area_array, area_var)
    area_vars[func] = area_var
    
    # Latency
    latency_array = [int(opt['latency'] * 10) for opt in options]
    latency_var = model.NewIntVar(0, sum(latency_array), f'{func}_latency')
    model.AddElement(option_var, latency_array, latency_var)
    latency_vars[func] = latency_var

# Total area and latency
total_area = model.NewIntVar(0, 10**6, 'total_area')
model.Add(total_area == sum(area_vars.values()))

total_latency = model.NewIntVar(0, 10**6, 'total_latency')
model.Add(total_latency == sum(latency_vars.values()))

# Target area: 6000 (scaled to 60000)
target_area = 60000
diff = model.NewIntVar(0, 10**6, 'diff')
model.AddAbsEquality(diff, total_area - target_area)

# Minimize combined objective: latency + area difference
model.Minimize(total_latency + diff * 10)  # Weight area difference more

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status in [cp_model.OPTIMAL, cp_model.FEASIBLE]:
    print("Solution found:")
    for func in functions:
        opt = solver.Value(option_vars[func])
        print(f"{func}: option {opt}, area {functions[func][opt]['area']}, latency {functions[func][opt]['latency']}")
    print(f"Total area: {solver.Value(total_area)/10}")
    print(f"Total latency: {solver.Value(total_latency)/10}")
else:
    print("No solution found.")
'''
