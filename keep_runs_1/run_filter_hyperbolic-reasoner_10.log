        {'area': 4625.0, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
    ],
    'fir': [
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
    ],
    'iir': [
        {'area': 7225.5, 'latency': 12.0},
        {'area': 7235.0, 'latency': 12.0},
        {'area': 8680.8, 'latency': 15.0},
        {'area': 8630.3, 'latency': 10.0},
        {'area': 8630.3, 'latency': 10.0},
    ],
    'filter': [
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
    ],
}

model = cp_model.CpModel()

# Variables: option index for each function
option_vars = {}
for func in functions:
    option_vars[func] = model.NewIntVar(0, len(functions[func])-1, func)

# Total area and latency expressions
total_area_expr = sum(
    functions[func][option_vars[func]]['area'] for func in functions
)
total_latency_expr = sum(
    functions[func][option_vars[func]]['latency'] for func in functions
)

# Convert to model variables
max_area = int(sum(max(f['area'] for f in func_options) for func_options in functions.values()))
max_latency = int(sum(max(f['latency'] for f in func_options) for func_options in functions.values()))

total_area = model.NewIntVar(0, max_area, 'total_area')
model.Add(total_area == int(total_area_expr))

total_latency = model.NewIntVar(0, max_latency, 'total_latency')
model.Add(total_latency == int(total_latency_expr))

# Objective: minimize latency and area difference from 6000
area_diff = model.NewIntVar(0, 20000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - 6000)
model.Minimize(total_latency * 1000 + area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal solution found:")
    for func in functions:
        idx = solver.Value(option_vars[func])
        print(f"{func}: option {idx} (area={functions[func][idx]['area']}, latency={functions[func][idx]['latency']})")
    print(f"Total area: {solver.Value(total_area)}")
    print(f"Total latency: {solver.Value(total_latency)}")
else:
    print("No solution found.")
