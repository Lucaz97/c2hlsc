Given that the explored configurations are either above the target area or have already been tried, I will use the Google OR-Tools library to solve the optimization problem and find the best combination of function options that minimizes latency while keeping the total area as close as possible to 2800.

Here is the Python script to solve the optimization problem:

```python
python: '''
from ortools.sat.python import cp_model

# Function options data
functions = {
    "fibonacci": [
        {"area": 1640.9, "latency": 2.0, "throughput": 3.0},
        {"area": 1728.2, "latency": 2.0, "throughput": 3.0},
        {"area": 1728.2, "latency": 2.0, "throughput": 3.0},
        {"area": 1640.9, "latency": 2.0, "throughput": 3.0},
        {"area": 1640.9, "latency": 2.0, "throughput": 3.0}
    ],
    "odd_sum": [
        {"area": 1287.7, "latency": 2.0, "throughput": 3.0},
        {"area": 1210.9, "latency": 2.0, "throughput": 3.0},
        {"area": 1287.7, "latency": 2.0, "throughput": 3.0},
        {"area": 1210.9, "latency": 2.0, "throughput": 3.0},
        {"area": 1210.9, "latency": 2.0, "throughput": 3.0}
    ],
    "even_sum": [
        {"area": 1349.7, "latency": 2.0, "throughput": 3.0},
        {"area": 2397.2, "latency": 3.0, "throughput": 4.0},
        {"area": 2136.8, "latency": 4.0, "throughput": 5.0},
        {"area": 1230.0, "latency": 2.0, "throughput": 3.0},
        {"area": 1509.2, "latency": 2.0, "throughput": 3.0}
    ],
    "compute3": [
        {"area": 3053.8, "latency": 9.0, "throughput": 10.0},
        {"area": 3053.8, "latency": 9.0, "throughput": 10.0},
        {"area": 3053.8, "latency": 9.0, "throughput": 10.0},
        {"area": 3053.8, "latency": 9.0, "throughput": 10.0},
        {"area": 3053.8, "latency": 9.0, "throughput": 10.0}
    ]
}

# Create the model
model = cp_model.CpModel()

# Variables
function_vars = {}
for func, options in functions.items():
    function_vars[func] = model.NewIntVar(0, len(options) - 1, func)

# Constraints
# Total area should be as close as possible to 2800
total_area = sum(
    functions[func][function_vars[func]].get("area", 0) for func in functions
)
model.Add(total_area <= 2800)

# Objective: Minimize latency
total_latency = sum(
    functions[func][function_vars[func]].get("latency", 0) for func in functions
)
model.Minimize(total_latency)

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Optimal configuration found:")
    for func in functions:
        option_index = solver.Value(function_vars[func])
        print(f"{func}: option {option_index} (area: {functions[func][option_index]['area']}, latency: {functions[func][option_index]['latency']})")
else:
    print("No feasible solution found.")
'''
