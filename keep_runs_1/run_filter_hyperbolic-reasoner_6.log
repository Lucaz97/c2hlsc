from ortools.sat.python import cp_model

def main():
    model = cp_model.CpModel()
    
    # Function options
    shift_options = 5
    mac_options = 5
    fir_options = 5
    iir_options = 5
    filter_options = 5

    # Create variables
    shift = model.NewIntVar(0, shift_options-1, 'shift')
    mac = model.NewIntVar(0, mac_options-1, 'mac')
    iir = model.NewIntVar(0, iir_options-1, 'iir')
    fir = model.NewIntVar(0, fir_options-1, 'fir')
    filter_var = model.NewIntVar(0, filter_options-1, 'filter')

    # Area data (converted to integers for CP-SAT)
    area = {
        'shift': [14518, 14518, 239, 239, 11071],
        'mac': [43467, 39514, 46250, 44175, 44175],
        'iir': [72255, 72350, 86808, 86303, 86303],
        'fir': [46691, 46691, 46691, 46691, 46691],
        'filter': [45813, 45813, 45813, 45813, 45813]
    }

    # Latency data
    latency = {
        'shift': [20, 20, 0, 0, 90],
        'mac': [20, 60, 80, 80, 80],
        'iir': [120, 120, 150, 100, 100],
        'fir': [60, 60, 60, 60, 60],
        'filter': [70, 70, 70, 70, 70]
    }

    # Calculate total area (scaled by 10)
    total_area = (
        model.NewIntVar(0, 1000000, 'total_area')
    )
    model.Add(total_area == (
        area['shift'][shift] + 
        area['mac'][mac] * 2 +  # 2 macs in iir
        area['iir'][iir] +
        area['fir'][fir] +
        area['filter'][filter_var]
    ))

    # Target area (6000 * 10 = 60000)
    target_area = 60000
    model.AddAbsEquality(0, total_area - target_area)

    # Minimize latency
    total_latency = (
        latency['shift'][shift] * 2 +  # 2 shifts in iir
        latency['mac'][mac] * 2 +      # 2 macs in iir
        latency['iir'][iir] +
        latency['fir'][fir] +
        latency['filter'][filter_var]
    )
    model.Minimize(total_latency)

    solver = cp_model.CpSolver()
    status = solver.Solve(model)

    if status == cp_model.OPTIMAL:
        print(f'Optimal solution found:')
        print(f'Shift option: {solver.Value(shift)}')
        print(f'MAC option: {solver.Value(mac)}')
        print(f'IIR option: {solver.Value(iir)}')
        print(f'FIR option: {solver.Value(fir)}')
        print(f'Filter option: {solver.Value(filter_var)}')
        print(f'Total area: {solver.Value(total_area)/10}')
        print(f'Total latency: {solver.Value(total_latency)}')
    else:
        print('No optimal solution found')

if __name__ == '__main__':
    main()
