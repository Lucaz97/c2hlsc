python: '''
from ortools.sat.python import cp_model

def main():
    model = cp_model.CpModel()
    # Function options
    shift_options = [0, 1, 2, 3, 4]
    mac_options = [0, 1, 2, 3, 4]
    fir_options = [0, 1, 2, 3, 4]
    iir_options = [0, 1, 2, 3, 4]
    filter_options = [0, 1, 2, 3, 4]

    # Variables
    shift = model.NewIntVar(0, 4, 'shift')
    mac = model.NewIntVar(0, 4, 'mac')
    fir = model.NewIntVar(0, 4, 'fir')
    iir = model.NewIntVar(0, 4, 'iir')
    filter_var = model.NewIntVar(0, 4, 'filter')

    # Area data (converted to integers)
    area_data = {
        'shift': [1452, 1452, 24, 24, 1107],
        'mac': [4347, 3951, 4625, 4418, 4418],
        'fir': [4669, 4669, 4669, 4669, 4669],
        'iir': [7226, 7235, 8681, 8630, 8630],
        'filter': [4581, 4581, 4581, 4581, 4581]
    }

    # Latency data
    latency_data = {
        'shift': [2, 2, 0, 0, 9],
        'mac': [2, 6, 8, 8, 8],
        'fir': [6, 6, 6, 6, 6],
        'iir': [12, 12, 15, 10, 10],
        'filter': [7, 7, 7, 7, 7]
    }

    # Calculate total area and latency
    total_area = sum([
        area_data['shift'][shift],
        area_data['mac'][mac],
        area_data['fir'][fir],
        area_data['iir'][iir],
        area_data['filter'][filter_var]
    ])
    
    total_latency = sum([
        latency_data['shift'][shift],
        latency_data['mac'][mac],
        latency_data['fir'][fir],
        latency_data['iir'][iir],
        latency_data['filter'][filter_var]
    ])

    # Target area constraint (6000 with some flexibility)
    target_area = 6000
    model.Add(total_area <= target_area * 1.05)  # 5% over target
    model.Add(total_area >= target_area * 0.95)  # 5% under target

    # Minimize latency
    model.Minimize(total_latency)

    solver = cp_model.CpSolver()
    status = solver.Solve(model)

    if status == cp_model.OPTIMAL:
        print(f'Optimal solution found:')
        print(f'Shift option: {solver.Value(shift)}')
        print(f'MAC option: {solver.Value(mac)}')
        print(f'FIR option: {solver.Value(fir)}')
        print(f'IIR option: {solver.Value(iir)}')
        print(f'Filter option: {solver.Value(filter_var)}')
        print(f'Total area: {solver.Value(total_area)}')
        print(f'Total latency: {solver.Value(total_latency)}')
    else:
        print('No optimal solution found')

if __name__ == '__main__':
    main()
'''
