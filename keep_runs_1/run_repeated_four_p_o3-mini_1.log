```c
int fibonacci(int n)
{
  // For n==0, return 0 as per Fibonacci definition
  if(n == 0)
    return 0;

  // Using matrix exponentiation based on:
  // [F(n+1) F(n)  ] = [1 1]^(n)
  // [F(n)   F(n-1)]   [1 0]
  //
  // We set up the result as an identity matrix and F as the Q-matrix.
  int result0 = 1, result1 = 0;  // result matrix first row [1, 0]
  int result2 = 0, result3 = 1;  // result matrix second row [0, 1]

  int F0 = 1, F1 = 1;            // F matrix first row: [1, 1]
  int F2 = 1, F3 = 0;            // F matrix second row: [1, 0]

  int exponent = n - 1;  // We compute Q^(n-1) so that result0 becomes F(n)

  while (exponent > 0)
  {
    #pragma hls_pipeline_init_interval 1
    if (exponent & 1)
    {
      // Multiply result by F: result = result * F
      int a = result0 * F0 + result1 * F2;
      int b = result0 * F1 + result1 * F3;
      int c = result2 * F0 + result3 * F2;
      int d = result2 * F1 + result3 * F3;
      result0 = a; result1 = b;
      result2 = c; result3 = d;
    }
    // Square F: F = F * F
    int a = F0 * F0 + F1 * F2;
    int b = F0 * F1 + F1 * F3;
    int c = F2 * F0 + F3 * F2;
    int d = F2 * F1 + F3 * F3;
    F0 = a; F1 = b;
    F2 = c; F3 = d;

    exponent >>= 1;
  }

  return result0;
}
```
