int odd_sum(int n)
{
  // Early exit if no odds are present.
  if (n <= 1)
    return 0;
    
  int sum0 = 0, sum1 = 0;
  
  // Pipelining the loop with an initiation interval of 1
  #pragma hls_pipeline_init_interval 1
  for (int i = 1; i < n; i += 4)
  {
    // Accumulate the first odd number in this group.
    sum0 += i;
    
    // If the next odd number (i+2) is valid, accumulate it in a separate adder.
    if ((i + 2) < n)
      sum1 += (i + 2);
  }
  
  return sum0 + sum1;
}
```
