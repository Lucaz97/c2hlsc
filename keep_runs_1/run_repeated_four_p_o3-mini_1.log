int even_sum(int n)
{
  // Compute the number of even numbers below n.
  // k = floor((n-1)/2). Sum of even numbers below n is: 2*(1+2+...+k) = k*(k+1)
  int k = (n - 1) / 2;
  return k * (k + 1);
}
