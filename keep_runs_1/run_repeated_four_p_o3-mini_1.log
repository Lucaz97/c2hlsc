int even_sum(int n)
{
  // Use two parallel accumulators and pipelined loops to reduce the dependency chain,
  // which helps to reduce the overall latency.
  int sum0 = 0;
  int sum1 = 0;
  int i;

  // Process pairs of even numbers in parallel.
  // This loop handles blocks of 4, accumulating two even numbers per iteration.
  for (i = 2; i <= n - 4; i += 4)
  {
    #pragma HLS pipeline II=1
    sum0 += i;         // even number: i
    sum1 += (i + 2);   // next even number: i+2
  }

  // Process any remaining even numbers if n is not a multiple of 4 beyond 2.
  for (; i < n; i += 2)
  {
    #pragma HLS pipeline II=1
    sum0 += i;
  }

  return sum0 + sum1;
}
```
