```c
int odd_sum(int n)
{
  // For n <= 1, there are no odd numbers to sum.
  if (n <= 1)
    return 0;

  // Compute k = floor(n/2) using a right-shift.
  int k = n >> 1;

  // Compute k*k without using the built‐in multiplication operator.
  // This manual “multiplier” is implemented as a fully unrolled loop over the bits of k.
  // For each bit set in k, add (k << bit) to compute the partial product.
  int square = 0;
  // The loop bound (32) is a constant for a typical 32‐bit int.
  #pragma hls_unroll yes
  for (int bit = 0; bit < 32; ++bit) {
    // Check if the current bit in k is set.
    if (k & (1 << bit))
      square += (k << bit);
  }
  
  return square;
}
```
