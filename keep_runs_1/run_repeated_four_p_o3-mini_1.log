void compute5(int n[5])
{
  // Enforce sequential (non–parallel) iteration ordering while enabling internal pipelining 
  // so that all operations within one iteration can be optimally scheduled for minimal latency.
  // The dependence pragma tells the tool that updates to n[] must occur in program order.
  #pragma HLS dependence variable=n inter false

  // Apply a pipeline directive to the loop. (The iteration interval will depend on the function latencies.)
  #pragma HLS pipeline_init_interval 1
  
  for (int i = 0; i < 5; i++)
  {
    int in_val = n[i];  // capture input before any updates
    int result0 = fibonacci(in_val);
    int result1 = odd_sum(result0);
    int result2 = even_sum(in_val);
    int result3 = fibonacci(result2);
    n[i] = result3 - result1;
