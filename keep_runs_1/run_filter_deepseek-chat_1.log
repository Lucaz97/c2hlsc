void fir(int input, int *output, int taps[5])
{
  static int delay_lane[5] = {};
  
  // Fully unroll the shift loop
  #pragma hls_unroll yes
  for (int i = 4; i > 0; i--) {
    delay_lane[i] = delay_lane[i-1];
  }
  delay_lane[0] = input;

