from ortools.sat.python import cp_model

# Data for each function: list of options where each option is a tuple (area, latency)
# The throughput is not used in the objective, but could be incorporated if needed.
# Functions: copyKey_hls, copyBlock_hls, generateRoundKeys80_hls, addRoundKey_hls, pLayer_hls, present80_encryptBlock_hls

# Note: For functions called multiple times in the call graph, we account for their occurrence count.
# According to the call graph:
#   generateRoundKeys80_hls calls: copyKey_hls twice and copyBlock_hls twice.
#   pLayer_hls calls: copyBlock_hls once.
#   present80_encryptBlock_hls calls: generateRoundKeys80_hls once, addRoundKey_hls twice, pLayer_hls once.
# The top-level total area will be computed as:
#   Total_area = present80_encryptBlock_area + generateRoundKeys80_area +
#                (2 * copyKey_area) + ( (2+1) * copyBlock_area ) + (2 * addRoundKey_area) + pLayer_area (if separately synthesized in pLayer_hls)
#
# However, note that the pLayer_hls is both used as a standalone and inside present80_encryptBlock_hls.
# Here we assume one selection per synthesizable function so we add area for each function instance multiplied by the number of calls:
#   copyKey_hls: 2 calls
#   copyBlock_hls: 3 calls (2 from generateRoundKeys80_hls and 1 from pLayer_hls)
#   generateRoundKeys80_hls: 1
#   addRoundKey_hls: 2 calls
#   pLayer_hls: 1
#   present80_encryptBlock_hls: 1
#
# Define options for each function:
copyKey_opts = [(529.7, 1.0), (529.7, 1.0), (529.7, 1.0), (1527.9, 19.0), (529.7, 1.0)]
copyBlock_opts = [(427.6, 1.0), (427.6, 1.0), (427.6, 1.0), (1175.3, 15.0), (1175.3, 15.0)]
generateRoundKeys80_opts = [(2354.3, 596.0), (2336.0, 596.0), (1558.8, 286.0), (1546.0, 286.0), (1546.0, 286.0)]
addRoundKey_opts = [(126.1, 0.0), (2056.9, 30.0), (126.1, 0.0), (126.1, 0.0), (126.1, 0.0)]
pLayer_opts = [(23.9, 0.0), (902.8, 79.0), (23.9, 0.0), (876.8, 79.0), (23.9, 0.0)]
present80_encryptBlock_opts = [(14572.9, 1128.0), (20121.8, 544.0), (13035.3, 584.0), (13077.4, 1137.0), (13066.8, 1137.0)]

# Occurrence counts in the overall call graph:
occurrences = {
    'copyKey' : 2,
    'copyBlock' : 3,
    'generateRoundKeys80' : 1,
    'addRoundKey' : 2,
    'pLayer' : 1,
    'present80_encryptBlock' : 1
}

target_area = 70000.0

# We'll create a brute-force CP model to enumerate all possibilities.
model = cp_model.CpModel()

# Decision variables: choose one option index per function.
copyKey_var = model.NewIntVar(0, len(copyKey_opts) - 1, 'copyKey')
copyBlock_var = model.NewIntVar(0, len(copyBlock_opts) - 1, 'copyBlock')
genRoundKeys_var = model.NewIntVar(0, len(generateRoundKeys80_opts) - 1, 'genRoundKeys')
addRoundKey_var = model.NewIntVar(0, len(addRoundKey_opts) - 1, 'addRoundKey')
pLayer_var = model.NewIntVar(0, len(pLayer_opts) - 1, 'pLayer')
present80_var = model.NewIntVar(0, len(present80_encryptBlock_opts) - 1, 'present80')

# As our search space is small (5^6 = 15625 combinations), we can simply enumerate them and find the best combination.
class SolutionPrinter(cp_model.CpSolverSolutionCallback):
    def __init__(self):
        cp_model.CpSolverSolutionCallback.__init__(self)
        self.best_obj = None
        self.best_solution = None

    def OnSolutionCallback(self):
        # Retrieve chosen indices.
        ckey = self.Value(copyKey_var)
        cblock = self.Value(copyBlock_var)
        grk = self.Value(genRoundKeys_var)
        ark = self.Value(addRoundKey_var)
        play = self.Value(pLayer_var)
        pencrypt = self.Value(present80_var)
        
        # Get area/latency for each choice.
        area_copyKey, lat_copyKey = copyKey_opts[ckey]
        area_copyBlock, lat_copyBlock = copyBlock_opts[cblock]
        area_grk, lat_grk = generateRoundKeys80_opts[grk]
        area_ark, lat_ark = addRoundKey_opts[ark]
        area_pLayer, lat_pLayer = pLayer_opts[play]
        area_pencrypt, lat_pencrypt = present80_encryptBlock_opts[pencrypt]
        
        # Compute total area:
        total_area = (occurrences['copyKey'] * area_copyKey +
                      occurrences['copyBlock'] * area_copyBlock +
                      occurrences['generateRoundKeys80'] * area_grk +
                      occurrences['addRoundKey'] * area_ark +
                      occurrences['pLayer'] * area_pLayer +
                      occurrences['present80_encryptBlock'] * area_pencrypt)
        
        # The overall latency is assumed to be the latency of the encryption block function (which already incorporates the best latencies of child functions).
        total_latency = lat_pencrypt
        
        # Formulate objective as: latency + weight * |area - target_area|
        # Choosing a weight factor alpha. Here we'll try alpha = 0.1.
        alpha = 0.1
        obj = total_latency + alpha * abs(total_area - target_area)
        
        if self.best_obj is None or obj < self.best_obj:
            self.best_obj = obj
            self.best_solution = (ckey, cblock, grk, ark, play, pencrypt, total_area, total_latency, obj)

# Create solver and iterate over all assignments.
solver = cp_model.CpSolver()
solution_printer = SolutionPrinter()

# Enumerate all solutions using a simple loop since our space is small.
best_obj = None
best_solution = None

