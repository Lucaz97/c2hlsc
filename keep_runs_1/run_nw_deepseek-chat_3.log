    print(f'traceback: {[i for i in range(5) if traceback_indicator[i].solution_value() == 1][0]}')
    print(f'needwun: {[i for i in range(5) if needwun_indicator[i].solution_value() == 1][0]}')
    print(f'Total Latency: {total_latency.solution_value()}')
    print(f'Total Area: {total_area.solution_value()}')
else:
    print('No optimal solution found.')
