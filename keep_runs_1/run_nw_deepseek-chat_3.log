needwun_latency = [1303.0, 1303.0, 1303.0, 1303.0, 1303.0]

# Define indicator variables for each option
fill_matrix_indicator = [solver.BoolVar(f'fill_matrix_{i}') for i in range(5)]
reverse_string_indicator = [solver.BoolVar(f'reverse_string_{i}') for i in range(5)]
traceback_indicator = [solver.BoolVar(f'traceback_{i}') for i in range(5)]
needwun_indicator = [solver.BoolVar(f'needwun_{i}') for i in range(5)]

# Ensure only one option is selected for each function
solver.Add(solver.Sum(fill_matrix_indicator) == 1)
solver.Add(solver.Sum(reverse_string_indicator) == 1)
solver.Add(solver.Sum(traceback_indicator) == 1)
solver.Add(solver.Sum(needwun_indicator) == 1)

# Define intermediate variables for area and latency
fill_matrix_area_var = solver.Sum([fill_matrix_area[i] * fill_matrix_indicator[i] for i in range(5)])
fill_matrix_latency_var = solver.Sum([fill_matrix_latency[i] * fill_matrix_indicator[i] for i in range(5)])

reverse_string_area_var = solver.Sum([reverse_string_area[i] * reverse_string_indicator[i] for i in range(5)])
reverse_string_latency_var = solver.Sum([reverse_string_latency[i] * reverse_string_indicator[i] for i in range(5)])

traceback_area_var = solver.Sum([traceback_area[i] * traceback_indicator[i] for i in range(5)])
traceback_latency_var = solver.Sum([traceback_latency[i] * traceback_indicator[i] for i in range(5)])

needwun_area_var = solver.Sum([needwun_area[i] * needwun_indicator[i] for i in range(5)])
needwun_latency_var = solver.Sum([needwun_latency[i] * needwun_indicator[i] for i in range(5)])

# Define the objective: minimize latency
total_latency = solver.Sum([
    fill_matrix_latency_var,
    reverse_string_latency_var,
    traceback_latency_var,
    needwun_latency_var
])
solver.Minimize(total_latency)

# Define the constraint: total area <= 7000
total_area = solver.Sum([
    fill_matrix_area_var,
    reverse_string_area_var,
    traceback_area_var,
    needwun_area_var
])
solver.Add(total_area <= 7000)

# Solve the problem
status = solver.Solve()

# Print the results
if status == pywraplp.Solver.OPTIMAL:
    print('Optimal solution found:')
    print(f'fill_matrix: {[i for i in range(5) if fill_matrix_indicator[i].solution_value() == 1][0]}')
