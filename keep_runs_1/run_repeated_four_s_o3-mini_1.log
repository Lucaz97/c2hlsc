int even_sum(int n)
{
  // Use an equivalent closed-form:
  // For both even and odd n, floor(n/2) = n >> 1, and even_sum(n) equals
  // q * (q - 1) where q = floor(n/2).
  int q = n >> 1;
  int sum = q * (q - 1);
  return sum;
}
