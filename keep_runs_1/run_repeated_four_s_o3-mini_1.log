int fibonacci(int n)
{
  int a = 0;
  int b = 1;
  int c;
  
  // The loop implements the Fibonacci recurrence.
  // Since each iteration depends on the result of the previous iteration,
  // full unrolling the loop minimizes the control overhead and reduces latency.
  // When n is a compile‐time constant (or a known maximum exists), full unrolling
  // will yield the lowest possible latency even though the recurrence is sequential.
  for (int i = 2; i < n; i++)
  {
    #pragma hls_unroll yes
    c = a + b;
    a = b;
    b = c;
  }
  
  return c;
}
