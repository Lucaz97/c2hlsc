int even_sum(int n)
{
  // Instead of iterating, we use a closed-form expression.
  // The sum of even numbers from 2 up to the largest even < n can be computed as:
  // Let m = (n-2)/2 if n is even, or m = (n-1)/2 if n is odd.
  // Then sum = m * (m + 1)
  int m;
  if (n % 2 == 0)
    m = (n - 2) / 2;
  else
    m = (n - 1) / 2;
    
  int sum = m * (m + 1);
  return sum;
}
```
