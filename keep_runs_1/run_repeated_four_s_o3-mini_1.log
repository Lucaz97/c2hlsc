```c
int odd_factorial(int n)
{
    if(n <= 1) return 1;

    int count = (n + 1) / 2;
    int prod_even = 1;
    int prod_odd = 1;
    
    // Accumulate factors at even indices: k = 0, 2, 4, ...
    for (int k = 0; k < count; k += 2) {
        #pragma hls_pipeline_init_interval 0
        prod_even = prod_even * (2 * k + 1);
    }
    
    // Accumulate factors at odd indices: k = 1, 3, 5, ...
    for (int k = 1; k < count; k += 2) {
        #pragma hls_pipeline_init_interval 0
        prod_odd = prod_odd * (2 * k + 1);
    }
    
    return prod_even * prod_odd;
}
```
