int fibonacci(int n)
{
  int a = 0;
  int b = 1;
  int c;

  // Double-step iterated computation to reduce the loop depth and overall latency.
  // The original loop runs for (n-2) iterations.
  // Here we perform two Fibonacci steps per loop iteration.
  int iterations = (n - 2) / 2;
  int remainder = (n - 2) % 2;

  for (int i = 0; i < iterations; i++) {
    #pragma hls_pipeline_init_interval 1
    // In one iteration two Fibonacci steps are computed:
    // temp1 = a + b computes the next Fibonacci number;
    // temp2 = a + 2*b computes the subsequent Fibonacci number.
    int temp1 = a + b;
    int temp2 = a + 2 * b;
    a = temp1;
    b = temp2;
  }

  if (remainder) {
    #pragma hls_pipeline_init_interval 1
    c = a + b;
  }
  else {
    c = b;
  }

  return c;
}
```
