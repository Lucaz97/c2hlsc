int odd_factorial(int n)
{
    // No multiplications needed if n is 1 or less.
    if(n <= 1) return 1;

    // Compute how many odd numbers less than n.
    int count = (n + 1) / 2;  // works for both even and odd n

    int acc0 = 1, acc1 = 1;
#pragma HLS unroll yes
    for (int k = 0; k < count; k++) {
        int factor = 2 * k + 1;
        // Split the product into two independent chains.
        if (k & 1)
            acc1 = acc1 * factor;
        else
            acc0 = acc0 * factor;
    }
    
    return acc0 * acc1;
}
```
