int fibonacci(int n)
{
    // For n < 2 the behavior is undefined in the original function.
    // We explicitly handle the base cases.
    if (n < 2) return 0;
    if (n == 2) return 1;

    // We compute Fibonacci using matrix exponentiation.
    // The Fibonacci recurrence can be derived from:
    //    | F(n+1) F(n)   | = |1 1|^n
    //    | F(n)   F(n-1) |   |1 0|
    // Since the original algorithm returns the value computed after (n-2) iterations,
    // we want to compute M^(n-2), and then the top-left element is F(n).
    //
    // Precompute M^(n-2) using binary exponentiation.
    int exp = n - 2;

    // Initialize result as identity matrix.
    int r[2][2] = { {1, 0}, {0, 1} };

    // Base Fibonacci matrix.
    int p[2][2] = { {1, 1}, {1, 0} };

    while(exp > 0)
    {
        #pragma hls_pipeline_init_interval 1
        // If the current exponent bit is 1, multiply r by p.
        if(exp & 1)
        {
            int t00 = r[0][0]*p[0][0] + r[0][1]*p[1][0];
            int t01 = r[0][0]*p[0][1] + r[0][1]*p[1][1];
            int t10 = r[1][0]*p[0][0] + r[1][1]*p[1][0];
            int t11 = r[1][0]*p[0][1] + r[1][1]*p[1][1];

            r[0][0] = t00;
            r[0][1] = t01;
            r[1][0] = t10;
            r[1][1] = t11;
        }

        // Square the matrix p.
        int t00 = p[0][0]*p[0][0] + p[0][1]*p[1][0];
        int t01 = p[0][0]*p[0][1] + p[0][1]*p[1][1];
        int t10 = p[1][0]*p[0][0] + p[1][1]*p[1][0];
        int t11 = p[1][0]*p[0][1] + p[1][1]*p[1][1];

        p[0][0] = t00;
        p[0][1] = t01;
        p[1][0] = t10;
        p[1][1] = t11;

        exp = exp >> 1;
    }

    // The top-left element of r now holds Fibonacci(n)
    return r[0][0];
}
