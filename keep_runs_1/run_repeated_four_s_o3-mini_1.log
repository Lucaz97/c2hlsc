```c
int odd_factorial(int n)
{
    // For n <= 1, there are no multiplications to perform.
    if(n <= 1) return 1;

    // Compute the number of odd factors.
    // The loop multiplies odd numbers 1, 3, 5, ... that are less than n.
    int count = n / 2;  // (for both even and odd n, this yields the correct count)

    // For latency optimization, we restructure the sequential chain into a reduction tree.
    // This method reduces the critical path to O(log(count)) multiplications.
    // Note: We assume a bounded maximum for n so that count does not exceed 128.
    int product[128];
    // Fully partition the array to allow parallel accesses during tree reduction.
#pragma HLS ARRAY_PARTITION variable=product complete dim=1

    // Populate the product array with the odd numbers.
    for (int i = 0; i < count; i++) {
#pragma HLS unroll yes
        product[i] = 2 * i + 1;
    }

    // Reduction tree: combine adjacent factors in parallel until a single product remains.
    while (count > 1) {
        // Compute the new count (ceiling of half).
        int new_count = (count + 1) >> 1;
        for (int j = 0; j < new_count; j++) {
#pragma HLS unroll yes
            int idx = 2 * j;
            if (idx + 1 < count)
                product[j] = product[idx] * product[idx + 1];
            else
                product[j] = product[idx];
        }
        count = new_count;
    }

    return product[0];
}
```
