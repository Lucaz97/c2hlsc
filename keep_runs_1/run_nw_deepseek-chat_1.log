            print(f'fill_matrix: option {i}')
    for i in reverse_string_options:
        if reverse_string_vars[i].solution_value() == 1:
            print(f'reverse_string: option {i}')
    for i in traceback_options:
        if traceback_vars[i].solution_value() == 1:
            print(f'traceback: option {i}')
    for i in needwun_options:
        if needwun_vars[i].solution_value() == 1:
            print(f'needwun: option {i}')
    print(f'Total latency: {solver.Objective().Value()}')
    print(f'Total area: {sum(area_data["fill_matrix"][i] * fill_matrix_vars[i].solution_value() for i in fill_matrix_options) + sum(area_data["reverse_string"][i] * reverse_string_vars[i].solution_value() for i in reverse_string_options) + sum(area_data["traceback"][i] * traceback_vars[i].solution_value() for i in traceback_options) + sum(area_data["needwun"][i] * needwun_vars[i].solution_value() for i in needwun_options)}')
