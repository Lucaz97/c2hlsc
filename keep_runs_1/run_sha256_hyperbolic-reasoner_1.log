typedef struct {
    data_t data;
    state_t state;
    unsigned int datalen;
    unsigned long long bitlen;
} hls_update_ctx;

hls_update_ctx sha256_update_hls(hls_update_ctx ctx, data_t data, size_t len) {
    int i;
    for (i = 0; i < len; ++i) {
        ctx.data[ctx.datalen] = data[i];
        ctx.datalen++;
        if (ctx.datalen == 64) {
            sha256_transform_hls(ctx.state, ctx.data);
            ctx.bitlen += 512;
            ctx.datalen = 0;
        }
    }
    return ctx;
}

void sha256_update(data_t *data_int, unsigned int* datalen_int, state_t *state, unsigned long long int* bitlen_int, data_t *data, size_t len) {
    hls_update_ctx ctx;
    memcpy(ctx.data, *data_int, 64);
    memcpy(ctx.state, *state, 32);
    ctx.datalen = *datalen_int;
    ctx.bitlen = *bitlen_int;
    
    ctx = sha256_update_hls(ctx, *data, len);
    
    memcpy(*data_int, ctx.data, 64);
    memcpy(*state, ctx.state, 32);
    *datalen_int = ctx.datalen;
    *bitlen_int = ctx.bitlen;
}
