python: '''import sys
from ortools.linear_solver import pywraplp

# Define the options for each function as (area, latency, throughput)
functions = {
    'shift': [
        (1451.8, 2.0, 4.0),
        (1929.7, 2.0, 4.0),
        (1451.8, 2.0, 4.0),
        (1546.9, 3.0, 5.0),
        (1451.8, 2.0, 4.0)
    ],
    'mac': [
        (4346.7, 2.0, 3.0),
        (6690.9, 6.0, 7.0),
        (4346.7, 2.0, 3.0),
        (4346.7, 2.0, 3.0),
        (6690.9, 6.0, 7.0)
    ],
    'fir': [
        (5043.1, 10.0, 11.0),
        (5043.1, 10.0, 11.0),
        (6135.1, 5.0, 6.0),
        (4901.3, 10.0, 11.0),
        (6219.2, 5.0, 6.0)
    ],
    'iir': [
        (8132.5, 16.0, 22.0),
        (8160.4, 16.0, 22.0),
        (8160.4, 16.0, 22.0),
        (8160.4, 16.0, 22.0),
        (8630.3, 10.0, 11.0)
    ],
    'filter': [
        (3440.3, 1.0, 2.0),
        (3440.3, 1.0, 2.0),
        (3440.3, 1.0, 2.0),
        (3440.3, 1.0, 2.0),
        (3440.3, 1.0, 2.0)
    ]
}

# Call graph:
# iir calls: shift, mac, mac, shift
# fir calls: shift, mac
# filter calls: fir, iir
#
# For a rough estimation, we define the overall application metrics as:
# Total_Area = filter_area + fir_area + iir_area + (number_of_shift_calls)*shift_area + (number_of_mac_calls)*mac_area
# where number_of_shift_calls = 1 (from fir) + 2 (from iir) = 3 
# and number_of_mac_calls   = 1 (from fir) + 2 (from iir) = 3
#
# Total_Latency is approximated by summing the individual latencies.
#
# Note: This is a simplified model for optimization purposes.
target_area = 6000.0

def compute_totals(opts):
    shift_area, shift_lat, _ = functions['shift'][opts['shift']]
    mac_area, mac_lat, _ = functions['mac'][opts['mac']]
    fir_area, fir_lat, _ = functions['fir'][opts['fir']]
    iir_area, iir_lat, _ = functions['iir'][opts['iir']]
    filter_area, filter_lat, _ = functions['filter'][opts['filter']]
    
    total_area = filter_area + fir_area + iir_area + 3*shift_area + 3*mac_area
    total_latency = filter_lat + fir_lat + iir_lat + shift_lat + mac_lat  # simplified summation
    return total_area, total_latency

# We will enumerate over the available options and select the configuration
# that minimizes latency while having the total area as close as possible to target_area.
# For simplicity, we use an objective: latency + |total_area - target_area|
best_obj = None
best_config = None

for shift_opt in range(len(functions['shift'])):
    for mac_opt in range(len(functions['mac'])):
        for fir_opt in range(len(functions['fir'])):
            for iir_opt in range(len(functions['iir'])):
                for filter_opt in range(len(functions['filter'])):
                    opts = {
                        'shift': shift_opt,
                        'mac': mac_opt,
                        'fir': fir_opt,
                        'iir': iir_opt,
                        'filter': filter_opt
                    }
                    area, latency = compute_totals(opts)
                    obj = latency + abs(area - target_area)
                    if best_obj is None or obj < best_obj:
                        best_obj = obj
                        best_config = opts

print(best_config)
'''
