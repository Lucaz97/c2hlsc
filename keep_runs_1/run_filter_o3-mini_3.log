        (3440.3, 1.0, 2.0),
        (3440.3, 1.0, 2.0),
        (3440.3, 1.0, 2.0),
        (3440.3, 1.0, 2.0)
    ]
}

target_area = 6000.0

def compute_totals(shift_opt, mac_opt, fir_opt, iir_opt, filter_opt):
    shift_area, shift_lat, _ = functions['shift'][shift_opt]
    mac_area, mac_lat, _ = functions['mac'][mac_opt]
    fir_area, fir_lat, _ = functions['fir'][fir_opt]
    iir_area, iir_lat, _ = functions['iir'][iir_opt]
    filter_area, filter_lat, _ = functions['filter'][filter_opt]
    
    # Compute total area
    total_area = filter_area + fir_area + iir_area + 3 * shift_area + 3 * mac_area
    
    # Compute total latency based on a simplified sum.
    # Here we consider one instance per function for the summation.
    total_latency = filter_lat + fir_lat + iir_lat + shift_lat + mac_lat
    return total_area, total_latency

best_obj = None
best_config = None

# Enumerate over all options for each function
for shift_opt in range(len(functions['shift'])):
    for mac_opt in range(len(functions['mac'])):
        for fir_opt in range(len(functions['fir'])):
            for iir_opt in range(len(functions['iir'])):
                for filter_opt in range(len(functions['filter'])):
                    total_area, total_latency = compute_totals(shift_opt, mac_opt, fir_opt, iir_opt, filter_opt)
                    # Objective: minimize latency while keeping area close to target
                    obj = total_latency + abs(total_area - target_area)
