area = model.NewIntVar(0, 1000000, "area")        # Scaled by 10

# Add constraints for latency and area
for func in functions:
    for i in range(len(functions[func])):
        # Add constraint: if option_vars[func] == i, then latency >= functions[func][i]["latency"]
        model.Add(latency >= functions[func][i]["latency"]).OnlyEnforceIf(
            model.NewBoolVar(f"{func}_option_{i}_latency"))
        # Add constraint: if option_vars[func] == i, then area >= functions[func][i]["area"]
        model.Add(area >= functions[func][i]["area"]).OnlyEnforceIf(
            model.NewBoolVar(f"{func}_option_{i}_area"))

# Objective: minimize latency
model.Minimize(latency)

# Constraint: area must be as close as possible to 105000 (scaled by 10)
model.Add(area <= 105000)

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Optimal configuration found:")
    for func in functions:
        option = solver.Value(option_vars[func])
        print(f"{func}: option {option} (latency={functions[func][option]['latency'] / 10}, area={functions[func][option]['area'] / 10})")
    print(f"Total latency: {solver.Value(latency) / 10}")
    print(f"Total area: {solver.Value(area) / 10}")
else:
    print("No feasible solution found.")
'''
