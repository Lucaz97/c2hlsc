        block[i] = 0;
        for (j = 0; j < 8; j++) {
            #pragma hls_unroll yes
            indexVal = const_i + (3 - (j >> 1));
            andVal = temp << ((j & 1) << 2);
            block[i] |= (((initial[indexVal] & andVal) != 0) << j);
        }
    }
}

void pLayer(block_t *block)
{
    pLayer_hls(*block);
}

