python: '''
from ortools.sat.python import cp_model

# Define the problem data
functions = {
    "copyKey_hls": [{"area": 529.7, "latency": 1.0} for _ in range(5)],
    "copyBlock_hls": [
        {"area": 427.6, "latency": 1.0},
        {"area": 758.8, "latency": 3.0},
        {"area": 1163.7, "latency": 8.0},
        {"area": 1026.9, "latency": 4.0},
        {"area": 427.6, "latency": 1.0},
    ],
    "generateRoundKeys80_hls": [{"area": 2354.3, "latency": 596.0} for _ in range(5)],
    "addRoundKey_hls": [
        {"area": 126.1, "latency": 0.0},
        {"area": 498.6, "latency": 2.0},
        {"area": 424.1, "latency": 14.0},
        {"area": 126.1, "latency": 0.0},
        {"area": 416.7, "latency": 6.0},
    ],
    "pLayer_hls": [
        {"area": 771.3, "latency": 8.0},
        {"area": 1007.7, "latency": 150.0},
        {"area": 771.3, "latency": 8.0},
        {"area": 1007.7, "latency": 150.0},
        {"area": 771.3, "latency": 8.0},
    ],
    "present80_encryptBlock_hls": [{"area": 13584.8, "latency": 1745.0} for _ in range(5)],
}

# Create the model
model = cp_model.CpModel()

# Decision variables: option index for each function
option_vars = {}
for func in functions:
    option_vars[func] = model.NewIntVar(0, len(functions[func]) - 1, f"{func}_option")

# Latency and area expressions
latency = 0
area = 0
for func in functions:
    latency += sum(option_vars[func] == i * functions[func][i]["latency"] for i in range(len(functions[func])))
    area += sum(option_vars[func] == i * functions[func][i]["area"] for i in range(len(functions[func])))

# Objective: minimize latency
model.Minimize(latency)

# Constraint: area must be as close as possible to 10500
model.Add(area <= 10500)

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Optimal configuration found:")
    for func in functions:
        option = solver.Value(option_vars[func])
        print(f"{func}: option {option} (latency={functions[func][option]['latency']}, area={functions[func][option]['area']})")
    print(f"Total latency: {solver.ObjectiveValue()}")
    print(f"Total area: {solver.Value(area)}")
else:
    print("No feasible solution found.")
'''
``` 

