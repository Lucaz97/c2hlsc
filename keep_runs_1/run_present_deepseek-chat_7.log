    ],
    "present80_encryptBlock_hls": [{"area": 13584.8, "latency": 1745.0} for _ in range(5)],
}

# Scale floating-point values to integers
scale_factor = 1000
for func, options in functions.items():
    for opt in options:
        opt["area"] = int(opt["area"] * scale_factor)
        opt["latency"] = int(opt["latency"] * scale_factor)

# Variables for function options
option_vars = {}
for func, options in functions.items():
    option_vars[func] = model.NewIntVar(0, len(options) - 1, f"{func}_option")

# Total area and latency
total_area = model.NewIntVar(0, 100000 * scale_factor, "total_area")
total_latency = model.NewIntVar(0, 100000 * scale_factor, "total_latency")

# Use Element constraint to dynamically access area and latency values
area_expr = []
latency_expr = []
for func, options in functions.items():
    area_expr.append(model.NewIntVar(0, 100000 * scale_factor, f"{func}_area"))
    latency_expr.append(model.NewIntVar(0, 100000 * scale_factor, f"{func}_latency"))
    model.AddElement(option_vars[func], [opt["area"] for opt in options], area_expr[-1])
    model.AddElement(option_vars[func], [opt["latency"] for opt in options], latency_expr[-1])

model.Add(total_area == sum(area_expr))
model.Add(total_latency == sum(latency_expr))

# Constraints
model.Add(total_area <= 12000 * scale_factor)  # Further relaxed area constraint
model.Minimize(total_latency)   # Minimize latency

