from ortools.sat.python import cp_model

# Define the problem
model = cp_model.CpModel()

# Function options and their area/latency values
functions = {
    "copyKey_hls": [{"area": 529.7, "latency": 1.0} for _ in range(5)],
    "copyBlock_hls": [
        {"area": 427.6, "latency": 1.0},
        {"area": 758.8, "latency": 3.0},
        {"area": 1163.7, "latency": 8.0},
        {"area": 1026.9, "latency": 4.0},
        {"area": 427.6, "latency": 1.0},
    ],
    "generateRoundKeys80_hls": [{"area": 2354.3, "latency": 596.0} for _ in range(5)],
    "addRoundKey_hls": [
        {"area": 126.1, "latency": 0.0},
        {"area": 498.6, "latency": 2.0},
        {"area": 424.1, "latency": 14.0},
        {"area": 126.1, "latency": 0.0},
        {"area": 416.7, "latency": 6.0},
    ],
    "pLayer_hls": [
        {"area": 771.3, "latency": 8.0},
        {"area": 1007.7, "latency": 150.0},
        {"area": 771.3, "latency": 8.0},
        {"area": 1007.7, "latency": 150.0},
        {"area": 771.3, "latency": 8.0},
    ],
    "present80_encryptBlock_hls": [{"area": 13584.8, "latency": 1745.0} for _ in range(5)],
}

# Variables for function options
option_vars = {}
for func, options in functions.items():
    option_vars[func] = model.NewIntVar(0, len(options) - 1, f"{func}_option")

# Total area and latency
total_area = sum(
    functions[func][option_vars[func]].get("area", 0) for func in functions
)
total_latency = sum(
    functions[func][option_vars[func]].get("latency", 0) for func in functions
)

# Constraints
model.Add(total_area <= 10500)  # Target area
model.Minimize(total_latency)   # Minimize latency

# Solve the problem
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Optimal configuration found:")
    for func in functions:
        option = solver.Value(option_vars[func])
        print(f"{func}: option {option}, area: {functions[func][option]['area']}, latency: {functions[func][option]['latency']}")
    print(f"Total area: {solver.Value(total_area)}")
    print(f"Total latency: {solver.Value(total_latency)}")
else:
    print("No feasible solution found.")
'''
