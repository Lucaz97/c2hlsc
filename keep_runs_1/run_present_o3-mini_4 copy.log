    (13066.8, 1137.0, 1139.0),
    (13066.8, 1137.0, 1139.0)
]

# List of functions in our configuration
functions = [
    ("copyKey_hls", copyKey),
    ("copyBlock_hls", copyBlock),
    ("generateRoundKeys80_hls", generateRoundKeys80),
    ("addRoundKey_hls", addRoundKey),
    ("pLayer_hls", pLayer),
    ("present80_encryptBlock_hls", present80_encryptBlock)
]

TARGET_AREA = 70000.0

# The design goal:
#   - Primary objective: minimize total latency (which is the sum of latencies of each synthesized function)
#   - Secondary objective: among configurations that achieve the minimal latency,
#                          choose the one whose total area is as close as possible to TARGET_AREA.
# Since our total area sums (from the options) are much lower than TARGET_AREA, "close" means as high as possible.

best_latency = None
best_config = None
best_area_diff = None  # absolute difference to TARGET_AREA

# Enumerate all combinations (brute force over the small search space)
from itertools import product

# create index ranges for each function based on number of options
ranges = [range(len(opts)) for _, opts in functions]

for config in product(*ranges):
    total_area = 0.0
