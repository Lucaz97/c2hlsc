    elif total_latency == best_latency:
        area_diff = abs(TARGET_AREA - total_area)
        if area_diff < best_area_diff:
            best_area_diff = area_diff
            best_config = config

# Print detailed result
print("Best configuration found:")
for (fname, opts), sel in zip(functions, best_config):
    area, latency, thr = opts[sel]
    print(f"{fname} option {sel}: area = {area}, latency = {latency}, throughput = {thr}")
total_area = sum(opts[sel][0] for (_, opts), sel in zip(functions, best_config))
total_latency = sum(opts[sel][1] for (_, opts), sel in zip(functions, best_config))
print(f"Total area = {total_area}")
print(f"Total latency = {total_latency}")
print(f"Area difference to target ({TARGET_AREA}) = {abs(TARGET_AREA - total_area)}")
