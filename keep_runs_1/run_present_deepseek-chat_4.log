    },
    "present80_encryptBlock_hls": {
        "options": [0, 1, 2, 3, 4],
        "area": [13584.8, 13584.8, 13584.8, 13584.8, 13584.8],
        "latency": [1745.0, 1745.0, 1745.0, 1745.0, 1745.0]
    }
}

# Scale area and latency values to integers
scale_factor = 10
for func in functions:
    functions[func]["area"] = [int(a * scale_factor) for a in functions[func]["area"]]
    functions[func]["latency"] = [int(l * scale_factor) for l in functions[func]["latency"]]

# Variables to represent the selected option for each function
selected_options = {}
for func in functions:
    selected_options[func] = model.NewIntVar(0, len(functions[func]["options"]) - 1, f"{func}_option")

# Total area and latency
total_area = model.NewIntVar(0, 200000, "total_area")
total_latency = model.NewIntVar(0, 100000, "total_latency")

# Use Element constraint to map selected options to area and latency
area_vars = {}
latency_vars = {}
for func in functions:
    area_vars[func] = model.NewIntVar(0, 200000, f"{func}_area")
    latency_vars[func] = model.NewIntVar(0, 100000, f"{func}_latency")
    model.AddElement(selected_options[func], functions[func]["area"], area_vars[func])
    model.AddElement(selected_options[func], functions[func]["latency"], latency_vars[func])

# Sum up area and latency
model.Add(total_area == sum(area_vars[func] for func in functions))
model.Add(total_latency == sum(latency_vars[func] for func in functions))

# Objective: minimize latency
model.Minimize(total_latency)

# Solve the model
solver = cp_model.CpSolver()
status = solver.Solve(model)

# Output the results
if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("Optimal configuration found:")
    for func in functions:
        print(f"{func}: option {solver.Value(selected_options[func])}")
    print(f"Total Area: {solver.Value(total_area) / scale_factor}")
    print(f"Total Latency: {solver.Value(total_latency) / scale_factor}")
else:
    print("No feasible solution found.")
