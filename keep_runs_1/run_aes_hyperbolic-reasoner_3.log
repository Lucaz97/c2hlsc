python: '''
from ortools.sat.python import cp_model

functions = {
    'AddRoundKey_hls': [
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 1816.7, 'latency': 49.0},
        {'area': 752.6, 'latency': 34.0},
        {'area': 752.6, 'latency': 34.0},
    ],
    'SubBytes_hls': [
        {'area': 826.5, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
        {'area': 825.9, 'latency': 33.0},
    ],
    'ShiftRows_hls': [
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
    ],
    'xtime': [
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
        {'area': 77.0, 'latency': 1.0},
    ],
    'MixColumns_hls': [
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
        {'area': 635.9, 'latency': 6.0},
    ],
    'Cipher_hls': [
        {'area': 2632.8, 'latency': 1091.0},
        {'area': 3685.5, 'latency': 1011.0},
        {'area': 2632.8, 'latency': 1091.0},
        {'area': 3685.5, 'latency': 1011.0},
        {'area': 2665.5, 'latency': 1029.0},
    ],
}

model = cp_model.CpModel()
option_vars = {func: model.NewIntVar(0, len(opts)-1, func) for func, opts in functions.items()}

total_area = 0
total_latency = 0
for func in functions:
    areas = [int(opt['area']*10) for opt in functions[func]]
    area_var = model.NewIntVar(0, 100000, f'area_{func}')
    model.AddElement(option_vars[func], areas, area_var)
    total_area += area_var

    latencies = [int(opt['latency']*10) for opt in functions[func]]
    latency_var = model.NewIntVar(0, 100000, f'latency_{func}')
    model.AddElement(option_vars[func], latencies, latency_var)
    total_latency += latency_var

# Relax target area to 11000
target_area = 11000 * 10  
area_diff = model.NewIntVar(0, 200000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - target_area)
model.Minimize(total_latency * 1000 + area_diff)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    config = []
    for func in functions:
        opt = solver.Value(option_vars[func])
        config.append(f"{func} {opt}")
    print(f"solution: {', '.join(config)}")
else:
    print("No optimal solution found.")
'''
