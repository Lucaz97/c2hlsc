python: '''
from ortools.sat.python import cp_model

# Scale areas and latencies to integers by multiplying by 10
functions = {
    'shift': [
        {'area': 14518, 'latency': 20},
        {'area': 14518, 'latency': 20},
        {'area': 239, 'latency': 0},
        {'area': 239, 'latency': 0},
        {'area': 11071, 'latency': 90},
    ],
    'mac': [
        {'area': 43467, 'latency': 20},
        {'area': 39514, 'latency': 60},
        {'area': 46250, 'latency': 80},
        {'area': 44175, 'latency': 80},
        {'area': 44175, 'latency': 80},
    ],
    'fir': [
        {'area': 46691, 'latency': 60},
        {'area': 46691, 'latency': 60},
        {'area': 46691, 'latency': 60},
        {'area': 46691, 'latency': 60},
        {'area': 46691, 'latency': 60},
    ],
    'iir': [
        {'area': 72255, 'latency': 120},
        {'area': 72350, 'latency': 120},
        {'area': 86808, 'latency': 150},
        {'area': 86303, 'latency': 100},
        {'area': 86303, 'latency': 100},
    ],
    'filter': [
        {'area': 45813, 'latency': 70},
        {'area': 45813, 'latency': 70},
        {'area': 45813, 'latency': 70},
        {'area': 45813, 'latency': 70},
        {'area': 45813, 'latency': 70},
    ],
}

target_area = 60000  # 6000 * 10

model = cp_model.CpModel()

selected = {}
for func in functions:
    selected[func] = model.NewIntVar(0, len(functions[func])-1, f'selected_{func}')

area_vars = []
latency_vars = []

for func in functions:
    options = functions[func]
    area_var = model.NewIntVar(0, sum(opt['area'] for opt in options), f'area_{func}')
    latency_var = model.NewIntVar(0, sum(opt['latency'] for opt in options), f'latency_{func}')
    
    for idx, opt in enumerate(options):
        model.Add(area_var == opt['area']).OnlyEnforceIf(selected[func] == idx)
        model.Add(latency_var == opt['latency']).OnlyEnforceIf(selected[func] == idx)
    
    area_vars.append(area_var)
    latency_vars.append(latency_var)

total_area = model.NewIntVar(0, 10*sum(opt['area'] for f in functions for opt in functions[f]), 'total_area')
model.Add(total_area == sum(area_vars))

delta = model.NewIntVar(-target_area, target_area, 'delta')
model.Add(delta == total_area - target_area)
abs_delta = model.NewIntVar(0, 2*target_area, 'abs_delta')
model.AddAbsEquality(abs_delta, delta)

total_latency = model.NewIntVar(0, 10*sum(opt['latency'] for f in functions for opt in functions[f]), 'total_latency')
model.Add(total_latency == sum(latency_vars))

model.Minimize(1000*total_latency + abs_delta)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Solution:")
    for func in functions:
        idx = solver.Value(selected[func])
        print(f"{func}:{idx}", end=', ')
    print(f"\\nArea: {solver.Value(total_area)/10}, Latency: {solver.Value(total_latency)/10}")
else:
    print("No solution found")
'''
