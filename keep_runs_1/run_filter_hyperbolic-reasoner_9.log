        {'area': 4625.0, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
    ],
    'fir': [
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
    ],
    'iir': [
        {'area': 7225.5, 'latency': 12.0},
        {'area': 7235.0, 'latency': 12.0},
        {'area': 8680.8, 'latency': 15.0},
        {'area': 8630.3, 'latency': 10.0},
        {'area': 8630.3, 'latency': 10.0},
    ],
    'filter': [
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
    ],
}

model = cp_model.CpModel()
selected = {}
for func in functions:
    selected[func] = model.NewIntVar(0, len(functions[func])-1, func)

area_vars = []
latency_vars = []

for func in functions:
    options = functions[func]
    for idx, opt in enumerate(options):
        option_active = model.NewBoolVar(f'{func}_{idx}')
        model.Add(selected[func] == idx).OnlyEnforceIf(option_active)
        model.Add(selected[func] != idx).OnlyEnforceIf(option_active.Not())
        
        scaled_area = int(opt['area'] * 10)
        scaled_latency = int(opt['latency'] * 10)
        area_vars.append(option_active * scaled_area)
        latency_vars.append(option_active * scaled_latency)

total_area = sum(area_vars)
total_latency = sum(latency_vars)

target = 6000 * 10
tolerance = 3000  # 5% of 60000
model.Add(total_area >= target - tolerance)
model.Add(total_area <= target + tolerance)

model.Minimize(total_latency)
solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Solution:")
    for func in functions:
        idx = solver.Value(selected[func])
        print(f"{func} {idx}", end=', ')
    print(f"\nTotal area: {solver.Value(total_area)/10}")
    print(f"Total latency: {solver.Value(total_latency)/10}")
else:
    print("No solution found")
