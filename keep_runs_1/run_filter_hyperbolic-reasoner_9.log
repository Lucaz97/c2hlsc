python: '''
from ortools.sat.python import cp_model

# Function options data
functions = {
    'shift': [
        {'area': 1451.8, 'latency': 2.0},
        {'area': 1451.8, 'latency': 2.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 23.9, 'latency': 0.0},
        {'area': 1107.1, 'latency': 9.0},
    ],
    'mac': [
        {'area': 4346.7, 'latency': 2.0},
        {'area': 3951.4, 'latency': 6.0},
        {'area': 4625.0, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
        {'area': 4417.5, 'latency': 8.0},
    ],
    'fir': [
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
        {'area': 4669.1, 'latency': 6.0},
    ],
    'iir': [
        {'area': 7225.5, 'latency': 12.0},
        {'area': 7235.0, 'latency': 12.0},
        {'area': 8680.8, 'latency': 15.0},
        {'area': 8630.3, 'latency': 10.0},
        {'area': 8630.3, 'latency': 10.0},
    ],
    'filter': [
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
        {'area': 4581.3, 'latency': 7.0},
    ],
}

model = cp_model.CpModel()

# Variables: option index for each function
option_vars = {}
for func in functions:
    option_vars[func] = model.NewIntVar(0, len(functions[func])-1, func)

# Total area and latency variables
total_area = model.NewIntVar(0, 100000, 'total_area')
total_latency = model.NewIntVar(0, 1000, 'total_latency')

# Element constraints for area and latency contributions
area_contributions = []
latency_contributions = []
for func in functions:
    areas = [functions[func][i]['area'] for i in range(len(functions[func]))]
    area_var = model.NewIntVar(0, sum(areas), f'area_{func}')
    model.AddElement(option_vars[func], areas, area_var)
    area_contributions.append(area_var)
    
    latencies = [functions[func][i]['latency'] for i in range(len(functions[func]))]
    latency_var = model.NewIntVar(0, sum(latencies), f'latency_{func}')
    model.AddElement(option_vars[func], latencies, latency_var)
    latency_contributions.append(latency_var)

model.Add(total_area == sum(area_contributions))
model.Add(total_latency == sum(latency_contributions))

# Objective: minimize latency and area difference from 6000
target_area = 6000
area_diff = model.NewIntVar(0, 100000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - target_area)
model.Minimize(area_diff * 1000 + total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal solution:")
    for func in functions:
        opt_idx = solver.Value(option_vars[func])
        print(f"{func} {opt_idx}", end=', ')
    print(f"\\nArea: {solver.Value(total_area)}, Latency: {solver.Value(total_latency)}")
else:
    print("No optimal solution found")
'''
