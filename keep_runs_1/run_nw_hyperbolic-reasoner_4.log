from ortools.sat.python import cp_model

# Function options data
functions = {
    'fill_matrix': [
        {'area': 2206.1, 'latency': 1293.0},
        {'area': 2144.7, 'latency': 1293.0},
        {'area': 2597.8, 'latency': 213.0},
        {'area': 2407.3, 'latency': 2538.0},
        {'area': 2698.4, 'latency': 213.0},
    ],
    'reverse_string': [
        {'area': 1804.2, 'latency': 31.0},
        {'area': 1719.0, 'latency': 31.0},
        {'area': 1719.0, 'latency': 31.0},
        {'area': 1906.1, 'latency': 31.0},
        {'area': 3611.2, 'latency': 95.0},
    ],
    'traceback': [
        {'area': 10173.9, 'latency': 34.0},
        {'area': 10173.9, 'latency': 34.0},
        {'area': 10173.9, 'latency': 34.0},
        {'area': 9416.3, 'latency': 127.0},
        {'area': 10173.9, 'latency': 34.0},
    ],
    'needwun': [
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
        {'area': 11809.5, 'latency': 250.0},
    ]
}

target_area = 6000

model = cp_model.CpModel()

# Variables: option index for each function
vars = {func: model.NewIntVar(0, len(options)-1, func) for func, options in functions.items()}

# Create area and latency variables for each function
area_vars = {}
latency_vars = {}
for func, options in functions.items():
    area_vars[func] = model.NewIntVar(0, int(max(opt['area'] for opt in options)*10), f"{func}_area")
    latency_vars[func] = model.NewIntVar(0, int(max(opt['latency'] for opt in options)*10), f"{func}_latency")
    
    # Link index variables to area/latency values
    model.AddElement(vars[func], [int(opt['area']*10) for opt in options], area_vars[func])
    model.AddElement(vars[func], [int(opt['latency']*10) for opt in options], latency_vars[func])

# Total area and latency (scaled by 10 to handle decimals)
total_area = sum(area_vars[func] for func in functions)
total_latency = sum(latency_vars[func] for func in functions)

# Area difference from target (target scaled by 10)
target_scaled = int(target_area * 10)
area_diff = model.NewIntVar(0, 1000000, 'area_diff')
model.AddAbsEquality(area_diff, total_area - target_scaled)

# Minimize weighted combination: priority to area difference, then latency
model.Minimize(area_diff * 1000 + total_latency)

solver = cp_model.CpSolver()
status = solver.Solve(model)

if status == cp_model.OPTIMAL:
    print("Optimal configuration:")
    for func in functions:
        idx = solver.Value(vars[func])
        print(f"{func} option {idx}: area={functions[func][idx]['area']}, latency={functions[func][idx]['latency']}")
    total_a = sum(functions[func][solver.Value(vars[func])]['area'] for func in functions)
    total_l = sum(functions[func][solver.Value(vars[func])]['latency'] for func in functions)
    print(f"Total area: {total_a} (target: {target_area})")
    print(f"Total latency: {total_l}")
else:
    print("No solution found")
